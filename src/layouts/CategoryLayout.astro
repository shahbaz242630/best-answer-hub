---
import BaseLayout from './BaseLayout.astro';
import type { SEOProps } from '../types';

interface Props {
  seo: SEOProps;
  categoryName: string;
  categoryDescription: string;
}

const { seo, categoryName, categoryDescription } = Astro.props;
---

<BaseLayout seo={seo}>
  <div class="py-12 md:py-16">
    <div class="container max-w-page mx-auto px-6">
      <header class="mb-10">
        <h1 class="font-serif text-3xl md:text-4xl font-bold text-bae-ink leading-tight mb-4">
          {categoryName}
        </h1>
        <p class="text-lg text-bae-muted max-w-2xl">{categoryDescription}</p>
      </header>
      
      <div class="grid gap-8">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
