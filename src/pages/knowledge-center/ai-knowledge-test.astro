  /* ───────────────────────── SERVE (random per attempt, options shuffled) ───────────────────────── */
  function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
  function pickN(arr, n) { return shuffle(arr.slice()).slice(0, n); }
  function buildServed(cfg) {
    var served = [];
    for (var d = 0; d < cfg.domains.length; d++) {
      var byLevel = [[], [], []];
      cfg.bank.forEach(function (q) { if (q.d === d) byLevel[q.l].push(q); });
      var chosen = [];
      for (var l = 0; l < 3; l++) { chosen = chosen.concat(pickN(byLevel[l], cfg.serve.mix[l])); } /* easy→med→hard ramp */
      chosen.forEach(function (q) {
        var order = shuffle([0, 1, 2, 3]);
        var opts = order.map(function (k) { return q.o[k]; });
        served.push({ d: q.d, q: q.q, opts: opts, correct: order.indexOf(q.c) });
      });
    }
    return served;
  }

  /* ───────────────────────── SCORING (pure, testable) ───────────────────────── */
  function computeResult(answers, served, cfg) {
    var nD = cfg.domains.length;
    var correctByD = new Array(nD).fill(0);
    var totalByD = new Array(nD).fill(0);
    for (var i = 0; i < served.length; i++) {
      totalByD[served[i].d]++;
      if (answers[i] === served[i].correct) correctByD[served[i].d]++;
    }
    var domainScores = correctByD.map(function (c, i2) { return totalByD[i2] ? Math.round((c / totalByD[i2]) * 100) : 0; });
    var totalCorrect = correctByD.reduce(function (a, b) { return a + b; }, 0);
    var overall = served.length ? Math.round((totalCorrect / served.length) * 100) : 0;
    var bucket = cfg.buckets[cfg.buckets.length - 1];
    for (var b = 0; b < cfg.buckets.length; b++) {
      if (overall <= cfg.buckets[b].max) { bucket = cfg.buckets[b]; break; }
    }
    var order = domainScores.map(function (s, idx) { return { idx: idx, s: s }; })
      .sort(function (a, b2) { return a.s - b2.s || a.idx - b2.idx; });
    return {
      domainScores: domainScores,
      overall: overall,
      bucket: bucket,
      weakest: [order[0].idx, order[1].idx],
      winIdx: [order[0].idx, order[1].idx, order[2].idx]
    };
  }
  /* expose for node-testing */
  if (typeof window !== 'undefined') { window.__baeAiTest = { computeResult: computeResult, buildServed: buildServed, fillCta: fillCta, CONFIG: CONFIG }; }

  /* ───────────────────────── STATE & PERSISTENCE ───────────────────────── */
  var st = { served: [], i: 0, answers: [], elapsed: 0, done: false, timerId: null };
  function N() { return st.served.length; }

  function freshState() { st.served = buildServed(CONFIG); st.i = 0; st.answers = new Array(st.served.length).fill(null); st.elapsed = 0; st.done = false; }
  function save() {
    try { sessionStorage.setItem(CONFIG.storageKey, JSON.stringify({ served: st.served, i: st.i, answers: st.answers, elapsed: st.elapsed, done: !!st.done })); } catch (e) {}
  }
  function clearSaved() { try { sessionStorage.removeItem(CONFIG.storageKey); } catch (e) {} }
  function validServed(s) {
    if (!Array.isArray(s) || s.length === 0) return false;
    return s.every(function (q) { return q && typeof q.d === 'number' && Array.isArray(q.opts) && q.opts.length === 4 && typeof q.correct === 'number'; });
  }
  function restore() {
    try {
      var raw = sessionStorage.getItem(CONFIG.storageKey);
      if (!raw) return false;
      var s = JSON.parse(raw);
      if (!s || !validServed(s.served)) return false;
      if (!Array.isArray(s.answers) || s.answers.length !== s.served.length) return false;
      st.served = s.served;
      var cleanAnswers = s.answers.map(function (a) { return (a === 0 || a === 1 || a === 2 || a === 3) ? a : null; });
      st.answers = cleanAnswers;
      st.i = Math.min(Math.max(parseInt(s.i, 10) || 0, 0), st.served.length - 1);
      st.elapsed = Math.max(parseInt(s.elapsed, 10) || 0, 0);
      st.done = s.done === true;
      return cleanAnswers.some(function (a) { return a !== null; });
    } catch (e) { return false; }
  }

  /* ───────────────────────── DOM HELPERS (no user input ever hits innerHTML) ───────────────────────── */
  function el(id) { return document.getElementById(id); }
  function show(id) { el(id).classList.remove('hidden'); }
  function hide(id) { el(id).classList.add('hidden'); }
  function fmt(sec) {
    var m = Math.floor(sec / 60), s2 = sec % 60;
    return (m < 10 ? '0' : '') + m + ':' + (s2 < 10 ? '0' : '') + s2;
  }
  function bandColor(s) { return s < CONFIG.bands.low ? '#ef4444' : s < CONFIG.bands.mid ? '#f59e0b' : '#10b981'; }

  /* ───────────────────────── TIMER ───────────────────────── */
  function startTimer() {
    stopTimer();
    st.timerId = setInterval(function () {
      if (st.done) return;
      st.elapsed++;
      el('as-timer').textContent = fmt(st.elapsed);
      if (st.elapsed % 5 === 0) save();
    }, 1000);
  }
  function stopTimer() { if (st.timerId) { clearInterval(st.timerId); st.timerId = null; } }

  /* ───────────────────────── QUIZ RENDER ───────────────────────── */
  function renderQuiz() {
    var q = st.served[st.i];
    el('as-pillarlabel').textContent = CONFIG.domains[q.d].name;
    el('as-num').textContent = String(st.i + 1);
    el('as-q').textContent = q.q;
    el('as-back').disabled = st.i === 0;
    el('as-timer').textContent = fmt(st.elapsed);

    var answered = st.answers.filter(function (a) { return a !== null; }).length;
    el('as-pct').textContent = Math.round((answered / N()) * 100) + '%';

    /* rail (one row per domain, tick when all its served questions are answered) */
    var rail = el('as-rail');
    rail.textContent = '';
    var domainDone = CONFIG.domains.map(function (_, di) {
      return st.served.every(function (qq, qi) { return qq.d !== di || st.answers[qi] !== null; });
    });
    CONFIG.domains.forEach(function (p, pi) {
      var row = document.createElement('div');
      var isNow = q.d === pi;
      row.className = 'flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-[13px] font-medium ' +
        (isNow ? 'bg-white/10 text-white font-semibold' : domainDone[pi] ? 'text-gray-300' : 'text-gray-500');
      var ic = document.createElement('span');
      ic.className = 'shrink-0 w-[22px] h-[22px] rounded-full border grid place-items-center text-[10px] font-bold ' +
        (domainDone[pi] ? 'bg-bae-accent border-bae-accent text-white' : isNow ? 'border-bae-accent text-bae-accent' : 'border-gray-600 text-gray-500');
      ic.textContent = domainDone[pi] ? '✓' : String(pi + 1);
      row.appendChild(ic);
      row.appendChild(document.createTextNode(p.name));
      rail.appendChild(row);
    });

    /* options */
    var box = el('as-opts');
    box.textContent = '';
    q.opts.forEach(function (txt, idx) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'w-full flex items-center gap-3.5 text-left rounded-bae-sm border-[1.5px] px-4 py-3 transition-all cursor-pointer ' +
        (st.answers[st.i] === idx
          ? 'border-bae-primary bg-bae-primary-soft shadow-[0_0_0_3px_rgba(99,102,241,.12)]'
          : 'border-bae-border bg-bae-bg hover:border-bae-primary hover:bg-bae-primary-soft');
      b.setAttribute('aria-label', 'Answer ' + (idx + 1) + ': ' + txt);
      var big = document.createElement('span');
      big.className = 'shrink-0 grid place-items-center w-7 h-7 rounded-full border border-bae-border bg-bae-card text-[13px] font-bold text-bae-primary';
      big.textContent = String(idx + 1);
      var sub = document.createElement('span');
      sub.className = 'block text-sm font-medium text-bae-ink leading-snug';
      sub.textContent = txt;
      b.appendChild(big); b.appendChild(sub);
      b.addEventListener('click', function () { answer(idx); });
      box.appendChild(b);
    });
  }

  function answer(idx) {
    if (st.done) return;
    st.answers[st.i] = idx;
    save();
    renderQuiz();
    setTimeout(function () {
      var next = st.answers.indexOf(null);
      if (next === -1) { finish(); return; }
      st.i = next;
      save();
      renderQuiz();
    }, 300);
  }

  /* ───────────────────────── RESULT RENDER ───────────────────────── */
  function finish(skipCalc) {
    st.done = true;
    stopTimer();
    save(); /* keep the session: a reload of the results page must not restart the test */
    var r = computeResult(st.answers, st.served, CONFIG);

    /* result payload for future checkout wiring (Paddle custom data + PDF stamp) */
    if (typeof window !== 'undefined' && window.__baeAiTest) {
      window.__baeAiTest.lastResult = {
        assessment: 'ai-knowledge-test',
        bucket: r.bucket.id,
        score: r.overall,
        level: r.bucket.label,   // stamped on the cover (stamp_level) + re-test baseline (stamp_base_level)
        domainScores: r.domainScores,
        profile: null
      };
    }

    hide('as-quiz');
    /* skipCalc: a RESUMED session goes straight to the result. Everything above still runs, so
       lastResult is always populated — bypassing finish() on resume is how the buy button ends up
       dead after a refresh (caught in test, 2026-07-19). Only the animation is skipped, because on
       a reload a "calculating..." sequence reads as the test restarting. */
    if (skipCalc) { hide('as-calc'); revealResult(r); } else { runCalc(function () { revealResult(r); }); }
  }

  function runCalc(done) {
    var msgs = CONFIG.calc.messages;
    var msgEl = el('as-calcmsg'), bar = el('as-calcbar');
    msgEl.style.opacity = '1';
    msgEl.textContent = msgs[0];
    bar.style.width = '0%';
    show('as-calc');
    el('as-calc').scrollIntoView({ behavior: 'smooth', block: 'start' });
    requestAnimationFrame(function () { bar.style.width = Math.round((1 / msgs.length) * 100) + '%'; });
    var mi = 0;
    var iv = setInterval(function () {
      mi++;
      if (mi >= msgs.length) {
        clearInterval(iv);
        hide('as-calc');
        done();
        return;
      }
      msgEl.style.opacity = '0';
      setTimeout(function () { msgEl.textContent = msgs[mi]; msgEl.style.opacity = '1'; }, 260);
      bar.style.width = Math.round(((mi + 1) / msgs.length) * 100) + '%';
    }, CONFIG.calc.stepMs);
  }

  function revealResult(r) {
    if (window.__baeResume) window.__baeResume.focusResult();
    show('as-result');

    el('res-badge').textContent = 'Your level: ' + r.bucket.label;
    el('res-stamp').textContent = 'Completed in ' + fmt(st.elapsed) + ' · 50 questions · 5 domains';
    renderCta(r);

    var scoreEl = el('res-score'), n = 0;
    var iv = setInterval(function () { n += 2; if (n >= r.overall) { n = r.overall; clearInterval(iv); } scoreEl.textContent = String(n); }, 28);

    renderRadar(r);
    renderDomains(r);
    renderJourney(r);
    renderWins(r);
    el('as-result').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderRadar(r) {
    var svg = el('res-radar');
    svg.textContent = '';
    var NS = 'http://www.w3.org/2000/svg';
    var cx = 200, cy = 150, R = 105, P = CONFIG.domains.length;
    function pt(i, rad) {
      var ang = -Math.PI / 2 + i * 2 * Math.PI / P;
      return [cx + rad * Math.cos(ang), cy + rad * Math.sin(ang)];
    }
    function poly(points, attrs) {
      var p2 = document.createElementNS(NS, 'polygon');
      p2.setAttribute('points', points.map(function (p3) { return p3.join(','); }).join(' '));
      Object.keys(attrs).forEach(function (k) { p2.setAttribute(k, attrs[k]); });
      svg.appendChild(p2);
      return p2;
    }
    [0.25, 0.5, 0.75, 1].forEach(function (f) {
      var pts = [];
      for (var i = 0; i < P; i++) pts.push(pt(i, R * f));
      poly(pts, { fill: 'none', stroke: '#e8e8f0', 'stroke-width': '1' });
    });
    CONFIG.domains.forEach(function (p, i) {
      var line = document.createElementNS(NS, 'line');
      var e = pt(i, R);
      line.setAttribute('x1', cx); line.setAttribute('y1', cy);
      line.setAttribute('x2', e[0]); line.setAttribute('y2', e[1]);
      line.setAttribute('stroke', '#e8e8f0'); line.setAttribute('stroke-width', '1');
      svg.appendChild(line);
      var lp = pt(i, R + 26);
      var t = document.createElementNS(NS, 'text');
      t.setAttribute('x', lp[0]); t.setAttribute('y', lp[1] + 4);
      t.setAttribute('text-anchor', Math.abs(lp[0] - cx) < 12 ? 'middle' : lp[0] > cx ? 'start' : 'end');
      t.setAttribute('font-size', '11');
      t.setAttribute('font-family', 'Inter, sans-serif');
      var weak = r.weakest.indexOf(i) !== -1;
      t.setAttribute('font-weight', weak ? '700' : '600');
      t.setAttribute('fill', weak ? '#dc2626' : '#6b6b80');
      t.textContent = p.short;
      svg.appendChild(t);
    });
    var target = r.domainScores.map(function (s, i) { return pt(i, R * s / 100); });
    var startPts = [];
    for (var i2 = 0; i2 < P; i2++) startPts.push([cx, cy]);
    var dataPoly = poly(startPts, { fill: 'rgba(99,102,241,0.18)', stroke: '#6366f1', 'stroke-width': '2.5', 'stroke-linejoin': 'round' });
    requestAnimationFrame(function () { requestAnimationFrame(function () {
      dataPoly.style.transition = 'all 1s cubic-bezier(.4,0,.2,1)';
      dataPoly.setAttribute('points', target.map(function (p3) { return p3.join(','); }).join(' '));
      target.forEach(function (p3, i3) {
        var c = document.createElementNS(NS, 'circle');
        c.setAttribute('cx', p3[0]); c.setAttribute('cy', p3[1]); c.setAttribute('r', '4');
        c.setAttribute('fill', r.weakest.indexOf(i3) !== -1 ? '#dc2626' : '#6366f1');
        c.setAttribute('stroke', '#fff'); c.setAttribute('stroke-width', '1.5');
        c.style.opacity = '0';
        c.style.transition = 'opacity .4s ease ' + (0.6 + i3 * 0.08) + 's';
        svg.appendChild(c);
        requestAnimationFrame(function () { c.style.opacity = '1'; });
      });
    }); });
  }

  function renderDomains(r) {
    var box = el('res-pillars');
    box.textContent = '';
    CONFIG.domains.forEach(function (p, i) {
      var s = r.domainScores[i];
      var weak = r.weakest.indexOf(i) !== -1;
      var row = document.createElement('div');
      var top = document.createElement('div');
      top.className = 'flex justify-between mb-1.5 text-[13px] font-semibold text-bae-ink';
      var left = document.createElement('span');
      left.textContent = p.name;
      if (weak) {
        var tag = document.createElement('span');
        tag.className = 'inline-block text-[10px] font-semibold px-2 py-0.5 rounded-full ml-2 align-middle';
        tag.style.background = 'rgba(239,68,68,.08)';
        tag.style.color = '#dc2626';
        tag.textContent = 'Focus area';
        left.appendChild(tag);
      }
      var right = document.createElement('span');
      right.className = 'text-bae-muted tabular-nums';
      right.textContent = s + '/100';
      top.appendChild(left); top.appendChild(right);
      var bar = document.createElement('div');
      bar.className = 'h-2 rounded-full overflow-hidden';
      bar.style.background = '#f0f0f6';
      var fill = document.createElement('i');
      fill.className = 'block h-full rounded-full';
      fill.style.width = '0%';
      fill.style.background = bandColor(s);
      fill.style.transition = 'width 1s cubic-bezier(.4,0,.2,1)';
      bar.appendChild(fill);
      row.appendChild(top); row.appendChild(bar);
      box.appendChild(row);
      requestAnimationFrame(function () { requestAnimationFrame(function () { fill.style.width = s + '%'; }); });
    });
  }

  function renderJourney(r) {
    var track = el('res-track');
    track.textContent = '';
    var nB = CONFIG.buckets.length;
    var segW = 100 / nB;
    var activeIdx = CONFIG.buckets.indexOf(r.bucket);
    CONFIG.buckets.forEach(function (b, i) {
      var seg = document.createElement('div');
      seg.className = 'h-[52px] rounded-bae-sm grid place-items-center text-center text-[12px] font-bold leading-tight px-2';
      if (i === activeIdx) { seg.style.background = '#6366f1'; seg.style.boxShadow = '0 6px 18px rgba(99,102,241,.35)'; seg.style.color = '#fff'; }
      else if (i < activeIdx) { seg.style.background = 'rgba(99,102,241,0.08)'; seg.style.color = '#6366f1'; }
      else { seg.style.background = '#f0f0f6'; seg.style.color = '#6b6b80'; }
      var l1 = document.createElement('span');
      l1.textContent = b.label;
      var l2 = document.createElement('span');
      l2.className = 'block font-semibold text-[10px] opacity-80';
      l2.textContent = b.min + '–' + b.max;
      var wrap = document.createElement('span');
      wrap.appendChild(l1); wrap.appendChild(l2);
      seg.appendChild(wrap);
      track.appendChild(seg);
    });
    var you = el('res-you');
    you.textContent = 'YOU ARE HERE · ' + r.overall + '/100';
    var b2 = r.bucket;
    var span = Math.max(b2.max - b2.min, 1);
    var pos = activeIdx * segW + ((r.overall - b2.min) / span) * segW;
    pos = Math.min(Math.max(pos, 4), 96);
    setTimeout(function () { you.style.left = pos + '%'; }, 350);

    var note = el('res-journeynote');
    if (activeIdx < CONFIG.buckets.length - 1) {
      var next = CONFIG.buckets[activeIdx + 1];
      var gap = next.min - r.overall;
      note.textContent = 'You’re ' + gap + ' points from ' + next.label + '. The fastest route up is studying your two weakest domains first: ' +
        CONFIG.domains[r.weakest[0]].name + ' and ' + CONFIG.domains[r.weakest[1]].name + '.';
    } else {
      note.textContent = 'You’re in the top band. The work from here is staying sharp: keeping up as models and rules change, and sharpening judgment on the trickiest cases.';
    }
  }

  function renderWins(r) {
    var box = el('res-wins');
    box.textContent = '';
    r.winIdx.forEach(function (pi, n2) {
      var card = document.createElement('div');
      card.className = 'bg-bae-bg border border-bae-border rounded-bae-sm p-4 text-[13px] text-bae-muted';
      var num = document.createElement('span');
      num.className = 'grid place-items-center w-6 h-6 rounded-full bg-bae-primary text-white text-xs font-bold mb-2';
      num.textContent = String(n2 + 1);
      var ttl = document.createElement('b');
      ttl.className = 'block text-bae-ink text-sm mb-0.5';
      ttl.textContent = CONFIG.domains[pi].name;
      var txt = document.createElement('span');
      txt.textContent = CONFIG.domains[pi].win;
      card.appendChild(num); card.appendChild(ttl); card.appendChild(txt);
      box.appendChild(card);
    });
  }

  function fillCta(tpl, r) {
    return tpl
      .replace('{score}', String(r.overall))
      .replace('{weak1}', CONFIG.domains[r.weakest[0]].name)
      .replace('{weak2}', CONFIG.domains[r.weakest[1]].name);
  }
  function renderCta(r) {
    var c = r.bucket.cta;
    el('res-ctaname').textContent = r.bucket.report;
    el('res-ctahead').textContent = fillCta(c.headline, r);
    el('res-ctabody').textContent = fillCta(c.body, r);
    var ul = el('res-ctapoints');
    ul.textContent = '';
    c.points.forEach(function (p) {
      var li = document.createElement('li');
      li.className = 'flex gap-2 items-start';
      var mark = document.createElement('span');
      mark.className = 'shrink-0 text-bae-primary font-bold';
      mark.textContent = '✓';
      var txt = document.createElement('span');
      txt.textContent = p;
      li.appendChild(mark); li.appendChild(txt);
      ul.appendChild(li);
    });
    renderCoverPreview(r);
  }

  /* Live cover preview: draws the buyer's real score/level/radar onto the actual playbook cover,
     using the SAME marker rectangles (point space 595.3 x 841.9 = the SVG viewBox) the bouncer
     stamps, so the preview is 1:1 with the PDF they download. Cover is identical across levels. */
  var COVER = {
    png: '/kc-covers/cover-aikt.png', W: 595.3, H: 841.9,
    score: [9.575, 79.222, 8.139, 4.062],
    level: [32.103, 79.98, 12.473, 1.924],
    radar: [61.739, 69.73, 24.614, 16.051]
  };
  function renderCoverPreview(r) {
    var img = el('res-coverimg'), svg = el('res-coversvg');
    if (!img || !svg) return;
    img.src = COVER.png;
    img.alt = 'The Best Answer Hub ' + r.bucket.report + ' cover, personalized with your score';
    svg.textContent = '';
    var W = COVER.W, H = COVER.H;
    function px(rect) { return { x: rect[0] / 100 * W, y: rect[1] / 100 * H, w: rect[2] / 100 * W, h: rect[3] / 100 * H }; }
    function svgNode(tag, attrs) { var n = document.createElementNS('http://www.w3.org/2000/svg', tag); for (var k in attrs) { if (Object.prototype.hasOwnProperty.call(attrs, k)) n.setAttribute(k, attrs[k]); } return n; }
    function drawText(rect, str, size, fill, family, weight) {
      var g = px(rect);
      var t = svgNode('text', { x: g.x + 1, y: g.y + g.h / 2, 'font-family': family || 'Inter, system-ui, sans-serif',
        'font-size': size, 'font-weight': weight || '700', fill: fill, 'dominant-baseline': 'central', 'text-anchor': 'start' });
      t.textContent = str; svg.appendChild(t);
    }
    drawText(COVER.score, String(r.overall), 28, '#C6603F', '"Bricolage Grotesque", Georgia, serif', '800');
    drawText(COVER.level, r.bucket.label, 16, '#B0512F', '"Bricolage Grotesque", system-ui, sans-serif', '700');
    var sc = r.domainScores;
    if (!sc || sc.length !== 5) return;
    var rd = px(COVER.radar), sx = rd.w / 320, sy = rd.h / 280, pts = [];
    for (var j = 0; j < 5; j++) {
      var rr = 108 * sc[j] / 100, a = -Math.PI / 2 + j * 2 * Math.PI / 5;
      pts.push((rd.x + (160 + rr * Math.cos(a)) * sx).toFixed(2) + ',' + (rd.y + (150 + rr * Math.sin(a)) * sy).toFixed(2));
    }
    svg.appendChild(svgNode('polygon', { points: pts.join(' '), fill: 'rgba(198,96,63,0.16)', stroke: '#C6603F', 'stroke-width': '2.6', 'stroke-linejoin': 'round' }));
  }

  /* ───────────────────────── FLOW CONTROL ───────────────────────── */
  function startFresh() {
    clearSaved();          /* retake integrity: every attempt gets a fresh served set */
    freshState();
    stopTimer();
    hide('as-intro'); hide('as-result');
    show('as-quiz');
    save();
    renderQuiz();
    startTimer();
    el('as-quiz').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  el('as-start').addEventListener('click', startFresh);
  el('as-retake').addEventListener('click', startFresh);
  el('as-back').addEventListener('click', function () {
    if (st.i > 0 && !st.done) { st.i--; save(); renderQuiz(); }
  });
  document.addEventListener('keydown', function (e) {
    if (st.done || el('as-quiz').classList.contains('hidden')) return;
    if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT')) return;
    var n2 = parseInt(e.key, 10);
    if (n2 >= 1 && n2 <= 4) answer(n2 - 1);
  });

  /* ───────────────────────── PADDLE CHECKOUT (scaffold; no price yet → stays "Coming soon") ───────────────────────── */
  var PADDLE = (typeof window !== 'undefined' && window.__BAE_PADDLE) || { env: 'sandbox', token: '', price: '' };
  var paddleReady = false;
  function paddleLive() { return PADDLE.env === 'production'; }
  function paddleTestFlag() { try { return new URLSearchParams(location.search).has('testbuy'); } catch (e) { return false; } }
  // LIVE ($29, go-live 2026-06-23): public checkout on production; ?testbuy=1 still works on non-prod.
  function checkoutEnabled() { return !!PADDLE.token && /^pri_[a-z0-9]+$/i.test(PADDLE.price) && (paddleLive() || paddleTestFlag()); }
  function initPaddle() {
    if (paddleReady || typeof Paddle === 'undefined' || !PADDLE.token) return;
    try {
      if (PADDLE.env === 'sandbox') Paddle.Environment.set('sandbox');
      Paddle.Initialize({
        token: PADDLE.token,
        eventCallback: function (ev) {
          if (!ev || !ev.name) return;
          if (ev.name === 'checkout.completed') {
            var txn = ev.data && ev.data.transaction_id;
            if (txn && /^txn_[a-z0-9]+$/i.test(txn)) window.location.href = '/kc/report/?txn=' + encodeURIComponent(txn);
          }
        }
      });
      paddleReady = true;
    } catch (e) {}
  }
  function openCheckout() {
    initPaddle();
    if (typeof Paddle === 'undefined' || !paddleReady) return;
    var lr = (window.__baeAiTest && window.__baeAiTest.lastResult) || null;
    if (!lr) return;
    try { Paddle.Checkout.open({ items: [{ priceId: PADDLE.price, quantity: 1 }], customData: lr }); } catch (e) {}
  }
  function setupBuyButton() {
    var btn = el('res-buy'), note = el('res-buynote');
    if (!btn) return;
    if (!checkoutEnabled()) return; /* leave "Coming soon · $29" until a price exists + go-live */
    btn.textContent = 'Buy now · $29' + (paddleLive() ? '' : ' (test)');
    btn.classList.remove('cursor-default', 'opacity-90', 'select-none');
    btn.classList.add('cursor-pointer');
    if (note) note.textContent = paddleLive() ? 'Secure checkout by Paddle · instant download' : 'Sandbox test mode · no real charge';
    btn.addEventListener('click', openCheckout);
    initPaddle();
  }
  setupBuyButton();

  /* Resume after a reload. A FINISHED session goes straight back to the result — no quiz flash and
     no replay of the calculating animation. Length comes from the SERVED set, not a constant: this
     bank is randomized per attempt, so served.length is what defines "all answered" here.
     Decision lives in the shared ResumeState component so every assessment behaves the same. */
  (function () {
    var saved = window.__baeResume.read(CONFIG.storageKey);
    var expected = (saved && Array.isArray(saved.served)) ? saved.served.length : 0;
    var mode = window.__baeResume.mode(saved, expected);
    if (mode === 'intro' || !restore()) return;
    if (mode === 'result') {
      hide('as-intro');
      finish(true);   /* the one code path that also populates lastResult for the buy button */
      return;
    }
    hide('as-intro');
    show('as-quiz');
    var firstUnanswered = st.answers.indexOf(null);
    st.i = st.answers[st.i] === null ? st.i : (firstUnanswered === -1 ? 0 : firstUnanswered);
    renderQuiz(); startTimer();
  })();
})();
  </script>
</BaseLayout>
