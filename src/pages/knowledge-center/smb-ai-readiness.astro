  /* ───────────────────────── SCORING (pure, testable) ───────────────────────── */
  function computeResult(answers, cfg) {
    var pillarRaw = [0, 0, 0, 0, 0];
    for (var i = 0; i < cfg.questions.length; i++) {
      pillarRaw[cfg.questions[i].p] += cfg.weights[answers[i]];
    }
    var pillarScores = pillarRaw.map(function (raw) { return Math.round((raw / cfg.pillarMax) * 100); });
    var totalRaw = pillarRaw.reduce(function (a, b) { return a + b; }, 0);
    var overall = Math.round(((totalRaw / cfg.totalMax) * 100) / cfg.snapStep) * cfg.snapStep;
    var bucket = cfg.buckets[cfg.buckets.length - 1];
    for (var b = 0; b < cfg.buckets.length; b++) {
      if (overall <= cfg.buckets[b].max) { bucket = cfg.buckets[b]; break; }
    }
    var order = pillarScores.map(function (s, idx) { return { idx: idx, s: s }; })
      .sort(function (a, b2) { return a.s - b2.s || a.idx - b2.idx; });
    return {
      pillarScores: pillarScores,
      overall: overall,
      bucket: bucket,
      weakest: [order[0].idx, order[1].idx],
      winIdx: [order[0].idx, order[1].idx, order[2].idx]
    };
  }
  /* profile values are only ever accepted from the known config lists */
  function sanitizeProfile(p, cfg) {
    var src = (p && typeof p === 'object') ? p : {};
    function pick(v, list) { return list.indexOf(v) !== -1 ? v : null; }
    return {
      industry: pick(src.industry, cfg.profile.industries),
      employees: pick(src.employees, cfg.profile.employees),
      age: pick(src.age, cfg.profile.ages)
    };
  }
  /* expose for node-testing */
  if (typeof window !== 'undefined') { window.__baeSmbAi = { computeResult: computeResult, sanitizeProfile: sanitizeProfile, fillCta: fillCta, CONFIG: CONFIG }; }

  /* ───────────────────────── STATE & PERSISTENCE ───────────────────────── */
  var N = CONFIG.questions.length;
  var st = { i: 0, answers: [], elapsed: 0, done: false, timerId: null, profile: null };

  function freshState() { st.i = 0; st.answers = new Array(N).fill(null); st.elapsed = 0; st.done = false; st.profile = sanitizeProfile(null, CONFIG); }
  function save() {
    try { sessionStorage.setItem(CONFIG.storageKey, JSON.stringify({ i: st.i, answers: st.answers, elapsed: st.elapsed, profile: st.profile, done: !!st.done })); } catch (e) {}
  }
  function clearSaved() { try { sessionStorage.removeItem(CONFIG.storageKey); } catch (e) {} }
  function restore() {
    try {
      var raw = sessionStorage.getItem(CONFIG.storageKey);
      if (!raw) return false;
      var s = JSON.parse(raw);
      if (!s || !Array.isArray(s.answers) || s.answers.length !== N) return false;
      var cleanAnswers = s.answers.map(function (a) { return (a === 0 || a === 1 || a === 2 || a === 3) ? a : null; });
      st.answers = cleanAnswers;
      st.i = Math.min(Math.max(parseInt(s.i, 10) || 0, 0), N - 1);
      st.elapsed = Math.max(parseInt(s.elapsed, 10) || 0, 0);
      st.profile = sanitizeProfile(s.profile, CONFIG);
      st.done = s.done === true;
      return cleanAnswers.some(function (a) { return a !== null; });
    } catch (e) { return false; }
  }

  /* ───────────────────────── DOM HELPERS (no user input ever hits innerHTML) ───────────────────────── */
  function el(id) { return document.getElementById(id); }
  function show(id) { el(id).classList.remove('hidden'); }
  function hide(id) { el(id).classList.add('hidden'); }
  function fmt(sec) {
    var m = Math.floor(sec / 60), s2 = sec % 60;
    return (m < 10 ? '0' : '') + m + ':' + (s2 < 10 ? '0' : '') + s2;
  }
  function bandColor(s) { return s < CONFIG.bands.low ? '#ef4444' : s < CONFIG.bands.mid ? '#f59e0b' : '#10b981'; }
  function bandLabel(s) { return s < CONFIG.bands.low ? 'Needs attention' : s < CONFIG.bands.mid ? 'Developing' : 'Strong'; }

  /* ───────────────────────── TIMER ───────────────────────── */
  function startTimer() {
    stopTimer();
