    r.sliders.forEach(function(s){
      var wrap=document.createElement('div');
      var lab=document.createElement('div'); lab.className='flex justify-between text-[12px] font-semibold text-bae-muted mb-1.5';
      var l=document.createElement('span'); l.textContent=s.left; var rt=document.createElement('span'); rt.textContent=s.right; lab.appendChild(l); lab.appendChild(rt);
      var track=document.createElement('div'); track.className='relative h-2 rounded-full'; track.style.background='linear-gradient(90deg,#eef0fe,#c7d2fe)';
      var dot=document.createElement('div'); dot.className='absolute top-1/2 w-4 h-4 rounded-full bg-bae-primary border-2 border-white shadow'; dot.style.transform='translate(-50%,-50%)'; dot.style.left='50%'; dot.style.transition='left 1s cubic-bezier(.4,0,.2,1)';
      track.appendChild(dot); wrap.appendChild(lab); wrap.appendChild(track); box.appendChild(wrap);
      requestAnimationFrame(function(){ requestAnimationFrame(function(){ dot.style.left=Math.min(Math.max(s.pos,4),96)+'%'; }); });
