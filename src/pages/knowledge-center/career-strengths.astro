      var rem=document.createElement('span'); rem.className='text-[10px] font-semibold px-2 py-0.5 rounded-full'; rem.style.background='rgba(107,107,128,.10)'; rem.style.color='#6b6b80'; rem.textContent='Remote: '+role.remote;
      var ai=CONFIG.aiTag[role.ai]; var ait=document.createElement('span'); ait.className='text-[10px] font-semibold px-2 py-0.5 rounded-full'; ait.style.background=ai.bg; ait.style.color=ai.c; ait.textContent=ai.t;
      tags.appendChild(rem); tags.appendChild(ait);
      var why=document.createElement('p'); why.className='text-[12px] text-bae-muted mt-auto'; why.textContent='Fits your '+strengthName(r.strengthsRanked[0].id)+' and '+strengthName(r.strengthsRanked[1].id)+'.';
      card.appendChild(nm); card.appendChild(tags); card.appendChild(why); box.appendChild(card);
    });
  }
  function strengthName(id){ var x=CONFIG.strengths.filter(function(z){return z.id===id;})[0]; return x?x.name:id; }

  /* ───────────────────────── FLOW ───────────────────────── */
  function renderSituations(){
    var box=el('sit-opts'); box.textContent='';
    CONFIG.situations.forEach(function(s){
      var b=document.createElement('button'); b.type='button';
      var baseCls='text-left rounded-bae-sm border-[1.5px] border-bae-border bg-bae-bg px-4 py-3 text-sm font-medium text-bae-ink hover:border-bae-primary hover:bg-bae-primary-soft transition-all';
      var selCls='text-left rounded-bae-sm border-[1.5px] border-bae-primary bg-bae-primary-soft px-4 py-3 text-sm font-semibold text-bae-ink transition-all';
      b.className=baseCls; b.textContent=s.label;
      b.addEventListener('click',function(){ st.situation=s.id; Array.prototype.forEach.call(box.children,function(c){ c.className=baseCls; }); b.className=selCls; });
      box.appendChild(b);
