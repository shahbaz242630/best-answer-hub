  /* ───────────────────────── SCORING (pure, testable; reads only cfg.scoring) ───────────────────────── */
  function computeResult(answers, cfg){
    var sc = cfg.scoring;
    var likert={}, fcWon={}, iRaw={}, iCnt={}, wSum={}, wCnt={};
    cfg.strengths.forEach(function(x){ likert[x.id]=0; fcWon[x.id]=false; });
    cfg.interests.forEach(function(x){ iRaw[x.id]=0; iCnt[x.id]=0; });
    cfg.workstyle.forEach(function(x){ wSum[x.id]=0; wCnt[x.id]=0; });
    var attentionSeen=false, attentionPass=true;
    cfg.questions.forEach(function(q,idx){
      var a = answers[idx]; if(a===null||a===undefined) return;
      if(q.type==='attention'){ attentionSeen=true; attentionPass=(a===sc.attentionExpected); return; }   // excluded from every score
      if(q.type==='fc'){ var win=q.dim[a]; if(win) fcWon[win]=true; return; }
      if(q.layer==='strength'){ likert[q.dim]+= a; }
      else if(q.layer==='interest'){ iRaw[q.dim]+= a; iCnt[q.dim]++; }
      else if(q.layer==='workstyle'){ wSum[q.dim]+= (a/3)*100; wCnt[q.dim]++; }
    });
    var maxRaw = 6 + sc.fcWeight;   // 2 Likert items (max 3 each) + one forced-choice bonus
    function norm(raw,cnt){ return cnt? Math.round((raw/(cnt*3))*100) : 0; }
    var strengths = cfg.strengths.map(function(x){
      var raw = likert[x.id] + (fcWon[x.id]?sc.fcWeight:0);
      return { id:x.id, name:x.name, short:x.short, blurb:x.blurb, score:Math.round(raw/maxRaw*100), raw:raw, likert:likert[x.id], fcWon:fcWon[x.id] };
    });
    var interests = cfg.interests.map(function(x){ return { id:x.id, name:x.name, score:norm(iRaw[x.id],iCnt[x.id]) }; });
    var sliders   = cfg.workstyle.map(function(x){ return { id:x.id, left:x.left, right:x.right, pos: wCnt[x.id]? Math.round(wSum[x.id]/wCnt[x.id]) : 50 }; });
    var order = sc.fixedThemeOrder;
    function ord(id){ return order.indexOf(id); }
    /* Ranking + deterministic tie-break chain: score -> forcedChoiceWins -> higherLikertSum -> fixedThemeOrder */
    var sRank = strengths.slice().sort(function(a,b){
      if(b.score!==a.score) return b.score-a.score;
      if(a.fcWon!==b.fcWon)  return a.fcWon? -1 : 1;
      if(b.likert!==a.likert) return b.likert-a.likert;
      return ord(a.id)-ord(b.id);
    });
    var iRank = interests.slice().sort(function(a,b){
      return b.score-a.score || cfg.interests.findIndex(function(z){return z.id===a.id;}) - cfg.interests.findIndex(function(z){return z.id===b.id;});
    });
    var topS = sRank.slice(0,3).map(function(x){return x.id;});
    var topI = iRank.slice(0,3).map(function(x){return x.id;});
    /* Flat-profile + composite-archetype are DISPLAY states only; never change bucket or scores. */
    var gap13 = (sRank[0].score - sRank[2].score)/100;
    var gap12 = (sRank[0].score - sRank[1].score)/100;
    var blended   = gap13 < sc.flatThreshold;
    var composite = !blended && gap12 < sc.archetypeMargin;
    var confidence = (blended || (attentionSeen && !attentionPass)) ? 'soft' : 'clear';
    var arch = cfg.archetypes[sRank[0].id] || { name:'The All-Rounder', desc:'A balanced mix across the board.' };
    /* Roles ranked with a stable secondary key so identical inputs always order identically. */
    var rolesRanked = cfg.roles.map(function(role){
      var s=0, aff=cfg.scoring.roleAffinity;
      role.s.forEach(function(id,pos){
        if(topS.indexOf(id)!==-1){
          var rankW = (id===sRank[0].id?3:id===sRank[1].id?2:1.5);
          s += rankW * (pos===0 ? aff.primary : aff.secondary);
        }
      });
      role.i.forEach(function(id){ if(topI.indexOf(id)!==-1) s+= 1.2; });
      return { role:role, score:s };
    }).sort(function(a,b){
      return b.score-a.score || cfg.roles.findIndex(function(z){return z.name===a.role.name;}) - cfg.roles.findIndex(function(z){return z.name===b.role.name;});
    });
    return {
      strengths:strengths, strengthsRanked:sRank, interests:interests, interestsRanked:iRank,
      sliders:sliders, topStrengths:topS, topInterests:topI, archetypeId:sRank[0].id, archetype:arch,
      roles:rolesRanked.slice(0,3), rolesRanked:rolesRanked, growthEdge:sRank[sRank.length-1],
      blended:blended, composite:composite, runnerUpId:sRank[1].id, confidence:confidence, attentionPass:attentionPass
    };
  }
  /* The Paddle custom_data contract (must match the bouncer/stamper exactly). Shape:
     0-100 theme/interest scores + 0-100 slider positions; bucket = top theme slug (PDF routing);
     themeOrder/interestOrder = the AUTHORITATIVE rankings this page already computed (full tie-break
     chain: score -> fcWon -> likert -> fixedThemeOrder). The paid PDF derives every ranked field
     (r1-8, low1/2, runner-up, role matches) from these so it matches this screen exactly; the raw
     scores alone can't reproduce the tie-breaks (only 9 possible score values across 8 themes → ties
     are common). Purely additive: an older/absent order lets the server fall back to score-desc order.
     Blended/composite/confidence stay display-only and are deliberately NOT sent. */
  function buildLastResult(r, cfg){
    var ts={}; r.strengths.forEach(function(x){ ts[x.id]=x.score; });
    var ws={}; r.sliders.forEach(function(s){ ws[cfg.workstyleKey[s.id]]=s.pos; });
    var is={}; r.interests.forEach(function(x){ is[x.id]=x.score; });
    var themeOrder    = r.strengthsRanked.map(function(x){ return x.id; }); // 8 theme slugs, best-first
    var interestOrder = r.interestsRanked.map(function(x){ return x.id; }); // 6 interest keys, best-first
    return { assessment:'career-strengths', bucket:r.archetypeId, themeScores:ts, workStyle:ws, interests:is, themeOrder:themeOrder, interestOrder:interestOrder };
  }
  if(typeof window!=='undefined'){ window.__baeCareer={ computeResult:computeResult, buildLastResult:buildLastResult, CONFIG:CONFIG }; }

  /* ───────────────────────── STATE & PERSISTENCE ───────────────────────── */
  var N = CONFIG.questions.length;
  var st = { i:0, answers:[], elapsed:0, done:false, timerId:null, situation:null };
  function freshState(){ st.i=0; st.answers=new Array(N).fill(null); st.elapsed=0; st.done=false; st.situation=null; }
  function save(){ try{ sessionStorage.setItem(CONFIG.storageKey, JSON.stringify({ i:st.i, answers:st.answers, elapsed:st.elapsed, situation:st.situation, done:!!st.done })); }catch(e){} }
  function clearSaved(){ try{ sessionStorage.removeItem(CONFIG.storageKey); }catch(e){} }
  function restore(){
    try{
      var raw=sessionStorage.getItem(CONFIG.storageKey); if(!raw) return false;
      var s=JSON.parse(raw); if(!s||!Array.isArray(s.answers)||s.answers.length!==N) return false;
      st.answers = s.answers.map(function(a){ return (a===0||a===1||a===2||a===3)?a:null; });
      st.i = Math.min(Math.max(parseInt(s.i,10)||0,0), N-1);
      st.elapsed = Math.max(parseInt(s.elapsed,10)||0,0);
      st.situation = s.situation || null;
      st.done = s.done===true;
      return st.answers.some(function(a){ return a!==null; });
    }catch(e){ return false; }
  }

  /* ───────────────────────── HELPERS ───────────────────────── */
  function el(id){ return document.getElementById(id); }
  function show(id){ el(id).classList.remove('hidden'); }
  function hide(id){ el(id).classList.add('hidden'); }
  function fmt(s){ var m=Math.floor(s/60), x=s%60; return (m<10?'0':'')+m+':'+(x<10?'0':'')+x; }
  function scaleFor(q){
    if(q.type==='fc') return q.opts;                 // 2 matched options
    if(q.layer==='interest') return CONFIG.scaleInterest;
    if(q.layer==='workstyle') return q.opts;
    return CONFIG.scaleStrength;                      // strength Likert + attention check
  }

  function startTimer(){ stopTimer(); st.timerId=setInterval(function(){ if(st.done)return; st.elapsed++; el('as-timer').textContent=fmt(st.elapsed); if(st.elapsed%5===0) save(); },1000); }
  function stopTimer(){ if(st.timerId){ clearInterval(st.timerId); st.timerId=null; } }

  /* ───────────────────────── QUIZ RENDER ───────────────────────── */
  function renderQuiz(){
    var q=CONFIG.questions[st.i];
    var sec=SECTIONS.filter(function(s){return s.id===q.layer;})[0];
    el('as-seclabel').textContent=sec.label;
    el('as-num').textContent=String(st.i+1);
    el('as-total').textContent=String(N);
    el('as-q').textContent=q.text;
    el('as-help').textContent = q.type==='fc' ? 'Neither is better — pick the one that fits you.' : q.type==='attention' ? '' : q.layer==='strength'?'How true is this of you?' : q.layer==='interest'?'How much does this pull you?' : '';
    el('as-help').style.display = el('as-help').textContent ? 'block':'none';
    el('as-back').disabled = st.i===0;
    el('as-timer').textContent=fmt(st.elapsed);
    var answered=st.answers.filter(function(a){return a!==null;}).length;
    el('as-pct').textContent=Math.round((answered/N)*100)+'%';

    var rail=el('as-rail'); rail.textContent='';
    SECTIONS.forEach(function(s,si){
      var qs=CONFIG.questions.map(function(qq,qi){return {qq:qq,qi:qi};}).filter(function(o){return o.qq.layer===s.id;});
      var doneCount=qs.filter(function(o){return st.answers[o.qi]!==null;}).length;
      var isNow=s.id===sec.id, complete=doneCount===qs.length;
      var row=document.createElement('div');
      row.className='flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-[13px] font-medium '+(isNow?'bg-white/10 text-white font-semibold':complete?'text-gray-300':'text-gray-500');
      var ic=document.createElement('span');
      ic.className='shrink-0 w-[22px] h-[22px] rounded-full border grid place-items-center text-[10px] font-bold '+(complete?'bg-bae-accent border-bae-accent text-white':isNow?'border-bae-accent text-bae-accent':'border-gray-600 text-gray-500');
      ic.textContent=complete?'✓':String(si+1);
      var lab=document.createElement('span'); lab.textContent=s.label;
      var cnt=document.createElement('span'); cnt.className='ml-auto text-[11px] '+(isNow?'text-gray-300':'text-gray-500'); cnt.textContent=doneCount+'/'+qs.length;
      row.appendChild(ic); row.appendChild(lab); row.appendChild(cnt); rail.appendChild(row);
    });

    var box=el('as-opts'); box.textContent='';
    scaleFor(q).forEach(function(txt,idx){
      var b=document.createElement('button'); b.type='button';
      b.className='w-full flex items-center gap-3.5 text-left rounded-bae-sm border-[1.5px] px-4 py-3 transition-all cursor-pointer '+
        (st.answers[st.i]===idx?'border-bae-primary bg-bae-primary-soft shadow-[0_0_0_3px_rgba(99,102,241,.12)]':'border-bae-border bg-bae-bg hover:border-bae-primary hover:bg-bae-primary-soft');
      var big=document.createElement('span'); big.className='shrink-0 grid place-items-center w-7 h-7 rounded-full border border-bae-border bg-bae-card text-[13px] font-bold text-bae-primary'; big.textContent=String(idx+1);
      var sub=document.createElement('span'); sub.className='block text-sm font-medium text-bae-ink leading-snug'; sub.textContent=txt;
      b.appendChild(big); b.appendChild(sub);
      b.addEventListener('click',function(){ answer(idx); });
      box.appendChild(b);
    });
  }

  function answer(idx){
    if(st.done)return;
    st.answers[st.i]=idx; save(); renderQuiz();
    setTimeout(function(){ var next=st.answers.indexOf(null); if(next===-1){ finish(); return; } st.i=next; save(); renderQuiz(); },240);
  }

  /* ───────────────────────── RESULT ───────────────────────── */
  function finish(skipCalc){
    /* Persist (do NOT clear): a reload of the results page, or the return trip from Paddle, must
       land back on the result rather than the intro. Cleared only by an explicit retake. */
    st.done=true; stopTimer(); save();
    var r=computeResult(st.answers,CONFIG);
    if(typeof window!=='undefined' && window.__baeCareer){ window.__baeCareer.lastResult=buildLastResult(r,CONFIG); }
    hide('as-quiz');
    /* skipCalc: a RESUMED session goes straight to the result. Everything above still runs, so
       lastResult is always populated — bypassing finish() on resume is how the buy button ends up
       dead after a refresh (caught in test, 2026-07-19). Only the animation is skipped, because on
       a reload a "calculating..." sequence reads as the test restarting. */
    if(skipCalc){ hide('as-calc'); revealResult(r); } else { runCalc(function(){ revealResult(r); }); }
  }
  function runCalc(done){
    var msgs=CONFIG.calc.messages, msgEl=el('as-calcmsg'), bar=el('as-calcbar');
    msgEl.style.opacity='1'; msgEl.textContent=msgs[0]; bar.style.width='0%';
    show('as-calc'); el('as-calc').scrollIntoView({behavior:'smooth',block:'start'});
    requestAnimationFrame(function(){ bar.style.width=Math.round((1/msgs.length)*100)+'%'; });
    var mi=0;
    var iv=setInterval(function(){
      mi++;
      if(mi>=msgs.length){ clearInterval(iv); hide('as-calc'); done(); return; }
      msgEl.style.opacity='0';
      setTimeout(function(){ msgEl.textContent=msgs[mi]; msgEl.style.opacity='1'; },240);
      bar.style.width=Math.round(((mi+1)/msgs.length)*100)+'%';
    },CONFIG.calc.stepMs);
  }
  function revealResult(r){
    if (window.__baeResume) window.__baeResume.focusResult();
    show('as-result');
    var scored=CONFIG.questions.filter(function(q){return q.type!=='attention';}).length;
    el('res-stamp').textContent='Completed in '+fmt(st.elapsed)+' · '+scored+' questions · your full result, free';
    el('res-arch').textContent=r.archetype.name;
    el('res-archdesc').textContent=r.archetype.desc;
    el('res-ctaname').textContent='the '+r.archetype.name.replace(/^The /,'')+' playbook';
    if(st.situation){ var s=CONFIG.situations.filter(function(x){return x.id===st.situation;})[0]; el('res-situation').textContent=s?s.note:''; } else { el('res-situation').textContent=''; }
    var note='';
    if(r.blended){ note='Your top themes sit close together, so this reads as a balanced blend rather than one clear type. This result leads with '+r.archetype.name+', but treat your top three as a set.'; }
    else if(r.composite){ note='You lead as '+r.archetype.name+', with a strong '+strengthName(r.runnerUpId)+' streak.'; }
    if(r.confidence==='soft' && !r.attentionPass){ note += (note?' ':'') + 'A couple of answers looked rushed, so a retake would give a sharper read.'; }
    var noteEl=el('res-note'); if(noteEl){ noteEl.textContent=note; noteEl.style.display=note?'block':'none'; }
    renderRadar(r); renderStrengths(r); renderSliders(r); renderInterests(r); renderRoles(r);
    renderCoverPreview(r);
    setupBuyButton();
    el('as-result').scrollIntoView({behavior:'smooth',block:'start'});
  }

  function renderRadar(r){
    var svg=el('res-radar'); svg.textContent=''; var NS='http://www.w3.org/2000/svg';
    var cx=200, cy=160, R=110, P=CONFIG.strengths.length;
    function pt(i,rad){ var a=-Math.PI/2+i*2*Math.PI/P; return [cx+rad*Math.cos(a), cy+rad*Math.sin(a)]; }
    function poly(points,attrs){ var p=document.createElementNS(NS,'polygon'); p.setAttribute('points',points.map(function(q){return q.join(',');}).join(' ')); for(var k in attrs) p.setAttribute(k,attrs[k]); svg.appendChild(p); return p; }
    [0.25,0.5,0.75,1].forEach(function(f){ var pts=[]; for(var i=0;i<P;i++)pts.push(pt(i,R*f)); poly(pts,{fill:'none',stroke:'#e8e8f0','stroke-width':'1'}); });
    var scoreById={}; r.strengths.forEach(function(x){scoreById[x.id]=x.score;});
    CONFIG.strengths.forEach(function(p,i){
      var e=pt(i,R); var ln=document.createElementNS(NS,'line');
      ln.setAttribute('x1',cx);ln.setAttribute('y1',cy);ln.setAttribute('x2',e[0]);ln.setAttribute('y2',e[1]);ln.setAttribute('stroke','#e8e8f0');ln.setAttribute('stroke-width','1'); svg.appendChild(ln);
      var lp=pt(i,R+22); var t=document.createElementNS(NS,'text');
      t.setAttribute('x',lp[0]); t.setAttribute('y',lp[1]+4);
      t.setAttribute('text-anchor', Math.abs(lp[0]-cx)<14?'middle':lp[0]>cx?'start':'end');
      t.setAttribute('font-size','10.5'); t.setAttribute('font-family','Inter, system-ui, sans-serif');
      var top=r.topStrengths.indexOf(p.id)!==-1;
      t.setAttribute('font-weight',top?'700':'500'); t.setAttribute('fill',top?'#6366f1':'#8b8b9e');
      t.textContent=p.short; svg.appendChild(t);
    });
    var target=CONFIG.strengths.map(function(p,i){ return pt(i,R*(scoreById[p.id]||0)/100); });
    var start=[]; for(var s=0;s<P;s++)start.push([cx,cy]);
    var dp=poly(start,{fill:'rgba(99,102,241,0.18)',stroke:'#6366f1','stroke-width':'2.5','stroke-linejoin':'round'});
    requestAnimationFrame(function(){ requestAnimationFrame(function(){
      dp.style.transition='all 1s cubic-bezier(.4,0,.2,1)';
      dp.setAttribute('points',target.map(function(q){return q.join(',');}).join(' '));
      target.forEach(function(q,i){
        var c=document.createElementNS(NS,'circle'); c.setAttribute('cx',q[0]);c.setAttribute('cy',q[1]);c.setAttribute('r','3.5');
        c.setAttribute('fill', r.topStrengths.indexOf(CONFIG.strengths[i].id)!==-1?'#6366f1':'#c7d2fe'); c.setAttribute('stroke','#fff');c.setAttribute('stroke-width','1.5');
        c.style.opacity='0'; c.style.transition='opacity .4s ease '+(0.6+i*0.05)+'s'; svg.appendChild(c);
        requestAnimationFrame(function(){ c.style.opacity='1'; });
      });
    }); });
  }
  function renderStrengths(r){
    var box=el('res-strengths'); box.textContent='';
    r.strengthsRanked.forEach(function(x,rank){
      var top=rank<3, row=document.createElement('div');
      var head=document.createElement('div'); head.className='flex justify-between items-baseline mb-1';
      var left=document.createElement('span'); left.className='text-[13px] font-semibold '+(top?'text-bae-ink':'text-bae-muted'); left.textContent=(rank+1)+'. '+x.name;
      if(rank===0){ var tag=document.createElement('span'); tag.className='ml-2 text-[10px] font-bold px-2 py-0.5 rounded-full align-middle'; tag.style.background='rgba(99,102,241,.10)'; tag.style.color='#6366f1'; tag.textContent='SIGNATURE'; left.appendChild(tag); }
      var val=document.createElement('span'); val.className='text-[12px] text-bae-muted tabular-nums'; val.textContent=x.score;
      head.appendChild(left); head.appendChild(val);
      var bar=document.createElement('div'); bar.className='h-2 rounded-full overflow-hidden'; bar.style.background='#f0f0f6';
      var fill=document.createElement('i'); fill.className='block h-full rounded-full'; fill.style.width='0%'; fill.style.background=top?'#6366f1':'#c7d2fe'; fill.style.transition='width .9s cubic-bezier(.4,0,.2,1)';
      bar.appendChild(fill); row.appendChild(head); row.appendChild(bar); box.appendChild(row);
      requestAnimationFrame(function(){ requestAnimationFrame(function(){ fill.style.width=Math.max(x.score,3)+'%'; }); });
    });
    var ge=document.createElement('p'); ge.className='text-[12px] text-bae-muted mt-1.5';
    var b=document.createElement('span'); b.textContent='Your growth edge is '; ge.appendChild(b);
    var strong=document.createElement('b'); strong.className='text-bae-ink'; strong.textContent=r.growthEdge.name+'. '; ge.appendChild(strong);
    var rest=document.createElement('span'); rest.textContent='The paid report shows how to work around a low theme, and the shadow side of your top ones.'; ge.appendChild(rest);
    box.appendChild(ge);
  }
  function renderSliders(r){
