      var fill=document.createElement('i'); fill.className='block h-full rounded-full'; fill.style.width='0%'; fill.style.background= rank<2?'#10b981':'#a7f3d0'; fill.style.transition='width .9s cubic-bezier(.4,0,.2,1)';
      bar.appendChild(fill); row.appendChild(head); row.appendChild(bar); box.appendChild(row);
