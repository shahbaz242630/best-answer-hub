  function startFresh(){ clearSaved(); freshState(); stopTimer(); hide('as-intro'); hide('as-result'); hide('as-quiz'); renderSituations(); show('as-situation'); el('as-situation').scrollIntoView({behavior:'smooth',block:'start'}); }
  function beginQuiz(){ hide('as-situation'); show('as-quiz'); save(); renderQuiz(); startTimer(); el('as-quiz').scrollIntoView({behavior:'smooth',block:'start'}); }
  el('as-start').addEventListener('click',startFresh);
  el('as-retake').addEventListener('click',startFresh);
  el('as-begin').addEventListener('click',beginQuiz);
  el('as-skip').addEventListener('click',function(){ st.situation=null; beginQuiz(); });
  el('as-back').addEventListener('click',function(){ if(st.i>0&&!st.done){ st.i--; save(); renderQuiz(); } });
  document.addEventListener('keydown',function(e){
    if(st.done||el('as-quiz').classList.contains('hidden'))return;
    if(e.target && (e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA'||e.target.tagName==='SELECT'))return;
    var optCount=scaleFor(CONFIG.questions[st.i]).length;
    var n=parseInt(e.key,10); if(n>=1&&n<=optCount) answer(n-1);
  });

  /* ───────────────────────── LIVE COVER PREVIEW ─────────────────────────
     The buyer's OWN edition cover (a PNG rendered from the real cs-<bucket>-template.pdf) with
     their real 8-spoke radar drawn over it, so the preview is 1:1 with the PDF they download.
     Every number below is the SAME one the stamper uses:
       stamp_radar rect = x 82.80, yTop 485.10, w 173.40, h 172.80 (A4 points, extracted from the
                          built template; identical across editions)
       radar geometry   = report/specs/career-strengths.json (vb 320x300, centre 160,150, r 108)
     ⚠ ORIENTATION: stamp-core's drawRadar normalizes the widget rect to a top-left origin with y
     running DOWN, which is exactly this SVG viewBox's convention — so do NOT flip y here. A sign
     error at this step is precisely what drew every buyer's radar mirrored on SMB/AIKT for a month. */
  var COVER={
    dir:'/kc-covers/cover-cs-', W:595.28, H:841.89,
    radar:{ x:82.80, yTop:485.10, w:173.40, h:172.80 },
    vb:320, vbh:300, cx:160, cy:150, r:108,
    gold:'#E9C36A', fillOpacity:0.2, strokeWidth:2.6, dotR:4
  };
  function renderCoverPreview(rr){
    var wrap=el('res-cover'), img=el('res-coverimg'), svg=el('res-coversvg');
    if(!wrap||!img||!svg) return;
    var col=wrap.parentNode, bucket=rr.archetypeId, isBuilt=false;
    for(var b=0;b<BUILT_BUCKETS.length;b++){ if(BUILT_BUCKETS[b]===bucket) isBuilt=true; }
    /* No cover art exists for an edition that hasn't been built — hide the image rather than show a
       broken one. The card is a single column in the rail now, so there is no grid to reflow. */
    if(!isBuilt){ if(col) col.style.display='none'; return; }
    if(col) col.style.display='';
    img.src=COVER.dir+bucket+'.png';
    img.alt='The Best Answer Hub '+rr.archetype.name+' report cover, personalized with your strengths radar';
    svg.textContent='';
    var NS='http://www.w3.org/2000/svg', n=CONFIG.strengths.length;
    var sx=COVER.radar.w/COVER.vb, sy=COVER.radar.h/COVER.vbh;
    var scoreById={}; rr.strengths.forEach(function(x){ scoreById[x.id]=x.score; });
    var pts=[];
    for(var i=0;i<n;i++){
      var sc=scoreById[CONFIG.strengths[i].id]||0;
      var rad=COVER.r*sc/100, a=-Math.PI/2+i*2*Math.PI/n;
      pts.push([ COVER.radar.x+(COVER.cx+rad*Math.cos(a))*sx,
                 COVER.radar.yTop+(COVER.cy+rad*Math.sin(a))*sy ]);
    }
    var poly=document.createElementNS(NS,'polygon');
    poly.setAttribute('points',pts.map(function(q){ return q[0].toFixed(2)+','+q[1].toFixed(2); }).join(' '));
    poly.setAttribute('fill',COVER.gold); poly.setAttribute('fill-opacity',String(COVER.fillOpacity));
    poly.setAttribute('stroke',COVER.gold); poly.setAttribute('stroke-width',String(COVER.strokeWidth));
    poly.setAttribute('stroke-linejoin','round');
    svg.appendChild(poly);
    for(var k=0;k<pts.length;k++){
      var dot=document.createElementNS(NS,'circle');
      dot.setAttribute('cx',pts[k][0].toFixed(2)); dot.setAttribute('cy',pts[k][1].toFixed(2));
      dot.setAttribute('r',String(Math.max(1,COVER.dotR*sx))); dot.setAttribute('fill',COVER.gold);
      svg.appendChild(dot);
    }
  }

  /* ───────────────────────── PADDLE CHECKOUT (scaffold; price id wired by Claude Code) ───────────────────────── */
  var PADDLE=(typeof window!=='undefined'&&window.__BAE_PADDLE)||{ env:'sandbox', token:'', price:'' };
  var BUILT_BUCKETS=(typeof window!=='undefined'&&window.__BAE_CS_BUILT)||[];
  var paddleReady=false;
  function paddleLive(){ return PADDLE.env==='production'; }
  function paddleTestFlag(){ try{ return new URLSearchParams(location.search).has('testbuy'); }catch(e){ return false; } }
  /* Only sell an edition whose PDF exists to be served. The bouncer's template check runs at
     DOWNLOAD time, i.e. after payment, so an ungated unbuilt bucket takes money then 503s. */
  function bucketBuyable(){
    var lr=(typeof window!=='undefined'&&window.__baeCareer&&window.__baeCareer.lastResult)||null;
    if(!lr||typeof lr.bucket!=='string'||!lr.bucket) return false;
    for(var i=0;i<BUILT_BUCKETS.length;i++){ if(BUILT_BUCKETS[i]===lr.bucket) return true; }
    return false;
  }
  function checkoutEnabled(){ return !!PADDLE.token && /^pri_[a-z0-9]+$/i.test(PADDLE.price) && (paddleLive()||paddleTestFlag()) && bucketBuyable(); }
  function initPaddle(){
    if(paddleReady||typeof Paddle==='undefined'||!PADDLE.token) return;
    try{
      if(PADDLE.env==='sandbox') Paddle.Environment.set('sandbox');
      Paddle.Initialize({ token:PADDLE.token, eventCallback:function(ev){
        if(!ev||!ev.name)return;
        if(ev.name==='checkout.completed'){ var txn=ev.data&&ev.data.transaction_id; if(txn&&/^txn_[a-z0-9]+$/i.test(txn)) window.location.href='/kc/report/?txn='+encodeURIComponent(txn); }
      }});
      paddleReady=true;
    }catch(e){}
  }
  function openCheckout(){
    initPaddle();
    if(typeof Paddle==='undefined'||!paddleReady) return;
    var lr=(window.__baeCareer&&window.__baeCareer.lastResult)||null; if(!lr) return;
    if(!bucketBuyable()) return; /* defense in depth: never open checkout for an unbuilt edition */
    try{ Paddle.Checkout.open({ items:[{ priceId:PADDLE.price, quantity:1 }], customData:lr }); }catch(e){}
  }
  function setupBuyButton(){
    var btn=el('res-buy'), note=el('res-buynote'); if(!btn) return;
    if(!checkoutEnabled()){
      /* Tell a buyer whose edition isn't built yet WHY, rather than a bare "Coming soon". */
      if(note && !bucketBuyable() && PADDLE.token && /^pri_[a-z0-9]+$/i.test(PADDLE.price)){
        note.textContent='The detailed report for your archetype is still in production. Your free result above is complete.';
      }
      return; /* keep "Coming soon · $29" */
    }
    btn.textContent='Buy now · $29'+(paddleLive()?'':' (test)');
    btn.classList.remove('cursor-default','opacity-90','select-none'); btn.classList.add('cursor-pointer');
    if(note) note.textContent=paddleLive()?'Secure checkout by Paddle · instant download':'Sandbox test mode · no real charge';
    btn.addEventListener('click',openCheckout); initPaddle();
  }

  /* Resume after a reload. A FINISHED session goes straight back to the result — no quiz flash and
     no replay of the calculating animation, which on a refresh reads as the test restarting. */
  (function(){
    var mode=window.__baeResume.mode(window.__baeResume.read(CONFIG.storageKey), N);
    if(mode==='intro' || !restore()) return;
    if(mode==='result'){
      hide('as-intro');
      finish(true);   /* the one code path that also populates lastResult for the buy button */
      return;
    }
    hide('as-intro'); show('as-quiz');
    var firstUnanswered=st.answers.indexOf(null);
    st.i = firstUnanswered===-1 ? 0 : firstUnanswered;
    renderQuiz(); startTimer();
  })();
})();
  </script>
</BaseLayout>
