  </section>

  <!-- Related Developer Tools CTA -->
  <section class="py-10 md:py-14 border-t border-bae-border">
    <div class="container max-w-page mx-auto px-6">
      <div class="bg-bae-primary-soft border border-bae-primary/15 rounded-bae p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <h3 class="font-serif text-xl font-bold text-bae-ink mb-1">Explore more developer tools</h3>
          <p class="text-sm text-bae-muted">Also try <a href="/developer-toolbox/diff-checker/" class="text-bae-primary hover:underline">Diff Checker</a>, <a href="/developer-toolbox/cron-expression-generator/" class="text-bae-primary hover:underline">Cron Generator</a>, <a href="/tools/json-formatter/" class="text-bae-primary hover:underline">JSON</a>, <a href="/tools/base64-encoder/" class="text-bae-primary hover:underline">Base64</a>, <a href="/tools/jwt-decoder/" class="text-bae-primary hover:underline">JWT</a>, <a href="/tools/regex-tester/" class="text-bae-primary hover:underline">Regex</a>, <a href="/tools/hash-generator/" class="text-bae-primary hover:underline">Hash</a>, and <a href="/tools/url-encoder/" class="text-bae-primary hover:underline">URL</a>, all free, no signup.</p>
        </div>
        <a href="/developer-toolbox/" class="inline-flex items-center gap-2 bg-bae-ink text-white px-5 py-2.5 rounded-bae-sm font-semibold text-sm no-underline hover:bg-bae-primary transition-colors shrink-0">
          Browse developer toolbox →
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      // --- Utility ---
      function copyText(text) {
        if (!text) return;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).catch(() => {});
        } else {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
      }

      function hexToRgba(hex, alpha) {
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        return 'rgba(' + r + ', ' + g + ', ' + b + ', ' + alpha + ')';
      }

      // --- Tabs ---
      const tabs = document.querySelectorAll('.css-tab');
      const panels = document.querySelectorAll('.css-panel');

      tabs.forEach(tab => {
        tab.addEventListener('click', function() {
          const target = this.dataset.tab;
          tabs.forEach(t => {
            t.classList.remove('bg-bae-primary', 'text-white');
            t.classList.add('bg-bae-bg', 'text-bae-ink', 'border', 'border-bae-border');
            t.setAttribute('aria-selected', 'false');
          });
          this.classList.remove('bg-bae-bg', 'text-bae-ink', 'border', 'border-bae-border');
          this.classList.add('bg-bae-primary', 'text-white');
          this.setAttribute('aria-selected', 'true');

          panels.forEach(p => {
            if (p.dataset.panel === target) p.classList.remove('hidden');
            else p.classList.add('hidden');
          });
        });
      });

      // --- Copy Buttons ---
      document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const targetId = this.dataset.target;
          const el = document.getElementById(targetId);
          if (el) copyText(el.textContent);
        });
      });

      // ===== BOX SHADOW =====
      let shadowLayers = [
        { x: 0, y: 4, blur: 6, spread: -1, color: '#000000', alpha: 0.1, inset: false }
      ];

      function renderShadowControls() {
        const container = document.getElementById('shadow-layers');
        container.innerHTML = '';
        shadowLayers.forEach((layer, i) => {
          const div = document.createElement('div');
          div.className = 'bg-bae-bg border border-bae-border rounded-bae-sm p-3 mb-2';
          div.innerHTML =
            '<div class="flex items-center justify-between mb-2">' +
              '<span class="text-xs font-semibold text-bae-ink">Layer ' + (i + 1) + '</span>' +
              (shadowLayers.length > 1 ? '<button type="button" class="shadow-remove text-[11px] text-red-600 hover:underline" data-idx="' + i + '">Remove</button>' : '') +
            '</div>' +
            '<div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-2">' +
              '<div><label class="text-[10px] text-bae-muted">X</label><input type="number" class="shadow-x w-full bg-bae-card border border-bae-border rounded-bae-sm px-2 py-1 text-xs font-mono" data-idx="' + i + '" value="' + layer.x + '" /></div>' +
              '<div><label class="text-[10px] text-bae-muted">Y</label><input type="number" class="shadow-y w-full bg-bae-card border border-bae-border rounded-bae-sm px-2 py-1 text-xs font-mono" data-idx="' + i + '" value="' + layer.y + '" /></div>' +
              '<div><label class="text-[10px] text-bae-muted">Blur</label><input type="number" class="shadow-blur w-full bg-bae-card border border-bae-border rounded-bae-sm px-2 py-1 text-xs font-mono" data-idx="' + i + '" value="' + layer.blur + '" /></div>' +
              '<div><label class="text-[10px] text-bae-muted">Spread</label><input type="number" class="shadow-spread w-full bg-bae-card border border-bae-border rounded-bae-sm px-2 py-1 text-xs font-mono" data-idx="' + i + '" value="' + layer.spread + '" /></div>' +
            '</div>' +
            '<div class="flex items-center gap-2">' +
              '<input type="color" class="shadow-color w-8 h-8 rounded-bae-sm border border-bae-border cursor-pointer" data-idx="' + i + '" value="' + layer.color + '" />' +
              '<div class="flex-1"><label class="text-[10px] text-bae-muted">Opacity: ' + layer.alpha + '</label><input type="range" class="shadow-alpha w-full" data-idx="' + i + '" min="0" max="1" step="0.01" value="' + layer.alpha + '" /></div>' +
              '<label class="flex items-center gap-1 text-[11px] text-bae-muted cursor-pointer"><input type="checkbox" class="shadow-inset" data-idx="' + i + '" ' + (layer.inset ? 'checked' : '') + ' /> Inset</label>' +
            '</div>';
          container.appendChild(div);
        });

        container.querySelectorAll('.shadow-remove').forEach(btn => {
          btn.addEventListener('click', function() {
            const idx = parseInt(this.dataset.idx);
            shadowLayers.splice(idx, 1);
            renderShadowControls();
            updateShadow();
          });
        });

        ['x','y','blur','spread'].forEach(prop => {
          container.querySelectorAll('.shadow-' + prop).forEach(input => {
            input.addEventListener('input', function() {
              const idx = parseInt(this.dataset.idx);
              shadowLayers[idx][prop] = parseInt(this.value) || 0;
              updateShadow();
            });
          });
        });

        container.querySelectorAll('.shadow-color').forEach(input => {
          input.addEventListener('input', function() {
            const idx = parseInt(this.dataset.idx);
            shadowLayers[idx].color = this.value;
            updateShadow();
          });
        });

        container.querySelectorAll('.shadow-alpha').forEach(input => {
          input.addEventListener('input', function() {
            const idx = parseInt(this.dataset.idx);
            shadowLayers[idx].alpha = parseFloat(this.value);
            this.previousElementSibling.textContent = 'Opacity: ' + this.value;
            updateShadow();
          });
        });

        container.querySelectorAll('.shadow-inset').forEach(input => {
          input.addEventListener('change', function() {
            const idx = parseInt(this.dataset.idx);
            shadowLayers[idx].inset = this.checked;
            updateShadow();
          });
        });
      }

      function updateShadow() {
        const css = shadowLayers.map(l => {
          const rgba = hexToRgba(l.color, l.alpha);
          return (l.inset ? 'inset ' : '') + l.x + 'px ' + l.y + 'px ' + l.blur + 'px ' + l.spread + 'px ' + rgba;
        }).join(', ');

        const box = document.getElementById('shadow-preview-box');
        box.style.boxShadow = css;

        document.getElementById('shadow-css').textContent = 'box-shadow: ' + css + ';';

        const tw = shadowLayers.map(l => {
          // Underscore the rgba() spaces — arbitrary Tailwind values cannot contain raw spaces.
          const rgba = hexToRgba(l.color, l.alpha).replace(/ /g, '_');
          return (l.inset ? 'inset_' : '') + l.x + 'px_' + l.y + 'px_' + l.blur + 'px_' + l.spread + 'px_' + rgba;
        }).join(',');
        document.getElementById('shadow-tw').textContent = 'shadow-[' + tw + ']';
      }

      document.getElementById('shadow-add').addEventListener('click', function() {
        shadowLayers.push({ x: 0, y: 4, blur: 6, spread: -1, color: '#000000', alpha: 0.1, inset: false });
        renderShadowControls();
        updateShadow();
      });

      renderShadowControls();
      updateShadow();

      // ===== GRADIENT =====
      let gradStops = [
        { color: '#6366f1', pos: 0 },
        { color: '#a855f7', pos: 100 }
      ];

      function renderGradControls() {
        const container = document.getElementById('grad-stops');
        container.innerHTML = '';
        gradStops.forEach((stop, i) => {
          const div = document.createElement('div');
          div.className = 'flex items-center gap-2 mb-2';
          div.innerHTML =
            '<input type="color" class="grad-color w-8 h-8 rounded-bae-sm border border-bae-border cursor-pointer" data-idx="' + i + '" value="' + stop.color + '" />' +
            '<div class="flex-1"><label class="text-[10px] text-bae-muted">Position: ' + stop.pos + '%</label><input type="range" class="grad-pos w-full" data-idx="' + i + '" min="0" max="100" value="' + stop.pos + '" /></div>' +
            (gradStops.length > 2 ? '<button type="button" class="grad-remove text-[11px] text-red-600 hover:underline" data-idx="' + i + '">Remove</button>' : '');
          container.appendChild(div);
        });

        container.querySelectorAll('.grad-remove').forEach(btn => {
          btn.addEventListener('click', function() {
            const idx = parseInt(this.dataset.idx);
            gradStops.splice(idx, 1);
            renderGradControls();
            updateGrad();
          });
        });

        container.querySelectorAll('.grad-color').forEach(input => {
          input.addEventListener('input', function() {
            const idx = parseInt(this.dataset.idx);
            gradStops[idx].color = this.value;
            updateGrad();
          });
        });

        container.querySelectorAll('.grad-pos').forEach(input => {
          input.addEventListener('input', function() {
            const idx = parseInt(this.dataset.idx);
            gradStops[idx].pos = parseInt(this.value);
            this.previousElementSibling.textContent = 'Position: ' + this.value + '%';
            updateGrad();
          });
        });
      }

      function updateGrad() {
        const type = document.getElementById('grad-type').value;
        const angle = document.getElementById('grad-angle').value;
        const stops = gradStops.slice().sort((a, b) => a.pos - b.pos);
        const stopsCss = stops.map(s => s.color + ' ' + s.pos + '%').join(', ');

        let css = '';
        if (type === 'linear') {
          css = 'linear-gradient(' + angle + 'deg, ' + stopsCss + ')';
        } else if (type === 'radial') {
          css = 'radial-gradient(' + stopsCss + ')';
        } else {
          css = 'conic-gradient(' + stopsCss + ')';
        }

        document.getElementById('grad-preview').style.background = css;
        document.getElementById('grad-css').textContent = 'background: ' + css + ';';

        // Tailwind
        let tw = '';
        if (type === 'linear') {
          const dirMap = { '0': 'bg-gradient-to-t', '45': 'bg-gradient-to-tr', '90': 'bg-gradient-to-r', '135': 'bg-gradient-to-br', '180': 'bg-gradient-to-b', '225': 'bg-gradient-to-bl', '270': 'bg-gradient-to-l', '315': 'bg-gradient-to-tl' };
          if (dirMap[angle] && stops.length === 2) {
            // Idiomatic Tailwind gradient utilities for cardinal angles with two stops.
            tw = dirMap[angle] + ' from-[' + stops[0].color + '] to-[' + stops[stops.length - 1].color + ']';
          } else {
            // Arbitrary value for non-cardinal angles or 3+ stops — exact, spaces underscored.
            tw = 'bg-[' + css.replace(/ /g, '_') + ']';
          }
        } else {
          tw = 'bg-[' + css.replace(/ /g, '_') + ']';
        }
        document.getElementById('grad-tw').textContent = tw;
      }

      document.getElementById('grad-type').addEventListener('change', function() {
        const angleWrap = document.getElementById('grad-angle-wrap');
        if (this.value === 'linear') angleWrap.classList.remove('hidden');
        else angleWrap.classList.add('hidden');
        updateGrad();
      });

      document.getElementById('grad-angle').addEventListener('input', function() {
        document.getElementById('grad-angle-val').textContent = this.value + '°';
        updateGrad();
      });

      document.getElementById('grad-add').addEventListener('click', function() {
        const last = gradStops[gradStops.length - 1];
        gradStops.push({ color: last ? last.color : '#6366f1', pos: 100 });
        renderGradControls();
        updateGrad();
      });

      renderGradControls();
      updateGrad();

      // ===== FLEXBOX =====
      function updateFlex() {
        const dir = document.getElementById('flex-dir').value;
        const wrap = document.getElementById('flex-wrap').value;
        const justify = document.getElementById('flex-justify').value;
        const align = document.getElementById('flex-align').value;
        const gap = document.getElementById('flex-gap').value;

        const preview = document.getElementById('flex-preview');
        preview.style.display = 'flex';
        preview.style.flexDirection = dir;
        preview.style.flexWrap = wrap;
        preview.style.justifyContent = justify;
        preview.style.alignItems = align;
        preview.style.gap = gap + 'px';

        document.getElementById('flex-gap-val').textContent = gap;

        const css = 'display: flex;\n' +
          'flex-direction: ' + dir + ';\n' +
          'flex-wrap: ' + wrap + ';\n' +
          'justify-content: ' + justify + ';\n' +
          'align-items: ' + align + ';\n' +
          'gap: ' + gap + 'px;';
        document.getElementById('flex-css').textContent = css;

        const twDir = dir === 'row' ? 'flex-row' : dir === 'row-reverse' ? 'flex-row-reverse' : dir === 'column' ? 'flex-col' : 'flex-col-reverse';
        const twWrap = wrap === 'nowrap' ? '' : wrap === 'wrap' ? ' flex-wrap' : ' flex-wrap-reverse';
        const twJust = justify === 'flex-start' ? ' justify-start' : justify === 'flex-end' ? ' justify-end' : justify === 'space-between' ? ' justify-between' : justify === 'space-around' ? ' justify-around' : justify === 'space-evenly' ? ' justify-evenly' : ' justify-center';
        const twAlign = align === 'stretch' ? ' items-stretch' : align === 'flex-start' ? ' items-start' : align === 'flex-end' ? ' items-end' : align === 'baseline' ? ' items-baseline' : ' items-center';
        const twGap = gap > 0 ? ' gap-[' + gap + 'px]' : '';
        document.getElementById('flex-tw').textContent = 'flex ' + twDir + twWrap + twJust + twAlign + twGap;
      }

      ['flex-dir','flex-wrap','flex-justify','flex-align'].forEach(id => {
        document.getElementById(id).addEventListener('change', updateFlex);
      });
      document.getElementById('flex-gap').addEventListener('input', updateFlex);
      updateFlex();

      // ===== GRID =====
      function updateGrid() {
        const cols = document.getElementById('grid-cols').value;
        const rows = document.getElementById('grid-rows').value;
        const gap = document.getElementById('grid-gap').value;
        const justify = document.getElementById('grid-justify').value;
        const align = document.getElementById('grid-align').value;

        const preview = document.getElementById('grid-preview');
        preview.style.display = 'grid';
        preview.style.gridTemplateColumns = 'repeat(' + cols + ', 1fr)';
        preview.style.gridTemplateRows = 'repeat(' + rows + ', minmax(3rem, auto))';
        preview.style.gap = gap + 'px';
        preview.style.justifyItems = justify;
        preview.style.alignItems = align;

        document.getElementById('grid-cols-val').textContent = cols;
        document.getElementById('grid-rows-val').textContent = rows;
        document.getElementById('grid-gap-val').textContent = gap;

        const css = 'display: grid;\n' +
          'grid-template-columns: repeat(' + cols + ', 1fr);\n' +
          'grid-template-rows: repeat(' + rows + ', minmax(3rem, auto));\n' +
          'gap: ' + gap + 'px;\n' +
          'justify-items: ' + justify + ';\n' +
          'align-items: ' + align + ';';
        document.getElementById('grid-css').textContent = css;

        const twCols = cols <= 6 ? ' grid-cols-' + cols : ' grid-cols-[' + cols + ']';
        const twRows = rows <= 6 ? ' grid-rows-' + rows : ' grid-rows-[' + rows + ']';
        const twGap = gap > 0 ? ' gap-[' + gap + 'px]' : '';
        const twJust = justify === 'stretch' ? '' : ' justify-items-' + justify;
        const twAlign = align === 'stretch' ? '' : ' items-' + align;
        document.getElementById('grid-tw').textContent = 'grid' + twCols + (rows !== '1' ? twRows : '') + twGap + twJust + twAlign;
      }

      ['grid-cols','grid-rows','grid-gap'].forEach(id => {
        document.getElementById(id).addEventListener('input', updateGrid);
      });
      ['grid-justify','grid-align'].forEach(id => {
        document.getElementById(id).addEventListener('change', updateGrid);
      });
      updateGrid();
    })();
  </script>
</BaseLayout>
