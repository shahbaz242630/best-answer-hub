// Known-subscription merchants for single-statement ("Mode B") detection —
// Subscriptions & Software keywords plus gyms, insurance, and telecom plans.
const AN_KNOWN_SUB_RE = /(\bAPPLE\b(?!BEE)|NETFLIX|SPOTIFY|HULU|DISNEY|HBO|PARAMOUNT|AUDIBLE|KINDLE|ADOBE|MICROSOFT 365|OFFICE 365|DROPBOX|CANVA|NOTION|FIGMA|GITHUB|OPENAI|CHATGPT|ANTHROPIC|CLAUDE\.AI|MIDJOURNEY|PATREON|SUBSTACK|NYTIMES|DUOLINGO|HEADSPACE|CALM\.COM|STRAVA|SHAHID|OSN|STARZPLAY|ANGHAMI|BEIN|CRUNCHYROLL|YOUTUBE|GOOGLE ONE|GOOGLE STORAGE|APPLE\.COM\/BILL|ICLOUD|APPLE ONE|AMAZON PRIME|PRIME VIDEO|ITUNES|FITNESS FIRST|GOLD'S GYM|ANYTIME FITNESS|PURE ?GYM|PLANET FITNESS|INSURANC|TAKAFUL|AXA |ALLIANZ|GEICO|ADMIRAL|LINKEDIN|ZOOM\.US|SLACK|1PASSWORD|LASTPASS|NORDVPN|EXPRESSVPN|SURFSHARK|PLAYSTATION PLUS|XBOX GAME PASS|NINTENDO ONLINE)/i;

const AN_PROC_PREFIX_RE = /^(SQ|TST|PAYPAL|PP|SP|WPY|IDP|GOOGLE|APL|CKO|PAYTABS|TELR)\s*\*\s*/i;
const AN_CHANNEL_RE = /^(IAP|NFC|ECOM|ATM|POS)\s*[-–]\s*(\((AP-PAY|G-PAY|S-PAY|[A-Z-]+)\)\s*[-–]?\s*)?/i;
const AN_NOISE_RE = /\b(POS( PURCHASE| DEBIT| WD)?|ACH (DEBIT|CREDIT)|CHECKCARD|CHKCARD|DEBIT (CARD )?PURCHASE|VISA (DDA )?PUR(CHASE)?|RECURRING (PAYMENT|PMT)|AUTHORIZED ON \d{1,2}\/\d{1,2}|CARD \d{4}|PURCHASE AUTHORIZED|PENDING|PREAUTH)\b/gi;
const AN_PHONE_RE = /\+?\d{3}[-. ]\d{3}[-. ]\d{4}\b/g;
const AN_DATE_IN_DESC_RE = /\b\d{1,2}\/\d{1,2}(\/\d{2,4})?\b/g;
const AN_COUNTRY_TAIL_RE = /\s+(ARE|UAE|AE|USA|US|GBR|GB|UK|FRA|FR|DEU|DE|NLD|NL|ESP|IT|ITA|IND|IN|PAK|CAN|AUS|NH|IDF|DXB|DUB)\s*$/;

function anParseDate(s, dayFirst) {
  const t = String(s || '').trim();
  let m = t.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
  if (m) return Date.UTC(+m[1], +m[2] - 1, +m[3]);
  m = t.match(/^(\d{1,2})[\/.\-](\d{1,2})[\/.\-](\d{2,4})$/);
  if (m) {
    let a = +m[1], b = +m[2], y = +m[3];
    if (y < 100) y += 2000;
    if (a > 12 && b <= 12) { const d = a; a = b; b = d; }        // unambiguous day-first
    else if (dayFirst && a <= 12 && b <= 12) { const d = a; a = b; b = d; } // file-level day-first (UK/EU/UAE)
    if (a >= 1 && a <= 12 && b >= 1 && b <= 31) return Date.UTC(y, a - 1, b);
    return null;
  }
  m = t.match(/^(\d{1,2})[-\s]([A-Za-z]{3,9})\.?[-\s](\d{2,4})$/);
  if (m) {
    const mo = AN_MONTHS[m[2].slice(0, 3).toLowerCase()];
    let y = +m[3]; if (y < 100) y += 2000;
    if (mo !== undefined) return Date.UTC(y, mo, +m[1]);
  }
  m = t.match(/^(\d{1,2})\s+([A-Za-z]{3,9})\.?\s+(\d{4})$/);
  if (m) {
    const mo = AN_MONTHS[m[2].slice(0, 3).toLowerCase()];
    if (mo !== undefined) return Date.UTC(+m[3], mo, +m[1]);
  }
  m = t.match(/^([A-Za-z]{3,9})\.?\s+(\d{1,2}),?\s+(\d{4})$/);
  if (m) {
    const mo = AN_MONTHS[m[1].slice(0, 3).toLowerCase()];
    if (mo !== undefined) return Date.UTC(+m[3], mo, +m[2]);
  }
  return null;
}

// Money/date token helpers for the bank-layout parser. Signed plain integers
// ("-551", "-21,000") count as money — neo-bank statements print whole-number
// amounts; UNSIGNED integers stay excluded (store numbers, refs).
const AN_ARABIC_RE = /[؀-ۿݐ-ݿﭐ-﷿ﹰ-﻿]/;
const AN_MONEY_TOK_RE = /^[\(\-\+]?\s*(?:[A-Z]{3}\s+)?(?:[$£€]\s*\d{1,3}(?:,\d{3})*(?:\.\d{1,2})?|\d{1,3}(?:,\d{3})+(?:\.\d{1,2})?|\d+\.\d{1,2})\s*\)?(?:\s*(?:CR|DR))?$/i;
const AN_SIGNED_INT_RE = /^[\-+]\s*[$£€]?\d{1,3}(?:,\d{3})*(?:\.\d{1,2})?$/;
function anIsMoneyTok(s) {
  const t = String(s || '').trim();
  if (!/\d/.test(t)) return false;
  return AN_MONEY_TOK_RE.test(t) || AN_SIGNED_INT_RE.test(t);
}
function anMoneyVal(s) {
  let t = String(s || '').trim().replace(/^([\(\-\+]?)\s*[A-Za-z]{3}\s+/, '$1');
  const cr = /(^|\s)CR$/i.test(t);
  const neg = /^\(.*\)$/.test(t) || /^-/.test(t);
  t = t.replace(/[()$£€,\s]/g, '').replace(/CR$|DR$/i, '').replace(/^[+-]/, '');
  const n = parseFloat(t);
  if (isNaN(n)) return null;
  return { val: neg ? -n : n, cr: cr };
}
function anIsDateTok(s) {
  return anParseDate(s) != null || /^(\d{1,2})[\/.\-](\d{1,2})$/.test(String(s || '').trim());
}

// Bank-layout parser. Two modes: (a) header-banded — a "Amount ... Balance"
// column header defines x positions (neo-bank style: Date | Ref | Description |
// signed Amount | Balance); (b) classic column-band clustering (money out /
// money in / balance) as proven in the Bank Statement to Excel tool.
// Returns { rows, banded } in the common transaction model.
function bankLinesToRows(lines) {
  const cleaned = [];
  for (const raw of lines) {
    const line = raw.filter(function (t) { return !AN_ARABIC_RE.test(t.s); });
    if (line.length) cleaned.push(line);
  }
  let amountX = null, balanceX = null;
  for (const line of cleaned) {
    let a = null, b = null;
    for (const t of line) {
      if (/^amount( \(|$)/i.test(t.s)) a = t;
      if (/^balance( \(|$)/i.test(t.s)) b = t;
    }
    if (a && b && b.x > a.x) { amountX = a.x; balanceX = b.x; break; }
  }
  const out = [];
  if (amountX != null) {
    for (const line of cleaned) {
      const first = line[0];
      if (!first || !anIsDateTok(first.s)) continue;
      const descToks = [];
      let amtTok = null;
      for (let i = 1; i < line.length; i++) {
        const t = line[i];
        if (anIsMoneyTok(t.s) && t.x >= balanceX - 15) continue;              // balance column
        if (anIsMoneyTok(t.s) && t.x >= amountX - 60) { amtTok = t; continue; } // amount column
        descToks.push(t);
      }
      if (!amtTok) continue;
      const v = anMoneyVal(amtTok.s);
      if (!v || v.val === 0) continue;
      const desc = descToks.map(function (t) { return t.s; }).join(' ').trim();
      if (/OPENING BALANCE|CLOSING BALANCE/i.test(desc)) continue;
      const isOut = v.val < 0 && !v.cr;
      out.push({
        date: first.s, description: desc,
        charge: isOut ? Math.abs(v.val).toFixed(2) : '',
        credit: isOut ? '' : Math.abs(v.val).toFixed(2),
      });
    }
    return { rows: out, banded: true };
  }
  // classic clustering
  const xs = [];
  for (const line of cleaned) {
    if (line[0] && anIsDateTok(line[0].s)) for (const t of line) if (anIsMoneyTok(t.s)) xs.push(t.x);
  }
  if (!xs.length) return { rows: [], banded: false };
  xs.sort(function (a, b) { return a - b; });
  const bandsArr = [];
  let cur = [xs[0]];
  for (let i = 1; i < xs.length; i++) {
    if (xs[i] - xs[i - 1] > 40) { bandsArr.push(cur); cur = [xs[i]]; }
    else cur.push(xs[i]);
  }
  bandsArr.push(cur);
  const centers = bandsArr.map(function (b) { return b.reduce(function (s, v) { return s + v; }, 0) / b.length; });
  const balIdx = centers.length - 1;
  const amountColCount = Math.max(0, centers.length - 1);
  for (const line of cleaned) {
    const first = line[0];
    if (!first || !anIsDateTok(first.s)) continue;
    const descToks = line.slice(1).filter(function (t) { return !anIsMoneyTok(t.s); });
    let moneyOut = '', moneyIn = '';
    for (const t of line) {
      if (!anIsMoneyTok(t.s)) continue;
      const v = anMoneyVal(t.s);
      if (!v) continue;
      let bi = 0, best = Infinity;
      for (let i = 0; i < centers.length; i++) { const d = Math.abs(t.x - centers[i]); if (d < best) { best = d; bi = i; } }
      if (centers.length >= 2 && bi === balIdx) continue;
      if (amountColCount >= 2) {
        if (bi === 0) moneyOut = Math.abs(v.val).toFixed(2); else moneyIn = Math.abs(v.val).toFixed(2);
      } else {
        if (v.val < 0 && !v.cr) moneyOut = Math.abs(v.val).toFixed(2);
        else if (v.cr) moneyIn = Math.abs(v.val).toFixed(2);
        else moneyOut = Math.abs(v.val).toFixed(2);
      }
    }
    const desc = descToks.map(function (t) { return t.s; }).join(' ').trim();
    if (/OPENING BALANCE|CLOSING BALANCE/i.test(desc)) continue;
    if (moneyOut === '' && moneyIn === '') continue;
    out.push({ date: first.s, description: desc, charge: moneyOut, credit: moneyIn });
  }
  return { rows: out, banded: false };
}

// Clean a raw descriptor into { display, key, hints }. Known-merchant category
// matching runs against the RAW uppercase string (Plaid/Actual pattern), so
// aggressive display cleanup here is harmless to categorization.
function anNormalize(desc) {
  const raw = String(desc || '').toUpperCase().replace(/\s{2,}/g, ' ').trim();
  const hints = AN_HINT_RE.test(raw);
  let t = raw;
  t = t.replace(/^[A-Z]{0,2}\d{7,}\s+/, ''); // leading transfer/ref number (P570295703 …)
  t = t.replace(AN_CHANNEL_RE, '');
  t = t.replace(AN_PROC_PREFIX_RE, '');
  t = t.replace(AN_NOISE_RE, ' ');
  t = t.replace(AN_PHONE_RE, ' ');
  t = t.replace(AN_DATE_IN_DESC_RE, ' ');
  t = t.replace(/[#*]\s?[A-Z0-9]{2,14}$/, ' ');       // trailing ref after # or *
  t = t.replace(/\s\d{4,}$/, ' ');                     // trailing store number
  t = t.replace(/\s{2,}/g, ' ').trim();
  let prev = '';
  while (prev !== t) { prev = t; t = t.replace(AN_COUNTRY_TAIL_RE, ''); } // repeated country/city-code tails
  t = t.replace(/\b(LLC|INC|LTD|CORP|PLC|FZE|FZ-?LLC)\b/g, ' ');
  t = t.replace(/^[\s*\-–_.]+|[\s*\-–_.]+$/g, '').replace(/\s{2,}/g, ' ').trim();
  if (!t) t = raw;
  // grouping key: letters/digits only, first 18 chars — stable across store
  // numbers, cities, and refs so streams group correctly
  const key = t.replace(/[^A-Z0-9]/g, '').slice(0, 18) || raw.replace(/[^A-Z0-9]/g, '').slice(0, 18);
  return { display: t, key: key, hints: hints };
}

// category from RAW uppercase descriptor; sign- and parser-type-aware.
function anCategorize(rawUpper, isCredit, parserType) {
  if (parserType === 'Fee' || parserType === 'Interest') return 'Fees & Interest';
  if (isCredit) {
    if (/(REFUND|REVERSAL|CASHBACK|RETURN|CREDIT ADJUSTMENT)/.test(rawUpper)) return 'Income & Refunds';
    if (/(SALARY|PAYROLL|WAGES|WPS|DIRECT DEPOSIT|PENSION|DIVIDEND|HMRC|IRS TREAS)/.test(rawUpper)) return 'Income & Refunds';
    if (/(PAYMENT|TRANSFER|TRF|AUTOPAY)/.test(rawUpper)) return 'Cash & Transfers';
    return 'Income & Refunds';
  }
  // bank-transfer patterns: "P570295703 To Golden Nest (rate: 1.0000)" style
  if (/^([A-Z]{0,2}\d{7,}\s+)?TO\s+[A-Z0-9]/.test(rawUpper) || /\(RATE:/.test(rawUpper) || /FOREIGN EXCHANGE/.test(rawUpper)) return 'Cash & Transfers';
  if (/^TST\s*\*/i.test(rawUpper)) return 'Dining & Delivery';
  for (const pair of AN_KW) {
    if (rawUpper.indexOf(pair[0]) !== -1) return pair[1];
  }
  if (/^SQ\s*\*/i.test(rawUpper)) return 'Shopping';
  return 'Other';
}

// Frequency windows (Plaid frequencies; day windows are our tolerance synthesis)
const AN_FREQ = [
  { name: 'Weekly', min: 5, max: 9, perMonth: 52 / 12 },
  { name: 'Every 2 weeks', min: 12, max: 17, perMonth: 26 / 12 },
  { name: 'Monthly', min: 26, max: 35, perMonth: 1 },
  { name: 'Quarterly', min: 80, max: 100, perMonth: 1 / 3 },
  { name: 'Yearly', min: 340, max: 395, perMonth: 1 / 12 },
];
const AN_SPEND_EXCLUDE = { 'Cash & Transfers': 1, 'Income & Refunds': 1 };
const AN_HABITUAL = { 'Groceries': 1, 'Dining & Delivery': 1, 'Transport & Fuel': 1, 'Shopping': 1, 'Entertainment': 1, 'Travel': 1, 'Health & Pharmacy': 1 };

// Parse a bank/card CSV export into the common transaction model. Handles
// quoted fields, Date/Description/Amount or Debit+Credit column layouts, and
// either sign convention (majority sign = the spending side).
function anCsvSplitLine(line) {
  const out = []; let cur = ''; let q = false;
  for (let i = 0; i < line.length; i++) {
    const ch = line[i];
    if (q) {
      if (ch === '"') { if (line[i + 1] === '"') { cur += '"'; i++; } else q = false; }
      else cur += ch;
    } else if (ch === '"') q = true;
    else if (ch === ',') { out.push(cur); cur = ''; }
    else cur += ch;
  }
  out.push(cur);
  return out;
}
function anCsvNum(s) {
  const t = String(s || '').replace(/[$£€,\s]|AED|USD|GBP|EUR/gi, '').replace(/^\((.*)\)$/, '-$1');
  if (t === '' || !/\d/.test(t)) return null;
  const n = parseFloat(t);
  return isNaN(n) ? null : n;
}
function anParseCsv(text, fileName) {
  const lines = String(text || '').split(/\r?\n/).filter(function (l) { return l.trim() !== ''; });
  if (!lines.length) return [];
  const rows = lines.map(anCsvSplitLine);
  const h = rows[0].map(function (c) { return c.trim().toLowerCase(); });
  const findH = function (re) { for (let i = 0; i < h.length; i++) { if (re.test(h[i])) return i; } return -1; };
  let dateI = findH(/^(trans(action)? )?date$|posting date|^posted/);
  let descI = findH(/desc|narrat|details|payee|merchant|memo|reference$/);
  const debitI = findH(/debit|money out|withdraw|paid out|^out$/);
  const creditI = findH(/^credit$|money in|deposit|paid in|^in$/);
  let amtI = findH(/^amount|^value$|^amt/);
  const hasHeader = dateI !== -1 || (descI !== -1 && (amtI !== -1 || debitI !== -1));
  const body = hasHeader ? rows.slice(1) : rows;
  if (!body.length) return [];
  if (!hasHeader) {
    // infer: first column where most values parse as dates; amount = last
    // numeric column; description = widest text column between them
    const cols = body[0].length;
    dateI = -1; amtI = -1; descI = -1;
    for (let c = 0; c < cols; c++) {
      const hits = body.filter(function (r) { return anParseDate((r[c] || '').trim()) != null; }).length;
      if (hits >= body.length * 0.6) { dateI = c; break; }
    }
    for (let c = cols - 1; c >= 0; c--) {
      const hits = body.filter(function (r) { return anCsvNum(r[c]) != null; }).length;
      if (hits >= body.length * 0.6 && c !== dateI) { amtI = c; break; }
    }
    let best = -1;
    for (let c = 0; c < cols; c++) {
      if (c === dateI || c === amtI) continue;
      const len = body.reduce(function (s, r) { return s + String(r[c] || '').replace(/[\d.,\s-]/g, '').length; }, 0);
      if (len > best) { best = len; descI = c; }
    }
    if (dateI === -1 || amtI === -1 || descI === -1) return [];
  }
  const txns = [];
  const signed = [];
  for (const r of body) {
    const date = (r[dateI] || '').trim();
    if (anParseDate(date) == null) continue;
    const description = descI !== -1 ? String(r[descI] || '').trim() : '';
    let charge = '', credit = '';
    if (debitI !== -1 || creditI !== -1) {
      const d = debitI !== -1 ? anCsvNum(r[debitI]) : null;
      const c = creditI !== -1 ? anCsvNum(r[creditI]) : null;
      if (d != null && d !== 0) charge = Math.abs(d).toFixed(2);
      else if (c != null && c !== 0) credit = Math.abs(c).toFixed(2);
      else continue;
      txns.push({ date: date, description: description, charge: charge, credit: credit, fileName: fileName || '' });
    } else if (amtI !== -1) {
      const n = anCsvNum(r[amtI]);
      if (n == null || n === 0) continue;
      signed.push({ date: date, description: description, n: n });
    }
  }
  if (signed.length) {
    // majority sign = the spending side (card CSVs differ from bank CSVs)
    const negs = signed.filter(function (s) { return s.n < 0; }).length;
    const negIsSpend = negs >= signed.length / 2;
    for (const s of signed) {
      const isSpend = negIsSpend ? s.n < 0 : s.n > 0;
      txns.push({
        date: s.date, description: s.description,
        charge: isSpend ? Math.abs(s.n).toFixed(2) : '',
        credit: isSpend ? '' : Math.abs(s.n).toFixed(2),
        fileName: fileName || '',
      });
    }
  }
  return txns;
}

// txns: [{ date, description, charge:'12.34'|'', credit:''|'5.00', type?, fileName? }]
// overrides: optional { itemIndex: 'Category Name' } from the user's manual edits.
function anAnalyze(txns, overrides) {
  // per-file day-first detection: any DD/MM date with day > 12 marks the file
  const dayFirstByFile = {};
  for (const t of txns) {
    const m = String(t.date || '').match(/^(\d{1,2})[\/.\-](\d{1,2})[\/.\-]\d{2,4}$/);
    if (m && +m[1] > 12 && +m[2] <= 12) dayFirstByFile[t.fileName || ''] = true;
  }
  const items = [];
  for (const t of txns) {
    const amt = t.charge ? parseFloat(t.charge) : (t.credit ? -parseFloat(t.credit) : 0);
    if (!amt) continue;
    const rawUpper = String(t.description || '').toUpperCase();
    if (/OPENING BALANCE|CLOSING BALANCE/.test(rawUpper)) continue;
    const norm = anNormalize(t.description);
    const cat = anCategorize(rawUpper, amt < 0, t.type === 'Fee' ? 'Fee' : t.type === 'Interest' ? 'Interest' : '');
    items.push({
      date: t.date, ts: anParseDate(t.date, dayFirstByFile[t.fileName || '']), description: t.description,
      merchant: norm.display, key: norm.key, hints: norm.hints,
      amount: amt, category: cat, fileName: t.fileName || '',
    });
  }
  if (overrides) {
    for (const k in overrides) {
      const i = parseInt(k, 10);
      if (items[i] && overrides[k]) items[i].category = overrides[k];
    }
  }

  // summary + categories
  let debits = 0, credits = 0, spend = 0, transfersOut = 0;
  const catTotals = {};
  let minTs = null, maxTs = null;
  for (const it of items) {
    if (it.ts != null) { if (minTs == null || it.ts < minTs) minTs = it.ts; if (maxTs == null || it.ts > maxTs) maxTs = it.ts; }
    if (it.amount > 0) {
      debits += it.amount;
      if (AN_SPEND_EXCLUDE[it.category]) transfersOut += it.amount;
      else { spend += it.amount; catTotals[it.category] = (catTotals[it.category] || 0) + it.amount; }
    } else {
      credits += -it.amount;
    }
  }
  const categories = Object.keys(catTotals)
    .map(function (c) { return { name: c, total: catTotals[c], pct: spend > 0 ? (catTotals[c] / spend) * 100 : 0 }; })
    .sort(function (a, b) { return b.total - a.total; });

  // top merchants (spend only)
  const merchTotals = {};
  for (const it of items) {
    if (it.amount <= 0 || AN_SPEND_EXCLUDE[it.category]) continue;
    if (!merchTotals[it.key]) merchTotals[it.key] = { name: it.merchant, total: 0, count: 0 };
    merchTotals[it.key].total += it.amount;
    merchTotals[it.key].count++;
  }
  const topMerchants = Object.keys(merchTotals).map(function (k) { return merchTotals[k]; })
    .sort(function (a, b) { return b.total - a.total; }).slice(0, 10);

  // recurring detection
  const groups = {};
  for (const it of items) {
    if (it.amount <= 0) continue;
    if (!groups[it.key]) groups[it.key] = [];
    groups[it.key].push(it);
  }
  const recurring = [];
  for (const k in groups) {
    const g = groups[k].filter(function (x) { return x.ts != null; }).sort(function (a, b) { return a.ts - b.ts; });
    if (!g.length) continue;
    const sample = g[g.length - 1];
    const knownSub = AN_KNOWN_SUB_RE.test(sample.description.toUpperCase());
    const hinted = g.some(function (x) { return x.hints; });
    const amounts = g.map(function (x) { return x.amount; }).sort(function (a, b) { return a - b; });
    const median = amounts[Math.floor(amounts.length / 2)];
    const tol = Math.max(median * 0.15, 3);
    const isFixed = amounts.every(function (a) { return Math.abs(a - median) <= tol; });

    if (g.length >= 2) {
      // Mode A: interval-based
      const gaps = [];
      for (let i = 1; i < g.length; i++) gaps.push((g[i].ts - g[i - 1].ts) / 86400000);
      const sg = gaps.slice().sort(function (a, b) { return a - b; });
      const medGap = sg[Math.floor(sg.length / 2)];
      const win = AN_FREQ.find(function (w) { return medGap >= w.min && medGap <= w.max; });
      if (win) {
        const inWin = gaps.filter(function (d) { return d >= win.min && d <= win.max; }).length;
        if (inWin / gaps.length >= 0.6) {
          const allowed = knownSub || hinted || sample.category === 'Subscriptions & Software' || sample.category === 'Telecom & Utilities' ||
            (isFixed && !AN_HABITUAL[sample.category]);
          if (allowed) {
            const lastAmount = g[g.length - 1].amount;
            recurring.push({
              merchant: sample.merchant, category: sample.category,
              frequency: win.name, occurrences: g.length,
              lastAmount: lastAmount, isFixed: isFixed,
              monthly: lastAmount * win.perMonth, annual: lastAmount * win.perMonth * 12,
              confidence: g.length >= 3 ? 'confirmed' : 'likely',
              nextTs: g[g.length - 1].ts + Math.round(medGap) * 86400000,
            });
            continue;
          }
        }
      }
    }
    // Mode B: single occurrence (or irregular) — known-merchant / hint scoring
    if (g.length === 1) {
      let score = 0;
      if (knownSub) score += 2;
      if (hinted) score += 2;
      const cents = Math.round((sample.amount % 1) * 100);
      if ((cents === 99 || cents === 95) && sample.amount >= 2 && sample.amount <= 150) score += 1;
      if (score >= 2 && !AN_SPEND_EXCLUDE[sample.category]) {
        recurring.push({
          merchant: sample.merchant, category: sample.category,
          frequency: 'Monthly (assumed)', occurrences: 1,
          lastAmount: sample.amount, isFixed: true,
          monthly: sample.amount, annual: sample.amount * 12,
          confidence: 'possible', nextTs: null,
        });
      }
    }
  }
  recurring.sort(function (a, b) { return b.monthly - a.monthly; });
  let subMonthly = 0;
  for (const r of recurring) subMonthly += r.monthly;

  return {
    items: items,
    summary: { debits: debits, credits: credits, spend: spend, transfersOut: transfersOut, net: credits - debits, count: items.length, minTs: minTs, maxTs: maxTs },
    categories: categories,
    topMerchants: topMerchants,
    recurring: recurring,
    subscriptionMonthly: subMonthly,
    subscriptionAnnual: subMonthly * 12,
  };
}

function anIcsDate(ts) {
  const d = new Date(ts);
  const p = function (n) { return (n < 10 ? '0' : '') + n; };
  return '' + d.getUTCFullYear() + p(d.getUTCMonth() + 1) + p(d.getUTCDate());
}
const AN_ICS_FREQ = { 'Weekly': 'FREQ=WEEKLY', 'Every 2 weeks': 'FREQ=WEEKLY;INTERVAL=2', 'Monthly': 'FREQ=MONTHLY', 'Quarterly': 'FREQ=MONTHLY;INTERVAL=3', 'Yearly': 'FREQ=YEARLY' };
function anBuildIcs(recurring, currency) {
  const lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Best Answer Hub//Bank Statement Analyzer//EN'];
  let n = 0;
  for (const r of recurring) {
    if (r.nextTs == null) continue;
    n++;
    lines.push('BEGIN:VEVENT');
    lines.push('UID:bah-analyzer-' + n + '-' + anIcsDate(r.nextTs) + '@bestanswerhub.com');
    lines.push('DTSTART;VALUE=DATE:' + anIcsDate(r.nextTs));
    const rr = AN_ICS_FREQ[r.frequency];
    if (rr) lines.push('RRULE:' + rr);
    lines.push('SUMMARY:' + (r.merchant + ' ' + (currency || '') + ' ' + r.lastAmount.toFixed(2) + ' expected (' + r.frequency + ')').replace(/[,;]/g, ' '));
    lines.push('END:VEVENT');
  }
  lines.push('END:VCALENDAR');
  return n ? lines.join('\r\n') : '';
}
// ── END ANALYZER CORE ──

    // ── Orchestration ────────────────────────────────────────────────────────
    function handleFiles(fs: File[]) {
      errorArea?.classList.add('hidden');
      resultArea?.classList.add('hidden');
      const okFiles = fs.filter((f) => /\.(pdf|csv)$/i.test(f.name));
      if (!okFiles.length) { showError('Please choose .pdf or .csv statement files.'); return; }
      files = okFiles;
      if (infoName) infoName.textContent = files.length === 1 ? files[0].name : files.length + ' files selected';
      if (infoSize) infoSize.textContent = formatBytes(files.reduce((s, f) => s + f.size, 0));
      fileInfo?.classList.remove('hidden');
      settingsArea?.classList.remove('hidden');
    }

    async function analyze() {
      if (!files.length) return;
      settingsArea?.classList.add('hidden');
      errorArea?.classList.add('hidden');
      progressArea?.classList.remove('hidden');
      txns = []; overrides = {};
      try {
        for (const file of files) {
          if (progressText) progressText.textContent = 'Reading ' + file.name + '...';
          if (/\.csv$/i.test(file.name)) {
            const text = await file.text();
            txns.push(...anParseCsv(text, file.name));
          } else {
            await loadPdf();
            const buf = await file.arrayBuffer();
            const pdf = await pdfjsLib.getDocument({ data: new Uint8Array(buf) }).promise;
            const allLines: any[] = [];
            let totalItems = 0;
            for (let i = 1; i <= pdf.numPages; i++) {
              if (progressText) progressText.textContent = 'Reading ' + file.name + ' — page ' + i + ' of ' + pdf.numPages + '...';
              const page = await pdf.getPage(i);
              const tc = await page.getTextContent();
              totalItems += tc.items.length;
              allLines.push(...groupLines(tc.items));
            }
            if (totalItems === 0) {
              showError(file.name + ' looks like a scanned statement (no text layer). Run it through the Bank Statement to Excel converter\'s OCR first, then drop the CSV here.');
              return;
            }
            const card = parseCardStatement(allLines);
            const bank = bankLinesToRows(allLines);
            // banded layouts are decisive: an Amount/Balance header means a bank
            // statement (rightmost money = running balance, never the amount)
            let rows: any[];
            if (bank.banded && bank.rows.length >= 3 && !card.banded) rows = bank.rows;
            else if (card.banded || card.rows.length >= bank.rows.length) rows = card.rows;
            else rows = bank.rows;
            for (const r of rows) (r as any).fileName = file.name;
            txns.push(...rows);
          }
        }
        if (!txns.length) {
          showError('No transactions could be read from these files. The layout may be unusual — try the Bank Statement to Excel converter first and drop its CSV here.');
          return;
        }
        recompute();
        progressArea?.classList.add('hidden');
        resultArea?.classList.remove('hidden');
        resultArea?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (e: any) {
        showError(e?.message || 'Something went wrong while analyzing.');
      }
    }

    function recompute() {
      analysis = anAnalyze(txns, overrides);
      renderSummary();
      renderSubs();
      renderCategories();
      renderMerchants();
      renderTxns();
    }

    function tsLabel(ts: number | null): string {
      if (ts == null) return '';
      const d = new Date(ts);
      const M = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      return d.getUTCDate() + ' ' + M[d.getUTCMonth()] + ' ' + d.getUTCFullYear();
    }

    function renderSummary() {
      if (!summaryStrip) return;
      const s = analysis.summary;
      const range = s.minTs != null ? tsLabel(s.minTs) + ' – ' + tsLabel(s.maxTs) : '';
      const tiles = [
        ['Total spending', fmt(s.spend), 'text-bae-ink'],
        ['Money in', fmt(s.credits), 'text-emerald-600'],
        ['Transfers & card payments', fmt(s.transfersOut), 'text-bae-muted'],
        ['Transactions', String(s.count) + (range ? '<span class="block text-[10px] font-normal text-bae-muted mt-0.5">' + escapeHtml(range) + '</span>' : ''), 'text-bae-ink'],
      ];
      summaryStrip.innerHTML = tiles.map((t) => `
        <div class="bg-bae-card border border-bae-border rounded-bae p-4 text-center">
          <p class="text-[10px] uppercase tracking-wide text-bae-muted mb-1">${t[0]}</p>
          <p class="text-base font-bold ${t[2]}">${t[1]}</p>
        </div>`).join('');
    }

    function renderSubs() {
      if (!subList || !subCount || !subBurn) return;
      const rec = analysis.recurring;
      subCount.textContent = rec.length + ' found';
      if (!rec.length) {
        subBurn.textContent = '';
        subList.innerHTML = '';
        subEmpty?.classList.remove('hidden');
        icsBtn?.classList.add('hidden');
        return;
      }
      subEmpty?.classList.add('hidden');
      subBurn.textContent = 'Estimated recurring spend: ' + fmt(analysis.subscriptionMonthly) + ' / month ≈ ' + fmt(analysis.subscriptionAnnual) + ' / year.';
      const badge = (c: string) =>
        c === 'confirmed' ? '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-100">confirmed</span>'
        : c === 'likely' ? '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-bae-primary-soft text-bae-primary">likely</span>'
        : '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-600 border border-amber-100">possible</span>';
      subList.innerHTML = rec.map((r: any) => `
        <div class="flex items-center justify-between gap-3 border border-bae-border-light rounded-bae-sm p-3 flex-wrap">
          <div class="min-w-0">
            <p class="text-xs font-semibold text-bae-ink truncate">${escapeHtml(r.merchant)} ${badge(r.confidence)}</p>
            <p class="text-[11px] text-bae-muted">${escapeHtml(r.frequency)}${r.isFixed ? '' : ' · variable amount'}${r.nextTs != null ? ' · next ≈ ' + escapeHtml(tsLabel(r.nextTs)) : ''}</p>
          </div>
          <div class="text-right shrink-0">
            <p class="text-xs font-bold text-bae-ink">${fmt(r.monthly)} / mo</p>
            <p class="text-[11px] text-bae-muted">≈ ${fmt(r.annual)} / yr</p>
          </div>
        </div>`).join('');
      if (icsBtn) icsBtn.classList.toggle('hidden', !rec.some((r: any) => r.nextTs != null));
    }

    function renderCategories() {
      if (!donut || !catBars) return;
      const cats = analysis.categories;
      if (!cats.length) {
        donut.style.background = '#e5e7eb';
        catBars.innerHTML = '<p class="text-xs text-bae-muted">No spending detected.</p>';
        if (donutLabel) donutLabel.textContent = '';
        return;
      }
      let acc = 0;
      const segs: string[] = [];
      cats.forEach((c: any, i: number) => {
        const col = PALETTE[i % PALETTE.length];
        segs.push(col + ' ' + acc.toFixed(2) + '% ' + (acc + c.pct).toFixed(2) + '%');
        acc += c.pct;
      });
      donut.style.background = 'conic-gradient(' + segs.join(', ') + ')';
      if (donutLabel) donutLabel.textContent = 'Spending ' + fmt(analysis.summary.spend);
      const max = cats[0].total || 1;
      catBars.innerHTML = cats.map((c: any, i: number) => `
        <div>
          <div class="flex items-center justify-between text-xs mb-0.5">
            <span class="font-medium text-bae-ink flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 rounded-sm" style="background:${PALETTE[i % PALETTE.length]}"></span>${escapeHtml(c.name)}</span>
            <span class="text-bae-muted">${fmt(c.total)} · ${c.pct.toFixed(1)}%</span>
          </div>
          <div class="h-1.5 bg-bae-bg rounded-full overflow-hidden"><div class="h-full rounded-full" style="width:${((c.total / max) * 100).toFixed(1)}%;background:${PALETTE[i % PALETTE.length]}"></div></div>
        </div>`).join('');
    }

    function renderMerchants() {
      if (!merchantBody) return;
      merchantBody.innerHTML = analysis.topMerchants.map((m: any) => `
        <tr class="border-b border-bae-border-light">
          <td class="py-2 pr-2 font-medium text-bae-ink">${escapeHtml(m.name)}</td>
          <td class="py-2 pr-2 text-right text-bae-muted">${m.count}</td>
          <td class="py-2 text-right font-semibold text-bae-ink">${fmt(m.total)}</td>
        </tr>`).join('');
    }

    function renderTxns() {
      if (!txnBody || !txnCount) return;
      const items = analysis.items;
      txnCount.textContent = items.length + (items.length === 1 ? ' row' : ' rows');
      const opts = (sel: string) => ALL_CATS.map((c) => `<option value="${escapeHtml(c)}"${c === sel ? ' selected' : ''}>${escapeHtml(c)}</option>`).join('');
      txnBody.innerHTML = items.map((it: any, i: number) => `
        <tr class="border-t border-bae-border-light">
          <td class="px-2 py-1.5 whitespace-nowrap">${escapeHtml(it.date)}</td>
          <td class="px-2 py-1.5">${escapeHtml(it.merchant)}</td>
          <td class="px-2 py-1.5"><select data-i="${i}" class="cat-sel text-xs bg-bae-bg border border-bae-border rounded-bae-sm px-1 py-0.5">${opts(it.category)}</select></td>
          <td class="px-2 py-1.5 text-right font-medium ${it.amount < 0 ? 'text-emerald-600' : 'text-bae-ink'}">${it.amount < 0 ? '+' + fmt(-it.amount) : fmt(it.amount)}</td>
        </tr>`).join('');
      txnBody.querySelectorAll('.cat-sel').forEach((sel) => {
        sel.addEventListener('change', () => {
          const i = parseInt((sel as HTMLElement).dataset.i || '-1', 10);
          if (i >= 0) { overrides[i] = (sel as HTMLSelectElement).value; recompute(); }
        });
      });
    }

    function triggerDownload(blob: Blob, name: string) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = name; document.body.appendChild(a); a.click();
      document.body.removeChild(a); setTimeout(() => URL.revokeObjectURL(url), 1000);
    }
    function downloadCsv() {
      if (!analysis) return;
      const header = ['Date', 'Description', 'Merchant', 'Category', 'Charge', 'Credit', 'Statement'];
      const rows = analysis.items.map((it: any) => [
        it.date, it.description, it.merchant, it.category,
        it.amount > 0 ? it.amount.toFixed(2) : '', it.amount < 0 ? (-it.amount).toFixed(2) : '', it.fileName,
      ]);
      const csv = [header, ...rows].map((row: any[]) => row.map((c) => {
        const v = String(c == null ? '' : c);
        return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v;
      }).join(',')).join('\r\n');
      triggerDownload(new Blob([csv], { type: 'text/csv;charset=utf-8' }), 'statement-analysis.csv');
    }
    function downloadIcs() {
      if (!analysis) return;
      const ics = anBuildIcs(analysis.recurring, '');
      if (!ics) return;
      triggerDownload(new Blob([ics], { type: 'text/calendar;charset=utf-8' }), 'subscription-renewals.ics');
    }
    function reset() {
      files = []; txns = []; overrides = {}; analysis = null;
      fileInput.value = '';
      [fileInfo, settingsArea, progressArea, resultArea, errorArea].forEach((el) => el?.classList.add('hidden'));
    }

    // ── Wiring ───────────────────────────────────────────────────────────────
    dropZone?.addEventListener('click', () => fileInput.click());
    dropZone?.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-bae-primary'); });
    dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('border-bae-primary'));
    dropZone?.addEventListener('drop', (e) => {
      e.preventDefault(); dropZone.classList.remove('border-bae-primary');
      const fs = e.dataTransfer?.files; if (fs && fs.length) handleFiles(Array.from(fs));
    });
    fileInput?.addEventListener('change', () => {
      const fs = fileInput.files ? Array.from(fileInput.files) : [];
      fileInput.value = ''; // allow re-selecting the same files without a page refresh
      if (fs.length) handleFiles(fs);
    });
    analyzeBtn?.addEventListener('click', analyze);
    csvBtn?.addEventListener('click', downloadCsv);
    icsBtn?.addEventListener('click', downloadIcs);
    resetBtn?.addEventListener('click', reset);
    document.getElementById('reset-top')?.addEventListener('click', reset);
  })();
</script>
