---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UpdatedBadge from '../../components/content/UpdatedBadge.astro';
import ToolHero from '../../components/tools/ToolHero.astro';
import ToolHowItWorks from '../../components/tools/ToolHowItWorks.astro';
import ToolFAQ from '../../components/tools/ToolFAQ.astro';

const today = '2026-07-13T00:00:00+00:00';

const faqs = [
  {
    q: 'What is the Best Answer Hub Bank Statement Analyzer?',
    a: 'The Best Answer Hub Bank Statement Analyzer is a free browser-based tool that turns bank and credit card statements (PDF or CSV) into a categorized spending breakdown plus a list of recurring charges and subscriptions — including ones long forgotten. Everything runs on your device: no upload, no signup, and no bank login. Updated July 2026.',
  },
  {
    q: 'Does this tool upload my bank statement or see my spending?',
    a: 'No. The analysis runs entirely in your browser, so the statement never leaves your device, is never stored anywhere, and is never seen by anyone. You can verify it: open your browser\'s Network tab while analyzing and no file data is sent — the tool even keeps working with the internet disconnected. Bank statements are among the most sensitive documents there are, and this design removes the trust question entirely.',
  },
  {
    q: 'How do I find subscriptions I forgot I\'m paying for?',
    a: 'Drop one or more statements into the Best Answer Hub Bank Statement Analyzer and open the recurring charges panel. It groups repeated payments to the same merchant, flags known subscription services, and shows what each one costs per month and per year — the annual number is usually the wake-up call. Analyzing two or three consecutive months catches the most, including charges that only appear quarterly.',
  },
  {
    q: 'Can I find my subscriptions without linking my bank account?',
    a: 'Yes — that is exactly what this tool is for. Apps like Rocket Money require connecting your bank through Plaid, which many people refuse on principle and which does not work outside the US at all. The Best Answer Hub Bank Statement Analyzer reads the statement PDF you already download from your bank, so no credentials, no third-party access, and no country restrictions are involved.',
  },
  {
    q: 'Is it really free? I don\'t want a subscription just to find my subscriptions.',
    a: 'It is completely free — no signup, no trial, no page caps, and no premium tier. Paid subscription-finders charge for the result: some take a cut of "savings", others charge per scan or lock PDF import behind a paid plan. The Best Answer Hub Bank Statement Analyzer has no server costs to recover because everything runs on your device, so nothing needs to be charged.',
  },
  {
    q: 'How does it detect recurring charges and subscriptions?',
    a: 'Two ways. Across multiple statements, the Best Answer Hub Bank Statement Analyzer groups payments to the same merchant and checks the spacing — weekly, monthly, quarterly, or yearly intervals with three or more occurrences count as confirmed. Within a single statement, it flags known subscription services and descriptor wording like "RECURRING" or "MEMBERSHIP" as possible subscriptions. Every result carries an honest confidence label.',
  },
  {
    q: 'What if a transaction lands in the wrong category?',
    a: 'Change it on the spot. Every row in the results table has a category dropdown, and all totals, percentages, and charts recompute instantly when you change one. Miscategorization is the single most common complaint about budgeting apps, so the Best Answer Hub Bank Statement Analyzer treats your correction as the final word instead of hiding mistakes inside an algorithm.',
  },
  {
    q: 'Which spending categories does it use?',
    a: 'Twelve practical categories: Groceries, Dining and Delivery, Transport and Fuel, Subscriptions and Software, Telecom and Utilities, Shopping, Health and Pharmacy, Travel, Entertainment, Fees and Interest, Cash and Transfers, and Income and Refunds — anything unrecognized goes to Other rather than being guessed. Transfers and credit card payments are kept out of the spending total, which fixes the classic "my spending looks doubled" problem.',
  },
  {
    q: 'Can I analyze credit card statements and several months together?',
    a: 'Yes. The Best Answer Hub Bank Statement Analyzer reads both bank statements and credit card statements — where most subscriptions actually live — and accepts several files at once, merging them into one view with each transaction tagged by file. More months of history also makes recurring-charge detection stronger, since real intervals become visible across statements.',
  },
  {
    q: 'Does it work with banks outside the US, like UAE or UK banks?',
    a: 'Yes. Because it reads statements rather than connecting to banks, it is country-agnostic — statements in dirhams, pounds, or euros analyze exactly the same way, and bilingual Middle East statements such as HSBC UAE are supported. Bank-link subscription apps are typically US-only, which leaves most of the world without an automatic option; a statement-based analyzer has no such restriction.',
  },
  {
    q: 'Can it catch duplicate subscriptions or a price increase?',
    a: 'Yes on both. Duplicate services show up as separate recurring entries for the same merchant — a common surprise when an old autopay was never switched off. For price creep, the Best Answer Hub Bank Statement Analyzer follows a subscription through a price change and always shows the latest amount charged, so a quiet increase becomes visible instead of hiding inside an average.',
  },
  {
    q: 'How accurate is the categorization?',
    a: 'Recognition is rule-based against hundreds of known merchants across US, UK, and Middle East spending — Walmart to Tesco to Carrefour, DoorDash to Deliveroo to Talabat. Anything unrecognized is honestly labeled Other instead of being guessed into the wrong bucket, and every row can be corrected with the dropdown. Review the table before exporting, exactly as you would with any automatic tool.',
  },
  {
    q: 'Can I export the results?',
    a: 'Yes, two ways. Download the categorized transactions as a CSV that opens in Excel, Google Sheets, or accounting software. And download a renewal calendar (.ics) of detected recurring charges — import it into Google, Apple, or Outlook Calendar and each expected renewal appears as an event, so the next charge never surprises you again. Both files are generated locally in your browser.',
  },
  {
    q: 'Is it safe to upload my bank statement to ChatGPT to analyze my spending?',
    a: 'Uploading statements to AI chatbots sends your account numbers, balances, and complete merchant history to a third-party server with varying retention policies — security experts consistently advise against it. The safer route is analysis that never transmits the file: the Best Answer Hub Bank Statement Analyzer produces the same categorized breakdown while the statement stays on your device.',
  },
  {
    q: 'Does it work on scanned paper statements?',
    a: 'The analyzer reads text-based PDF statements (the kind your bank generates digitally) and CSV exports. For a scanned paper statement, run it through the Best Answer Hub <a href="/tools/bank-statement-to-excel/">Bank Statement to Excel converter</a> first — its built-in OCR extracts the transactions — then download the CSV and drop that into the analyzer. Digital PDFs from your bank give the most accurate results.',
  },
];

const steps = [
  { title: 'Drop your statements', description: 'Drag in bank or credit card statements — PDF or CSV, one month or several at once. Files stay on your device and are never uploaded anywhere.' },
  { title: 'Review spending & subscriptions', description: 'See spending categorized with charts, top merchants, and every recurring charge with its monthly and annual cost. Fix any category with a dropdown — totals recompute instantly.' },
  { title: 'Export or set reminders', description: 'Download the categorized transactions as CSV, or export a renewal calendar (.ics) so upcoming subscription charges appear in Google, Apple, or Outlook Calendar.' },
];

const seo = {
  title: 'Bank Statement Analyzer: Free Subscription Finder (2026)',
  description: 'Free bank statement analyzer. Drop PDF or CSV statements to see categorized spending and every recurring subscription. 100% in your browser, no upload.',
  url: '/tools/bank-statement-analyzer/',
  type: 'WebPage' as const,
  datePublished: today,
  dateModified: today,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Finance Toolkit', url: '/finance-toolkit/' },
    { name: 'Bank Statement Analyzer', url: '/tools/bank-statement-analyzer/' },
  ],
  faq: faqs.map(f => ({ question: f.q, answer: f.a.replace(/<[^>]*>/g, '').replace(/\s{2,}/g, ' ').trim() })),
};
---

<BaseLayout seo={seo}>
  <ToolHero
    badge="Free Tool · Nothing Uploaded"
    title="Bank Statement Analyzer:"
    accentText="Find forgotten subscriptions and see where money goes"
    description="Drop bank or credit card statements (PDF or CSV) and get categorized spending, top merchants, and every recurring charge with its true annual cost — all in your browser. No upload, no signup, no bank login."
    href={seo.url}
  />

  <!-- Analyzer Interface -->
  <section class="py-6 md:py-8" aria-label="Bank statement analyzer">
    <div class="container max-w-page mx-auto px-6">
      <div class="mb-5"><UpdatedBadge date={seo.dateModified} /></div>
      <div class="max-w-3xl mx-auto">
        <!-- Drop Zone -->
        <div id="drop-zone" class="border-2 border-dashed border-bae-border rounded-bae p-8 md:p-12 text-center bg-bae-card hover:border-bae-primary hover:bg-bae-primary-soft/30 transition-colors cursor-pointer mb-4">
          <div class="w-12 h-12 rounded-full bg-bae-primary-soft flex items-center justify-center text-bae-primary mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          </div>
          <p class="text-sm font-semibold text-bae-ink mb-1" id="drop-title">Drop bank or card statements here</p>
          <p class="text-xs text-bae-muted" id="drop-subtitle">PDF or CSV — several months at once works best (.pdf, .csv)</p>
          <input type="file" id="file-input" class="hidden" accept=".pdf,.csv,application/pdf,text/csv" multiple />
        </div>

        <!-- File Info -->
        <div id="file-info" class="hidden mb-4 text-center">
          <p class="text-sm text-bae-ink font-medium" id="info-name"></p>
          <p class="text-xs text-bae-muted" id="info-size"></p>
          <button type="button" id="reset-top" class="mt-2 text-xs font-semibold text-bae-primary hover:text-bae-accent transition-colors">↺ Reset — choose different files</button>
        </div>

        <!-- Settings -->
        <div id="settings-area" class="hidden mb-4 bg-bae-card border border-bae-border rounded-bae p-5">
          <button type="button" id="analyze-btn" class="w-full bg-bae-primary text-white text-sm font-semibold py-3 rounded-bae-sm hover:bg-bae-accent transition-colors">
            Analyze Statements
          </button>
          <p class="text-[11px] text-bae-muted mt-2 text-center">Everything runs locally — you can even go offline first.</p>
        </div>

        <!-- Progress -->
        <div id="progress-area" class="hidden mb-4">
          <div class="bg-bae-card border border-bae-border rounded-bae p-5 text-center">
            <div class="w-8 h-8 border-2 border-bae-primary border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
            <p class="text-sm font-medium text-bae-ink" id="progress-text">Reading statements...</p>
            <p class="text-xs text-bae-muted mt-2">Processing locally in your browser</p>
          </div>
        </div>

        <!-- Error -->
        <div id="error-area" class="hidden mb-4 bg-amber-50 border border-amber-200 rounded-bae p-4">
          <p class="text-sm font-semibold text-amber-800 mb-1">Could not analyze</p>
          <p class="text-xs text-amber-700" id="error-text"></p>
        </div>

        <!-- Results -->
        <div id="result-area" class="hidden">
          <!-- Summary strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4" id="summary-strip"></div>

          <!-- Subscriptions panel -->
          <div class="bg-bae-card border border-bae-border rounded-bae p-5 mb-4">
            <div class="flex items-center justify-between mb-1 flex-wrap gap-2">
              <h3 class="text-sm font-bold text-bae-ink">Recurring Charges &amp; Subscriptions</h3>
              <span class="text-[11px] font-bold px-2.5 py-1 rounded-full bg-bae-primary-soft text-bae-primary" id="sub-count"></span>
            </div>
            <p class="text-xs text-bae-muted mb-4" id="sub-burn"></p>
            <div id="sub-list" class="space-y-2"></div>
            <p id="sub-empty" class="hidden text-xs text-bae-muted">No recurring charges detected. Analyzing 2–3 consecutive months catches more — intervals become visible across statements.</p>
            <div class="mt-4">
              <button type="button" id="ics-btn" class="hidden text-xs font-semibold text-bae-primary hover:text-bae-accent transition-colors">📅 Download renewal calendar (.ics)</button>
            </div>
          </div>

          <!-- Categories -->
          <div class="bg-bae-card border border-bae-border rounded-bae p-5 mb-4">
            <h3 class="text-sm font-bold text-bae-ink mb-4">Spending by Category</h3>
            <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start">
              <div id="donut" class="w-36 h-36 rounded-full shrink-0 relative">
                <div class="absolute inset-4 rounded-full bg-bae-card flex items-center justify-center">
                  <span class="text-[10px] text-bae-muted text-center leading-tight" id="donut-label"></span>
                </div>
              </div>
              <div class="flex-1 w-full space-y-2" id="cat-bars"></div>
            </div>
            <p class="text-[11px] text-bae-muted mt-3">Transfers, card payments, and income are excluded from the spending total and shown in the summary instead. Amounts are in your statement's currency.</p>
          </div>

          <!-- Top merchants -->
          <div class="bg-bae-card border border-bae-border rounded-bae p-5 mb-4">
            <h3 class="text-sm font-bold text-bae-ink mb-3">Top Merchants</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-xs">
                <thead><tr class="text-left text-bae-muted border-b border-bae-border-light"><th class="py-2 pr-2 font-medium">Merchant</th><th class="py-2 pr-2 font-medium text-right">Visits</th><th class="py-2 font-medium text-right">Total</th></tr></thead>
                <tbody id="merchant-body"></tbody>
              </table>
            </div>
          </div>

          <!-- Transactions -->
          <div class="bg-bae-card border border-bae-border rounded-bae p-5 mb-4">
            <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
              <h3 class="text-sm font-bold text-bae-ink">All Transactions</h3>
              <span class="text-[11px] font-bold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-100" id="txn-count"></span>
            </div>
            <p class="text-[11px] text-bae-muted mb-3">Wrong category? Change it with the dropdown — every total and chart recomputes instantly.</p>
            <div class="overflow-x-auto border border-bae-border rounded-bae-sm max-h-96 overflow-y-auto">
              <table class="w-full text-xs" id="txn-table">
                <thead class="bg-bae-bg sticky top-0"><tr class="text-left text-bae-muted"><th class="px-2 py-2 font-medium">Date</th><th class="px-2 py-2 font-medium">Description</th><th class="px-2 py-2 font-medium">Category</th><th class="px-2 py-2 font-medium text-right">Amount</th></tr></thead>
                <tbody id="txn-body"></tbody>
              </table>
            </div>
            <div class="flex gap-3 mt-4">
              <button type="button" id="csv-btn" class="flex-1 bg-bae-primary text-white text-sm font-semibold py-3 rounded-bae-sm hover:bg-bae-accent transition-colors">Download categorized CSV</button>
              <button type="button" id="reset-btn" class="px-4 bg-bae-ink text-white text-sm font-semibold py-3 rounded-bae-sm hover:bg-bae-primary transition-colors">New files</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Limitations -->
  <section class="py-6 md:py-8 border-t border-bae-border-light">
    <div class="container max-w-page mx-auto px-6">
      <div class="max-w-3xl mx-auto bg-amber-50 border border-amber-200 rounded-bae p-4 md:p-5">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
          <div>
            <h3 class="text-sm font-semibold text-amber-800 mb-2">What to keep in mind</h3>
            <ul class="text-sm text-amber-700 space-y-1.5 list-disc list-inside">
              <li><strong>Review before acting:</strong> categorization is rule-based and honest about uncertainty — unknown merchants go to "Other" and single-statement subscription detection is marked "possible", not certain.</li>
              <li><strong>More months = better detection:</strong> recurring intervals only become provable across 2–3 statements; quarterly and annual charges need even longer windows.</li>
              <li><strong>Text PDFs or CSVs:</strong> scanned paper statements should go through the <a href="/tools/bank-statement-to-excel/" class="underline">Bank Statement to Excel converter</a> (OCR) first, then drop its CSV here.</li>
              <li><strong>Cancelling is on you:</strong> the analyzer finds and prices recurring charges; cancelling them happens with the merchant or your bank.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ToolHowItWorks steps={steps} />
  <ToolFAQ faqs={faqs} />
</BaseLayout>

<script>
  // ─────────────────────────────────────────────────────────────────────────
  // Bank Statement Analyzer, 100% client-side. PDF path: pdf.js text extraction
  // → line grouping → statement parser (the credit-card banded/section parser
  // shared with the CC converter, or the bank-layout column parser — whichever
  // reads more rows). CSV path: anParseCsv. Then the ANALYZER CORE categorizes,
  // detects recurring charges (Plaid-style: >=3 occurrences at a regular
  // interval = confirmed; known-merchant/hint scoring for single statements),
  // and the UI renders with zero chart libraries (conic-gradient + CSS bars).
  // Core blocks are plain JS and node-tested against this real file.
  // ─────────────────────────────────────────────────────────────────────────
  (function () {
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const fileInfo = document.getElementById('file-info');
    const infoName = document.getElementById('info-name');
    const infoSize = document.getElementById('info-size');
    const settingsArea = document.getElementById('settings-area');
    const analyzeBtn = document.getElementById('analyze-btn');
    const progressArea = document.getElementById('progress-area');
    const progressText = document.getElementById('progress-text');
    const errorArea = document.getElementById('error-area');
    const errorText = document.getElementById('error-text');
    const resultArea = document.getElementById('result-area');
    const summaryStrip = document.getElementById('summary-strip');
    const subCount = document.getElementById('sub-count');
    const subBurn = document.getElementById('sub-burn');
    const subList = document.getElementById('sub-list');
    const subEmpty = document.getElementById('sub-empty');
    const icsBtn = document.getElementById('ics-btn');
    const donut = document.getElementById('donut');
    const donutLabel = document.getElementById('donut-label');
    const catBars = document.getElementById('cat-bars');
    const merchantBody = document.getElementById('merchant-body');
    const txnBody = document.getElementById('txn-body');
    const txnCount = document.getElementById('txn-count');
    const csvBtn = document.getElementById('csv-btn');
    const resetBtn = document.getElementById('reset-btn');

    let pdfjsLib: any = null;
    let files: File[] = [];
    let txns: any[] = [];
    let overrides: any = {};
    let analysis: any = null;

    const PALETTE = ['#2563eb', '#16a34a', '#f59e0b', '#dc2626', '#7c3aed', '#0891b2', '#db2777', '#65a30d', '#ea580c', '#0d9488', '#a21caf', '#475569', '#94a3b8'];
    const ALL_CATS = ['Groceries', 'Dining & Delivery', 'Transport & Fuel', 'Subscriptions & Software', 'Telecom & Utilities', 'Shopping', 'Health & Pharmacy', 'Travel', 'Entertainment', 'Fees & Interest', 'Cash & Transfers', 'Income & Refunds', 'Other'];

    function escapeHtml(s: string): string {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function fmt(n: number): string {
      return (n < 0 ? '-' : '') + Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    function formatBytes(b: number): string {
      if (!b) return '0 B';
      const k = 1024, sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(b) / Math.log(k));
      return parseFloat((b / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }
    function showError(msg: string) {
      progressArea?.classList.add('hidden');
      if (errorText) errorText.textContent = msg;
      errorArea?.classList.remove('hidden');
    }
    function loadScript(src: string): Promise<void> {
      return new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = src;
        s.onload = () => resolve();
        s.onerror = () => reject(new Error('Failed to load ' + src));
        document.head.appendChild(s);
      });
    }
    async function loadPdf() {
      if (pdfjsLib) return;
      await loadScript('/pdf.min.js');
      pdfjsLib = (window as any).pdfjsLib;
      pdfjsLib.GlobalWorkerOptions.workerSrc = '/pdf.worker.min.js';
    }
    function groupLines(items: any[]): any[] {
      const toks = items
        .filter((it) => it && typeof it.str === 'string' && it.str.trim() !== '')
        .map((it) => ({ s: it.str.trim(), x: it.transform[4], y: it.transform[5] }));
      toks.sort((a, b) => b.y - a.y || a.x - b.x);
      const lines: any[] = [];
      let cur: any[] = [];
      let lastY: number | null = null;
      for (const t of toks) {
        if (lastY === null || Math.abs(t.y - lastY) <= 3) cur.push(t);
        else { if (cur.length) lines.push(cur); cur = [t]; }
        lastY = t.y;
      }
      if (cur.length) lines.push(cur);
      lines.forEach((l) => l.sort((a: any, b: any) => a.x - b.x));
      return lines;
    }

// ── CC PARSE CORE (shared with the Credit Card converter — node-tested there) ──
const CC_ARABIC_RE = /[؀-ۿݐ-ݿﭐ-﷿ﹰ-﻿]/;
const CC_MONEY_RE = /^[\(\-\+]?\s*(?:[A-Z]{3}\s+)?(?:[$£€]\s*\d{1,3}(?:,\d{3})*(?:\.\d{1,2})?|\d{1,3}(?:,\d{3})+(?:\.\d{1,2})?|\d+\.\d{1,2})\s*\)?(?:\s*(?:CR|DR))?$/i;
const CC_FOOTER_RE = /please review this account statement|report any discrepancies|regulated by|customer service|page \d+ of \d+|important information about/i;
const CC_MONTHS = { jan: 1, feb: 2, mar: 3, apr: 4, may: 5, jun: 6, jul: 7, aug: 8, sep: 9, oct: 10, nov: 11, dec: 12 };
const CC_SEC_RULES = [
  { re: /^(payments and other credits|payments,? credits( and adjustments)?|payments and credits|payments\/credits|payments? received|other credits)$/i, sec: 'payments' },
  { re: /^(purchases?( and adjustments)?|standard purchases|new charges|new transactions|transactions)$/i, sec: 'charges' },
  { re: /^(fees|fees charged)$/i, sec: 'fees' },
  { re: /^(interest charged)$/i, sec: 'interest' },
];
const CC_SEC_EXCLUDE_RE = /^(totals? year-to-date|interest charge calculation|rewards summary|membership rewards|cashback bonus|plan balance details|pay over time|qualifying promotional|special terms|deferred interest|account summary|payment information)/i;
const CC_SUMMARY_LABELS = [
  ['previousBalance', /^(previous balance|total outstanding \(previous statement\)|opening balance)\b/i],
  ['payments', /^(payments?,? (and other )?credits( and adjustments)?|payments?\/credits|payment, credits|payments and credits|\(-\) payment)\b/i],
  ['purchases', /^(purchases|new charges|\(\+\) new purchases)\b/i],
  ['cashAdvances', /^cash advances\b/i],
  ['balanceTransfers', /^balance transfers\b/i],
  ['fees', /^(fees( charged)?|\(\+\) fees)\b/i],
  ['interest', /^(interest charged|\(\+\) finance charges)\b/i],
  ['vat', /^\(\+\) vat\b/i],
  ['newBalance', /^(new balance|total outstanding \(current statement\)|total outstanding on statement date)\b/i],
];
const CC_CLOSING_RES = [
  { re: /opening\/closing date\s+\d{1,2}\/\d{1,2}\/\d{2,4}\s*[-–]\s*(\d{1,2})\/\d{1,2}\/(\d{2,4})/i, kind: 'mdy' },
  { re: /billing period:?\s*\d{1,2}\/\d{1,2}\/\d{2,4}\s*[-–]\s*(\d{1,2})\/\d{1,2}\/(\d{2,4})/i, kind: 'mdy' },
  { re: /(?<!\/)(?:statement )?closing date:?\s+(\d{1,2})\/\d{1,2}\/(\d{2,4})/i, kind: 'mdy' },
  { re: /statement date:?\s+\d{1,2}\s+([A-Za-z]{3,9})\.?\s+(\d{4})/i, kind: 'dmy-name' },
