  ['VAT ON FEE', 'Fees & Interest'], ['CARD FEE', 'Fees & Interest'], [' FEE', 'Fees & Interest'],
  // — cash & transfers —
  ['ATM', 'Cash & Transfers'], ['CASH WITHDRAWAL', 'Cash & Transfers'], ['CASH WD', 'Cash & Transfers'],
  ['TRANSFER', 'Cash & Transfers'], ['WESTERN UNION', 'Cash & Transfers'], ['MONEYGRAM', 'Cash & Transfers'],
  ['AL ANSARI', 'Cash & Transfers'], ['LULU EXCHANGE', 'Cash & Transfers'], ['AL FARDAN', 'Cash & Transfers'],
  ['TRANSFERWISE', 'Cash & Transfers'], ['WISE.COM', 'Cash & Transfers'], ['ZELLE', 'Cash & Transfers'],
  ['VENMO', 'Cash & Transfers'], ['CASH APP', 'Cash & Transfers'], ['REVOLUT', 'Cash & Transfers'],
  ['STANDING ORDER', 'Cash & Transfers'], ['DIRECT DEBIT', 'Cash & Transfers'], ['CHEQUE', 'Cash & Transfers'],
  // — shopping (broad — late so specifics win first) —
  ['AMAZON', 'Shopping'], ['AMZN', 'Shopping'], ['EBAY', 'Shopping'], ['ETSY', 'Shopping'],
  ['NOON', 'Shopping'], ['NAMSHI', 'Shopping'], ['SHEIN', 'Shopping'], ['TEMU', 'Shopping'],
  ['ALIEXPRESS', 'Shopping'], ['ZARA', 'Shopping'], ['H&M', 'Shopping'], ['UNIQLO', 'Shopping'],
  ['NIKE', 'Shopping'], ['ADIDAS', 'Shopping'], ['IKEA', 'Shopping'], ['HOME DEPOT', 'Shopping'],
  ['LOWES', 'Shopping'], ['BEST BUY', 'Shopping'], ['SHARAF DG', 'Shopping'], ['JUMBO ELECTRONICS', 'Shopping'],
  ['EMAX', 'Shopping'], ['ACE HARDWARE', 'Shopping'], ['ARGOS', 'Shopping'], ['JOHN LEWIS', 'Shopping'],
  ['PRIMARK', 'Shopping'], ['CENTREPOINT', 'Shopping'], ['MAX FASHION', 'Shopping'], ['MAX ', 'Shopping'],
  ['BRANDS FOR LESS', 'Shopping'], ['APPLE STORE', 'Shopping'], ['TARGET', 'Shopping'], ['DAY TO DAY', 'Shopping'],
  ['AL KABAYEL', 'Shopping'],
  // — income & refunds —
  ['SALARY', 'Income & Refunds'], ['PAYROLL', 'Income & Refunds'], ['WAGES', 'Income & Refunds'],
  ['WPS', 'Income & Refunds'], ['DIRECT DEPOSIT', 'Income & Refunds'], ['REFUND', 'Income & Refunds'],
  ['REVERSAL', 'Income & Refunds'], ['CASHBACK', 'Income & Refunds'], ['DIVIDEND', 'Income & Refunds'],
