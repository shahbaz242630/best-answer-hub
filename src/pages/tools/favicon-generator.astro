  <!-- Related Tools CTA -->
  <section class="py-10 md:py-14 border-t border-bae-border">
    <div class="container max-w-page mx-auto px-6">
      <div class="bg-bae-primary-soft border border-bae-primary/15 rounded-bae p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <h3 class="font-serif text-xl font-bold text-bae-ink mb-1">Explore more design & web tools</h3>
          <p class="text-sm text-bae-muted">Also try <a href="/tools/screenshot-beautifier/" class="text-bae-primary hover:underline">Screenshot Beautifier</a>, <a href="/tools/color-palette-generator/" class="text-bae-primary hover:underline">Color Palette Generator</a>, <a href="/tools/image-compressor/" class="text-bae-primary hover:underline">Image Compressor</a>, <a href="/tools/qr-code-generator/" class="text-bae-primary hover:underline">QR Code Generator</a>, <a href="/tools/meta-tag-generator/" class="text-bae-primary hover:underline">Meta Tag Generator</a>, and <a href="/tools/seo-score-checker/" class="text-bae-primary hover:underline">SEO Score Checker</a>.</p>
        </div>
        <a href="/tools/" class="inline-flex items-center gap-2 bg-bae-ink text-white px-5 py-2.5 rounded-bae-sm font-semibold text-sm no-underline hover:bg-bae-primary transition-colors shrink-0">
          Browse all tools →
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      // --- State ---
      let mode = 'image'; // image | text | emoji
      let imageSource = null; // Image object
      let imageFileName = 'favicon';
      let zoom = 100;
      let position = 'mc';
      let textSettings = { text: 'A', font: 'Arial, sans-serif', bg: '#6366f1', color: '#ffffff', shape: 'square' };
      let emojiSettings = { emoji: '🔥', bg: '#ffffff', transparent: false };
      const sizes = [16, 32, 48, 64, 128, 192, 256, 512];
      const previewSizes = [16, 32, 180];

      // --- Elements ---
      const tabs = {
        image: document.getElementById('fg-tab-image'),
        text: document.getElementById('fg-tab-text'),
        emoji: document.getElementById('fg-tab-emoji'),
      };
      const panels = {
        image: document.getElementById('fg-panel-image'),
        text: document.getElementById('fg-panel-text'),
        emoji: document.getElementById('fg-panel-emoji'),
      };
      const canvases = {};
      previewSizes.forEach(s => canvases[s] = document.getElementById('fg-prev-' + s));
      canvases.tabLight = document.getElementById('fg-tab-light');
      canvases.tabDark = document.getElementById('fg-tab-dark');

      // --- Utilities ---
      function escapeHtml(str) {
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function setTab(newMode) {
        mode = newMode;
        Object.keys(tabs).forEach(k => {
          const active = k === newMode;
          tabs[k].classList.toggle('bg-bae-primary', active);
          tabs[k].classList.toggle('text-white', active);
          tabs[k].classList.toggle('border-bae-primary', active);
          tabs[k].classList.toggle('bg-bae-bg', !active);
          tabs[k].classList.toggle('text-bae-ink', !active);
          tabs[k].classList.toggle('border-bae-border', !active);
          panels[k].classList.toggle('hidden', !active);
        });
        renderAll();
      }

      Object.keys(tabs).forEach(k => {
        tabs[k].addEventListener('click', () => setTab(k));
      });

      // Image mode handlers
      document.getElementById('fg-image-file').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        if (file.size > 20 * 1024 * 1024) {
          alert('Image must be under 20 MB');
          e.target.value = '';
          return;
        }
        imageFileName = file.name.replace(/\.[^/.]+$/, '') || 'favicon';
        const reader = new FileReader();
        reader.onload = function(ev) {
          const img = new Image();
          img.onload = function() {
            imageSource = img;
            renderAll();
          };
          img.onerror = function() {
            alert('Failed to load image. Please try a different file.');
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(file);
      });

      document.getElementById('fg-image-clear').addEventListener('click', function() {
        document.getElementById('fg-image-file').value = '';
        imageSource = null;
        renderAll();
      });

      document.getElementById('fg-zoom').addEventListener('input', function(e) {
        zoom = parseInt(e.target.value, 10);
        document.getElementById('fg-zoom-val').textContent = zoom;
        renderAll();
      });

      document.querySelectorAll('.fg-pos-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          position = this.dataset.pos;
          document.querySelectorAll('.fg-pos-btn').forEach(b => {
            b.classList.remove('border-bae-primary', 'bg-bae-primary-soft');
            b.classList.add('border-bae-border', 'bg-bae-bg');
          });
          this.classList.remove('border-bae-border', 'bg-bae-bg');
          this.classList.add('border-bae-primary', 'bg-bae-primary-soft');
          renderAll();
        });
      });

      // Text mode handlers
      document.getElementById('fg-text-input').addEventListener('input', function(e) {
        textSettings.text = e.target.value;
        renderAll();
      });
      document.getElementById('fg-text-font').addEventListener('change', function(e) {
        textSettings.font = e.target.value;
        renderAll();
      });
      document.getElementById('fg-text-bg').addEventListener('input', function(e) {
        textSettings.bg = e.target.value;
        document.getElementById('fg-text-bg-hex').value = e.target.value;
        renderAll();
      });
      document.getElementById('fg-text-bg-hex').addEventListener('input', function(e) {
        if (/^#[0-9A-Fa-f]{6}$/.test(e.target.value)) {
          textSettings.bg = e.target.value;
          document.getElementById('fg-text-bg').value = e.target.value;
          renderAll();
        }
      });
      document.getElementById('fg-text-color').addEventListener('input', function(e) {
        textSettings.color = e.target.value;
        document.getElementById('fg-text-color-hex').value = e.target.value;
        renderAll();
      });
      document.getElementById('fg-text-color-hex').addEventListener('input', function(e) {
        if (/^#[0-9A-Fa-f]{6}$/.test(e.target.value)) {
          textSettings.color = e.target.value;
          document.getElementById('fg-text-color').value = e.target.value;
          renderAll();
        }
      });
      document.querySelectorAll('.fg-shape-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          textSettings.shape = this.dataset.shape;
          document.querySelectorAll('.fg-shape-btn').forEach(b => {
            b.classList.remove('bg-bae-primary', 'text-white', 'border-bae-primary');
            b.classList.add('bg-bae-bg', 'text-bae-ink', 'border-bae-border');
          });
          this.classList.remove('bg-bae-bg', 'text-bae-ink', 'border-bae-border');
          this.classList.add('bg-bae-primary', 'text-white', 'border-bae-primary');
          renderAll();
        });
      });

      // Emoji mode handlers
      document.getElementById('fg-emoji-input').addEventListener('input', function(e) {
        emojiSettings.emoji = e.target.value;
        renderAll();
      });
      document.querySelectorAll('.fg-emoji-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          emojiSettings.emoji = this.textContent;
          document.getElementById('fg-emoji-input').value = this.textContent;
          renderAll();
        });
      });
      document.getElementById('fg-emoji-bg').addEventListener('input', function(e) {
        emojiSettings.bg = e.target.value;
        document.getElementById('fg-emoji-bg-hex').value = e.target.value;
        emojiSettings.transparent = false;
        document.getElementById('fg-emoji-transparent').checked = false;
        renderAll();
      });
      document.getElementById('fg-emoji-bg-hex').addEventListener('input', function(e) {
        if (/^#[0-9A-Fa-f]{6}$/.test(e.target.value)) {
          emojiSettings.bg = e.target.value;
          document.getElementById('fg-emoji-bg').value = e.target.value;
          emojiSettings.transparent = false;
          document.getElementById('fg-emoji-transparent').checked = false;
          renderAll();
        }
      });
      document.getElementById('fg-emoji-transparent').addEventListener('change', function(e) {
        emojiSettings.transparent = e.target.checked;
        renderAll();
      });

      // --- Rendering ---
      function drawToCanvas(canvas, size) {
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, size, size);

        if (mode === 'image' && imageSource) {
          drawImageMode(ctx, size);
        } else if (mode === 'text') {
          drawTextMode(ctx, size);
        } else if (mode === 'emoji') {
          drawEmojiMode(ctx, size);
        } else {
          // Empty state
          ctx.fillStyle = '#f3f4f6';
          ctx.fillRect(0, 0, size, size);
          ctx.fillStyle = '#9ca3af';
          ctx.font = (size * 0.4) + 'px Arial';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText('?', size / 2, size / 2);
        }
      }

      function drawImageMode(ctx, size) {
        const img = imageSource;
        const s = zoom / 100;
        const imgAspect = img.width / img.height;
        const canvasAspect = 1;

        let srcW, srcH, srcX, srcY;
        if (imgAspect > canvasAspect) {
          srcH = img.height;
          srcW = img.height * canvasAspect;
        } else {
          srcW = img.width;
          srcH = img.width / canvasAspect;
        }

        // Apply zoom
        const cx = img.width / 2;
        const cy = img.height / 2;
        srcW = srcW / s;
        srcH = srcH / s;

        // Position
        const posMap = { tl: [-0.5, -0.5], tc: [0, -0.5], tr: [0.5, -0.5], ml: [-0.5, 0], mc: [0, 0], mr: [0.5, 0], bl: [-0.5, 0.5], bc: [0, 0.5], br: [0.5, 0.5] };
        const [px, py] = posMap[position] || [0, 0];
        const maxOffsetX = Math.max(0, (img.width - srcW) / 2);
        const maxOffsetY = Math.max(0, (img.height - srcH) / 2);
        srcX = cx + px * maxOffsetX * 2 - srcW / 2;
        srcY = cy + py * maxOffsetY * 2 - srcH / 2;

        // Clamp
        srcX = Math.max(0, Math.min(srcX, img.width - srcW));
        srcY = Math.max(0, Math.min(srcY, img.height - srcH));
        srcW = Math.min(srcW, img.width - srcX);
        srcH = Math.min(srcH, img.height - srcY);

        ctx.drawImage(img, srcX, srcY, srcW, srcH, 0, 0, size, size);
      }

      function drawTextMode(ctx, size) {
        const { text, font, bg, color, shape } = textSettings;
        const dpr = typeof window !== 'undefined' ? window.devicePixelRatio || 1 : 1;

        ctx.save();
        if (shape === 'circle') {
          ctx.beginPath();
          ctx.arc(size / 2, size / 2, size / 2, 0, Math.PI * 2);
          ctx.closePath();
          ctx.clip();
        } else if (shape === 'rounded') {
          const r = size * 0.2;
          ctx.beginPath();
          ctx.moveTo(r, 0);
          ctx.lineTo(size - r, 0);
          ctx.quadraticCurveTo(size, 0, size, r);
          ctx.lineTo(size, size - r);
          ctx.quadraticCurveTo(size, size, size - r, size);
          ctx.lineTo(r, size);
          ctx.quadraticCurveTo(0, size, 0, size - r);
          ctx.lineTo(0, r);
          ctx.quadraticCurveTo(0, 0, r, 0);
          ctx.closePath();
          ctx.clip();
        }

        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, size, size);
        ctx.restore();

        if (!text) return;
        const fontSize = size * (text.length > 1 ? 0.45 : 0.6);
        ctx.font = 'bold ' + fontSize + 'px ' + font;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = color;
        ctx.fillText(text, size / 2, size / 2 + size * 0.02);
      }

      function drawEmojiMode(ctx, size) {
        const { emoji, bg, transparent } = emojiSettings;
        if (!transparent) {
          ctx.fillStyle = bg;
          ctx.fillRect(0, 0, size, size);
        }
        if (!emoji) return;
        const fontSize = size * 0.65;
        ctx.font = fontSize + 'px "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(emoji, size / 2, size / 2 + size * 0.02);
      }

      function renderAll() {
        previewSizes.forEach(s => drawToCanvas(canvases[s], s));
        drawToCanvas(canvases.tabLight, 32);
        drawToCanvas(canvases.tabDark, 32);
        updateSnippet();
      }

      function updateSnippet() {
        const name = escapeHtml(imageFileName);
        const lines = [];
        lines.push('<!-- Primary favicon -->');
        lines.push('<link rel="icon" type="image/svg+xml" href="/' + name + '.svg">');
        lines.push('<link rel="icon" type="image/png" sizes="32x32" href="/' + name + '-32x32.png">');
        lines.push('<link rel="icon" type="image/png" sizes="16x16" href="/' + name + '-16x16.png">');
        lines.push('<link rel="shortcut icon" href="/' + name + '.ico">');
        lines.push('');
        lines.push('<!-- Apple Touch Icon -->');
        lines.push('<link rel="apple-touch-icon" sizes="180x180" href="/' + name + '-180x180.png">');
        lines.push('');
        lines.push('<!-- Android / PWA -->');
        lines.push('<link rel="icon" type="image/png" sizes="192x192" href="/' + name + '-192x192.png">');
        lines.push('<link rel="icon" type="image/png" sizes="512x512" href="/' + name + '-512x512.png">');
        document.getElementById('fg-html-snippet').textContent = lines.join('\n');
      }

      // --- ICO Assembler ---
      async function canvasToPngBlob(canvas) {
        return new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
      }

      async function buildIcoBlob() {
        const pngBlobs = [];
        const pngSizes = [];
        for (const s of [16, 32, 48]) {
          const c = document.createElement('canvas');
          c.width = s; c.height = s;
          drawToCanvas(c, s);
          const blob = await canvasToPngBlob(c);
          pngBlobs.push(blob);
          pngSizes.push(s);
        }
        const count = pngBlobs.length;
        const headerSize = 6 + count * 16;
        const parts = [];

        const dir = new DataView(new ArrayBuffer(6));
        dir.setUint16(0, 0, true);
        dir.setUint16(2, 1, true);
        dir.setUint16(4, count, true);
        parts.push(new Uint8Array(dir.buffer));

        let offset = headerSize;
        const entries = [];
        for (let i = 0; i < count; i++) {
          const size = pngBlobs[i].size;
          const w = pngSizes[i];
          const entry = new DataView(new ArrayBuffer(16));
          entry.setUint8(0, w > 255 ? 0 : w);
          entry.setUint8(1, w > 255 ? 0 : w);
          entry.setUint8(2, 0);
          entry.setUint8(3, 0);
          entry.setUint16(4, 1, true);
          entry.setUint16(6, 32, true);
          entry.setUint32(8, size, true);
          entry.setUint32(12, offset, true);
          entries.push(new Uint8Array(entry.buffer));
          offset += size;
        }
        parts.push(...entries);

        for (let i = 0; i < count; i++) {
          const buf = await pngBlobs[i].arrayBuffer();
          parts.push(new Uint8Array(buf));
        }

        const totalLen = parts.reduce((a, b) => a + b.length, 0);
        const out = new Uint8Array(totalLen);
        let pos = 0;
        for (const p of parts) {
          out.set(p, pos);
          pos += p.length;
        }
        return new Blob([out], { type: 'image/x-icon' });
      }

      // --- Download handlers ---
      function downloadBlob(blob, filename) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      document.getElementById('fg-dl-ico').addEventListener('click', async function() {
        const blob = await buildIcoBlob();
        downloadBlob(blob, imageFileName + '.ico');
      });

      document.getElementById('fg-dl-png').addEventListener('click', async function() {
        let JSZip = window.JSZip;
        if (!JSZip) {
          await new Promise((resolve, reject) => {
            const s = document.createElement('script');
            s.src = '/jszip.min.js';
            s.onload = () => { JSZip = window.JSZip; resolve(); };
            s.onerror = reject;
            document.head.appendChild(s);
          });
        }
        const zip = new JSZip();
        for (const s of sizes) {
          const c = document.createElement('canvas');
          c.width = s; c.height = s;
          drawToCanvas(c, s);
          const blob = await canvasToPngBlob(c);
          zip.file(imageFileName + '-' + s + 'x' + s + '.png', blob);
        }
        const zipBlob = await zip.generateAsync({ type: 'blob' });
        downloadBlob(zipBlob, imageFileName + '-favicons.zip');
      });

      document.getElementById('fg-dl-svg').addEventListener('click', function() {
        let svg = '';
        if (mode === 'text') {
          const { text, font, bg, color, shape } = textSettings;
          const bgAttr = shape === 'circle' ? '' : 'fill="' + bg + '"';
          let shapeEl = '';
          if (shape === 'circle') {
            shapeEl = '<circle cx="16" cy="16" r="16" fill="' + bg + '"/>';
          } else if (shape === 'rounded') {
            shapeEl = '<rect width="32" height="32" rx="6" fill="' + bg + '"/>';
          } else {
            shapeEl = '<rect width="32" height="32" fill="' + bg + '"/>';
          }
          svg = '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">' + shapeEl + '<text x="16" y="18" font-family="' + font.replace(/"/g, "'") + '" font-size="' + (text.length > 1 ? '14' : '18') + '" font-weight="bold" fill="' + color + '" text-anchor="middle">' + escapeHtml(text) + '</text></svg>';
        } else if (mode === 'emoji') {
          const { emoji, bg, transparent } = emojiSettings;
          const bgEl = transparent ? '' : '<rect width="32" height="32" fill="' + bg + '"/>';
          svg = '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">' + bgEl + '<text x="16" y="18" font-family="Apple Color Emoji, Segoe UI Emoji, Noto Color Emoji" font-size="20" text-anchor="middle">' + escapeHtml(emoji) + '</text></svg>';
        } else {
          alert('SVG download is available for Text and Emoji modes. For images, use the PNG ZIP download.');
          return;
        }
        const blob = new Blob([svg], { type: 'image/svg+xml;charset=utf-8' });
        downloadBlob(blob, imageFileName + '.svg');
      });

      document.getElementById('fg-copy-html').addEventListener('click', function() {
        const text = document.getElementById('fg-html-snippet').textContent;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).catch(() => {});
        } else {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
      });

      // Initial render
      renderAll();
    })();
  </script>
</BaseLayout>
