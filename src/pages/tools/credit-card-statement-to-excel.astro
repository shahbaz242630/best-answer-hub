---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UpdatedBadge from '../../components/content/UpdatedBadge.astro';
import ToolHero from '../../components/tools/ToolHero.astro';
import ToolHowItWorks from '../../components/tools/ToolHowItWorks.astro';
import ToolFAQ from '../../components/tools/ToolFAQ.astro';

const today = '2026-07-12T00:00:00+00:00';

const faqs = [
  {
    q: 'What is the Best Answer Hub Credit Card Statement to Excel converter?',
    a: 'The Best Answer Hub Credit Card Statement to Excel converter is a free browser-based tool that turns credit card statement PDFs into clean Excel or CSV files. It reads the transaction sections, separates dates, descriptions, charges, and payments, reconciles everything against the statement totals, and runs entirely on your device with no file ever uploaded. Updated July 2026.',
  },
  {
    q: 'Does this tool upload my credit card statement to a server?',
    a: 'No. Every step runs locally in your browser, so the PDF never leaves your device, is never stored, and is never seen by anyone else. You can confirm this yourself: open your browser\'s Network tab while converting and no file data is sent, and the converter keeps working after you disconnect from the internet. That makes it suitable for the most sensitive financial documents.',
  },
  {
    q: 'How do I convert a credit card statement PDF to Excel?',
    a: 'Drag one or more PDF statements into the upload area or click to browse. The Best Answer Hub Credit Card Statement to Excel converter reads each page, rebuilds the transaction list, labels each row as a purchase, payment, fee, or interest, and reconciles the rows against the statement summary. Choose Excel or CSV, review the editable preview, then download.',
  },
  {
    q: 'Is it really free, or are there credits, page limits, or a signup?',
    a: 'It is completely free with no signup, no subscription, no per-page credits, and no watermarks. Many converters charge monthly plans or page credits and lock downloads behind an account. The Best Answer Hub Credit Card Statement to Excel converter has none of that, because all processing happens on your own device with no server cost to recover. There is no premium tier.',
  },
  {
    q: 'My card issuer only lets me export 90 days of transactions. How do I get older ones into Excel?',
    a: 'Convert the archived PDF statements instead. Most issuers cap CSV downloads to a rolling window — Chase and Capital One around 90 days, American Express to recent activity plus the past six billing statements — while keeping up to seven years of monthly PDFs online. Download those PDFs and the Best Answer Hub Credit Card Statement to Excel converter rebuilds the full history without retyping.',
  },
  {
    q: 'Can I combine several months of statements into one spreadsheet?',
    a: 'Yes. The Best Answer Hub Credit Card Statement to Excel converter accepts multiple PDF statements at once and merges them into a single spreadsheet, with each row tagged by statement so you can still tell months apart. This is the fastest way to backfill a year of card history for taxes, budgeting, or bookkeeping instead of converting and stitching files one by one.',
  },
  {
    q: 'How do I know the converted numbers are correct?',
    a: 'Every statement is reconciled two ways. The Best Answer Hub Credit Card Statement to Excel converter first checks the statement\'s own summary — previous balance minus payments plus purchases, fees, and interest must equal the new balance — then verifies the extracted rows add up to those printed totals. If anything does not reconcile, a clear warning appears so nothing is silently wrong.',
  },
  {
    q: 'Which credit card issuers does it support?',
    a: 'It is format-aware rather than issuer-specific, so it reads statements from most major issuers — Chase, American Express, Citi, Capital One, Discover, Bank of America, UK cards that mark credits with a CR suffix, and bilingual Middle East statements such as HSBC UAE with VAT columns and Arabic text. Unusual store-card formats may need a quick review in the preview.',
  },
  {
    q: 'How does it handle payments, refunds, fees, and interest charges?',
    a: 'Each row gets a type label. The Best Answer Hub Credit Card Statement to Excel converter reads the statement\'s own sections — payments and credits, purchases, fees, interest — so payments and refunds land in a credits column and charges stay separate, with signs preserved. That means totals, pivot tables, and expense reports work immediately without manually re-sorting mixed-sign rows.',
  },
  {
    q: 'Why does copying and pasting a statement into Excel break the formatting?',
    a: 'PDF statements are laid out for printing, so pasted text loses its columns, wraps descriptions across lines, and mixes dates with amounts. The Best Answer Hub Credit Card Statement to Excel converter avoids that by reading the PDF\'s text positions directly: wrapped descriptions are folded back into one row and transaction and posting dates are kept as proper columns.',
  },
  {
    q: 'Does it work with Amex statements that have multiple employee or family cards?',
    a: 'Yes. American Express lists charges in a separate subsection per card member, which trips up basic converters and makes reconciling painful. The Best Answer Hub Credit Card Statement to Excel converter parses through each card member\'s subsection and keeps every transaction in one continuous table, so a business statement with several employee cards converts in one pass.',
  },
  {
    q: 'Is it safe to upload a credit card statement to ChatGPT or an AI tool?',
    a: 'Pasting or uploading card statements into AI chatbots sends your account details, merchant history, and balances to a third-party server, where retention policies vary. A safer workflow is converting the statement locally first: the Best Answer Hub Credit Card Statement to Excel converter runs entirely in your browser, so you get a clean spreadsheet without any part of the statement leaving your device.',
  },
  {
    q: 'Can I import the CSV into QuickBooks or other accounting software?',
    a: 'Yes. The CSV download uses clean Date, Description, and amount columns, which matches the three-column and four-column layouts QuickBooks Online accepts for imports, and works with Xero, Wave, and spreadsheets. Bookkeepers backfilling client card history beyond the bank-feed window can convert each archived PDF statement and import the CSVs month by month.',
  },
  {
    q: 'Does it work on scanned or photographed statements?',
    a: 'It works best on text-based PDFs, the kind an issuer generates digitally — and every major issuer produces those. Scanned paper statements have no text layer, so the converter detects them and offers optional in-browser text recognition (OCR), which is slower and best-effort. For accuracy, download the original digital PDF from your card issuer instead of scanning paper copies.',
  },
  {
    q: 'What if my statement PDF is password-protected?',
    a: 'Some issuers, including certain American Express downloads, protect statement PDFs with a password. Browsers cannot hand a locked file to the converter, so remove the password first: open the PDF in your viewer with the password, print or save it as a new unlocked PDF, then convert that copy. The Best Answer Hub Credit Card Statement to Excel converter will flag locked files with a clear message.',
  },
];

const steps = [
  { title: 'Drop your PDF statements', description: 'Drag one or more credit card statement PDFs into the upload area. Files stay on your device and are never uploaded. The tool shows the file count, pages, and size after loading.' },
  { title: 'Review the reconciled table', description: 'The converter rebuilds every transaction with a type label and reconciles rows against each statement\'s printed totals. Anything that does not add up is called out before you export.' },
  { title: 'Download Excel or CSV', description: 'Choose Excel (.xlsx) or CSV and download instantly. Multiple statements merge into one clean spreadsheet with date, description, type, charge, and payment columns.' },
];

const seo = {
  title: 'Credit Card Statement to Excel: Free PDF to XLSX/CSV (2026)',
  description: 'Convert credit card statement PDFs to Excel or CSV free, in your browser — Chase, Amex, Citi and more. Reconciles to statement totals. No upload, no signup.',
  url: '/tools/credit-card-statement-to-excel/',
  type: 'WebPage' as const,
  datePublished: today,
  dateModified: today,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Finance Toolkit', url: '/finance-toolkit/' },
    { name: 'Credit Card Statement to Excel', url: '/tools/credit-card-statement-to-excel/' },
  ],
  faq: faqs.map(f => ({ question: f.q, answer: f.a.replace(/<[^>]*>/g, '').replace(/\s{2,}/g, ' ').trim() })),
};
---

<BaseLayout seo={seo}>
  <ToolHero
    badge="Free Tool · Nothing Uploaded"
    title="Credit Card Statement to Excel:"
    accentText="Turn card statement PDFs into clean spreadsheets"
    description="Convert credit card statement PDFs into clean Excel or CSV in your browser. Reads purchases, payments, fees, and interest, reconciles against statement totals, and never uploads your file. No signup, no credits, no page limits."
    href={seo.url}
  />

  <!-- Converter Interface -->
  <section class="py-6 md:py-8" aria-label="Credit card statement to Excel converter">
    <div class="container max-w-page mx-auto px-6">
      <div class="mb-5"><UpdatedBadge date={seo.dateModified} /></div>
      <div class="max-w-2xl mx-auto">
        <!-- Drop Zone -->
        <div id="drop-zone" class="border-2 border-dashed border-bae-border rounded-bae p-8 md:p-12 text-center bg-bae-card hover:border-bae-primary hover:bg-bae-primary-soft/30 transition-colors cursor-pointer mb-4">
          <div class="w-12 h-12 rounded-full bg-bae-primary-soft flex items-center justify-center text-bae-primary mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <p class="text-sm font-semibold text-bae-ink mb-1" id="drop-title">Drop your PDF card statements here</p>
          <p class="text-xs text-bae-muted" id="drop-subtitle">or click to browse — several statements at once is fine (.pdf only)</p>
          <input type="file" id="file-input" class="hidden" accept=".pdf,application/pdf" multiple />
        </div>

        <!-- File Info -->
        <div id="file-info" class="hidden mb-4 text-center">
          <p class="text-sm text-bae-ink font-medium" id="info-name"></p>
          <p class="text-xs text-bae-muted"><span id="info-pages"></span> · <span id="info-size"></span></p>
          <button type="button" id="reset-top" class="mt-2 text-xs font-semibold text-bae-primary hover:text-bae-accent transition-colors">↺ Reset — choose different files</button>
        </div>

        <!-- Scanned notice -->
        <div id="scanned-notice" class="hidden mb-4 bg-amber-50 border border-amber-200 rounded-bae p-3 flex items-start gap-2">
          <svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
          <div class="text-xs text-amber-700">
            <p class="font-semibold mb-1">This looks like a scanned statement</p>
            <p class="mb-2">Text-based PDFs from your card issuer give the most accurate results. You can try in-browser text recognition (OCR), which is slower and best-effort, so review the output carefully.</p>
            <button type="button" id="ocr-btn" class="bg-amber-600 text-white text-xs font-semibold px-3 py-1.5 rounded-bae-sm hover:bg-amber-700 transition-colors">Try OCR (best-effort)</button>
          </div>
        </div>

        <!-- Settings -->
        <div id="settings-area" class="hidden mb-4 bg-bae-card border border-bae-border rounded-bae p-5">
          <h3 class="text-sm font-bold text-bae-ink mb-4">Export Settings</h3>
          <div class="mb-4">
            <label class="block text-xs font-medium text-bae-muted mb-2">Output Format</label>
            <div class="inline-flex bg-bae-bg border border-bae-border rounded-bae-sm overflow-hidden w-full sm:w-auto">
              <button type="button" id="format-xlsx" class="format-btn flex-1 sm:flex-none px-4 py-2 text-xs font-medium bg-bae-primary text-white transition-colors">Excel (.xlsx)</button>
              <button type="button" id="format-csv" class="format-btn flex-1 sm:flex-none px-4 py-2 text-xs font-medium text-bae-muted hover:text-bae-ink transition-colors">CSV</button>
            </div>
          </div>
          <button type="button" id="convert-btn" class="w-full bg-bae-primary text-white text-sm font-semibold py-3 rounded-bae-sm hover:bg-bae-accent transition-colors">
            Convert Statements
          </button>
        </div>

        <!-- Progress -->
        <div id="progress-area" class="hidden mb-4">
          <div class="bg-bae-card border border-bae-border rounded-bae p-5 text-center">
            <div class="w-8 h-8 border-2 border-bae-primary border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
            <p class="text-sm font-medium text-bae-ink" id="progress-text">Reading statement...</p>
            <p class="text-xs text-bae-muted mt-2">Processing locally in your browser</p>
          </div>
        </div>

        <!-- Result -->
        <div id="result-area" class="hidden mb-4">
          <div class="bg-bae-card border border-bae-border rounded-bae p-5">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-sm font-bold text-bae-ink">Detected Transactions</h3>
              <span class="text-[11px] font-bold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-100" id="result-count">0 rows</span>
            </div>

            <!-- Reconciliation banner -->
            <div id="recon-banner" class="mb-4 rounded-bae-sm p-3 text-xs"></div>

            <!-- Editable preview -->
            <div class="overflow-x-auto border border-bae-border rounded-bae-sm mb-4 max-h-96 overflow-y-auto">
              <table class="w-full text-xs" id="preview-table">
                <thead class="bg-bae-bg sticky top-0">
                  <tr class="text-left text-bae-muted">
                    <th class="px-2 py-2 font-medium">Date</th>
                    <th class="px-2 py-2 font-medium">Description</th>
                    <th class="px-2 py-2 font-medium">Type</th>
                    <th class="px-2 py-2 font-medium text-right">Charge</th>
                    <th class="px-2 py-2 font-medium text-right">Payment / Credit</th>
                  </tr>
                </thead>
                <tbody id="preview-body"></tbody>
              </table>
            </div>
            <p class="text-[11px] text-bae-muted mb-4">Tip: cells are editable. Posting dates (where the statement prints them) are included in the download.</p>

            <div class="flex gap-3">
              <button type="button" id="download-btn" class="flex-1 bg-bae-primary text-white text-sm font-semibold py-3 rounded-bae-sm hover:bg-bae-accent transition-colors">Download</button>
              <button type="button" id="reset-btn" class="px-4 bg-bae-ink text-white text-sm font-semibold py-3 rounded-bae-sm hover:bg-bae-primary transition-colors">New files</button>
            </div>
          </div>
        </div>

        <!-- Error -->
        <div id="error-area" class="hidden mb-4 bg-amber-50 border border-amber-200 rounded-bae p-4">
          <p class="text-sm font-semibold text-amber-800 mb-1" id="error-title">Could not read this statement</p>
          <p class="text-xs text-amber-700" id="error-text"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Limitations -->
  <section class="py-6 md:py-8 border-t border-bae-border-light">
    <div class="container max-w-page mx-auto px-6">
      <div class="max-w-2xl mx-auto bg-amber-50 border border-amber-200 rounded-bae p-4 md:p-5">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
          <div>
            <h3 class="text-sm font-semibold text-amber-800 mb-2">What to keep in mind</h3>
            <ul class="text-sm text-amber-700 space-y-1.5 list-disc list-inside">
              <li><strong>Review before use:</strong> Always check the preview. The reconciliation check compares rows against the statement's own totals, but it cannot catch every error.</li>
              <li><strong>Text-based PDFs work best:</strong> Scanned statements rely on OCR, which is slower and less accurate.</li>
              <li><strong>Unusual layouts:</strong> Some store-card, credit-union, and international formats may need manual edits in the preview.</li>
              <li><strong>Password-protected files:</strong> Remove the password in your PDF viewer first, then convert the unlocked copy.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ToolHowItWorks steps={steps} />
  <ToolFAQ faqs={faqs} />
</BaseLayout>

<script>
  // ─────────────────────────────────────────────────────────────────────────
  // Credit Card Statement to Excel, 100% client-side. PDF.js (text + coords),
  // line grouping, then the CC parse core: section state machine (payments /
  // purchases / fees / interest), two-date rows, detached-sign merging, year
  // inference from the closing date, and Reg-Z summary reconciliation (cards
  // print no running balance — the totals identity is the checksum instead).
  // The parse core block is plain JS and node-tested against the real file
  // (Claude Test.md hard rule) — keep the markers intact.
  // ─────────────────────────────────────────────────────────────────────────
  (function () {
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const fileInfo = document.getElementById('file-info');
    const infoName = document.getElementById('info-name');
    const infoPages = document.getElementById('info-pages');
    const infoSize = document.getElementById('info-size');
    const settingsArea = document.getElementById('settings-area');
    const scannedNotice = document.getElementById('scanned-notice');
    const ocrBtn = document.getElementById('ocr-btn');
    const convertBtn = document.getElementById('convert-btn');
    const progressArea = document.getElementById('progress-area');
    const progressText = document.getElementById('progress-text');
    const resultArea = document.getElementById('result-area');
    const resultCount = document.getElementById('result-count');
    const reconBanner = document.getElementById('recon-banner');
    const previewBody = document.getElementById('preview-body');
    const downloadBtn = document.getElementById('download-btn');
    const resetBtn = document.getElementById('reset-btn');
    const errorArea = document.getElementById('error-area');
    const errorText = document.getElementById('error-text');

    let pdfjsLib: any = null;
    let xlsxLib: any = null;
    let tesseractLib: any = null;
    let docs: any[] = [];      // [{ file, pdf, numPages }]
    let rows: any[] = [];      // parsed transactions across all files
    let fileResults: any[] = []; // per-file { name, summary, checks, rowCount }
    let outputFormat = 'xlsx';

    function escapeHtml(s: string): string {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function formatBytes(b: number): string {
      if (!b) return '0 B';
      const k = 1024, sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(b) / Math.log(k));
      return parseFloat((b / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }
    function validatePdf(file: File): boolean {
      if (!file.name.toLowerCase().endsWith('.pdf')) return false;
      return file.type === '' || file.type === 'application/pdf' || file.type === 'application/octet-stream';
    }
    function showError(msg: string) {
      progressArea?.classList.add('hidden');
      if (errorText) errorText.textContent = msg;
      errorArea?.classList.remove('hidden');
    }

    function loadScript(src: string): Promise<void> {
      return new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = src;
        s.onload = () => resolve();
        s.onerror = () => reject(new Error('Failed to load ' + src));
        document.head.appendChild(s);
      });
    }
    async function loadCore() {
      if (!pdfjsLib) {
        await loadScript('/pdf.min.js');
        pdfjsLib = (window as any).pdfjsLib;
        pdfjsLib.GlobalWorkerOptions.workerSrc = '/pdf.worker.min.js';
      }
      if (!xlsxLib) {
        await loadScript('/xlsx.full.min.js');
        xlsxLib = (window as any).XLSX;
      }
    }
    async function loadTesseract() {
      if (tesseractLib) return;
      await loadScript('/tesseract/tesseract.min.js');
      tesseractLib = (window as any).Tesseract;
    }

    // Group page text items into visual lines by y coordinate (same approach as
    // the Bank Statement converter — proven on real statement PDFs).
    function groupLines(items: any[]): any[] {
      const toks = items
        .filter((it) => it && typeof it.str === 'string' && it.str.trim() !== '')
        .map((it) => ({ s: it.str.trim(), x: it.transform[4], y: it.transform[5] }));
      toks.sort((a, b) => b.y - a.y || a.x - b.x);
      const lines: any[] = [];
      let cur: any[] = [];
      let lastY: number | null = null;
      for (const t of toks) {
        if (lastY === null || Math.abs(t.y - lastY) <= 3) {
          cur.push(t);
        } else {
          if (cur.length) lines.push(cur);
          cur = [t];
        }
        lastY = t.y;
      }
      if (cur.length) lines.push(cur);
      lines.forEach((l) => l.sort((a: any, b: any) => a.x - b.x));
      return lines;
    }

// ── CC PARSE CORE (plain JS — node-tested, see Claude Test.md hard rule) ──
const CC_ARABIC_RE = /[؀-ۿݐ-ݿﭐ-﷿ﹰ-﻿]/;
const CC_MONEY_RE = /^[\(\-\+]?\s*(?:[A-Z]{3}\s+)?(?:[$£€]\s*\d{1,3}(?:,\d{3})*(?:\.\d{1,2})?|\d{1,3}(?:,\d{3})+(?:\.\d{1,2})?|\d+\.\d{1,2})\s*\)?(?:\s*(?:CR|DR))?$/i;
const CC_FOOTER_RE = /please review this account statement|report any discrepancies|regulated by|customer service|page \d+ of \d+|important information about/i;
const CC_MONTHS = { jan: 1, feb: 2, mar: 3, apr: 4, may: 5, jun: 6, jul: 7, aug: 8, sep: 9, oct: 10, nov: 11, dec: 12 };

const CC_SEC_RULES = [
  { re: /^(payments and other credits|payments,? credits( and adjustments)?|payments and credits|payments\/credits|payments? received|other credits)$/i, sec: 'payments' },
  { re: /^(purchases?( and adjustments)?|standard purchases|new charges|new transactions|transactions)$/i, sec: 'charges' },
  { re: /^(fees|fees charged)$/i, sec: 'fees' },
  { re: /^(interest charged)$/i, sec: 'interest' },
];
const CC_SEC_EXCLUDE_RE = /^(totals? year-to-date|interest charge calculation|rewards summary|membership rewards|cashback bonus|plan balance details|pay over time|qualifying promotional|special terms|deferred interest|account summary|payment information)/i;
const CC_SUMMARY_LABELS = [
  ['previousBalance', /^(previous balance|total outstanding \(previous statement\)|opening balance)\b/i],
  ['payments', /^(payments?,? (and other )?credits( and adjustments)?|payments?\/credits|payment, credits|payments and credits|\(-\) payment)\b/i],
  ['purchases', /^(purchases|new charges|\(\+\) new purchases)\b/i],
  ['cashAdvances', /^cash advances\b/i],
  ['balanceTransfers', /^balance transfers\b/i],
  ['fees', /^(fees( charged)?|\(\+\) fees)\b/i],
  ['interest', /^(interest charged|\(\+\) finance charges)\b/i],
  ['vat', /^\(\+\) vat\b/i],
  ['newBalance', /^(new balance|total outstanding \(current statement\)|total outstanding on statement date)\b/i],
];
const CC_CLOSING_RES = [
  { re: /opening\/closing date\s+\d{1,2}\/\d{1,2}\/\d{2,4}\s*[-–]\s*(\d{1,2})\/\d{1,2}\/(\d{2,4})/i, kind: 'mdy' },
  { re: /billing period:?\s*\d{1,2}\/\d{1,2}\/\d{2,4}\s*[-–]\s*(\d{1,2})\/\d{1,2}\/(\d{2,4})/i, kind: 'mdy' },
  { re: /(?<!\/)(?:statement )?closing date:?\s+(\d{1,2})\/\d{1,2}\/(\d{2,4})/i, kind: 'mdy' },
  { re: /statement date:?\s+\d{1,2}\s+([A-Za-z]{3,9})\.?\s+(\d{4})/i, kind: 'dmy-name' },
  { re: /\bfrom\s+\d{1,2}\s+[A-Za-z]{3,9}\.?\s*\d{2,4}\s+to\s+\d{1,2}\s+([A-Za-z]{3,9})\.?\s*(\d{2,4})/i, kind: 'dmy-name' },
];
// Page furniture / statement-chrome lines that must never join a transaction.
const CC_NOISE_RE = /^(credit card statement|together we thrive|details of your transactions|transaction date\b|page \d+|to view your|opening balance|closing balance)/i;

function ccIsDate(s) {
  const t = String(s || '').trim();
  const m = t.match(/^(\d{1,2})[\/.\-](\d{1,2})([\/.\-]\d{2,4})?$/);
  if (m) {
    const a = parseInt(m[1], 10), b = parseInt(m[2], 10);
    return a >= 1 && a <= 31 && b >= 1 && b <= 31 && (a <= 12 || b <= 12);
  }
  const MON = /^(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)/i;
