    function renderPreview() {
      if (!previewBody) return;
      const multi = fileResults.filter((f: any) => !f.textless).length > 1;
      let html = '';
      let lastFile = '';
      rows.forEach((r: any, i: number) => {
        if (multi && r.fileName !== lastFile) {
          lastFile = r.fileName;
          html += `<tr class="bg-bae-bg border-t border-bae-border"><td colspan="5" class="px-2 py-1.5 font-semibold text-bae-muted">${escapeHtml(r.fileName)}</td></tr>`;
        }
        html += `
        <tr class="${r.flagged ? 'bg-amber-50' : ''} border-t border-bae-border-light" data-i="${i}">
          <td class="px-2 py-1.5" contenteditable data-k="date">${escapeHtml(r.date)}</td>
          <td class="px-2 py-1.5" contenteditable data-k="description">${escapeHtml(r.description)}</td>
          <td class="px-2 py-1.5" contenteditable data-k="type">${escapeHtml(r.type)}</td>
          <td class="px-2 py-1.5 text-right" contenteditable data-k="charge">${escapeHtml(r.charge)}</td>
          <td class="px-2 py-1.5 text-right" contenteditable data-k="credit">${escapeHtml(r.credit)}</td>
        </tr>`;
