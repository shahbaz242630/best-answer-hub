        triggerDownload(blob, base + '.csv');
      } else {
        const ws = xlsxLib.utils.aoa_to_sheet(aoa);
        const widths = [];
        if (multi) widths.push({ wch: 24 });
        widths.push({ wch: 12 });
        if (hasPostDate) widths.push({ wch: 12 });
        widths.push({ wch: 44 }, { wch: 16 }, { wch: 12 }, { wch: 16 });
        ws['!cols'] = widths;
        const wb = xlsxLib.utils.book_new();
        xlsxLib.utils.book_append_sheet(wb, ws, 'Transactions');
        const out = xlsxLib.write(wb, { bookType: 'xlsx', type: 'array' });
        triggerDownload(new Blob([out], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), base + '.xlsx');
      }
    }
    function triggerDownload(blob: Blob, name: string) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = name; document.body.appendChild(a); a.click();
      document.body.removeChild(a); setTimeout(() => URL.revokeObjectURL(url), 1000);
    }
    function reset() {
      docs = []; rows = []; fileResults = [];
      fileInput.value = '';
      [fileInfo, settingsArea, progressArea, resultArea, errorArea, scannedNotice].forEach((el) => el?.classList.add('hidden'));
    }

    // ── Wiring ───────────────────────────────────────────────────────────────
    dropZone?.addEventListener('click', () => fileInput.click());
    dropZone?.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-bae-primary'); });
    dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('border-bae-primary'));
    dropZone?.addEventListener('drop', (e) => {
      e.preventDefault(); dropZone.classList.remove('border-bae-primary');
      const fs = e.dataTransfer?.files; if (fs && fs.length) handleFiles(Array.from(fs));
    });
    fileInput?.addEventListener('change', () => {
      const fs = fileInput.files ? Array.from(fileInput.files) : [];
      fileInput.value = ''; // allow re-selecting the same files without a page refresh
      if (fs.length) handleFiles(fs);
    });
    convertBtn?.addEventListener('click', convert);
    document.getElementById('reset-top')?.addEventListener('click', reset);
    ocrBtn?.addEventListener('click', runOcr);
    downloadBtn?.addEventListener('click', download);
    resetBtn?.addEventListener('click', reset);
    document.getElementById('format-xlsx')?.addEventListener('click', () => setFormat('xlsx'));
    document.getElementById('format-csv')?.addEventListener('click', () => setFormat('csv'));
    function setFormat(fmt: string) {
      outputFormat = fmt;
      const x = document.getElementById('format-xlsx'), c = document.getElementById('format-csv');
      [x, c].forEach((b) => { b?.classList.remove('bg-bae-primary', 'text-white'); b?.classList.add('text-bae-muted'); });
      const active = fmt === 'xlsx' ? x : c;
      active?.classList.add('bg-bae-primary', 'text-white'); active?.classList.remove('text-bae-muted');
    }
  })();
</script>
