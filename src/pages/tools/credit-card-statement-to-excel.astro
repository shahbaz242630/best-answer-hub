    // ── Main flow ────────────────────────────────────────────────────────────
    async function handleFiles(files: File[]) {
      errorArea?.classList.add('hidden');
      resultArea?.classList.add('hidden');
      scannedNotice?.classList.add('hidden');
      const pdfs = files.filter(validatePdf);
      if (!pdfs.length) { showError('Please choose valid .pdf files.'); return; }
      progressArea?.classList.remove('hidden');
      if (progressText) progressText.textContent = 'Loading...';
      try {
        await loadCore();
        docs = [];
        let totalPages = 0, totalSize = 0;
        for (const file of pdfs) {
          const buf = await file.arrayBuffer();
          const pdf = await pdfjsLib.getDocument({ data: new Uint8Array(buf) }).promise;
          docs.push({ file, pdf, numPages: pdf.numPages });
          totalPages += pdf.numPages;
          totalSize += file.size;
        }
        if (infoName) infoName.textContent = docs.length === 1 ? docs[0].file.name : docs.length + ' statements selected';
        if (infoPages) infoPages.textContent = totalPages + (totalPages === 1 ? ' page' : ' pages');
        if (infoSize) infoSize.textContent = formatBytes(totalSize);
        fileInfo?.classList.remove('hidden');
        settingsArea?.classList.remove('hidden');
        progressArea?.classList.add('hidden');
      } catch (e: any) {
        showError(e?.message || 'A PDF could not be opened. It may be corrupt or password-protected — remove the password in your PDF viewer first, then try the unlocked copy.');
      }
    }

    async function convert() {
      if (!docs.length) return;
      settingsArea?.classList.add('hidden');
      progressArea?.classList.remove('hidden');
      rows = []; fileResults = [];
      let anyTextless = false;
      try {
        for (let d = 0; d < docs.length; d++) {
          const doc = docs[d];
          const allLines: any[] = [];
          let totalItems = 0;
          for (let i = 1; i <= doc.numPages; i++) {
            if (progressText) progressText.textContent = `Reading ${doc.file.name} — page ${i} of ${doc.numPages}...`;
            const page = await doc.pdf.getPage(i);
            const tc = await page.getTextContent();
            totalItems += tc.items.length;
            allLines.push(...groupLines(tc.items));
          }
          if (totalItems === 0) { anyTextless = true; fileResults.push({ name: doc.file.name, summary: {}, checks: {}, rowCount: 0, textless: true }); continue; }
          const parsed = parseCardStatement(allLines);
          parsed.rows.forEach((r: any) => { r.fileName = doc.file.name; });
          rows.push(...parsed.rows);
          fileResults.push({ name: doc.file.name, summary: parsed.summary, checks: parsed.checks, rowCount: parsed.rows.length });
        }
        if (rows.length === 0) {
          progressArea?.classList.add('hidden');
          if (anyTextless && docs.length === 1) { scannedNotice?.classList.remove('hidden'); }
          else { showError('No transaction rows could be assembled. The layout may be unusual — or the files are scanned images (convert a scanned statement on its own to use OCR).'); }
          return;
        }
        renderPreview();
        showReconBanner();
        progressArea?.classList.add('hidden');
        resultArea?.classList.remove('hidden');
        resultArea?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (e: any) {
        showError(e?.message || 'Something went wrong while reading the statements.');
      }
    }

    async function runOcr() {
      if (docs.length !== 1) return;
      scannedNotice?.classList.add('hidden');
      progressArea?.classList.remove('hidden');
      if (progressText) progressText.textContent = 'Preparing text recognition (one-time setup)...';
      rows = []; fileResults = [];
      let worker: any = null;
      try {
        await loadTesseract();
        worker = await tesseractLib.createWorker('eng', 1, {
          workerPath: '/tesseract/worker.min.js',
          corePath: '/tesseract/',
          langPath: '/tesseract/',
          workerBlobURL: false,
          logger: (m: any) => {
            if (m && m.status === 'recognizing text' && progressText) {
              progressText.textContent = `Reading scanned text ${Math.round((m.progress || 0) * 100)}%`;
            }
          },
        });
