---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UpdatedBadge from '../../components/content/UpdatedBadge.astro';
import ToolHero from '../../components/tools/ToolHero.astro';
import ToolHowItWorks from '../../components/tools/ToolHowItWorks.astro';
import ToolFAQ from '../../components/tools/ToolFAQ.astro';

const today = '2026-06-13T00:00:00+00:00';

const faqs = [
  {
    q: 'What is the Best Answer Hub Resume Builder?',
    a: 'The Best Answer Hub Resume Builder is a free, browser-based tool that creates professional, ATS-friendly resumes in PDF and Microsoft Word format, with no account, no subscription, and no watermark. Fill in your details through a guided form, watch the live preview update as you type, then download in one click. Everything runs entirely in your browser: no data is stored on any server, and no company ever sees your personal information.',
  },
  {
    q: 'Why do 75% of resumes get rejected by ATS before a human sees them?',
    a: 'Most ATS rejections trace back to formatting errors: multi-column layouts, tables, text boxes, graphics, and contact information placed inside Word headers or footers that the parser cannot read. Keyword mismatch with the specific job description is the second leading cause. The Best Answer Hub Resume Builder eliminates the formatting risk by using a rigorously tested single-column template with standard section headings. Tailoring your skills and summary to each role handles the keyword side.',
  },
  {
    q: 'What is the best free resume builder with no watermark and no sign-up in 2025?',
    a: 'This tool. The Best Answer Hub Resume Builder is genuinely free: no credit card, no account, and no watermark on any download. Unlike Zety, Resume.io, and Novoresume, which let you build for free but charge up to $25 per month to download, the Best Answer Hub Resume Builder generates your PDF and Word files entirely in your browser and delivers them instantly. Your data never touches a server. There are no usage limits and no upgrade prompts.',
  },
  {
    q: 'Does Canva create ATS-friendly resumes, or will my resume get rejected?',
    a: 'Most Canva templates use floating text boxes, multi-column layouts, and embedded graphics that ATS software cannot parse correctly. The system reads content out of order, skips entire sections, or rejects the file before a recruiter ever sees it. Independent testing shows up to 72% of Canva templates fail basic ATS parsing. If you use Canva, choose a single-column template with no graphics and export as a text-based PDF, not an image.',
  },
  {
    q: 'Should I submit my resume as a PDF or a Word (.docx) file?',
    a: 'Submit PDF when emailing a resume directly to a recruiter. It preserves formatting exactly. Submit Word (.docx) when uploading through an application portal, as some older ATS software parses .docx files more reliably than PDFs. The Best Answer Hub Resume Builder generates both formats from the same data, so keep both versions and choose based on how you are applying. When a job posting specifies a format, always follow it.',
  },
  {
    q: 'What are the most common resume mistakes that cause automatic ATS rejection?',
    a: 'The top mistakes are: placing contact information inside Word headers or footers, using multi-column layouts or tables, adding graphics and icons, submitting a scanned PDF instead of a text-based one, and using the same resume for every application. Keyword mismatch is the single most controllable factor: a resume not tailored to the specific role will score below the ATS threshold regardless of how qualified you are.',
  },
  {
    q: 'How do I tailor my resume keywords to a specific job description for ATS?',
    a: 'Mirror the exact phrasing from the job description (not synonyms) in your skills section and bullet points. Focus on job titles, hard skills, and tools that appear more than once in the posting. Each tailored version should match at least 75–80% of the role\'s key terms. A custom resume consistently outperforms a generic one in ATS scoring, sometimes by 40 percentage points or more. The <a href="/tools/job-keyword-matcher/">Best Answer Hub Job Keyword Matcher</a> can show your exact match rate before you apply.',
  },
  {
    q: 'What sections must a 2025 resume include to pass ATS and impress a recruiter?',
    a: 'Every ATS-ready resume needs five sections with standard headings: contact information in the main body (never in Word headers), a professional summary, a skills section with keyword-matched hard skills, reverse-chronological work experience with quantified achievements, and education. Use conventional labels ("Work Experience" rather than a creative alternative) because ATS systems rely on recognised section names to map your content correctly.',
  },
  {
    q: 'Does using a two-column resume template hurt my chances with ATS?',
    a: 'Yes, in most cases. Most ATS software reads resumes linearly from top to bottom and left to right. A two-column layout causes the system to merge or reorder content from separate columns, which can place your contact details inside your work history or make entire skills sections unreadable. Single-column resumes with standard headings are the safe default for any online application portal or ATS-heavy hiring process.',
  },
  {
    q: 'What font size and margin settings should a resume use to pass ATS in 2025?',
    a: 'Use 11–12pt for body text in a standard font (Arial, Calibri, or Times New Roman) and 13–16pt for section headers. Set margins between 0.75 and 1 inch on all sides. Margins narrower than 0.5 inches can cause text to be cut off during parsing. Avoid decorative fonts, custom kerning, or anything that a basic PDF reader would not render reliably. The Best Answer Hub Resume Builder uses pre-configured typography that meets all of these standards automatically.',
  },
  {
    q: 'Is a one-page or two-page resume better for experienced professionals in 2025?',
    a: 'A two-page resume is better once you have more than 7–10 years of relevant experience. A ResumeGo study of 482 recruiters found two-page resumes were preferred 2.3 times more often than one-page resumes for senior candidates. Under 5 years of experience, one page remains the safe choice. The rule either way: every line must earn its place: never pad a second page with filler to reach a round number.',
  },
  {
    q: 'What resume format is best for a career change with no relevant experience?',
    a: 'Use a combination (hybrid) format: open with a skills summary highlighting transferable abilities, then follow with a streamlined work history. Write a professional summary that explicitly connects your previous experience to the target role. Relevant certifications, courses, or projects in the new field should appear near the top (before your work history) to direct the reader toward your capabilities rather than your timeline.',
  },
  {
    q: 'How do I write a resume summary when I have no work experience?',
    a: 'Write 2–3 sentences: name your target role, cite one relevant skill or outcome from a course, project, or internship, and add a certification or academic achievement. Avoid starting with "I." Example: "Marketing communications graduate with hands-on email campaign experience from a university internship. Google Analytics certified. Focused on data-driven content strategy." Specificity (even from academic work) consistently outperforms vague generic statements.',
  },
  {
    q: 'Can I use AI tools like ChatGPT to write my resume?',
    a: 'Yes, but personalise every output before submitting. AI-generated bullet points often lack specific metrics, named tools, and real context. Recruiters increasingly recognise templated language. Use AI to generate a first draft or suggest phrasing, then rewrite each point with real numbers, specific technologies, and verifiable outcomes from your actual experience. The final resume should sound like you, not a language model describing a hypothetical candidate.',
  },
  {
    q: 'Are resume builder subscriptions worth it, or should I just use Google Docs?',
    a: 'For most job seekers, Google Docs with an ATS-safe template is as effective as a paid subscription, and avoids the bait-and-switch paywalls common on Zety and Resume.io. Paid tools add genuine value only if they include real-time ATS keyword matching or AI bullet point suggestions. The Best Answer Hub Resume Builder gives you an ATS-optimised single-column template with PDF and Word export, completely free, no subscription required, and no data stored anywhere.',
  },
];

const steps = [
  { title: 'Fill in your details', description: 'Enter your personal information, summary, work history, education, skills, projects, and certifications through the guided form on the left.' },
  { title: 'Preview and refine', description: 'Watch the live preview update as you type. Add or remove experience entries, tweak your bullets, and adjust your summary until it feels right.' },
  { title: 'Download PDF or Word', description: 'Click Download PDF for recruiter emails or Download Word for ATS portals. Both files are generated instantly in your browser with no watermarks.' },
];

const seo = {
  title: 'Free Resume Builder — ATS-Friendly PDF & Word (2026)',
  description: 'Build professional, ATS-friendly resumes for free. Live preview, PDF and Word export, no signup, no watermarks. Your data never leaves your browser.',
  url: '/tools/resume-builder/',
  type: 'WebPage' as const,
  datePublished: today,
  dateModified: today,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Resume Builder', url: '/tools/resume-builder/' },
  ],
  faq: faqs.map(f => ({ question: f.q, answer: f.a })),
};
---

<BaseLayout seo={seo}>
  <ToolHero
    badge="Free Tool · No Data Stored on Servers"
    title="Resume Builder:"
    accentText="ATS-friendly PDF & Word resumes"
    description="Build a professional resume with live preview. Export to PDF or Word instantly. Single-column, parser-safe template. No signup, no watermarks, no paywalls."
    backLink="/career-toolkit/"
    backLabel="← Career Toolkit"
  />

  <!-- Builder Interface -->
  <section class="py-6 md:py-8" aria-label="Resume builder">
    <div class="container max-w-page mx-auto px-6">
        <div class="mb-5"><UpdatedBadge date={seo.dateModified} /></div>
      <!-- Mobile tabs -->
      <div class="md:hidden flex gap-2 mb-4">
        <button type="button" id="tab-edit" class="flex-1 py-2 text-sm font-semibold rounded-bae-sm bg-bae-primary text-white">Edit</button>
        <button type="button" id="tab-preview" class="flex-1 py-2 text-sm font-semibold rounded-bae-sm bg-bae-card border border-bae-border text-bae-muted">Preview</button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Form -->
        <div id="panel-edit" class="space-y-5">
          <!-- Personal Info -->
          <div class="bg-bae-card border border-bae-border rounded-bae p-5">
            <h2 class="text-sm font-bold text-bae-ink mb-4 flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-bae-primary-soft flex items-center justify-center text-bae-primary text-xs font-bold">1</span>
              Personal Information
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input type="text" id="rb-firstName" spellcheck="true" placeholder="First Name" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3.5 py-2.5 text-sm text-bae-ink focus:outline-none focus:ring-2 focus:ring-bae-primary/30 focus:border-bae-primary" />
              <input type="text" id="rb-lastName" spellcheck="true" placeholder="Last Name" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3.5 py-2.5 text-sm text-bae-ink focus:outline-none focus:ring-2 focus:ring-bae-primary/30 focus:border-bae-primary" />
              <input type="text" id="rb-title" spellcheck="true" placeholder="Professional Title (e.g. Software Engineer)" class="rb-input sm:col-span-2 w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3.5 py-2.5 text-sm text-bae-ink focus:outline-none focus:ring-2 focus:ring-bae-primary/30 focus:border-bae-primary" />
              <input type="email" id="rb-email" placeholder="Email" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3.5 py-2.5 text-sm text-bae-ink focus:outline-none focus:ring-2 focus:ring-bae-primary/30 focus:border-bae-primary" />
              <input type="text" id="rb-phone" placeholder="Phone" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3.5 py-2.5 text-sm text-bae-ink focus:outline-none focus:ring-2 focus:ring-bae-primary/30 focus:border-bae-primary" />
              <input type="text" id="rb-location" spellcheck="true" placeholder="Location (e.g. New York, NY)" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3.5 py-2.5 text-sm text-bae-ink focus:outline-none focus:ring-2 focus:ring-bae-primary/30 focus:border-bae-primary" />
              <input type="text" id="rb-linkedin" spellcheck="true" placeholder="LinkedIn (optional)" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3.5 py-2.5 text-sm text-bae-ink focus:outline-none focus:ring-2 focus:ring-bae-primary/30 focus:border-bae-primary" />
              <input type="text" id="rb-website" spellcheck="true" placeholder="Portfolio / Website (optional)" class="rb-input sm:col-span-2 w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3.5 py-2.5 text-sm text-bae-ink focus:outline-none focus:ring-2 focus:ring-bae-primary/30 focus:border-bae-primary" />
              <div class="sm:col-span-2">
                <label class="block text-xs font-medium text-bae-muted mb-1.5">Profile Photo</label>
                <div id="photo-upload" class="border-2 border-dashed border-bae-border rounded-bae-sm p-4 text-center cursor-pointer hover:border-bae-primary hover:bg-bae-primary-soft/20 transition-colors">
                  <div id="photo-preview-area" class="hidden mb-2">
                    <img id="photo-preview-img" class="h-20 mx-auto object-contain rounded-bae-sm" alt="Profile photo preview" />
                  </div>
                  <p class="text-xs text-bae-muted" id="photo-text">Click to upload photo: PNG, JPEG, WebP</p>
                  <input type="file" id="rb-photo-input" class="hidden" accept="image/*" />
                </div>
                <div class="mt-2 flex flex-wrap gap-4">
                  <label class="flex items-center gap-1.5 text-xs text-bae-muted cursor-pointer">
                    <input type="radio" name="photo-position" value="top-left" class="text-bae-primary focus:ring-bae-primary" /> Top Left
                  </label>
                  <label class="flex items-center gap-1.5 text-xs text-bae-muted cursor-pointer">
                    <input type="radio" name="photo-position" value="top-center" class="text-bae-primary focus:ring-bae-primary" checked /> Top Center
                  </label>
                  <label class="flex items-center gap-1.5 text-xs text-bae-muted cursor-pointer">
                    <input type="radio" name="photo-position" value="top-right" class="text-bae-primary focus:ring-bae-primary" /> Top Right
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- Summary -->
          <div class="bg-bae-card border border-bae-border rounded-bae p-5">
            <h2 class="text-sm font-bold text-bae-ink mb-4 flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-bae-primary-soft flex items-center justify-center text-bae-primary text-xs font-bold">2</span>
              Professional Summary
            </h2>
            <textarea id="rb-summary" rows="4" spellcheck="true" placeholder="Write a 2–4 sentence summary of your experience, strengths, and career goals..." class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3.5 py-2.5 text-sm text-bae-ink focus:outline-none focus:ring-2 focus:ring-bae-primary/30 focus:border-bae-primary resize-y"></textarea>
          </div>

          <!-- Work Experience -->
          <div class="bg-bae-card border border-bae-border rounded-bae p-5">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-sm font-bold text-bae-ink flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-bae-primary-soft flex items-center justify-center text-bae-primary text-xs font-bold">3</span>
                Work Experience
              </h2>
              <button type="button" id="add-exp" class="text-xs font-semibold text-bae-primary hover:text-bae-accent transition-colors">+ Add Job</button>
            </div>
            <div id="exp-list" class="space-y-4"></div>
          </div>

          <!-- Education -->
          <div class="bg-bae-card border border-bae-border rounded-bae p-5">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-sm font-bold text-bae-ink flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-bae-primary-soft flex items-center justify-center text-bae-primary text-xs font-bold">4</span>
                Education
              </h2>
              <button type="button" id="add-edu" class="text-xs font-semibold text-bae-primary hover:text-bae-accent transition-colors">+ Add School</button>
            </div>
            <div id="edu-list" class="space-y-4"></div>
          </div>

          <!-- Skills -->
          <div class="bg-bae-card border border-bae-border rounded-bae p-5">
            <h2 class="text-sm font-bold text-bae-ink mb-4 flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-bae-primary-soft flex items-center justify-center text-bae-primary text-xs font-bold">5</span>
              Skills
            </h2>
            <textarea id="rb-skills" rows="3" spellcheck="true" placeholder="List your skills separated by commas or new lines... e.g. JavaScript, React, Project Management, Data Analysis" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3.5 py-2.5 text-sm text-bae-ink focus:outline-none focus:ring-2 focus:ring-bae-primary/30 focus:border-bae-primary resize-y"></textarea>
          </div>

          <!-- Projects -->
          <div class="bg-bae-card border border-bae-border rounded-bae p-5">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-sm font-bold text-bae-ink flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-bae-primary-soft flex items-center justify-center text-bae-primary text-xs font-bold">6</span>
                Projects
              </h2>
              <button type="button" id="add-project" class="text-xs font-semibold text-bae-primary hover:text-bae-accent transition-colors">+ Add Project</button>
            </div>
            <div id="project-list" class="space-y-4"></div>
          </div>

          <!-- Certifications -->
          <div class="bg-bae-card border border-bae-border rounded-bae p-5">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-sm font-bold text-bae-ink flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-bae-primary-soft flex items-center justify-center text-bae-primary text-xs font-bold">7</span>
                Certifications
              </h2>
              <button type="button" id="add-cert" class="text-xs font-semibold text-bae-primary hover:text-bae-accent transition-colors">+ Add Certification</button>
            </div>
            <div id="cert-list" class="space-y-4"></div>
          </div>

          <!-- Actions -->
          <div class="flex flex-wrap gap-3">
            <button type="button" id="download-pdf" class="flex-1 min-w-[140px] bg-bae-primary text-white font-semibold text-sm py-3 rounded-bae-sm hover:bg-bae-accent transition-colors">
              Download PDF
            </button>
            <button type="button" id="download-docx" class="flex-1 min-w-[140px] bg-bae-ink text-white font-semibold text-sm py-3 rounded-bae-sm hover:bg-bae-primary transition-colors">
              Download Word
            </button>
          </div>
          <div class="flex flex-wrap gap-3">
            <button type="button" id="export-json" class="text-xs font-medium text-bae-primary hover:text-bae-accent transition-colors">Export JSON</button>
            <button type="button" id="import-json-btn" class="text-xs font-medium text-bae-primary hover:text-bae-accent transition-colors">Import JSON</button>
            <input type="file" id="import-json-file" class="hidden" accept="application/json" />
            <button type="button" id="reset-data" class="text-xs font-medium text-red-500 hover:text-red-600 transition-colors ml-auto">Reset All</button>
          </div>
        </div>

        <!-- Preview -->
        <div id="panel-preview" class="lg:sticky lg:top-24 h-fit md:block hidden">
          <div class="bg-bae-card border border-bae-border rounded-bae p-4">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-semibold text-bae-ink">Preview</h3>
              <span class="text-[11px] text-bae-muted bg-bae-bg px-2 py-0.5 rounded-full border border-bae-border">A4 Single Column</span>
            </div>
            <div class="bg-white rounded-bae-sm shadow-bae-sm overflow-hidden">
              <div id="resume-preview" class="text-[13px] leading-relaxed text-gray-800" style="font-family: Arial, Helvetica, sans-serif;">
                <!-- Populated by JS -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ToolHowItWorks steps={steps} />
  <ToolFAQ faqs={faqs} />

  <!-- What People Build -->
  <section class="py-10 md:py-14 border-t border-bae-border">
    <div class="container max-w-page mx-auto px-6">
      <h2 class="font-serif text-2xl md:text-[1.75rem] font-bold text-bae-ink mb-8">What people build with it</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-bae-card border border-bae-border rounded-bae p-5">
          <div class="text-xs font-semibold text-bae-muted uppercase tracking-wider mb-2">CS grad, 0 years experience, software engineering</div>
          <div class="text-xl font-bold text-bae-ink mb-1">Entry-level tech role</div>
          <div class="text-2xl font-bold text-bae-primary font-serif mb-2">3 interviews, week one</div>
          <p class="text-sm text-bae-muted leading-relaxed">Led with a skills-forward summary and a GitHub project as the top experience entry. The single-column DOCX passed Workday without a single formatting error.</p>
        </div>
        <div class="bg-bae-card border border-bae-border rounded-bae p-5">
          <div class="text-xs font-semibold text-bae-muted uppercase tracking-wider mb-2">8 years retail management → marketing manager</div>
          <div class="text-xl font-bold text-bae-ink mb-1">Industry pivot, no prior title</div>
          <div class="text-2xl font-bold text-bae-primary font-serif mb-2">Landed the role</div>
          <p class="text-sm text-bae-muted leading-relaxed">Used the combination format: skills summary first, then a streamlined work history. Matched keywords from three job descriptions. Downloaded PDF for email outreach and Word for the ATS portal.</p>
        </div>
        <div class="bg-bae-card border border-bae-border rounded-bae p-5">
          <div class="text-xs font-semibold text-bae-muted uppercase tracking-wider mb-2">2-year employment gap, healthcare administrator</div>
          <div class="text-xl font-bold text-bae-ink mb-1">Back in the workforce</div>
          <div class="text-2xl font-bold text-bae-primary font-serif mb-2">No gap questions at interview</div>
          <p class="text-sm text-bae-muted leading-relaxed">Used year-only date formatting to reduce visual emphasis on the gap. No account or email needed. Built it entirely in the browser, downloaded, applied. The privacy-first approach mattered.</p>
        </div>
        <div class="bg-bae-card border border-bae-border rounded-bae p-5">
          <div class="text-xs font-semibold text-bae-muted uppercase tracking-wider mb-2">5 years freelance UX designer, going full-time</div>
          <div class="text-xl font-bold text-bae-ink mb-1">Contract → permanent role</div>
          <div class="text-2xl font-bold text-bae-primary font-serif mb-2">47 clients → 6 strong bullets</div>
          <p class="text-sm text-bae-muted leading-relaxed">Condensed five years of freelance work under a single "Freelance UX Designer" entry with quantified outcomes. The ATS-safe format cleared the agency's tracking system without any manual review flag.</p>
        </div>
      </div>
      <p class="text-xs text-bae-muted mt-4">Scenarios are illustrative examples based on common use cases. Results vary by industry, role level, and application strategy.</p>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-10 md:py-14 border-t border-bae-border">
    <div class="container max-w-page mx-auto px-6">
      <div class="bg-bae-primary-soft border border-bae-primary/15 rounded-bae p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <h3 class="font-serif text-xl font-bold text-bae-ink mb-1">Explore more career tools</h3>
          <p class="text-sm text-bae-muted">Also try <a href="/career-toolkit/" class="text-bae-primary hover:underline">Career Toolkit</a>, <a href="/tools/invoice-generator/" class="text-bae-primary hover:underline">Invoice Generator</a>, <a href="/tools/pdf-to-word-converter/" class="text-bae-primary hover:underline">PDF to Word</a>, and <a href="/tools/qr-code-generator/" class="text-bae-primary hover:underline">QR Code Generator</a>.</p>
        </div>
        <a href="/tools/" class="inline-flex items-center gap-2 bg-bae-ink text-white px-5 py-2.5 rounded-bae-sm font-semibold text-sm no-underline hover:bg-bae-primary transition-colors shrink-0">
          Browse all tools →
        </a>
      </div>
    </div>
  </section>

  <script src="/html2pdf.bundle.min.js" is:inline></script>
  <script src="/docx.iife.js" is:inline></script>

  <script is:inline>
    (function() {
      'use strict';

      const STORAGE_KEY = 'resume-builder-data-v1';

      function defaultData() {
        return {
          personal: { firstName: '', lastName: '', title: '', email: '', phone: '', location: '', linkedin: '', website: '' },
          photo: { dataUrl: '', position: 'top-center' },
          summary: '',
          experience: [],
          education: [],
          skills: '',
          projects: [],
          certifications: [],
        };
      }

      function loadData() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) return JSON.parse(raw);
        } catch (e) {}
        return defaultData();
      }

      function saveData(data) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
        } catch (e) {}
      }

      let data = loadData();

      // Ensure nested objects exist (defensive against old/corrupted localStorage)
      if (!data.personal || typeof data.personal !== 'object') {
        data.personal = { firstName: '', lastName: '', title: '', email: '', phone: '', location: '', linkedin: '', website: '' };
      }
      if (!data.photo || typeof data.photo !== 'object') {
        data.photo = { dataUrl: '', position: 'top-center' };
      }

      // Ensure arrays exist
      if (!Array.isArray(data.experience)) data.experience = [];
      if (!Array.isArray(data.education)) data.education = [];
      if (!Array.isArray(data.projects)) data.projects = [];
      if (!Array.isArray(data.certifications)) data.certifications = [];

      // DOM refs
      const els = {
        expList: document.getElementById('exp-list'),
        eduList: document.getElementById('edu-list'),
        projectList: document.getElementById('project-list'),
        certList: document.getElementById('cert-list'),
        preview: document.getElementById('resume-preview'),
        tabEdit: document.getElementById('tab-edit'),
        tabPreview: document.getElementById('tab-preview'),
        panelEdit: document.getElementById('panel-edit'),
        panelPreview: document.getElementById('panel-preview'),
      };

      // ---------- Helpers ----------
      function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      function getVal(id) {
        const el = document.getElementById(id);
        return el ? el.value.trim() : '';
      }

      function setVal(id, value) {
        const el = document.getElementById(id);
        if (el) el.value = value || '';
      }

      function debounce(fn, ms) {
        let t;
        return function(...args) {
          clearTimeout(t);
          t = setTimeout(() => fn.apply(this, args), ms);
        };
      }

      // ---------- Render repeatable sections ----------
      function renderExperience() {
        if (!els.expList) return;
        els.expList.innerHTML = '';
        data.experience.forEach((item, idx) => {
          const div = document.createElement('div');
          div.className = 'bg-bae-bg border border-bae-border rounded-bae-sm p-4 space-y-3';
          div.innerHTML = `
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-bae-muted">Job #${idx + 1}</span>
              <button type="button" data-remove-exp="${idx}" class="text-xs text-red-500 hover:text-red-600 transition-colors">Remove</button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input type="text" data-exp="${idx}" data-field="role" spellcheck="true" placeholder="Job Title" value="${escapeHtml(item.role || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
              <input type="text" data-exp="${idx}" data-field="company" spellcheck="true" placeholder="Company" value="${escapeHtml(item.company || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <input type="text" data-exp="${idx}" data-field="startDate" placeholder="Start Date" value="${escapeHtml(item.startDate || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
              <input type="text" data-exp="${idx}" data-field="endDate" placeholder="End Date" value="${escapeHtml(item.endDate || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
            </div>
            <label class="flex items-center gap-2 text-xs text-bae-muted cursor-pointer">
              <input type="checkbox" data-exp="${idx}" data-field="current" ${item.current ? 'checked' : ''} class="rounded border-bae-border text-bae-primary focus:ring-bae-primary" />
              Current position
            </label>
            <textarea data-exp="${idx}" data-field="bullets" rows="3" spellcheck="true" placeholder="Achievement bullets (one per line)..." class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary resize-y">${escapeHtml((item.bullets || []).join('\n'))}</textarea>
          `;
          els.expList.appendChild(div);
        });
        bindRepeatable('exp', data.experience);
      }

      function renderEducation() {
        if (!els.eduList) return;
        els.eduList.innerHTML = '';
        data.education.forEach((item, idx) => {
          const div = document.createElement('div');
          div.className = 'bg-bae-bg border border-bae-border rounded-bae-sm p-4 space-y-3';
          div.innerHTML = `
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-bae-muted">School #${idx + 1}</span>
              <button type="button" data-remove-edu="${idx}" class="text-xs text-red-500 hover:text-red-600 transition-colors">Remove</button>
            </div>
            <input type="text" data-edu="${idx}" data-field="school" spellcheck="true" placeholder="School / University" value="${escapeHtml(item.school || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
            <div class="grid grid-cols-2 gap-3">
              <input type="text" data-edu="${idx}" data-field="degree" spellcheck="true" placeholder="Degree" value="${escapeHtml(item.degree || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
              <input type="text" data-edu="${idx}" data-field="field" spellcheck="true" placeholder="Field of Study" value="${escapeHtml(item.field || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <input type="text" data-edu="${idx}" data-field="startDate" placeholder="Start Date" value="${escapeHtml(item.startDate || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
              <input type="text" data-edu="${idx}" data-field="endDate" placeholder="End Date" value="${escapeHtml(item.endDate || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
            </div>
          `;
          els.eduList.appendChild(div);
        });
        bindRepeatable('edu', data.education);
      }

      function renderProjects() {
        if (!els.projectList) return;
        els.projectList.innerHTML = '';
        data.projects.forEach((item, idx) => {
          const div = document.createElement('div');
          div.className = 'bg-bae-bg border border-bae-border rounded-bae-sm p-4 space-y-3';
          div.innerHTML = `
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-bae-muted">Project #${idx + 1}</span>
              <button type="button" data-remove-project="${idx}" class="text-xs text-red-500 hover:text-red-600 transition-colors">Remove</button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input type="text" data-project="${idx}" data-field="name" spellcheck="true" placeholder="Project Name" value="${escapeHtml(item.name || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
              <input type="text" data-project="${idx}" data-field="link" placeholder="Link (optional)" value="${escapeHtml(item.link || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
            </div>
            <textarea data-project="${idx}" data-field="bullets" rows="3" spellcheck="true" placeholder="Description bullets (one per line)..." class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary resize-y">${escapeHtml((item.bullets || []).join('\n'))}</textarea>
          `;
          els.projectList.appendChild(div);
        });
        bindRepeatable('project', data.projects);
      }

      function renderCertifications() {
        if (!els.certList) return;
        els.certList.innerHTML = '';
        data.certifications.forEach((item, idx) => {
          const div = document.createElement('div');
          div.className = 'bg-bae-bg border border-bae-border rounded-bae-sm p-4 space-y-3';
          div.innerHTML = `
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-bae-muted">Cert #${idx + 1}</span>
              <button type="button" data-remove-cert="${idx}" class="text-xs text-red-500 hover:text-red-600 transition-colors">Remove</button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input type="text" data-cert="${idx}" data-field="name" spellcheck="true" placeholder="Certification Name" value="${escapeHtml(item.name || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
              <input type="text" data-cert="${idx}" data-field="issuer" spellcheck="true" placeholder="Issuing Organization" value="${escapeHtml(item.issuer || '')}" class="rb-input w-full bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
            </div>
            <input type="text" data-cert="${idx}" data-field="date" placeholder="Date (e.g. May 2024)" value="${escapeHtml(item.date || '')}" class="rb-input w-full sm:w-1/2 bg-bae-bg border border-bae-border rounded-bae-sm px-3 py-2 text-sm text-bae-ink focus:outline-none focus:border-bae-primary" />
          `;
          els.certList.appendChild(div);
        });
        bindRepeatable('cert', data.certifications);
      }

      function bindRepeatable(type, arr) {
        const container = document.getElementById(type === 'exp' ? 'exp-list' : type === 'edu' ? 'edu-list' : type === 'project' ? 'project-list' : 'cert-list');
        if (!container) return;
        container.querySelectorAll('input, textarea').forEach(inp => {
          inp.addEventListener('input', () => {
            const idx = parseInt(inp.getAttribute('data-' + type), 10);
            const field = inp.getAttribute('data-field');
            if (isNaN(idx) || !arr[idx]) return;
            if (field === 'current') {
              arr[idx][field] = inp.checked;
            } else if (field === 'bullets') {
              arr[idx][field] = inp.value.split('\n').map(s => s.trim()).filter(Boolean);
            } else {
              arr[idx][field] = inp.value;
            }
            renderPreview();
            saveData(data);
          });
        });
        container.querySelectorAll('button[data-remove-' + type + ']').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = parseInt(btn.getAttribute('data-remove-' + type), 10);
            if (!isNaN(idx)) {
              arr.splice(idx, 1);
              if (type === 'exp') renderExperience();
              else if (type === 'edu') renderEducation();
              else if (type === 'project') renderProjects();
              else if (type === 'cert') renderCertifications();
              renderPreview();
              saveData(data);
            }
          });
        });
      }

      // ---------- Preview ----------
      function renderPreview() {
        if (!els.preview) return;
        const p = data.personal;
        const name = [p.firstName, p.lastName].filter(Boolean).join(' ') || 'Your Name';
        const contactParts = [p.title, p.email, p.phone, p.location].filter(Boolean);
        const linkParts = [];
        if (p.linkedin) linkParts.push('LinkedIn: ' + p.linkedin);
        if (p.website) linkParts.push('Portfolio: ' + p.website);

        let html = '<div id="resume-pdf-content" style="padding: 40px 48px; max-width: 210mm; margin: 0 auto; color: #1f2937; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 1.6;">';
        html += '<style>p, li, div, h1, h2, h3, h4, h5, h6, ul { page-break-inside: avoid; }</style>';

        // Header
        const photo = data.photo;
        const hasPhoto = !!photo.dataUrl;
        const pos = photo.position || 'top-center';

        if (hasPhoto && pos === 'top-left') {
          html += '<div style="display: flex; align-items: center; gap: 16px; border-bottom: 2px solid #e5e7eb; padding-bottom: 12px; margin-bottom: 16px;">';
          html += '<img src="' + photo.dataUrl + '" style="width: 72px; height: 72px; object-fit: cover; border-radius: 8px; flex-shrink: 0;" alt="Profile photo" />';
          html += '<div style="text-align: left;">';
          html += '<h1 style="font-size: 22px; font-weight: 700; color: #111827; margin: 0 0 4px 0; text-transform: uppercase; letter-spacing: 0.5px;">' + escapeHtml(name) + '</h1>';
          if (contactParts.length) html += '<p style="font-size: 12px; color: #4b5563; margin: 0;">' + escapeHtml(contactParts.join(' | ')) + '</p>';
          if (linkParts.length) html += '<p style="font-size: 11px; color: #6b7280; margin: 2px 0 0 0;">' + escapeHtml(linkParts.join(' | ')) + '</p>';
          html += '</div></div>';
        } else if (hasPhoto && pos === 'top-right') {
          html += '<div style="display: flex; align-items: center; gap: 16px; border-bottom: 2px solid #e5e7eb; padding-bottom: 12px; margin-bottom: 16px;">';
          html += '<div style="flex: 1; text-align: left;">';
          html += '<h1 style="font-size: 22px; font-weight: 700; color: #111827; margin: 0 0 4px 0; text-transform: uppercase; letter-spacing: 0.5px;">' + escapeHtml(name) + '</h1>';
          if (contactParts.length) html += '<p style="font-size: 12px; color: #4b5563; margin: 0;">' + escapeHtml(contactParts.join(' | ')) + '</p>';
          if (linkParts.length) html += '<p style="font-size: 11px; color: #6b7280; margin: 2px 0 0 0;">' + escapeHtml(linkParts.join(' | ')) + '</p>';
          html += '</div>';
          html += '<img src="' + photo.dataUrl + '" style="width: 72px; height: 72px; object-fit: cover; border-radius: 8px; flex-shrink: 0;" alt="Profile photo" />';
          html += '</div>';
        } else if (hasPhoto && pos === 'top-center') {
          html += '<div style="text-align: center; border-bottom: 2px solid #e5e7eb; padding-bottom: 12px; margin-bottom: 16px;">';
          html += '<img src="' + photo.dataUrl + '" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px; margin-bottom: 8px;" alt="Profile photo" />';
          html += '<h1 style="font-size: 22px; font-weight: 700; color: #111827; margin: 0 0 4px 0; text-transform: uppercase; letter-spacing: 0.5px;">' + escapeHtml(name) + '</h1>';
          if (contactParts.length) html += '<p style="font-size: 12px; color: #4b5563; margin: 0;">' + escapeHtml(contactParts.join(' | ')) + '</p>';
          if (linkParts.length) html += '<p style="font-size: 11px; color: #6b7280; margin: 2px 0 0 0;">' + escapeHtml(linkParts.join(' | ')) + '</p>';
          html += '</div>';
        } else {
          html += '<div style="text-align: center; border-bottom: 2px solid #e5e7eb; padding-bottom: 12px; margin-bottom: 16px;">';
          html += '<h1 style="font-size: 22px; font-weight: 700; color: #111827; margin: 0 0 4px 0; text-transform: uppercase; letter-spacing: 0.5px;">' + escapeHtml(name) + '</h1>';
          if (contactParts.length) html += '<p style="font-size: 12px; color: #4b5563; margin: 0;">' + escapeHtml(contactParts.join(' | ')) + '</p>';
          if (linkParts.length) html += '<p style="font-size: 11px; color: #6b7280; margin: 2px 0 0 0;">' + escapeHtml(linkParts.join(' | ')) + '</p>';
          html += '</div>';
        }

        // Summary
        if (data.summary) {
          html += '<div style="margin-bottom: 14px;">';
          html += '<h2 style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #111827; border-bottom: 1px solid #d1d5db; padding-bottom: 3px; margin: 0 0 6px 0;">Professional Summary</h2>';
          html += '<p style="margin: 0; color: #374151;">' + escapeHtml(data.summary).replace(/\n/g, '<br>') + '</p>';
          html += '</div>';
        }

        // Experience
        if (data.experience.length) {
          html += '<div style="margin-bottom: 14px;">';
          html += '<h2 style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #111827; border-bottom: 1px solid #d1d5db; padding-bottom: 3px; margin: 0 0 6px 0;">Work Experience</h2>';
          data.experience.forEach(job => {
            const dateStr = [job.startDate, job.current ? 'Present' : job.endDate].filter(Boolean).join(' – ');
            html += '<div style="margin-bottom: 10px;">';
            html += '<div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 4px;">';
            html += '<h3 style="font-size: 13px; font-weight: 600; color: #111827; margin: 0;">' + escapeHtml(job.role || 'Role') + '</h3>';
            html += '<span style="font-size: 11px; color: #6b7280; white-space: nowrap;">' + escapeHtml(dateStr) + '</span>';
            html += '</div>';
            html += '<p style="font-size: 12px; color: #4b5563; margin: 1px 0 4px 0; font-style: italic;">' + escapeHtml(job.company || 'Company') + '</p>';
            if (job.bullets && job.bullets.length) {
              html += '<ul style="margin: 0; padding-left: 18px; color: #374151;">';
              job.bullets.forEach(b => {
                if (b.trim()) html += '<li style="margin-bottom: 1px;">' + escapeHtml(b.trim()) + '</li>';
              });
              html += '</ul>';
            }
            html += '</div>';
          });
          html += '</div>';
        }

        // Education
        if (data.education.length) {
          html += '<div style="margin-bottom: 14px;">';
          html += '<h2 style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #111827; border-bottom: 1px solid #d1d5db; padding-bottom: 3px; margin: 0 0 6px 0;">Education</h2>';
          data.education.forEach(edu => {
            const dateStr = [edu.startDate, edu.endDate].filter(Boolean).join(' – ');
            html += '<div style="margin-bottom: 8px;">';
            html += '<div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 4px;">';
            html += '<h3 style="font-size: 13px; font-weight: 600; color: #111827; margin: 0;">' + escapeHtml(edu.school || 'School') + '</h3>';
            html += '<span style="font-size: 11px; color: #6b7280; white-space: nowrap;">' + escapeHtml(dateStr) + '</span>';
            html += '</div>';
            html += '<p style="font-size: 12px; color: #4b5563; margin: 1px 0 0 0;">' + escapeHtml([edu.degree, edu.field].filter(Boolean).join(', ')) + '</p>';
            html += '</div>';
          });
          html += '</div>';
        }

        // Skills
        if (data.skills) {
          const skillList = data.skills.split(/[\n,]/).map(s => s.trim()).filter(Boolean);
          if (skillList.length) {
            html += '<div style="margin-bottom: 14px;">';
            html += '<h2 style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #111827; border-bottom: 1px solid #d1d5db; padding-bottom: 3px; margin: 0 0 6px 0;">Skills</h2>';
            html += '<p style="margin: 0; color: #374151;">' + escapeHtml(skillList.join(' • ')) + '</p>';
            html += '</div>';
          }
        }

        // Projects
        if (data.projects.length) {
          html += '<div style="margin-bottom: 14px;">';
          html += '<h2 style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #111827; border-bottom: 1px solid #d1d5db; padding-bottom: 3px; margin: 0 0 6px 0;">Projects</h2>';
          data.projects.forEach(proj => {
            html += '<div style="margin-bottom: 8px;">';
            html += '<h3 style="font-size: 13px; font-weight: 600; color: #111827; margin: 0;">' + escapeHtml(proj.name || 'Project') + (proj.link ? ' <span style="font-weight: 400; font-size: 11px; color: #6366f1;">(' + escapeHtml(proj.link) + ')</span>' : '') + '</h3>';
            if (proj.bullets && proj.bullets.length) {
              html += '<ul style="margin: 2px 0 0 0; padding-left: 18px; color: #374151;">';
              proj.bullets.forEach(b => {
                if (b.trim()) html += '<li style="margin-bottom: 1px;">' + escapeHtml(b.trim()) + '</li>';
              });
              html += '</ul>';
            }
            html += '</div>';
          });
          html += '</div>';
        }

        // Certifications
        if (data.certifications.length) {
          html += '<div style="margin-bottom: 14px;">';
          html += '<h2 style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #111827; border-bottom: 1px solid #d1d5db; padding-bottom: 3px; margin: 0 0 6px 0;">Certifications</h2>';
          data.certifications.forEach(cert => {
            html += '<div style="margin-bottom: 4px;">';
            html += '<p style="margin: 0; color: #374151;"><strong>' + escapeHtml(cert.name || 'Certification') + '</strong> — ' + escapeHtml(cert.issuer || 'Issuer') + (cert.date ? ' <span style="color: #6b7280;">(' + escapeHtml(cert.date) + ')</span>' : '') + '</p>';
            html += '</div>';
          });
          html += '</div>';
        }

        html += '</div>';
        els.preview.innerHTML = html;
      }

      // ---------- Collect from simple fields ----------
      function collectPersonal() {
        data.personal.firstName = getVal('rb-firstName');
        data.personal.lastName = getVal('rb-lastName');
        data.personal.title = getVal('rb-title');
        data.personal.email = getVal('rb-email');
        data.personal.phone = getVal('rb-phone');
        data.personal.location = getVal('rb-location');
        data.personal.linkedin = getVal('rb-linkedin');
        data.personal.website = getVal('rb-website');
      }

      const simpleInputs = [
        'rb-firstName','rb-lastName','rb-title','rb-email','rb-phone','rb-location','rb-linkedin','rb-website','rb-summary','rb-skills'
      ];
      simpleInputs.forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.addEventListener('input', debounce(() => {
            collectPersonal();
            data.summary = getVal('rb-summary');
            data.skills = getVal('rb-skills');
            renderPreview();
            saveData(data);
          }, 200));
        }
      });

      // Photo upload
      const photoUpload = document.getElementById('photo-upload');
      const photoInput = document.getElementById('rb-photo-input');
      const photoPreviewArea = document.getElementById('photo-preview-area');
      const photoPreviewImg = document.getElementById('photo-preview-img');
      const photoText = document.getElementById('photo-text');

      photoUpload?.addEventListener('click', () => photoInput?.click());
      const MAX_PHOTO_SIZE = 5 * 1024 * 1024;
      photoInput?.addEventListener('change', (e) => {
        if (e.target.files[0]) {
          const file = e.target.files[0];
          const extOk = /\.(jpe?g|png|gif|bmp|webp)$/i.test(file.name);
          const mimeOk = file.type.startsWith('image/');
          if (!extOk || !mimeOk) {
            alert('Please upload a valid image file (JPG, PNG, WebP, GIF, BMP).');
            photoInput.value = '';
            return;
          }
          if (file.size > MAX_PHOTO_SIZE) {
            alert('Photo too large. Maximum size is 5 MB.');
            photoInput.value = '';
            return;
          }
          const reader = new FileReader();
          reader.onload = (ev) => {
            data.photo.dataUrl = ev.target.result;
            photoPreviewImg.src = data.photo.dataUrl;
            photoPreviewArea.classList.remove('hidden');
            photoText.textContent = 'Click to change photo';
            renderPreview();
            saveData(data);
          };
          reader.readAsDataURL(file);
        }
      });

      // Photo position
      document.querySelectorAll('input[name="photo-position"]').forEach(radio => {
        radio.addEventListener('change', (e) => {
          if (e.target.checked) {
            data.photo.position = e.target.value;
            renderPreview();
            saveData(data);
          }
        });
      });

      // ---------- Add buttons ----------
      document.getElementById('add-exp')?.addEventListener('click', () => {
        data.experience.push({ company: '', role: '', startDate: '', endDate: '', current: false, bullets: [''] });
        renderExperience();
        renderPreview();
        saveData(data);
      });
      document.getElementById('add-edu')?.addEventListener('click', () => {
        data.education.push({ school: '', degree: '', field: '', startDate: '', endDate: '' });
        renderEducation();
        renderPreview();
        saveData(data);
      });
      document.getElementById('add-project')?.addEventListener('click', () => {
        data.projects.push({ name: '', link: '', bullets: [''] });
        renderProjects();
        renderPreview();
        saveData(data);
      });
      document.getElementById('add-cert')?.addEventListener('click', () => {
        data.certifications.push({ name: '', issuer: '', date: '' });
        renderCertifications();
        renderPreview();
        saveData(data);
      });

      // ---------- Reset ----------
      document.getElementById('reset-data')?.addEventListener('click', () => {
        if (confirm('Are you sure? This will clear all resume data.')) {
          data = defaultData();
          localStorage.removeItem(STORAGE_KEY);
          simpleInputs.forEach(id => setVal(id, ''));
          if (photoPreviewImg) photoPreviewImg.src = '';
          if (photoPreviewArea) photoPreviewArea.classList.add('hidden');
          if (photoText) photoText.textContent = 'Click to upload photo: PNG, JPEG, WebP';
          document.querySelectorAll('input[name="photo-position"]').forEach(r => {
            r.checked = r.value === 'top-center';
          });
          renderExperience();
          renderEducation();
          renderProjects();
          renderCertifications();
          renderPreview();
        }
      });

      // ---------- JSON Export / Import ----------
      document.getElementById('export-json')?.addEventListener('click', () => {
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'resume-data.json';
        a.click();
        URL.revokeObjectURL(url);
      });

      document.getElementById('import-json-btn')?.addEventListener('click', () => {
        document.getElementById('import-json-file')?.click();
      });

      const MAX_JSON_SIZE = 1 * 1024 * 1024;
      function sanitizeResumeJson(raw) {
        if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return null;
        const out = {};
        const allowedTop = ['personal','photo','summary','experience','education','skills','projects','certifications'];
        const personalKeys = ['firstName','lastName','title','email','phone','location','linkedin','website'];
        for (const key of allowedTop) {
          if (!Object.prototype.hasOwnProperty.call(raw, key)) continue;
          if (key === '__proto__' || key === 'constructor' || key === 'prototype') continue;
          const val = raw[key];
          if (key === 'personal' && val && typeof val === 'object' && !Array.isArray(val)) {
            out.personal = {};
            for (const pk of personalKeys) {
              if (Object.prototype.hasOwnProperty.call(val, pk) && typeof val[pk] === 'string') {
                out.personal[pk] = val[pk].slice(0, 500);
              }
            }
          } else if (key === 'photo' && val && typeof val === 'object' && !Array.isArray(val)) {
            out.photo = { dataUrl: '', position: 'top-center' };
            if (typeof val.dataUrl === 'string') out.photo.dataUrl = val.dataUrl.slice(0, 500000);
            if (typeof val.position === 'string') out.photo.position = val.position.slice(0, 50);
          } else if (key === 'experience' && Array.isArray(val)) {
            out.experience = val.filter(item => item && typeof item === 'object').map(item => ({
              company: String(item.company || '').slice(0, 200),
              role: String(item.role || '').slice(0, 200),
              startDate: String(item.startDate || '').slice(0, 50),
              endDate: String(item.endDate || '').slice(0, 50),
              current: !!item.current,
              bullets: Array.isArray(item.bullets) ? item.bullets.filter(b => typeof b === 'string').map(b => b.slice(0, 1000)).slice(0, 20) : []
            })).slice(0, 50);
          } else if (key === 'education' && Array.isArray(val)) {
            out.education = val.filter(item => item && typeof item === 'object').map(item => ({
              school: String(item.school || '').slice(0, 200),
              degree: String(item.degree || '').slice(0, 200),
              field: String(item.field || '').slice(0, 200),
              startDate: String(item.startDate || '').slice(0, 50),
              endDate: String(item.endDate || '').slice(0, 50)
            })).slice(0, 20);
          } else if (key === 'projects' && Array.isArray(val)) {
            out.projects = val.filter(item => item && typeof item === 'object').map(item => ({
              name: String(item.name || '').slice(0, 200),
              link: String(item.link || '').slice(0, 500),
              bullets: Array.isArray(item.bullets) ? item.bullets.filter(b => typeof b === 'string').map(b => b.slice(0, 1000)).slice(0, 20) : []
            })).slice(0, 30);
          } else if (key === 'certifications' && Array.isArray(val)) {
            out.certifications = val.filter(item => item && typeof item === 'object').map(item => ({
              name: String(item.name || '').slice(0, 200),
              issuer: String(item.issuer || '').slice(0, 200),
              date: String(item.date || '').slice(0, 50)
            })).slice(0, 20);
          } else if ((key === 'skills' || key === 'summary') && typeof val === 'string') {
            out[key] = val.slice(0, 5000);
          }
        }
        return out;
      }

      document.getElementById('import-json-file')?.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;
        if (file.type !== 'application/json' && !file.name.toLowerCase().endsWith('.json')) {
          alert('Please upload a JSON file.');
          e.target.value = '';
          return;
        }
        if (file.size > MAX_JSON_SIZE) {
          alert('JSON file too large. Maximum size is 1 MB.');
          e.target.value = '';
          return;
        }
        const reader = new FileReader();
        reader.onload = (ev) => {
          try {
            const imported = JSON.parse(ev.target.result);
            const clean = sanitizeResumeJson(imported);
            if (!clean) { alert('Invalid JSON file.'); return; }
            data = Object.assign(defaultData(), clean);
            // Restore form values
            setVal('rb-firstName', data.personal.firstName);
            setVal('rb-lastName', data.personal.lastName);
            setVal('rb-title', data.personal.title);
            setVal('rb-email', data.personal.email);
            setVal('rb-phone', data.personal.phone);
            setVal('rb-location', data.personal.location);
            setVal('rb-linkedin', data.personal.linkedin);
            setVal('rb-website', data.personal.website);
            setVal('rb-summary', data.summary);
            setVal('rb-skills', data.skills);
            renderExperience();
            renderEducation();
            renderProjects();
            renderCertifications();
            renderPreview();
            saveData(data);
          } catch (err) {
            alert('Invalid JSON file.');
          }
        };
        reader.readAsText(file);
        e.target.value = '';
      });

      // ---------- Mobile tabs ----------
      els.tabEdit?.addEventListener('click', () => {
        els.panelEdit.classList.remove('hidden');
        els.panelPreview.classList.add('hidden');
        els.panelPreview.classList.remove('md:block');
        els.tabEdit.classList.add('bg-bae-primary', 'text-white');
        els.tabEdit.classList.remove('bg-bae-card', 'text-bae-muted');
        els.tabPreview.classList.remove('bg-bae-primary', 'text-white');
        els.tabPreview.classList.add('bg-bae-card', 'text-bae-muted');
      });
      els.tabPreview?.addEventListener('click', () => {
        els.panelEdit.classList.add('hidden');
        els.panelPreview.classList.remove('hidden');
        els.panelPreview.classList.add('md:block');
        els.tabPreview.classList.add('bg-bae-primary', 'text-white');
        els.tabPreview.classList.remove('bg-bae-card', 'text-bae-muted');
        els.tabEdit.classList.remove('bg-bae-primary', 'text-white');
        els.tabEdit.classList.add('bg-bae-card', 'text-bae-muted');
        renderPreview();
      });

      // ---------- PDF Export ----------
      document.getElementById('download-pdf')?.addEventListener('click', async () => {
        const btn = document.getElementById('download-pdf');
        const content = document.getElementById('resume-pdf-content');
        if (!content) { alert('Nothing to export. Please fill in your resume first.'); return; }

        btn.textContent = 'Generating PDF...';
        btn.disabled = true;

        const clone = content.cloneNode(true);
        clone.removeAttribute('id');
        clone.style.maxWidth = 'none';
        clone.style.width = '210mm';
        clone.style.margin = '0';
        clone.style.boxSizing = 'border-box';
        document.body.appendChild(clone);

        const opt = {
          margin: [8, 0, 8, 0],
          filename: 'resume.pdf',
          image: { type: 'jpeg', quality: 0.95 },
          html2canvas: { scale: 2, useCORS: true, logging: false, scrollX: 0, scrollY: 0 },
          jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
          pagebreak: { mode: ['css', 'legacy'], avoid: 'p, li, div, h1, h2, h3, h4, h5, h6, ul' }
        };

        try {
          await html2pdf().set(opt).from(clone).save();
        } catch (err) {
          console.error(err);
          alert('PDF generation failed. Please try again.');
        } finally {
          if (clone.parentNode) document.body.removeChild(clone);
          btn.textContent = 'Download PDF';
          btn.disabled = false;
        }
      });

      function dataUrlToArrayBuffer(dataUrl) {
        const base64 = dataUrl.split(',')[1];
        const binaryString = atob(base64);
        const bytes = new Uint8Array(binaryString.length);
        for (let i = 0; i < binaryString.length; i++) {
          bytes[i] = binaryString.charCodeAt(i);
        }
        return bytes.buffer;
      }

      // ---------- DOCX Export ----------
      document.getElementById('download-docx')?.addEventListener('click', async () => {
        const btn = document.getElementById('download-docx');
        if (typeof docx === 'undefined') { alert('Word export library not loaded. Please check your connection and refresh.'); return; }

        btn.textContent = 'Generating Word...';
        btn.disabled = true;

        try {
          const p = data.personal;
          const name = [p.firstName, p.lastName].filter(Boolean).join(' ') || 'Resume';
          const children = [];

          function addText(text, opts = {}) {
            children.push(new docx.Paragraph(Object.assign({ children: [new docx.TextRun(Object.assign({ text: text || '' }, opts))] }, opts.paragraph || {})));
          }

          function addHeading(text) {
            children.push(new docx.Paragraph({
              text: text,
              heading: docx.HeadingLevel.HEADING_2,
              spacing: { before: 200, after: 100 },
              border: { bottom: { color: 'd1d5db', space: 1, style: docx.BorderStyle.SINGLE, size: 6 } },
            }));
          }

          // Header with optional photo
          const photo = data.photo;
          const hasPhoto = !!photo.dataUrl;
          const photoPos = photo.position || 'top-center';

          if (hasPhoto) {
            const mimeMatch = photo.dataUrl.match(/data:image\/(png|jpe?g|gif|bmp|webp)/i);
            const imgType = mimeMatch ? mimeMatch[1].replace('jpeg', 'jpg').toLowerCase() : 'png';
            const imgBuffer = await dataUrlToArrayBuffer(photo.dataUrl);
            const imgRun = new docx.ImageRun({
              type: imgType,
              data: imgBuffer,
              transformation: { width: 75, height: 75 },
            });

            if (photoPos === 'top-left') {
              children.push(new docx.Paragraph({
                spacing: { after: 80 },
                children: [
                  imgRun,
                  new docx.TextRun({ text: '  ' + name, bold: true, size: 28 }),
                ],
              }));
            } else if (photoPos === 'top-right') {
              children.push(new docx.Paragraph({
                spacing: { after: 80 },
                alignment: docx.AlignmentType.END,
                children: [
                  new docx.TextRun({ text: name + '  ', bold: true, size: 28 }),
                  imgRun,
                ],
              }));
            } else {
              children.push(new docx.Paragraph({
                alignment: docx.AlignmentType.CENTER,
                spacing: { after: 40 },
                children: [imgRun],
              }));
              children.push(new docx.Paragraph({
                text: name,
                heading: docx.HeadingLevel.HEADING_1,
                alignment: docx.AlignmentType.CENTER,
                spacing: { after: 40 },
              }));
            }
          } else {
            children.push(new docx.Paragraph({
              text: name,
              heading: docx.HeadingLevel.HEADING_1,
              alignment: docx.AlignmentType.CENTER,
              spacing: { after: 40 },
            }));
          }

          // Contact
          const contactParts = [p.title, p.email, p.phone, p.location].filter(Boolean);
          const linkParts = [];
          if (p.linkedin) linkParts.push('LinkedIn: ' + p.linkedin);
          if (p.website) linkParts.push('Portfolio: ' + p.website);
          if (contactParts.length) {
            children.push(new docx.Paragraph({ text: contactParts.join(' | '), alignment: docx.AlignmentType.CENTER, spacing: { after: 20 } }));
          }
          if (linkParts.length) {
            children.push(new docx.Paragraph({ text: linkParts.join(' | '), alignment: docx.AlignmentType.CENTER, spacing: { after: 120 } }));
          }

          // Summary
          if (data.summary) {
            addHeading('Professional Summary');
            addText(data.summary);
          }

          // Experience
          if (data.experience.length) {
            addHeading('Work Experience');
            data.experience.forEach(job => {
              const dateStr = [job.startDate, job.current ? 'Present' : job.endDate].filter(Boolean).join(' – ');
              children.push(new docx.Paragraph({
                spacing: { before: 120, after: 0 },
                children: [
                  new docx.TextRun({ text: job.role || 'Role', bold: true }),
                  new docx.TextRun({ text: '  ' + dateStr, color: '6b7280', size: 20 }),
                ]
              }));
              children.push(new docx.Paragraph({ text: job.company || 'Company', italics: true, spacing: { after: 60 } }));
              if (job.bullets && job.bullets.length) {
                job.bullets.filter(b => b.trim()).forEach(b => {
                  children.push(new docx.Paragraph({ text: b.trim(), bullet: { level: 0 }, spacing: { after: 20 } }));
                });
              }
            });
          }

          // Education
          if (data.education.length) {
            addHeading('Education');
            data.education.forEach(edu => {
              const dateStr = [edu.startDate, edu.endDate].filter(Boolean).join(' – ');
              children.push(new docx.Paragraph({
                spacing: { before: 80, after: 0 },
                children: [
                  new docx.TextRun({ text: edu.school || 'School', bold: true }),
                  new docx.TextRun({ text: '  ' + dateStr, color: '6b7280', size: 20 }),
                ]
              }));
              children.push(new docx.Paragraph({ text: [edu.degree, edu.field].filter(Boolean).join(', '), spacing: { after: 40 } }));
            });
          }

          // Skills
          if (data.skills) {
            const skillList = data.skills.split(/[\n,]/).map(s => s.trim()).filter(Boolean);
            if (skillList.length) {
              addHeading('Skills');
              addText(skillList.join(' • '));
            }
          }

          // Projects
          if (data.projects.length) {
            addHeading('Projects');
            data.projects.forEach(proj => {
              children.push(new docx.Paragraph({
                spacing: { before: 80, after: 0 },
                children: [
                  new docx.TextRun({ text: proj.name || 'Project', bold: true }),
                  new docx.TextRun({ text: proj.link ? ' (' + proj.link + ')' : '', color: '6366f1', size: 20 }),
                ]
              }));
              if (proj.bullets && proj.bullets.length) {
                proj.bullets.filter(b => b.trim()).forEach(b => {
                  children.push(new docx.Paragraph({ text: b.trim(), bullet: { level: 0 }, spacing: { after: 20 } }));
                });
              }
            });
          }

          // Certifications
          if (data.certifications.length) {
            addHeading('Certifications');
            data.certifications.forEach(cert => {
              addText((cert.name || 'Certification') + ' — ' + (cert.issuer || 'Issuer') + (cert.date ? ' (' + cert.date + ')' : ''));
            });
          }

          const doc = new docx.Document({
            sections: [{
              properties: { page: { margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } },
              children: children,
            }]
          });

          const blob = await docx.Packer.toBlob(doc);
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'resume.docx';
          a.click();
          URL.revokeObjectURL(url);
        } catch (err) {
          console.error(err);
          alert('Word export failed. Please try again.');
        } finally {
          btn.textContent = 'Download Word';
          btn.disabled = false;
        }
      });

      // ---------- Init ----------
      function init() {
        setVal('rb-firstName', data.personal.firstName);
        setVal('rb-lastName', data.personal.lastName);
        setVal('rb-title', data.personal.title);
        setVal('rb-email', data.personal.email);
        setVal('rb-phone', data.personal.phone);
        setVal('rb-location', data.personal.location);
        setVal('rb-linkedin', data.personal.linkedin);
        setVal('rb-website', data.personal.website);
        setVal('rb-summary', data.summary);
        setVal('rb-skills', data.skills);
        if (data.photo.dataUrl) {
          photoPreviewImg.src = data.photo.dataUrl;
          photoPreviewArea.classList.remove('hidden');
          photoText.textContent = 'Click to change photo';
        }
        document.querySelectorAll('input[name="photo-position"]').forEach(r => {
          r.checked = r.value === (data.photo.position || 'top-center');
        });
        renderExperience();
        renderEducation();
        renderProjects();
        renderCertifications();
        renderPreview();
      }

      init();
    })();
  </script>
</BaseLayout>
