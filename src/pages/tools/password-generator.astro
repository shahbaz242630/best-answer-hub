,'needy','nerve','never','newly','nexus','ninja','noble','noise','north','notch','novel','nurse','ocean','offer','often','olive','onion','opera','orbit','order','organ','other','outer','oxide','ozone','paint','panel','panic','paper','party','pasta','patch','pause','peace','pearl','pedal','penny','phase','phone','piano','piece','pilot','pinch','pitch','pivot','place','plain','plane','plant','plate','plaza','pluck','plumb','plush','point','poker','polar','porch','pouch','power','prawn','press','price','pride','prime','print','prism','prize','probe','prone','proof','prose','proud','prove','puppy','purse','quack','quail','quart','queen','quest','quick','quiet','quill','quilt','quote','radio','rainy','raise','ranch','range','rapid','ratio','reach','ready','realm','rebel','refer','reign','relax','relay','renal','reply','reset','resin','rider','ridge','rifle','right','rigid','risky','rival','river','roast','robin','robot','rocky','rogue','roman','roost','rotor','rouge','rough','round','route','royal','rugby','ruler','rumor','rural','rusty','saber','sadly','saint','salad','salon','salsa','salty','salve','sandy','sassy','sauce','scale','scalp','scare','scarf','scene','scent','scoop','scope','score','scorn','scour','scout','scrap','screw','scrub','scuba','sedan','shack','shade','shady','shaft','shake','shaky','shame','shape','shard','share','shark','sharp','shave','sheep','sheer','sheet','shelf','shell','shift','shine','shiny','shirt','shock','shook','shoot','shore','short','shout','shove','shown','shrub','shrug','siege','sight','silky','silly','since','sixth','sixty','skate','skill','skull','skunk','slack','slang','slash','slate','sleek','sleep','sleet','slice','slick','slide','slope','sloth','small','smart','smash','smell','smile','smoke','snack','snail','snake','snare','snarl','sneak','sniff','snore','snout','snowy','snuck','soapy','sober','solar','solid','solve','sonar','sonic','sooty','sorry','sound','south','space','spade','spare','spark','spasm','spawn','speak','spear','speed','spell','spend','spent','spice','spicy','spike','spill','spine','spite','splat','split','spoil','spoke','spook','spool','spoon','spore','sport','spout','spray','spree','sprig','squad','squat','squib','squid','stack','staff','stage','stain','stair','stake','stale','stalk','stall','stamp','stand','stare','stark','start','stash','state','stays','steak','steal','steam','steed','steel','steep','steer','stern','stick','stiff','still','sting','stink','stock','stoke','stole','stomp','stone','stony','stood','stool','store','storm','story','stout','stove','strap','straw','stray','strip','strut','stuck','study','stuff','stump','stung','stunt','style','suave','sugar','suite','sulky','sunny','super','surge','sushi','swamp','swarm','swear','sweat','sweep','sweet','swell','swept','swift','swill','swine','swing','swipe','swirl','swish','swoop','sword','sworn','synod','syrup','table','tacky','taint','tally','talon','tango','taper','tardy','taste','tasty','teach','tease','teddy','teeth','tempo','tenor','tense','tenth','tepee','terra','testy','thank','theft','theme','thick','thief','thigh','thing','think','third','thorn','those','three','threw','throb','throw','thrum','thumb','thump','thyme','tibia','tidal','tiger','tight','tilde','timer','timid','tinge','titan','title','toast','today','token','tonic','tooth','topic','torch','torso','total','totem','touch','tough','towel','tower','toxic','trace','track','tract','trade','trail','train','trait','tramp','trash','tread','treat','trend','triad','trial','tribe','trick','tried','tripe','trite','troll','troop','trout','trove','truce','truck','truly','trump','trunk','trust','truth','tulip','tumor','tunic','turbo','tutor','twang','tweak','tweed','twice','twine','twirl','twist','uncle','uncut','under','undue','unify','union','unite','unity','until','upper','upset','urban','urine','usage','usher','using','usual','usurp','utter','vague','valid','valor','value','valve','vapor','vault','vegan','venom','venue','verge','verse','verso','verve','vicar','video','vigor','villa','vinyl','viola','viper','viral','virus','visit','visor','vista','vital','vivid','vocal','vodka','vogue','voice','voter','vouch','vowel','vying','wacky','wafer','wager','wagon','waist','waive','waltz','waste','watch','water','waver','waxen','weary','weave','wedge','weird','whale','wheat','wheel','where','which','whiff','while','whine','whirl','whisk','white','whole','whore','whose','widen','widow','width','wield','wight','wimpy','wince','winch','windy','wiser','witch','witty','woken','woman','woody','wooer','words','world','worry','worse','worst','worth','would','wound','woven','wrack','wrath','wreak','wreck','wrest','wring','wrist','write','wrong','wrote','xerox','yacht','yearn','yeast','yield','young','youth','zebra','zesty','zonal','zoned'
      ];

      const consonants = 'bcdfghjklmnpqrstvwxyz';
      const vowels = 'aeiou';
      const ambiguous = '0O1lI';
      const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      const lower = 'abcdefghijklmnopqrstuvwxyz';
      const numbers = '0123456789';
      const symbols = '!@#$%^&*()_+-=[]{}|;:,.<>?';

      function secureRand(max) {
        const arr = new Uint32Array(1);
        crypto.getRandomValues(arr);
        return arr[0] % max;
      }

      function calcEntropy(len, poolSize) {
        const bits = Math.log2(Math.pow(poolSize, len));
        return bits < 10 ? bits.toFixed(1) : Math.round(bits);
      }

      // --- Random Password ---
      function generateRandom() {
        const len = parseInt(document.getElementById('rand-len').value);
        const useUpper = document.getElementById('rand-upper').checked;
        const useLower = document.getElementById('rand-lower').checked;
        const useNum = document.getElementById('rand-number').checked;
        const useSym = document.getElementById('rand-symbol').checked;
        const noAmbig = document.getElementById('rand-ambig').checked;

        let pool = '';
        if (useUpper) pool += noAmbig ? upper.replace(/[O]/g,'') : upper;
        if (useLower) pool += noAmbig ? lower.replace(/[l]/g,'') : lower;
        if (useNum) pool += noAmbig ? numbers.replace(/[01]/g,'') : numbers;
        if (useSym) pool += symbols;

        if (!pool) { pool = lower; }

        let pw = '';
        for (let i = 0; i < len; i++) {
          pw += pool[secureRand(pool.length)];
        }

        document.getElementById('rand-output').textContent = pw;
        document.getElementById('rand-len-val').textContent = len;
        const bits = calcEntropy(len, pool.length);
        document.getElementById('rand-entropy').textContent = '~' + bits + ' bits';
      }

      // --- Memorable Passphrase ---
      let currentSep = ' ';
      function generatePassphrase() {
        const count = parseInt(document.getElementById('pass-count').value);
        const appendNum = document.getElementById('pass-num').checked;

        const words = [];
        for (let i = 0; i < count; i++) {
          words.push(wordList[secureRand(wordList.length)]);
        }
        let phrase = words.join(currentSep);
        if (appendNum) phrase += currentSep + secureRand(100);

        document.getElementById('pass-output').textContent = phrase;
        document.getElementById('pass-count-val').textContent = count;
        const bits = calcEntropy(count, wordList.length);
        document.getElementById('pass-entropy').textContent = '~' + bits + ' bits';
      }

      // --- Enterprise ---
      function generateEnterprise() {
        const len = parseInt(document.getElementById('ent-len').value);
        let pool = '';
        pool += upper.replace(/[OI]/g,'');
        pool += lower.replace(/[l]/g,'');
        pool += numbers.replace(/[01]/g,'');
        pool += symbols;

        let pw = '';
        for (let i = 0; i < len; i++) {
          pw += pool[secureRand(pool.length)];
        }
        // Ensure at least one of each type
        const all = [upper.replace(/[OI]/g,''), lower.replace(/[l]/g,''), numbers.replace(/[01]/g,''), symbols];
        let final = pw.split('');
        for (let i = 0; i < 4 && i < len; i++) {
          const set = all[i];
          final[i] = set[secureRand(set.length)];
        }
        // Shuffle
        for (let i = final.length - 1; i > 0; i--) {
          const j = secureRand(i + 1);
          [final[i], final[j]] = [final[j], final[i]];
        }

        document.getElementById('ent-output').textContent = final.join('');
        document.getElementById('ent-len-val').textContent = len;
        const bits = calcEntropy(len, pool.length);
        document.getElementById('ent-entropy').textContent = '~' + bits + ' bits';
      }

      // --- Pronounceable ---
      function generatePronounceable() {
        const sylCount = parseInt(document.getElementById('pro-syl').value);
        const appendNum = document.getElementById('pro-num').checked;
        const capitalize = document.getElementById('pro-cap').checked;

        let pw = '';
        for (let i = 0; i < sylCount; i++) {
          const c1 = consonants[secureRand(consonants.length)];
          const v = vowels[secureRand(vowels.length)];
          const c2 = consonants[secureRand(consonants.length)];
          pw += c1 + v + c2;
        }
        if (capitalize) pw = pw.charAt(0).toUpperCase() + pw.slice(1);
        if (appendNum) pw += secureRand(100);

        document.getElementById('pro-output').textContent = pw;
        document.getElementById('pro-syl-val').textContent = sylCount;
        const pool = consonants + vowels;
        const bits = calcEntropy(pw.length, pool.length);
        document.getElementById('pro-entropy').textContent = '~' + bits + ' bits';
      }

      // --- Copy functionality ---
      document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const targetId = btn.dataset.copy;
          const text = document.getElementById(targetId).textContent;
          if (!text || text === 'Click generate') return;
          try {
            await navigator.clipboard.writeText(text);
            const original = btn.innerHTML;
            btn.innerHTML = '<svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
            setTimeout(() => { btn.innerHTML = original; }, 1200);
          } catch (e) {
            // Fallback
            const ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            const original = btn.innerHTML;
            btn.innerHTML = '<svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
            setTimeout(() => { btn.innerHTML = original; }, 1200);
          }
        });
      });

      // --- Event bindings ---
      document.getElementById('rand-gen').addEventListener('click', generateRandom);
      document.getElementById('rand-len').addEventListener('input', generateRandom);
      document.getElementById('rand-upper').addEventListener('change', generateRandom);
      document.getElementById('rand-lower').addEventListener('change', generateRandom);
      document.getElementById('rand-number').addEventListener('change', generateRandom);
      document.getElementById('rand-symbol').addEventListener('change', generateRandom);
      document.getElementById('rand-ambig').addEventListener('change', generateRandom);

      document.getElementById('pass-gen').addEventListener('click', generatePassphrase);
      document.getElementById('pass-count').addEventListener('input', generatePassphrase);
      document.getElementById('pass-num').addEventListener('change', generatePassphrase);
      document.querySelectorAll('.sep-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentSep = btn.dataset.sep;
          document.querySelectorAll('.sep-btn').forEach(b => {
            const active = b === btn;
            b.classList.toggle('bg-bae-primary', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('border-bae-primary', active);
            b.classList.toggle('bg-bae-bg', !active);
            b.classList.toggle('text-bae-muted', !active);
            b.classList.toggle('border-bae-border', !active);
          });
          generatePassphrase();
        });
      });

      document.getElementById('ent-gen').addEventListener('click', generateEnterprise);
      document.getElementById('ent-len').addEventListener('input', generateEnterprise);

      document.getElementById('pro-gen').addEventListener('click', generatePronounceable);
      document.getElementById('pro-syl').addEventListener('input', generatePronounceable);
      document.getElementById('pro-num').addEventListener('change', generatePronounceable);
      document.getElementById('pro-cap').addEventListener('change', generatePronounceable);

      // Initial generation
      generateRandom();
      generatePassphrase();
      generateEnterprise();
      generatePronounceable();
    })();
  </script>
