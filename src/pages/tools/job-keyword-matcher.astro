      function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      function countWords(text) {
        return text.trim().split(/\s+/).filter(w => w.length > 0).length;
      }

      function cleanText(text) {
        return text.toLowerCase()
          .replace(/[^\w\s]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      function extractKeywords(text) {
        const clean = cleanText(text);
        const words = clean.split(' ').filter(w => w.length > 2 && !STOP_WORDS.has(w));

        const freq = {};
        words.forEach(w => { freq[w] = (freq[w] || 0) + 1; });

        // Bigrams
        const rawWords = clean.split(' ').filter(w => w.length > 0);
        const bigramFreq = {};
        for (let i = 0; i < rawWords.length - 1; i++) {
          if (!STOP_WORDS.has(rawWords[i]) && !STOP_WORDS.has(rawWords[i+1])) {
            const bg = rawWords[i] + ' ' + rawWords[i+1];
            bigramFreq[bg] = (bigramFreq[bg] || 0) + 1;
          }
        }

        // Trigrams
        const trigramFreq = {};
        for (let i = 0; i < rawWords.length - 2; i++) {
          if (!STOP_WORDS.has(rawWords[i]) && !STOP_WORDS.has(rawWords[i+1]) && !STOP_WORDS.has(rawWords[i+2])) {
            const tg = rawWords[i] + ' ' + rawWords[i+1] + ' ' + rawWords[i+2];
            trigramFreq[tg] = (trigramFreq[tg] || 0) + 1;
          }
        }

        const keywords = [];
        Object.entries(freq).forEach(([word, count]) => {
          if (count >= 2 || word.length > 5 || SKILL_TERMS.has(word)) {
            keywords.push(word);
          }
        });
        Object.entries(bigramFreq).forEach(([phrase, count]) => {
          if (count >= 2 || SKILL_TERMS.has(phrase.replace(/\s/g,''))) {
            keywords.push(phrase);
          }
        });
        Object.entries(trigramFreq).forEach(([phrase, count]) => {
          if (count >= 2) {
            keywords.push(phrase);
          }
        });

        return [...new Set(keywords)];
      }

      function analyze() {
        const jobText = document.getElementById('job-text').value;
        const resumeText = document.getElementById('resume-text').value;

        if (!jobText.trim() || !resumeText.trim()) {
          alert('Please paste both a job description and your resume text.');
          return;
        }

        const jobKeywords = extractKeywords(jobText);
        const resumeClean = cleanText(resumeText);

        // Whole-word / whole-phrase match. cleanText() reduces both sides to
        // word-chars + single spaces, so a \b…\b regex is exact and safe — this
        // mirrors how real ATS systems match (exact terms, not substrings),
        // avoiding false positives like "java" matching "javascript".
        function resumeHasKeyword(kw) {
          const re = new RegExp('\\b' + kw.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\b');
          return re.test(resumeClean);
        }

        const matched = [];
        const missing = [];

        jobKeywords.forEach(kw => {
          if (resumeHasKeyword(kw)) matched.push(kw); else missing.push(kw);
        });

        const total = jobKeywords.length;
        const score = total > 0 ? Math.round((matched.length / total) * 100) : 0;

        // Update UI
        document.getElementById('match-score').textContent = score + '%';
        document.getElementById('matched-count').textContent = matched.length;
        document.getElementById('missing-count').textContent = missing.length;
        document.getElementById('total-count').textContent = total;

        let msg = '';
        if (score >= 80) msg = 'Strong alignment. Your resume covers most of the key terms from this job description.';
        else if (score >= 60) msg = 'Decent match. Consider adding some of the missing keywords to improve your chances.';
        else if (score >= 40) msg = 'Weak match. Your resume may be filtered out by ATS before a human sees it. Add more relevant keywords.';
        else msg = 'Very low match. This role uses very different language from your resume. Consider tailoring significantly or applying to roles that better align with your experience.';
        document.getElementById('match-message').textContent = msg;

        // Render matched
        const matchedContainer = document.getElementById('matched-keywords');
        matchedContainer.innerHTML = matched.length ? matched.map(k => `<span class="inline-flex items-center gap-1 text-xs font-medium px-2.5 py-1 rounded-full bg-green-100 text-green-700 border border-green-200">${escapeHtml(k)}</span>`).join('') : '<span class="text-xs text-bae-muted">No matched keywords found.</span>';

        // Render missing
        const missingContainer = document.getElementById('missing-keywords');
        missingContainer.innerHTML = missing.length ? missing.map(k => `<span class="inline-flex items-center gap-1 text-xs font-medium px-2.5 py-1 rounded-full bg-red-100 text-red-700 border border-red-200">${escapeHtml(k)}</span>`).join('') : '<span class="text-xs text-bae-muted">No missing keywords. Great job!</span>';

        // Show results
        document.getElementById('results-panel').classList.remove('hidden');
        document.getElementById('copy-missing-btn').disabled = missing.length === 0;
        document.getElementById('download-pdf-btn').disabled = false;

        // Build PDF content
        const pdfContent = document.getElementById('pdf-report-content');
        let pdfHtml = '<div style="padding: 40px 48px; font-family: Arial, Helvetica, sans-serif; font-size: 13px; color: #1f2937; line-height: 1.6;">';
        pdfHtml += '<h1 style="font-size: 20px; font-weight: 700; margin: 0 0 16px 0;">Job Keyword Matcher Report</h1>';
        pdfHtml += '<p style="margin: 0 0 12px 0;"><strong>Match Score:</strong> ' + score + '%</p>';
        pdfHtml += '<p style="margin: 0 0 12px 0;"><strong>Matched:</strong> ' + matched.length + ' &nbsp;|&nbsp; <strong>Missing:</strong> ' + missing.length + ' &nbsp;|&nbsp; <strong>Total:</strong> ' + total + '</p>';
        pdfHtml += '<p style="margin: 0 0 24px 0; color: #4b5563;">' + escapeHtml(msg) + '</p>';

        if (matched.length) {
          pdfHtml += '<h2 style="font-size: 14px; font-weight: 700; margin: 0 0 8px 0; color: #15803d;">Matched Keywords</h2>';
          pdfHtml += '<p style="margin: 0 0 16px 0;">' + matched.map(k => escapeHtml(k)).join(', ') + '</p>';
        }
        if (missing.length) {
          pdfHtml += '<h2 style="font-size: 14px; font-weight: 700; margin: 0 0 8px 0; color: #b91c1c;">Missing Keywords</h2>';
          pdfHtml += '<p style="margin: 0 0 16px 0;">' + missing.map(k => escapeHtml(k)).join(', ') + '</p>';
        }
        pdfHtml += '</div>';
        pdfContent.innerHTML = pdfHtml;

        // Scroll to results
        document.getElementById('results-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // Word count updates
      document.getElementById('job-text')?.addEventListener('input', (e) => {
        document.getElementById('job-stats').textContent = countWords(e.target.value) + ' words';
      });
      document.getElementById('resume-text')?.addEventListener('input', (e) => {
        document.getElementById('resume-stats').textContent = countWords(e.target.value) + ' words';
      });

      // Buttons
      document.getElementById('analyze-btn')?.addEventListener('click', analyze);
      document.getElementById('clear-job')?.addEventListener('click', () => {
        document.getElementById('job-text').value = '';
        document.getElementById('job-stats').textContent = '0 words';
      });
      document.getElementById('clear-resume')?.addEventListener('click', () => {
        document.getElementById('resume-text').value = '';
        document.getElementById('resume-stats').textContent = '0 words';
      });

      function copyToClipboard(text, btnId, successLabel) {
        if (!text) return;
        const btn = document.getElementById(btnId);
        const original = btn ? btn.textContent : '';

        function onSuccess() {
          if (btn) {
            btn.textContent = successLabel || 'Copied!';
            setTimeout(() => btn.textContent = original, 1500);
          }
        }

        function fallbackCopy() {
          try {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.left = '-9999px';
            ta.style.top = '0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            const ok = document.execCommand('copy');
            document.body.removeChild(ta);
            if (ok) onSuccess();
            else alert('Copy failed. Please copy manually.');
          } catch (e) {
            alert('Copy failed. Please copy manually.');
          }
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(onSuccess).catch(fallbackCopy);
        } else {
          fallbackCopy();
        }
      }

      document.getElementById('copy-missing-btn')?.addEventListener('click', () => {
        const missingContainer = document.getElementById('missing-keywords');
        if (!missingContainer) return;
        const badges = missingContainer.querySelectorAll('span');
        const text = Array.from(badges).map(b => b.textContent).join(', ');
        copyToClipboard(text, 'copy-missing-btn', 'Copied!');
      });

      document.getElementById('download-pdf-btn')?.addEventListener('click', async () => {
        const btn = document.getElementById('download-pdf-btn');
        const pdfContainer = document.getElementById('pdf-report-content');
        const content = pdfContainer.firstElementChild;
        if (!content) { alert('Please run the analysis first.'); return; }

        btn.textContent = 'Generating...';
        btn.disabled = true;

        const clone = content.cloneNode(true);
        clone.removeAttribute('id');
        clone.style.maxWidth = 'none';
        clone.style.width = '210mm';
        clone.style.margin = '0';
        clone.style.boxSizing = 'border-box';
        document.body.appendChild(clone);

        try {
          await html2pdf().set({
            margin: 0,
            filename: 'keyword-match-report.pdf',
            image: { type: 'jpeg', quality: 0.95 },
            html2canvas: { scale: 2, useCORS: true, logging: false, scrollX: 0, scrollY: 0 },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
            pagebreak: { mode: ['css', 'legacy'], avoid: 'p, li, div, h1, h2, h3, h4, h5, h6, ul, tr, td, table' }
          }).from(clone).save();
        } catch (err) {
          console.error(err);
          alert('PDF generation failed. Please try again.');
        } finally {
          if (clone.parentNode) document.body.removeChild(clone);
          btn.textContent = 'Download PDF Report';
          btn.disabled = false;
        }
      });

      // Import from Resume Builder
      function tryImportResume() {
        try {
          const raw = localStorage.getItem('resume-builder-data-v1');
          if (!raw) return;
          const data = JSON.parse(raw);
          const parts = [];
          if (data.summary) parts.push(data.summary);
          if (Array.isArray(data.experience)) {
            data.experience.forEach(job => {
              if (job.role) parts.push(job.role);
              if (job.company) parts.push(job.company);
              if (Array.isArray(job.bullets)) parts.push(job.bullets.join(' '));
            });
          }
          if (Array.isArray(data.education)) {
            data.education.forEach(edu => {
              if (edu.school) parts.push(edu.school);
              if (edu.degree) parts.push(edu.degree);
              if (edu.field) parts.push(edu.field);
            });
          }
          if (data.skills) parts.push(data.skills);
          if (Array.isArray(data.projects)) {
            data.projects.forEach(proj => {
              if (proj.name) parts.push(proj.name);
              if (Array.isArray(proj.bullets)) parts.push(proj.bullets.join(' '));
            });
          }
          if (Array.isArray(data.certifications)) {
            data.certifications.forEach(cert => {
              if (cert.name) parts.push(cert.name);
              if (cert.issuer) parts.push(cert.issuer);
            });
          }
          const fullText = parts.join('\n\n');
          if (!fullText.trim()) return;

          const importBtn = document.getElementById('import-resume-btn');
          importBtn.classList.remove('hidden');
          importBtn.addEventListener('click', () => {
            document.getElementById('resume-text').value = fullText;
            document.getElementById('resume-stats').textContent = countWords(fullText) + ' words';
          });
        } catch (e) {}
      }

      tryImportResume();
    })();
  </script>
</BaseLayout>
