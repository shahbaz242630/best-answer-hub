  <script slot="scripts" src="/html2pdf.bundle.min.js"></script>
  <script is:inline define:vars={{ pricingData }}>
    (function() {
      // Stamp the "Generated" date at runtime (user's date), not at build time —
      // a build-time date changes the static HTML daily and causes a spurious
      // IndexNow re-submit for an otherwise-unchanged page.
      const genDateEl = document.getElementById('report-gen-date');
      if (genDateEl) genDateEl.textContent = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      const currencies = pricingData.currencies;
      const WORK_DAYS_PER_MONTH = 22;
      let currentCurrency = 'USD';
      let currentMode = 'personal';

      function formatMoney(amount, currencyCode) {
        const c = currencies[currencyCode];
        const converted = amount * c.rate;
        if (converted >= 100) return c.symbol + Math.round(converted).toLocaleString();
        if (converted >= 1) return c.symbol + converted.toFixed(2);
        return c.symbol + converted.toFixed(3);
      }

      function getMonthlyTokens(dailyReqs, tokensPerReq) {
        return dailyReqs * tokensPerReq * WORK_DAYS_PER_MONTH;
      }

      function calculate() {
        let totalMonthly = 0;
        let totalSeats = 0;
        const breakdown = [];

        // Subscription tools
        document.querySelectorAll('.tool-card[data-tool-type="subscription"]').forEach(card => {
          const check = card.querySelector('.tool-check');
          if (!check.checked) return;
          const toolId = card.dataset.toolId;
          const tierSelect = card.querySelector('.tool-tier');
          const tierOption = tierSelect.options[tierSelect.selectedIndex];
          const price = parseFloat(tierOption.dataset.price);
          const perSeat = tierOption.dataset.perSeat === 'true';
          const seatsInput = card.querySelector('.tool-seats');
          const seats = parseInt(seatsInput?.value || '1', 10);
          const count = (currentMode === 'business' && perSeat) ? seats : (perSeat ? seats : 1);
          const monthly = price * count;
          totalMonthly += monthly;
          if (perSeat || currentMode === 'business') totalSeats += count;
          breakdown.push({
            name: card.querySelector('.font-semibold').textContent.trim(),
            plan: tierOption.text.split('—')[0].trim(),
            monthly,
            detail: perSeat ? `${count} seat${count > 1 ? 's' : ''}` : 'fixed'
          });
        });

        // API platforms
        document.querySelectorAll('.tool-card[data-tool-type="api"]').forEach(card => {
          const check = card.querySelector('.tool-check');
          if (!check.checked) return;
          const platformName = card.querySelector('.font-semibold').textContent.trim();
          const modelSelect = card.querySelector('.tool-model');
          const modelOption = modelSelect.options[modelSelect.selectedIndex];
          const inputRate = parseFloat(modelOption.dataset.input);
          const outputRate = parseFloat(modelOption.dataset.output);
          const inputTokens = parseInt(card.querySelector('.tool-input-tokens').value || '0', 10);
          const outputTokens = parseInt(card.querySelector('.tool-output-tokens').value || '0', 10);
          const monthly = ((inputTokens / 1e6) * inputRate + (outputTokens / 1e6) * outputRate) * 1.15; // 15% buffer
          totalMonthly += monthly;
          breakdown.push({
            name: platformName,
            plan: modelOption.text.split('(')[0].trim(),
            monthly,
            detail: `${(inputTokens/1e6).toFixed(2)}M in / ${(outputTokens/1e6).toFixed(2)}M out`
          });
        });

        // Cursor BYOK
        const cursorByokCard = document.querySelector('.tool-card[data-tool-id="cursor-byok"]');
        if (cursorByokCard) {
          const check = cursorByokCard.querySelector('.tool-check');
          if (check.checked) {
            const tierSelect = cursorByokCard.querySelector('.cursor-tier');
            const tierOption = tierSelect.options[tierSelect.selectedIndex];
            const subPrice = parseFloat(tierOption.dataset.price);
            const seats = parseInt(cursorByokCard.querySelector('.cursor-seats')?.value || '1', 10);
            const isBusiness = tierOption.value === 'cursor-business';
            const seatCount = (currentMode === 'business' || isBusiness) ? seats : (isBusiness ? seats : 1);
            const subMonthly = subPrice * seatCount;
            totalMonthly += subMonthly;
            if (isBusiness || currentMode === 'business') totalSeats += seatCount;

            const modelSelect = cursorByokCard.querySelector('.cursor-api-model');
            const modelOption = modelSelect.options[modelSelect.selectedIndex];
            const inputRate = parseFloat(modelOption.dataset.input);
            const outputRate = parseFloat(modelOption.dataset.output);
            const inputTokens = parseInt(cursorByokCard.querySelector('.cursor-input-tokens').value || '0', 10);
            const outputTokens = parseInt(cursorByokCard.querySelector('.cursor-output-tokens').value || '0', 10);
            const apiMonthly = ((inputTokens / 1e6) * inputRate + (outputTokens / 1e6) * outputRate) * 1.15;
            totalMonthly += apiMonthly;

            breakdown.push({
              name: 'Cursor (BYOK)',
              plan: tierOption.text.split('—')[0].trim() + ' + ' + modelOption.text.split('(')[0].trim(),
              monthly: subMonthly + apiMonthly,
              detail: `Sub ${seatCount} seat${seatCount>1?'s':''} + API ${(inputTokens/1e6).toFixed(2)}M/${(outputTokens/1e6).toFixed(2)}M`
            });
          }
        }

        // Update UI
        const annual = totalMonthly * 12;
        document.getElementById('summary-monthly').textContent = formatMoney(totalMonthly, currentCurrency);
        document.getElementById('summary-annual').textContent = formatMoney(annual, currentCurrency);

        const perUserWrapper = document.getElementById('per-user-wrapper');
        if (currentMode === 'business' && totalSeats > 0) {
          perUserWrapper.classList.remove('hidden');
          document.getElementById('summary-per-user').textContent = formatMoney(totalMonthly / totalSeats, currentCurrency);
        } else {
          perUserWrapper.classList.add('hidden');
        }

        // Breakdown list
        const list = document.getElementById('breakdown-list');
        list.textContent = '';
        if (breakdown.length === 0) {
          const p = document.createElement('p');
          p.className = 'text-sm text-bae-muted';
          p.textContent = 'Select tools above to see your cost breakdown.';
          list.appendChild(p);
        } else {
          breakdown.forEach(item => {
            const row = document.createElement('div');
            row.className = 'flex items-center justify-between text-sm';

            const left = document.createElement('div');
            left.className = 'truncate pr-2';

            const nameSpan = document.createElement('span');
            nameSpan.className = 'font-medium text-bae-ink';
            nameSpan.textContent = item.name;

            const planSpan = document.createElement('span');
            planSpan.className = 'text-bae-muted';
            planSpan.textContent = ' — ' + item.plan;

            left.appendChild(nameSpan);
            left.appendChild(planSpan);

            const costSpan = document.createElement('span');
            costSpan.className = 'font-semibold text-bae-ink shrink-0';
            costSpan.textContent = formatMoney(item.monthly, currentCurrency);

            row.appendChild(left);
            row.appendChild(costSpan);
            list.appendChild(row);

            const detailDiv = document.createElement('div');
            detailDiv.className = 'text-[11px] text-bae-muted -mt-1 mb-1';
            detailDiv.textContent = item.detail;
            list.appendChild(detailDiv);
          });
        }

        const pdfBtn = document.getElementById('pdf-btn');
        if (breakdown.length > 0) {
          pdfBtn.classList.remove('hidden');
        } else {
          pdfBtn.classList.add('hidden');
        }

        // Populate print report
        document.getElementById('print-monthly').textContent = formatMoney(totalMonthly, currentCurrency);
        document.getElementById('print-annual').textContent = formatMoney(annual, currentCurrency);
        const printBreakdown = document.getElementById('print-breakdown');
        printBreakdown.textContent = '';
        if (breakdown.length > 0) {
          breakdown.forEach(item => {
            const row = document.createElement('div');
            row.className = 'flex justify-between border-b border-bae-border py-2';

            const left = document.createElement('div');

            const nameSpan = document.createElement('span');
            nameSpan.className = 'font-medium';
            nameSpan.textContent = item.name;

            const planSpan = document.createElement('span');
            planSpan.className = 'text-bae-muted';
            planSpan.textContent = ' — ' + item.plan;

            const detailDiv = document.createElement('div');
            detailDiv.className = 'text-xs text-bae-muted';
            detailDiv.textContent = item.detail;

            left.appendChild(nameSpan);
            left.appendChild(planSpan);
            left.appendChild(detailDiv);

            const costSpan = document.createElement('span');
            costSpan.className = 'font-semibold';
            costSpan.textContent = formatMoney(item.monthly, currentCurrency);

            row.appendChild(left);
            row.appendChild(costSpan);
            printBreakdown.appendChild(row);
          });
        } else {
          const p = document.createElement('p');
          p.className = 'text-bae-muted';
          p.textContent = 'No tools selected.';
          printBreakdown.appendChild(p);
        }
      }

      // Currency toggle
      document.getElementById('currency-toggle').addEventListener('click', (e) => {
        const btn = e.target.closest('.currency-btn');
        if (!btn) return;
        currentCurrency = btn.dataset.currency;
        document.querySelectorAll('.currency-btn').forEach(b => {
          b.classList.toggle('bg-bae-ink', b.dataset.currency === currentCurrency);
          b.classList.toggle('text-white', b.dataset.currency === currentCurrency);
          b.classList.toggle('text-bae-muted', b.dataset.currency !== currentCurrency);
        });
        calculate();
      });

      // Mode toggle
      document.getElementById('mode-toggle').addEventListener('click', (e) => {
        const btn = e.target.closest('.mode-btn');
        if (!btn) return;
        currentMode = btn.dataset.mode;
        document.querySelectorAll('.mode-btn').forEach(b => {
          b.classList.toggle('bg-bae-primary', b.dataset.mode === currentMode);
          b.classList.toggle('text-white', b.dataset.mode === currentMode);
          b.classList.toggle('text-bae-muted', b.dataset.mode !== currentMode);
        });
        calculate();
      });

      // Tool checkbox expand/collapse
      document.querySelectorAll('.tool-check').forEach(check => {
        check.addEventListener('change', () => {
          const card = check.closest('.tool-card');
          const config = card.querySelector('.tool-config');
          if (check.checked) {
            config.classList.remove('hidden');
            card.classList.add('border-bae-primary', 'ring-1', 'ring-bae-primary/20');
            // Auto-populate tokens for API tools if preset selected
            const preset = card.querySelector('.tool-preset');
            if (preset && preset.value !== 'custom') {
              preset.dispatchEvent(new Event('change'));
            }
          } else {
            config.classList.add('hidden');
            card.classList.remove('border-bae-primary', 'ring-1', 'ring-bae-primary/20');
          }
          calculate();
        });
      });

      // Preset change -> fill tokens
      document.querySelectorAll('.tool-preset').forEach(select => {
        select.addEventListener('change', () => {
          const card = select.closest('.tool-card');
          const option = select.options[select.selectedIndex];
          if (select.value === 'custom') return;
          const daily = parseInt(option.dataset.daily, 10);
          const input = parseInt(option.dataset.input, 10);
          const output = parseInt(option.dataset.output, 10);
          card.querySelector('.tool-input-tokens').value = getMonthlyTokens(daily, input);
          card.querySelector('.tool-output-tokens').value = getMonthlyTokens(daily, output);
          calculate();
        });
      });

      // API model, token inputs, seats — auto-calculate
      document.querySelectorAll('.tool-model, .tool-input-tokens, .tool-output-tokens, .tool-seats').forEach(el => {
        el.addEventListener('input', calculate);
      });

      // Cursor API provider switch
      const cursorProvider = document.querySelector('.cursor-api-provider');
      if (cursorProvider) {
        cursorProvider.addEventListener('change', () => {
          const provider = cursorProvider.value;
          const modelSelect = document.querySelector('.cursor-api-model');
          // 'claude-api' -> 'claude'. Matching on data-provider means a new vendor is a markup
          // change only; the old boolean class could only ever express "OpenAI or not".
          const key = provider.replace(/-api$/, '');
          Array.from(modelSelect.options).forEach(opt => {
            opt.classList.toggle('hidden', opt.dataset.provider !== key);
          });
          // Select first visible
          const firstVisible = Array.from(modelSelect.options).find(o => !o.classList.contains('hidden'));
          if (firstVisible) modelSelect.value = firstVisible.value;
          calculate();
        });
      }

      // Cursor inputs — auto-calculate
      document.querySelectorAll('.cursor-api-model, .cursor-input-tokens, .cursor-output-tokens, .cursor-seats').forEach(el => {
        el.addEventListener('input', calculate);
      });

      // PDF buttons
      async function downloadPDF() {
        if (typeof html2pdf === 'undefined') return;
        const element = document.getElementById('print-report');
        const clone = element.cloneNode(true);
        clone.removeAttribute('id');
        clone.classList.remove('hidden');
        clone.style.maxWidth = '100%';
        clone.style.width = '190mm';
        clone.style.margin = '0';
        clone.style.boxSizing = 'border-box';
        document.body.appendChild(clone);
        try {
          await html2pdf().set({
            margin: [6, 6, 6, 6],
            filename: 'ai-stack-cost-report.pdf',
            image: { type: 'jpeg', quality: 0.95 },
            html2canvas: { scale: 2, useCORS: true, logging: false, scrollX: 0, scrollY: 0 },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
            pagebreak: { mode: ['css', 'legacy'], avoid: 'p, li, div, h1, h2, h3, h4, h5, h6, ul, tr, td, table' }
          }).from(clone).save();
        } catch (err) {
          console.error(err);
        } finally {
          if (clone.parentNode) document.body.removeChild(clone);
        }
      }
      document.getElementById('pdf-btn').addEventListener('click', downloadPDF);
      // Reset
      document.getElementById('clear-btn').addEventListener('click', () => {
        // Uncheck all tools
        document.querySelectorAll('.tool-check').forEach(check => {
          check.checked = false;
          const card = check.closest('.tool-card');
          const config = card.querySelector('.tool-config');
          if (config) config.classList.add('hidden');
          card.classList.remove('border-bae-primary', 'ring-1', 'ring-bae-primary/20');
        });
        // Reset subscription tiers to first option
        document.querySelectorAll('.tool-tier').forEach(select => {
          select.selectedIndex = 0;
        });
        // Reset API models to first option
        document.querySelectorAll('.tool-model').forEach(select => {
          select.selectedIndex = 0;
        });
        // Reset presets to custom
        document.querySelectorAll('.tool-preset').forEach(select => {
          select.value = 'custom';
        });
        // Zero token inputs
        document.querySelectorAll('.tool-input-tokens, .tool-output-tokens').forEach(input => {
          input.value = 0;
        });
        // Reset seats
        document.querySelectorAll('.tool-seats').forEach(input => {
          input.value = 1;
        });
        // Reset Cursor BYOK
        const cursorTierEl = document.querySelector('.cursor-tier');
        if (cursorTierEl) cursorTierEl.selectedIndex = 0;
        const cursorProviderEl = document.querySelector('.cursor-api-provider');
        if (cursorProviderEl) cursorProviderEl.selectedIndex = 0;
        const cursorModelEl = document.querySelector('.cursor-api-model');
        if (cursorModelEl) {
          cursorModelEl.selectedIndex = 0;
          // Reset shows the Claude models, matching the provider select's own reset to index 0.
          Array.from(cursorModelEl.options).forEach(opt => {
            opt.classList.toggle('hidden', opt.dataset.provider !== 'claude');
          });
        }
        document.querySelectorAll('.cursor-input-tokens').forEach(input => { input.value = 500000; });
        document.querySelectorAll('.cursor-output-tokens').forEach(input => { input.value = 250000; });
        document.querySelectorAll('.cursor-seats').forEach(input => { input.value = 1; });
        // Reset currency to USD
        currentCurrency = 'USD';
        document.querySelectorAll('.currency-btn').forEach(b => {
          b.classList.toggle('bg-bae-ink', b.dataset.currency === 'USD');
          b.classList.toggle('text-white', b.dataset.currency === 'USD');
          b.classList.toggle('text-bae-muted', b.dataset.currency !== 'USD');
        });
        // Reset mode to personal
        currentMode = 'personal';
        document.querySelectorAll('.mode-btn').forEach(b => {
          b.classList.toggle('bg-bae-primary', b.dataset.mode === 'personal');
          b.classList.toggle('text-white', b.dataset.mode === 'personal');
          b.classList.toggle('text-bae-muted', b.dataset.mode !== 'personal');
        });
        updateSeatsVisibility();
        const cursorWrapper = document.querySelector('.cursor-seats-wrapper');
        if (cursorWrapper) {
          cursorWrapper.classList.add('hidden');
          cursorWrapper.querySelector('input').value = '1';
        }
        calculate();
      });

      // Seats visibility logic for subscription tools
      function updateSeatsVisibility() {
        document.querySelectorAll('.tool-card[data-tool-type="subscription"]').forEach(card => {
          const tierSelect = card.querySelector('.tool-tier');
          const seatsWrapper = card.querySelector('.tool-seats-wrapper');
          if (!tierSelect || !seatsWrapper) return;
          const perSeat = tierSelect.options[tierSelect.selectedIndex].dataset.perSeat === 'true';
          if (perSeat || currentMode === 'business') {
            seatsWrapper.classList.remove('hidden');
          } else {
            seatsWrapper.classList.add('hidden');
            seatsWrapper.querySelector('input').value = '1';
          }
        });
      }
      document.querySelectorAll('.tool-tier').forEach(s => s.addEventListener('change', () => {
        updateSeatsVisibility();
        calculate();
      }));

      // Cursor seats visibility
      const cursorTier = document.querySelector('.cursor-tier');
      if (cursorTier) {
        cursorTier.addEventListener('change', () => {
          const isBusiness = cursorTier.value === 'cursor-business';
          const wrapper = document.querySelector('.cursor-seats-wrapper');
          if (isBusiness || currentMode === 'business') {
            wrapper.classList.remove('hidden');
          } else {
            wrapper.classList.add('hidden');
            wrapper.querySelector('input').value = '1';
          }
          calculate();
        });
      }

      // Initial state
      updateSeatsVisibility();
    })();
  </script>

  <style>
    @media print {
      body * {
        visibility: hidden;
      }
      #print-report,
      #print-report * {
        visibility: visible;
      }
      #print-report {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        display: block !important;
      }
      nav, footer, section, main > *:not(#print-report) {
        display: none !important;
      }
    }
    .tool-card {
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .tool-config {
      animation: fadeIn 0.2s ease;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>

