---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UpdatedBadge from '../../components/content/UpdatedBadge.astro';
import ToolHero from '../../components/tools/ToolHero.astro';
import ToolHowItWorks from '../../components/tools/ToolHowItWorks.astro';
import ToolFAQ from '../../components/tools/ToolFAQ.astro';

const today = '2026-06-13T00:00:00+00:00';

const faqs = [
  {
    q: 'What is a color palette generator?',
    a: 'The Best Answer Hub Color Palette Generator creates harmonious sets of colors for design projects. You input a starting color (seed), and it generates lighter and darker shades, neutral grays, and semantic colors (success, warning, error) that work together visually. The Best Answer Hub Color Palette Generator also checks every combination against WCAG accessibility standards so your palette is beautiful and readable.',
  },
  {
    q: 'What is WCAG and why does it matter for colors?',
    a: 'WCAG stands for Web Content Accessibility Guidelines. It defines contrast ratio standards to ensure text is readable against its background for people with visual impairments, color blindness, or low vision. WCAG AA requires a 4.5:1 contrast ratio for normal text, and AAA requires 7:1. Meeting these standards makes your website usable by the widest possible audience and can also improve SEO.',
  },
  {
    q: 'What is the difference between AA and AAA contrast ratios?',
    a: 'WCAG AA is the minimum standard for accessibility. It requires a 4.5:1 contrast ratio for normal text and 3:1 for large text. WCAG AAA is the highest standard, requiring 7:1 for normal text and 4.5:1 for large text. Most commercial websites aim for AA compliance. AAA is ideal for government, healthcare, and education sites where maximum accessibility is critical.',
  },
  {
    q: 'How does this tool generate color scales?',
    a: 'The Best Answer Hub Color Palette Generator converts your seed color into the HSL color space (Hue, Saturation, Lightness) and generates scales by systematically varying lightness while preserving hue relationships. Lighter shades have higher lightness values with reduced saturation, while darker shades have lower lightness with concentrated saturation. This creates perceptually smooth gradients that feel natural and professional.',
  },
  {
    q: 'What is a good contrast ratio for text and backgrounds?',
    a: 'For normal body text (under 18pt or 14pt bold), aim for at least 4.5:1 (WCAG AA) or 7:1 (WCAG AAA). For large text (18pt+ or 14pt+ bold), 3:1 meets AA and 4.5:1 meets AAA. For user interface components like buttons and form fields, a 3:1 contrast ratio against adjacent colors is recommended. The Best Answer Hub Color Palette Generator checks all of these automatically.',
  },
  {
    q: 'What are design tokens and why should I use them?',
    a: 'Design tokens are named variables that store design decisions like colors, typography, and spacing. Instead of hardcoding hex codes throughout your project, you use semantic names like --color-primary-600 or primary-600. This makes your design system consistent, easier to maintain, and simpler to update. When your brand color changes, you update one token instead of hundreds of CSS rules.',
  },
  {
    q: 'How do I export my palette to Tailwind CSS?',
    a: 'After generating your palette, click the Export section and select the Tailwind tab. The tool outputs a Tailwind v4 compatible @theme block with all your colors named as primary, neutral, success, warning, and error scales. You can copy this directly into your CSS file. For Tailwind v3, use the CSS Variables export and reference them in your tailwind.config.js colors section.',
  },
  {
    q: 'What is the difference between a primary color and a neutral color?',
    a: 'A primary color is the main brand color that defines your visual identity: it appears in buttons, links, and key UI elements. A neutral color scale provides grayscale shades for text, backgrounds, borders, and dividers. A well-designed palette uses neutrals for 80% of the interface and the primary color for the 20% that needs emphasis. The Best Answer Hub Color Palette Generator generates both automatically from your seed color.',
  },
  {
    q: 'How do I ensure my palette works in dark mode?',
    a: 'The Best Answer Hub Color Palette Generator includes a live dark mode preview that shows how your palette looks on dark backgrounds. A good dark mode palette inverts the usage pattern: dark backgrounds use neutral-900 to neutral-800, text uses neutral-50 to neutral-200, and primary accents use lighter shades (primary-400 to primary-500) instead of darker ones. The built-in component lab lets you test both modes side by side before exporting.',
  },
  {
    q: 'What is color blindness and how does it affect palette design?',
    a: 'Color blindness affects approximately 8% of men and 0.5% of women worldwide. The most common type is red-green color blindness, where users cannot distinguish between red and green hues. This is why relying solely on color to convey meaning (like error states) is problematic. A safe palette uses distinct lightness differences, icons, and text labels in addition to color. High contrast ratios help colorblind users distinguish elements regardless of hue.',
  },
  {
    q: 'What makes a color palette "accessible"?',
    a: 'An accessible palette ensures that all text is readable against its background, that interactive elements are distinguishable from their surroundings, and that information is not conveyed by color alone. Specifically: normal text needs 4.5:1 contrast, large text needs 3:1, and UI components need 3:1 against adjacent colors. The Best Answer Hub Color Palette Generator checks every combination and flags failures with red badges so you can fix them before shipping.',
  },
  {
    q: 'Can I use generated palettes for commercial projects?',
    a: 'Yes. All palettes generated by the Best Answer Hub Color Palette Generator are free to use for both personal and commercial projects. There are no licensing restrictions, no attribution requirements, and no watermarks. The colors are mathematically generated and not derived from any proprietary source. Use them for websites, mobile apps, brand identities, presentations, or any design work.',
  },
  {
    q: 'What is the difference between HEX, RGB, HSL, and CMYK color formats?',
    a: 'HEX (#6366f1) is the standard format for web use, a six-digit code that browsers and CSS interpret directly. RGB (rgb(99, 102, 241)) expresses colors as red, green, and blue channel intensities from 0 to 255, which is useful for JavaScript color manipulation and CSS rgba() transparency. HSL (hsl(239, 84%, 67%)) describes colors using Hue (0–360°), Saturation (%), and Lightness (%), making it the most intuitive format for creating shades and tints: adjusting lightness produces natural-looking variations. CMYK is a print format used by designers working with physical materials and is not used for digital screens. The Best Answer Hub Color Palette Generator exports in HEX and CSS variable formats, which cover all standard web and app development workflows.',
  },
  {
    q: 'What are complementary, analogous, and triadic color schemes?',
    a: 'These are the three most common color harmony types in design. Complementary colors sit directly opposite each other on the color wheel (such as blue and orange), creating high contrast and visual energy, ideal for call-to-action buttons and highlights. Analogous colors are adjacent on the wheel (such as blue, blue-green, and green), producing a harmonious, cohesive feel widely used in calm UI designs. Triadic schemes use three colors equally spaced 120° apart (such as red, yellow, and blue), which are vibrant but require careful balance to avoid visual noise. Understanding which harmony type fits your brand helps you decide which secondary and accent colors to pair with your seed color when generating a palette with the Best Answer Hub Color Palette Generator.',
  },
  {
    q: 'What is the 60-30-10 color rule and how does it apply to UI design?',
    a: 'The 60-30-10 rule is a fundamental design principle that creates visual balance in any color scheme. Sixty percent of your design should use a dominant neutral, typically backgrounds, surfaces, and large text areas. Thirty percent should use a secondary color that complements the dominant, often applied to cards, sidebars, and secondary UI elements. Ten percent should use your accent or primary color, reserved for buttons, links, highlights, and interactive elements. Following this rule prevents visual overwhelm and ensures your primary brand color has maximum impact through intentional scarcity. A well-structured palette separates colors into these roles automatically, which is why the Best Answer Hub Color Palette Generator generates distinct primary, neutral, and semantic scales from a single seed color.',
  },
];

const steps = [
  { title: 'Enter your brand color', description: 'Type a hex code or use the color picker to set your starting seed color. This becomes the center of your primary scale.' },
  { title: 'Generate and refine', description: 'Press spacebar or click Generate to create your palette. Lock colors you love, regenerate the rest. Every combination is checked for WCAG accessibility.' },
  { title: 'Preview and export', description: 'Switch between light and dark mode previews to see your palette on real UI components. Export as CSS variables, Tailwind theme, or a plain hex list.' },
];

const seo = {
  title: 'Free Color Palette Generator + WCAG Contrast Checker',
  description: 'Generate accessible color palettes from one seed color. Check WCAG AA/AAA contrast ratios on live UI components. Export to CSS, Tailwind, or hex. No signup.',
  url: '/tools/color-palette-generator/',
  type: 'WebPage' as const,
  datePublished: today,
  dateModified: today,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Color Palette Generator', url: '/tools/color-palette-generator/' },
  ],
  faq: faqs.map(f => ({ question: f.q, answer: f.a.replace(/<[^>]*>/g, '').replace(/\s{2,}/g, ' ').trim() })),
};
---

<BaseLayout seo={seo}>
