  <script is:inline>
    (function() {
      let qrcode = null;
      let currentEC = 0; // 0=M, 1=L, 2=H, 3=Q

      const typeSelect = document.getElementById('qr-type');
      const sizeSlider = document.getElementById('qr-size');
      const sizeValue = document.getElementById('size-value');
      const fgInput = document.getElementById('qr-fg');
      const bgInput = document.getElementById('qr-bg');
      const fgVal = document.getElementById('qr-fg-val');
      const bgVal = document.getElementById('qr-bg-val');
      const previewDiv = document.getElementById('qr-preview');
      const downloadBtn = document.getElementById('qr-download');
      const ecButtons = document.querySelectorAll('.ec-btn');

      const inputSections = {
        url: document.getElementById('input-url'),
        text: document.getElementById('input-text'),
        phone: document.getElementById('input-phone'),
        sms: document.getElementById('input-sms'),
        email: document.getElementById('input-email'),
        wifi: document.getElementById('input-wifi'),
      };

      const inputs = {
        url: document.getElementById('qr-url'),
        text: document.getElementById('qr-text'),
        phone: document.getElementById('qr-phone'),
        smsPhone: document.getElementById('qr-sms-phone'),
        smsBody: document.getElementById('qr-sms-body'),
        emailAddr: document.getElementById('qr-email-addr'),
        emailSubj: document.getElementById('qr-email-subj'),
        emailBody: document.getElementById('qr-email-body'),
        wifiSsid: document.getElementById('qr-wifi-ssid'),
        wifiPass: document.getElementById('qr-wifi-pass'),
        wifiEnc: document.getElementById('qr-wifi-enc'),
      };

      function showInput(type) {
        Object.values(inputSections).forEach(el => el.classList.add('hidden'));
        inputSections[type].classList.remove('hidden');
      }

      function getQRData() {
        const type = typeSelect.value;
        switch(type) {
          case 'url': return inputs.url.value.trim();
          case 'text': return inputs.text.value.trim();
          case 'phone': return inputs.phone.value.trim() ? 'tel:' + inputs.phone.value.trim() : '';
          case 'sms': {
            const p = inputs.smsPhone.value.trim();
            const b = inputs.smsBody.value.trim();
            if (!p) return '';
            return b ? 'smsto:' + p + ':' + b : 'smsto:' + p;
          }
          case 'email': {
            const a = inputs.emailAddr.value.trim();
            const s = inputs.emailSubj.value.trim();
            const b = inputs.emailBody.value.trim();
            if (!a) return '';
            let mailto = 'mailto:' + a;
            const params = [];
            if (s) params.push('subject=' + encodeURIComponent(s));
            if (b) params.push('body=' + encodeURIComponent(b));
            if (params.length) mailto += '?' + params.join('&');
            return mailto;
          }
          case 'wifi': {
            // Per the WIFI: format spec, the reserved characters \ ; , : " must be
            // backslash-escaped in SSID and password, or scanners mis-parse the fields.
            const escWifi = s => s.replace(/([\\;,:"])/g, '\\$1');
            const ssid = escWifi(inputs.wifiSsid.value.trim());
            const pass = escWifi(inputs.wifiPass.value.trim());
            const enc = inputs.wifiEnc.value;
            if (!ssid) return '';
            return 'WIFI:S:' + ssid + ';T:' + enc + ';P:' + pass + ';;';
          }
          default: return '';
        }
      }

      function generate() {
        const data = getQRData();
        const size = parseInt(sizeSlider.value);
        const fg = fgInput.value;
        const bg = bgInput.value;

        previewDiv.innerHTML = '';
        downloadBtn.href = '#';

        if (!data) {
          previewDiv.innerHTML = '<p class="text-sm text-bae-muted">Enter data to generate QR code</p>';
          return;
        }

        try {
          qrcode = new QRCode(previewDiv, {
            text: data,
            width: size,
            height: size,
            colorDark: fg,
            colorLight: bg,
            correctLevel: currentEC,
          });

          // Wait for canvas/img to render then set download
          setTimeout(() => {
            const img = previewDiv.querySelector('img');
            const canvas = previewDiv.querySelector('canvas');
            if (img && img.src && img.src !== '') {
              downloadBtn.href = img.src;
            } else if (canvas) {
              downloadBtn.href = canvas.toDataURL('image/png');
            }
          }, 100);
        } catch (e) {
          previewDiv.innerHTML = '<p class="text-sm text-red-600">Error generating QR code. Try shorter text or lower error correction.</p>';
        }
      }

      // Event listeners
      typeSelect.addEventListener('change', () => { showInput(typeSelect.value); generate(); });
      sizeSlider.addEventListener('input', () => { sizeValue.textContent = sizeSlider.value + ' px'; generate(); });
      fgInput.addEventListener('input', () => { fgVal.textContent = fgInput.value; generate(); });
      bgInput.addEventListener('input', () => { bgVal.textContent = bgInput.value; generate(); });

      Object.values(inputs).forEach(inp => {
        if (inp) inp.addEventListener('input', generate);
      });

      ecButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          currentEC = parseInt(btn.dataset.ec);
          ecButtons.forEach(b => {
            const active = parseInt(b.dataset.ec) === currentEC;
            b.classList.toggle('bg-bae-primary', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('border-bae-primary', active);
            b.classList.toggle('bg-bae-bg', !active);
            b.classList.toggle('text-bae-muted', !active);
            b.classList.toggle('border-bae-border', !active);
          });
          generate();
        });
      });

      document.getElementById('qr-clear').addEventListener('click', function() {
        // Clear all inputs
        inputs.url.value = '';
        inputs.text.value = '';
        inputs.phone.value = '';
        inputs.smsPhone.value = '';
        inputs.smsBody.value = '';
        inputs.emailAddr.value = '';
        inputs.emailSubj.value = '';
        inputs.emailBody.value = '';
        inputs.wifiSsid.value = '';
        inputs.wifiPass.value = '';
        inputs.wifiEnc.value = 'WPA';

        // Reset type to URL
        typeSelect.value = 'url';
        showInput('url');

        // Reset size
        sizeSlider.value = 300;
        sizeValue.textContent = '300 px';

        // Reset colors
        fgInput.value = '#000000';
        bgInput.value = '#ffffff';
        fgVal.textContent = '#000000';
        bgVal.textContent = '#ffffff';

        // Reset error correction to Medium
        currentEC = 0;
        ecButtons.forEach(b => {
          const active = parseInt(b.dataset.ec) === 0;
          b.classList.toggle('bg-bae-primary', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('border-bae-primary', active);
          b.classList.toggle('bg-bae-bg', !active);
          b.classList.toggle('text-bae-muted', !active);
          b.classList.toggle('border-bae-border', !active);
        });

        // Clear preview
        previewDiv.innerHTML = '<p class="text-sm text-bae-muted">Enter data to generate QR code</p>';
        downloadBtn.href = '#';
      });

      // Initial
      showInput('url');
      generate();
    })();
  </script>

  <script src="/qrcode.min.js" is:inline></script>
</BaseLayout>
