      async function hasVisualContent(page) {
        try {
          const viewport = page.getViewport({ scale: 0.15 });
          const canvas = document.createElement('canvas');
          canvas.width = Math.max(1, Math.floor(viewport.width));
          canvas.height = Math.max(1, Math.floor(viewport.height));
          const ctx = canvas.getContext('2d', { willReadFrequently: true });
          if (!ctx) return false;
          await page.render({ canvasContext: ctx, viewport }).promise;
          const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          const data = imageData.data;
          for (let i = 0; i < data.length; i += 16) {
            if (data[i] < 240 || data[i+1] < 240 || data[i+2] < 240) {
              return true;
            }
          }
          return false;
        } catch (e) {
          console.warn('Visual check failed:', e);
          return false;
        }
      }

      async function convertPdfToWord(file) {
        progressText.textContent = 'Reading PDF...';
        const arrayBuffer = await file.arrayBuffer();

        if (!isValidPdfHeader(arrayBuffer)) {
          progressArea.classList.add('hidden');
          resultArea.classList.remove('hidden');
          outputName.textContent = file.name.replace(/\.pdf$/i, '') + '.docx';
          pageCount.textContent = 'Invalid file';
          previewContent.innerHTML = `
            <div class="bg-amber-50 border border-amber-200 rounded-bae p-4 text-center">
              <svg class="w-8 h-8 text-amber-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
              <p class="text-sm font-semibold text-amber-800 mb-1">This does not appear to be a valid PDF file</p>
              <p class="text-xs text-amber-700">The file header does not match a standard PDF. If you renamed a .txt or other file to .pdf, please convert it to a real PDF first (use Print to PDF in any text editor or browser).</p>
            </div>
          `;
          downloadBtn.href = '#';
          downloadBtn.download = '';
          downloadBtn._objUrl = null;
          downloadBtn.textContent = 'Invalid File';
          downloadBtn.classList.add('opacity-50', 'cursor-not-allowed');
          resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }

        if (!pdfjsLib) {
          throw new Error('PDF library failed to load. Please refresh the page and try again.');
        }
        if (!jszipLib) {
          throw new Error('ZIP library failed to load. Please refresh the page and try again.');
        }

        const pdf = await pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) }).promise;
        currentPdf = pdf;
        const numPages = pdf.numPages;
        console.log('[PDF→Word] Pages:', numPages);

        // Extract text with paragraph detection using hasEOL markers and inline newlines
        const allParagraphs = [];
        let totalItems = 0;
        let nonEmptyItems = 0;
        let hasVisual = false;
        let textExtractionError = null;

        for (let i = 1; i <= numPages; i++) {
          progressText.textContent = `Extracting page ${i} of ${numPages}...`;
          const page = await pdf.getPage(i);

          // Try text extraction with retry — some PDF generators need a moment
          let textContent;
          try {
            textContent = await page.getTextContent();
            // Retry once if empty (catches race conditions / delayed worker init)
            if (!textContent || !textContent.items || textContent.items.length === 0) {
              await new Promise(r => setTimeout(r, 300));
              textContent = await page.getTextContent();
            }
          } catch (err) {
            console.error('[PDF→Word] getTextContent error on page', i, err);
            textExtractionError = err.message || 'Text extraction failed';
            textContent = { items: [] };
          }

          totalItems += textContent.items.length;
          console.log('[PDF→Word] Page', i, 'items:', textContent.items.length);

          let currentLine = '';
          const pageParagraphs = [];

          function flushLine() {
            const trimmed = currentLine.trim();
            if (trimmed) pageParagraphs.push(trimmed);
            currentLine = '';
          }

          for (const item of textContent.items) {
            if (!item || typeof item.str !== 'string') {
              console.log('[PDF→Word] Skipped item (no str):', item);
              continue;
            }
            const str = item.str;
            if (str.trim().length > 0) nonEmptyItems++;
            if (str.trim().length > 0) {
              console.log('[PDF→Word] Text item:', JSON.stringify(str.substring(0, 40)), 'hasEOL:', item.hasEOL);
            }

            // Some PDF generators embed \\n inside the string instead of using hasEOL
            if (str.indexOf('\n') !== -1) {
              const parts = str.split('\n');
              for (let pi = 0; pi < parts.length; pi++) {
                currentLine += parts[pi];
                if (pi < parts.length - 1) {
                  flushLine();
                }
              }
            } else {
              currentLine += str;
            }

            if (item.hasEOL) {
              flushLine();
            }
          }
          flushLine();

          allParagraphs.push(...pageParagraphs);

          // Check visual content on any page with zero text — helps diagnose format issues
          if (pageParagraphs.length === 0 && !hasVisual) {
            hasVisual = await hasVisualContent(page);
            console.log('[PDF→Word] Page', i, 'has visual content:', hasVisual);
          }
        }

        console.log('[PDF→Word] Total paragraphs:', allParagraphs.length, 'Non-empty items:', nonEmptyItems, 'Has visual:', hasVisual, 'Error:', textExtractionError);
        progressText.textContent = 'Building Word document...';

        // No selectable text found.
        if (allParagraphs.length === 0) {
          // If the page is visibly a scan/image, convert automatically with OCR — no prompt, no button.
          if (hasVisual && !textExtractionError && currentPdf) {
            console.log('[PDF→Word] Scanned/image PDF detected — auto-running OCR.');
            progressText.textContent = 'Scanned PDF detected, extracting text...';
            await runOcrToWord(file);
            return;
          }
          outputName.textContent = file.name.replace(/\.pdf$/i, '') + '.docx';
          let diagnostic = '';
          if (textExtractionError) {
            diagnostic = 'Text extraction failed: ' + textExtractionError;
          } else if (totalItems === 0) {
            diagnostic = 'The parser found 0 text objects and no readable image content. The file may be empty, corrupt, or password-protected.';
          } else if (nonEmptyItems === 0) {
            diagnostic = `The parser found ${totalItems} objects but none contained readable text. This can happen with certain PDF generators that use non-standard fonts or missing character mappings.`;
          } else {
            diagnostic = `The parser found ${nonEmptyItems} text objects but could not assemble them into paragraphs. This PDF may have an unusual text structure.`;
          }
          pageCount.textContent = numPages + (numPages === 1 ? ' page' : ' pages') + ', ' + totalItems + ' objects scanned';
          previewContent.innerHTML = `
            <div class="bg-amber-50 border border-amber-200 rounded-bae p-4 text-center">
              <svg class="w-8 h-8 text-amber-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
              <p class="text-sm font-semibold text-amber-800 mb-1">Could not convert this PDF</p>
              <p class="text-xs text-amber-700">` + escapeHtml(diagnostic) + `</p>
            </div>
          `;
          downloadBtn.href = '#';
          downloadBtn.download = '';
          downloadBtn._objUrl = null;
          downloadBtn.textContent = 'No Text to Download';
          downloadBtn.classList.add('opacity-50', 'cursor-not-allowed');

          progressArea.classList.add('hidden');
          resultArea.classList.remove('hidden');
          resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }

        const blob = await createDocxBlob(allParagraphs);
        if (downloadBtn._objUrl) URL.revokeObjectURL(downloadBtn._objUrl);
        const url = URL.createObjectURL(blob);
        const outputFilename = file.name.replace(/\.pdf$/i, '') + '.docx';

        outputName.textContent = outputFilename;
        pageCount.textContent = numPages + (numPages === 1 ? ' page' : ' pages') + ', ' + allParagraphs.length + ' paragraphs extracted';
        previewContent.innerHTML = allParagraphs.map(p => `<p style="margin-bottom:12px">${escapeHtml(p)}</p>`).join('');
        downloadBtn.href = url;
        downloadBtn.download = outputFilename;
        downloadBtn._objUrl = url;
        downloadBtn.textContent = 'Download Word Document';
        downloadBtn.classList.remove('opacity-50', 'cursor-not-allowed');

        progressArea.classList.add('hidden');
        resultArea.classList.remove('hidden');
        resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      async function runOcrToWord(file) {
        const pdf = currentPdf;
        if (!pdf) {
          progressText.textContent = 'Could not process. Please re-upload the file.';
          return;
        }
        const numPages = pdf.numPages;
        resultArea.classList.add('hidden');
        progressArea.classList.remove('hidden');
        progressText.textContent = 'Preparing to extract text (one-time setup, ~10 MB)...';

        let worker = null;
        let ocrPage = 0;
        try {
          await loadTesseract();
          worker = await tesseractLib.createWorker('eng', 1, {
            workerPath: '/tesseract/worker.min.js',
            corePath: '/tesseract/',
            langPath: '/tesseract/',
            workerBlobURL: false,
            logger: (m) => {
              if (m && m.status === 'recognizing text' && typeof m.progress === 'number') {
                progressText.textContent = `Extracting text from page ${ocrPage} of ${numPages} at ${Math.round(m.progress * 100)}%`;
              }
            },
          });

          const ocrParagraphs = [];
          for (let i = 1; i <= numPages; i++) {
            ocrPage = i;
            progressText.textContent = `Reading page ${i} of ${numPages}...`;
            const page = await pdf.getPage(i);
            const viewport = page.getViewport({ scale: 2.5 });
            const canvas = document.createElement('canvas');
            canvas.width = Math.max(1, Math.floor(viewport.width));
            canvas.height = Math.max(1, Math.floor(viewport.height));
            const ctx = canvas.getContext('2d');
            await page.render({ canvasContext: ctx, viewport }).promise;
            const { data } = await worker.recognize(canvas);
            const text = (data && typeof data.text === 'string') ? data.text : '';
            text.split(/\r?\n/).forEach(line => {
              const trimmed = line.trim();
              if (trimmed) ocrParagraphs.push(trimmed);
            });
            // release the canvas memory before the next page
            canvas.width = 0; canvas.height = 0;
          }

          await worker.terminate();
          worker = null;

          console.log('[OCR] paragraphs extracted:', ocrParagraphs.length);

          if (ocrParagraphs.length === 0) {
            progressArea.classList.add('hidden');
            resultArea.classList.remove('hidden');
            pageCount.textContent = numPages + (numPages === 1 ? ' page' : ' pages') + ', no readable text found';
            previewContent.innerHTML = `
              <div class="bg-amber-50 border border-amber-200 rounded-bae p-4 text-center">
                <p class="text-sm font-semibold text-amber-800 mb-1">Could not read any text</p>
                <p class="text-xs text-amber-700">The scan may be low-resolution, skewed, or handwritten. Try a clearer, higher-resolution scan.</p>
              </div>`;
            resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return;
          }

          progressText.textContent = 'Building Word document...';
          const blob = await createDocxBlob(ocrParagraphs);
          if (downloadBtn._objUrl) URL.revokeObjectURL(downloadBtn._objUrl);
          const url = URL.createObjectURL(blob);
          const outputFilename = file.name.replace(/\.pdf$/i, '') + '.docx';

          outputName.textContent = outputFilename;
          pageCount.textContent = numPages + (numPages === 1 ? ' page' : ' pages') + ', ' + ocrParagraphs.length + ' lines extracted';
          previewContent.innerHTML = allParagraphsPreview(ocrParagraphs);
          downloadBtn.href = url;
          downloadBtn.download = outputFilename;
          downloadBtn._objUrl = url;
          downloadBtn.textContent = 'Download Word Document';
          downloadBtn.classList.remove('opacity-50', 'cursor-not-allowed');

          progressArea.classList.add('hidden');
          resultArea.classList.remove('hidden');
          resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (err) {
          console.error('[OCR] failed', err);
          if (worker) { try { await worker.terminate(); } catch (e) {} }
          progressArea.classList.add('hidden');
          resultArea.classList.remove('hidden');
          previewContent.innerHTML = `
            <div class="bg-amber-50 border border-amber-200 rounded-bae p-4 text-center">
              <p class="text-sm font-semibold text-amber-800 mb-1">Could not extract text</p>
              <p class="text-xs text-amber-700">` + escapeHtml(err && err.message ? err.message : 'Unknown error while extracting text.') + `</p>
            </div>`;
          resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      function allParagraphsPreview(paragraphs) {
        return paragraphs.map(p => `<p style="margin-bottom:12px">${escapeHtml(p)}</p>`).join('');
      }

      async function convertWordToPdf(file) {
        progressText.textContent = 'Reading Word document...';
        const arrayBuffer = await file.arrayBuffer();
        const result = await mammothLib.convertToHtml({ arrayBuffer });

        progressText.textContent = 'Generating PDF...';
        if (!window.DOMPurify) {
          throw new Error('Security library (DOMPurify) failed to load. Cannot convert.');
        }
        const sanitized = window.DOMPurify.sanitize(result.value);
        // Scoped styles (.b2pdf-doc) so mammoth's bare <table> keeps gridlines in the
        // rendered PDF. The <style> block is our own static trusted markup, added
        // after sanitization of the document content.
        const cleanHtml = `
          <div class="b2pdf-doc" style="font-family:Arial,sans-serif;font-size:11pt;line-height:1.6;padding:40px;max-width:700px;margin:0 auto;color:#333">
            <style>
              .b2pdf-doc table{border-collapse:collapse;width:100%;margin:12px 0}
              .b2pdf-doc td,.b2pdf-doc th{border:1px solid #999;padding:6px 10px;text-align:left;vertical-align:top}
              .b2pdf-doc th{background:#f3f4f6;font-weight:bold}
              .b2pdf-doc td p,.b2pdf-doc th p{margin:0}
              .b2pdf-doc img{max-width:100%;height:auto}
              .b2pdf-doc h1{font-size:18pt;margin:16px 0 8px}
              .b2pdf-doc h2{font-size:15pt;margin:14px 0 6px}
              .b2pdf-doc h3{font-size:13pt;margin:12px 0 6px}
            </style>
            ${sanitized}
          </div>
        `;

        previewContent.innerHTML = cleanHtml;

        // Use a clone of the preview content wrapper for PDF generation.
        // We append it to body in normal flow instead of positioning off-screen,
        // because html2canvas can fail to capture elements at extreme negative coordinates.
        const wrapper = previewContent.querySelector('div');
        if (!wrapper) {
          throw new Error('No content to convert');
        }

        const clone = wrapper.cloneNode(true);
        clone.style.maxWidth = 'none';
        clone.style.width = '7.5in';
        clone.style.margin = '0';
        clone.style.boxSizing = 'border-box';
        document.body.appendChild(clone);

        const opt = {
          margin: 0.5,
          filename: file.name.replace(/\.docx$/i, '') + '.pdf',
          image: { type: 'jpeg', quality: 0.95 },
          html2canvas: { scale: 2, useCORS: true, scrollX: 0, scrollY: 0 },
          jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' },
          pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
        };

        let pdfBlob;
        try {
          pdfBlob = await html2pdfLib().set(opt).from(clone).outputPdf('blob');
        } finally {
          if (clone.parentNode) document.body.removeChild(clone);
        }

        if (downloadBtn._objUrl) URL.revokeObjectURL(downloadBtn._objUrl);
        const url = URL.createObjectURL(pdfBlob);
        const outputFilename = file.name.replace(/\.docx$/i, '') + '.pdf';

        outputName.textContent = outputFilename;
        pageCount.textContent = 'PDF generated';
        downloadBtn.href = url;
        downloadBtn.download = outputFilename;
        downloadBtn._objUrl = url;
        downloadBtn.textContent = 'Download PDF';
        downloadBtn.classList.remove('opacity-50', 'cursor-not-allowed');

        progressArea.classList.add('hidden');
        resultArea.classList.remove('hidden');
        resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }
    })();
  </script>
</BaseLayout>
