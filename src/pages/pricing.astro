---
import BaseLayout from '../layouts/BaseLayout.astro';

const today = '2026-06-13T00:00:00+00:00';

// Indicative launch pricing for the optional paid PDF reports. Every underlying
// assessment is, and will remain, free. Final price + currency are shown at
// checkout, handled by Paddle as Merchant of Record.
const reports = [
  {
    name: 'SMB AI & Digital Readiness: Roadmap Report',
    assessment: 'Small & Medium Business AI Readiness Score',
    price: 39,
    summary: 'Turns your free 5-pillar readiness score into a prioritized 90-day AI adoption roadmap for your business.',
    includes: [
      'Pillar-by-pillar analysis (data, infrastructure, process, skills, governance)',
      'Benchmark context vs typical SMBs',
      'Prioritized 90-day action roadmap',
      'Recommended tools and starter templates',
    ],
  },
  {
    name: 'Professional Competency: Development Plan',
    assessment: 'Professional Competency Assessment (PM track)',
    price: 29,
    summary: 'Expands your free competency level into a concrete plan to reach the next rung of the career ladder.',
    includes: [
      'Level placement across 6 PM dimensions',
      'Exact gaps separating you from the next level',
      'Recommended development projects',
      'Reusable templates and frameworks',
    ],
  },
  {
    name: 'Career Path & Strengths: Full Report',
    assessment: 'Career Path & Strengths Map',
    price: 19,
    summary: 'Goes beyond the free top-5 strengths into a full ranked role-match report and action plan.',
    includes: [
      '20+ ranked role matches (incl. remote & AI-augmented roles)',
      'Full strengths and work-style profile',
      'Concrete transition action plan',
      'Suggested next steps and resources',
    ],
  },
  {
    name: 'Emotional Intelligence (EQ): Development Plan',
    assessment: 'Emotional Intelligence (EQ) Score',
    price: 19,
    summary: 'Converts your free EQ score into targeted techniques to strengthen each emotional-intelligence domain.',
    includes: [
      'Breakdown across all 5 EQ domains',
      'Targeted techniques per domain',
      'Practice exercises and prompts',
      '30-day improvement plan',
    ],
  },
  {
    name: 'AI Knowledge Test: Results & Certificate Report',
    assessment: 'AI Knowledge Test',
    price: 14,
    summary: 'A shareable results report and certificate documenting your AI literacy level across topics.',
    includes: [
      'Topic-by-topic score breakdown',
      'Beginner → advanced level placement',
      'Personalized study recommendations',
      'Downloadable completion certificate',
    ],
  },
];

const seo = {
  title: 'Pricing — Free Assessments & Optional Paid Reports',
  description: 'Every Best Answer Hub assessment is free. An optional paid PDF report ($10–$50, one-time) turns your score into a detailed action plan. No subscription.',
  url: '/pricing/',
  type: 'WebPage' as const,
  datePublished: today,
  dateModified: today,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Pricing', url: '/pricing/' },
  ],
};
---

<BaseLayout seo={seo}>
  <div class="py-12 md:py-16">
    <div class="container max-w-page mx-auto px-6">

      <!-- Header -->
      <header class="max-w-content mb-10">
        <span class="inline-block text-xs font-semibold uppercase tracking-wider text-bae-primary mb-3">Pricing</span>
        <h1 class="font-serif text-3xl md:text-4xl font-bold text-bae-ink leading-tight mb-4">Free to find out. A small fee to go deep.</h1>
        <p class="text-lg text-bae-muted">Every diagnostic assessment on Best Answer Hub is <strong>100% free</strong>. You get your full score, radar chart, and quick wins with no account and no email. If you want the detailed plan, each assessment has an <strong>optional paid PDF report</strong>.</p>
      </header>

      <!-- Free vs Paid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12 max-w-content">
        <div class="bg-bae-card border border-bae-border rounded-bae p-6">
          <div class="flex items-baseline justify-between mb-2">
            <h2 class="text-base font-semibold text-bae-ink">The assessment</h2>
            <span class="text-lg font-bold text-bae-primary">Free</span>
          </div>
          <p class="text-sm text-bae-muted mb-3">Always free, no signup, no data stored. Runs entirely in your browser.</p>
          <ul class="text-sm text-bae-muted space-y-1.5">
            <li>✓ Overall score</li>
            <li>✓ Dimension radar chart</li>
            <li>✓ Strengths and weakest areas</li>
            <li>✓ 2–3 immediate quick wins</li>
          </ul>
        </div>
        <div class="bg-bae-card border border-bae-primary/40 rounded-bae p-6">
          <div class="flex items-baseline justify-between mb-2">
            <h2 class="text-base font-semibold text-bae-ink">The PDF report</h2>
            <span class="text-lg font-bold text-bae-ink">$10–$50</span>
          </div>
          <p class="text-sm text-bae-muted mb-3">Optional, one-time payment. Instant download. No subscription.</p>
          <ul class="text-sm text-bae-muted space-y-1.5">
            <li>✓ 20–30 page personalized action plan</li>
            <li>✓ Benchmark comparisons</li>
            <li>✓ Prioritized roadmap</li>
            <li>✓ Templates and recommended tools</li>
          </ul>
        </div>
      </div>

      <!-- Report pricing -->
      <h2 class="font-serif text-2xl font-bold text-bae-ink mb-2">Report pricing</h2>
      <p class="text-sm text-bae-muted mb-6 max-w-content">Indicative launch pricing for each optional report. The free assessment behind every report stays free. Final price and your local currency are shown at checkout.</p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-12">
        {reports.map((r) => (
          <div class="bg-bae-card border border-bae-border rounded-bae p-6">
            <div class="flex items-start justify-between gap-4 mb-2">
              <h3 class="text-base font-semibold text-bae-ink">{r.name}</h3>
              <span class="shrink-0 text-base font-bold text-bae-primary">${r.price}</span>
            </div>
            <p class="text-xs text-bae-muted mb-1">Based on the free <strong>{r.assessment}</strong></p>
            <p class="text-sm text-bae-muted mb-4">{r.summary}</p>
            <p class="text-xs font-semibold uppercase tracking-wider text-bae-ink/70 mb-2">Report includes</p>
            <ul class="text-sm text-bae-muted space-y-1.5">
              {r.includes.map((item) => (<li>✓ {item}</li>))}
            </ul>
          </div>
        ))}
      </div>

      <!-- How payment works -->
      <div class="bg-bae-card border border-bae-border rounded-bae p-6 md:p-8 max-w-content">
        <h2 class="font-serif text-xl font-bold text-bae-ink mb-4">How payment &amp; delivery works</h2>
        <ul class="text-sm text-bae-muted space-y-3">
          <li><strong>One-time payment.</strong> Reports are a single purchase, with no subscriptions or recurring charges.</li>
          <li><strong>Instant digital delivery.</strong> Your PDF is delivered for download immediately after purchase. No physical goods are shipped.</li>
          <li><strong>Secure checkout via Paddle.</strong> Payments are processed by Paddle.com Market Limited, our authorized reseller and Merchant of Record, who handle billing, applicable taxes/VAT, and invoicing worldwide.</li>
          <li><strong>Global currencies.</strong> Paddle displays the price in your local currency where supported.</li>
          <li><strong>Your rights.</strong> See our <a href="/refund-policy/" class="text-bae-primary hover:underline">Refund Policy</a> and <a href="/terms/" class="text-bae-primary hover:underline">Terms of Use</a> for full details on digital-content delivery and consumer rights.</li>
        </ul>
        <p class="text-xs text-bae-muted mt-6 pt-4 border-t border-bae-border">Our paid reports are in active development and launching soon. Pricing on this page is indicative and may be adjusted before launch. Explore the free assessments in the <a href="/knowledge-center/" class="text-bae-primary hover:underline">Knowledge Center</a>.</p>
      </div>

    </div>
  </div>
</BaseLayout>
