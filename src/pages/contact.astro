---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  title: 'Contact — Best Answer Hub',
  description: 'Get in touch with Best Answer Hub. Questions, suggestions, corrections, purchase support, and partnership inquiries welcome. We reply within 1–2 business days.',
  url: '/contact/',
  type: 'WebPage' as const,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact/' },
  ],
};
---

<BaseLayout seo={seo}>
  <div class="py-12 md:py-16">
    <div class="container max-w-content mx-auto px-6">
      <header class="mb-10">
        <h1 class="font-serif text-3xl md:text-4xl font-bold text-bae-ink leading-tight mb-4">Contact</h1>
        <p class="text-lg text-bae-muted">We read every message. Response time is typically 1–2 business days.</p>
      </header>
      
      <div class="bg-bae-card border border-bae-border rounded-bae p-8">
        <div class="grid gap-6 mb-8">
          <div>
            <h2 class="text-base font-semibold text-bae-ink mb-2">General inquiries</h2>
            <a href="mailto:admin@bestanswerhub.com" class="text-bae-primary font-medium hover:underline">admin@bestanswerhub.com</a>
          </div>
          <div>
            <h2 class="text-base font-semibold text-bae-ink mb-2">Purchase support & refunds</h2>
            <a href="mailto:admin@bestanswerhub.com" class="text-bae-primary font-medium hover:underline">admin@bestanswerhub.com</a>
            <p class="text-sm text-bae-muted mt-1">For questions about orders, downloads, refunds, or billing. Refunds are also handled directly through <a href="https://paddle.net" target="_blank" rel="noopener noreferrer" class="text-bae-primary hover:underline">Paddle</a>.</p>
          </div>
          <div>
            <h2 class="text-base font-semibold text-bae-ink mb-2">Partnership & affiliate</h2>
            <a href="mailto:admin@bestanswerhub.com" class="text-bae-primary font-medium hover:underline">admin@bestanswerhub.com</a>
          </div>
          <div>
            <h2 class="text-base font-semibold text-bae-ink mb-2">Corrections</h2>
            <a href="mailto:admin@bestanswerhub.com" class="text-bae-primary font-medium hover:underline">admin@bestanswerhub.com</a>
          </div>
        </div>
        
        <p class="text-sm text-bae-muted">For press, brand partnerships, or bulk content licensing, please email the partnership address above with details about your request.</p>
      </div>
    </div>
  </div>
</BaseLayout>
