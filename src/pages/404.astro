---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  title: 'Page Not Found — Best Answer Hub',
  description: 'The page you are looking for does not exist or has been moved. Explore our free browser tools, software recommendations, or return to the homepage.',
  url: '/404/',
  type: 'WebPage' as const,
};
---

<BaseLayout seo={seo}>
  <div class="py-20 md:py-28 relative z-[1]">
    <div class="container max-w-page mx-auto px-6 text-center">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-[14px] bg-bae-primary-soft text-bae-primary text-3xl font-extrabold mb-8">
        404
      </div>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-bae-ink leading-tight mb-4">
        Page not found
      </h1>
      <p class="text-bae-muted text-base md:text-lg max-w-md mx-auto mb-8 leading-relaxed">
        The page you are looking for doesn't exist or has been moved. Try searching or browse our free tools.
      </p>
      
      <div class="flex flex-wrap gap-3 justify-center mb-12">
        <a href="/" class="inline-flex items-center gap-2 bg-bae-ink text-white px-6 py-3 rounded-bae-sm font-semibold text-sm hover:bg-bae-primary transition-colors no-underline">
          ← Back to home
        </a>
        <a href="/tools/" class="inline-flex items-center gap-2 bg-bae-card text-bae-ink px-6 py-3 rounded-bae-sm font-semibold text-sm border border-bae-border hover:border-bae-primary transition-colors no-underline">
          Browse free tools
        </a>
      </div>
      
      <div class="max-w-md mx-auto">
        <h2 class="text-sm text-bae-muted mb-3 font-medium">Popular tools</h2>
        <div class="flex flex-wrap justify-center gap-2">
          <a href="/tools/ai-cost-calculator/" class="px-4 py-2 bg-bae-card border border-bae-border rounded-full text-sm font-medium text-bae-fg hover:border-bae-primary hover:text-bae-primary transition-colors no-underline">
            AI Cost Calculator
          </a>
          <a href="/tools/seo-score-checker/" class="px-4 py-2 bg-bae-card border border-bae-border rounded-full text-sm font-medium text-bae-fg hover:border-bae-primary hover:text-bae-primary transition-colors no-underline">
            SEO Checker
          </a>
          <a href="/tools/website-speed-test/" class="px-4 py-2 bg-bae-card border border-bae-border rounded-full text-sm font-medium text-bae-fg hover:border-bae-primary hover:text-bae-primary transition-colors no-underline">
            Speed Test
          </a>
          <a href="/tools/invoice-generator/" class="px-4 py-2 bg-bae-card border border-bae-border rounded-full text-sm font-medium text-bae-fg hover:border-bae-primary hover:text-bae-primary transition-colors no-underline">
            Invoice Generator
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
