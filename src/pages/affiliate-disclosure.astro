---
import LegalLayout from '../layouts/LegalLayout.astro';

const seo = {
  title: 'Affiliate Disclosure — Best Answer Hub',
  description: 'Affiliate disclosure for Best Answer Hub. Learn how we earn commissions, how this affects our recommendations, and our FTC-compliant editorial standards.',
  url: '/affiliate-disclosure/',
  type: 'WebPage' as const,
  breadcrumbs: [
    { name: 'Home', url: '/' },
