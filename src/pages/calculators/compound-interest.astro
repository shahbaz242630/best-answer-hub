          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-bae-border">
                  <th class="text-left py-2 pr-3 font-semibold text-bae-ink text-xs">Year</th>
                  <th class="text-right py-2 px-2 font-semibold text-bae-ink text-xs">Balance</th>
                  <th class="text-right py-2 pl-2 font-semibold text-bae-ink text-xs">Interest</th>
                </tr>
              </thead>
