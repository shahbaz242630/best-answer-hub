      const resultsEmpty = document.getElementById('results-empty');
      const resultsContent = document.getElementById('results-content');
      const resMainValue = document.getElementById('res-main-value');
      const resMainLabel = document.getElementById('res-main-label');
      const resDetails = document.getElementById('res-details');
      const resWarning = document.getElementById('res-warning');
      const resImpossible = document.getElementById('res-impossible');
      const resSecured = document.getElementById('res-secured');
      const toast = document.getElementById('fg-toast');
      const toggleScale = document.getElementById('toggle-scale');
      const scalePanel = document.getElementById('scale-panel');
      const scaleChevron = document.getElementById('scale-chevron');
      const scaleInputs = document.querySelectorAll('.scale-bound');
      const scalePlusMinus = document.getElementById('scale-plusminus');

      // Classic tab refs
      const cCurrent = document.getElementById('c-current');
      const cWeight = document.getElementById('c-weight');
      const cDesiredType = document.getElementById('c-desired-type');
      const cDesiredLetter = document.getElementById('c-desired-letter');
      const cDesiredLetterWrap = document.getElementById('c-desired-letter-wrap');
      const cDesiredPercent = document.getElementById('c-desired-percent');
      const cDesiredPercentWrap = document.getElementById('c-desired-percent-wrap');
      const cDesiredPass = document.getElementById('c-desired-pass');
      const cDesiredPassWrap = document.getElementById('c-desired-pass-wrap');

      // Reverse tab refs
      const rCurrent = document.getElementById('r-current');
      const rFinal = document.getElementById('r-final');
      const rWeight = document.getElementById('r-weight');

      // Weighted tab refs
      const wCategories = document.getElementById('w-categories');
      const wAddCat = document.getElementById('w-add-cat');
      const wDesiredType = document.getElementById('w-desired-type');
      const wDesiredLetter = document.getElementById('w-desired-letter');
      const wDesiredLetterWrap = document.getElementById('w-desired-letter-wrap');
      const wDesiredPercent = document.getElementById('w-desired-percent');
      const wDesiredPercentWrap = document.getElementById('w-desired-percent-wrap');
      const wCalcRequired = document.getElementById('w-calc-required');
      const wCalcOverall = document.getElementById('w-calc-overall');

      // LMS helper refs
      const toggleLms = document.getElementById('toggle-lms');
      const lmsPanel = document.getElementById('lms-panel');
      const lmsChevron = document.getElementById('lms-chevron');
      const lmsDisplayed = document.getElementById('lms-displayed');
      const lmsGraded = document.getElementById('lms-graded');
      const lmsResult = document.getElementById('lms-result');
      const lmsApply = document.getElementById('lms-apply');

      // GPA Plan refs
      const gCum = document.getElementById('g-cum');
      const gTarget = document.getElementById('g-target');
      const gDone = document.getElementById('g-done');
      const gRemaining = document.getElementById('g-remaining');

      // Study Priority refs
      const pClasses = document.getElementById('p-classes');
      const pAdd = document.getElementById('p-add');

      // ─── State ───
      let activeTab = 'classic';
      let scaleBounds = { A: 90, B: 80, C: 70, D: 60, F: 0 };
      let usePlusMinus = true;
      let lastResult = null;

      // ─── Helpers ───
      function showToast(msg) {
        toast.textContent = msg;
        toast.classList.remove('opacity-0');
        toast.classList.add('opacity-100');
        setTimeout(function() {
          toast.classList.remove('opacity-100');
          toast.classList.add('opacity-0');
        }, 2000);
      }

      function getScale() {
        const s = {};
        scaleInputs.forEach(function(inp) {
          s[inp.dataset.grade] = parseFloat(inp.value) || 0;
        });
        // Ensure descending order
        const keys = ['A','B','C','D','F'];
        for (let i = 0; i < keys.length - 1; i++) {
          if (s[keys[i]] <= s[keys[i+1]]) s[keys[i]] = s[keys[i+1]] + 10;
        }
        return s;
      }

      function buildGradeMap(bounds, plusMinus) {
        const map = [];
        const letters = ['A','B','C','D'];
        const tops = [100, bounds.A, bounds.B, bounds.C, bounds.D];
        for (let i = 0; i < letters.length; i++) {
          const letter = letters[i];
          const top = tops[i];
          const bottom = tops[i+1];
          if (plusMinus) {
            const midHigh = bottom + (top - bottom) * 0.67;
            const midLow = bottom + (top - bottom) * 0.33;
            map.push({ grade: letter + '+', min: Math.round(midHigh * 100) / 100 });
            map.push({ grade: letter, min: Math.round(midLow * 100) / 100 });
            map.push({ grade: letter + '-', min: bottom });
          } else {
            map.push({ grade: letter, min: bottom });
          }
        }
        map.push({ grade: 'F', min: 0 });
        // Sort descending by min
        map.sort(function(a, b) { return b.min - a.min; });
        return map;
      }

      function percentToLetter(pct, gradeMap) {
        for (let i = 0; i < gradeMap.length; i++) {
          if (pct >= gradeMap[i].min - 0.001) return gradeMap[i].grade;
        }
        return 'F';
      }

      function letterToPercent(letter, gradeMap) {
        for (let i = 0; i < gradeMap.length; i++) {
          if (gradeMap[i].grade === letter) return gradeMap[i].min;
        }
        return 0;
      }

      // Resolve a *target* letter to the % you need to reach it.
      // Base letters (A/B/C/D) always map to the scale boundary — "target B" = 80,
      // not the plus/minus mid-band — so results match the FAQ and Percentage mode.
      // Plus/minus targets (A-, B+, …) use the plus/minus map, with a safe fallback
      // to the base boundary when plus/minus grading is switched off.
      function resolveTarget(letter, bounds, gradeMap) {
        const base = letter.charAt(0);
        if (base === 'F') return 0;
        if (letter.length === 1) {
          return bounds[base] !== undefined ? bounds[base] : letterToPercent(letter, gradeMap);
        }
        const fromMap = letterToPercent(letter, gradeMap);
        if (fromMap > 0) return fromMap;            // plus/minus on: real band bottom
        return bounds[base] !== undefined ? bounds[base] : 0;  // plus/minus off: base boundary
      }

      function formatNum(n) {
        return (Math.round(n * 100) / 100).toFixed(2);
      }

      // ─── Tabs ───
      function switchTab(name) {
        activeTab = name;
        tabBtns.forEach(function(btn) {
          const active = btn.dataset.tab === name;
          btn.classList.toggle('bg-bae-primary', active);
          btn.classList.toggle('text-white', active);
          btn.classList.toggle('text-bae-ink', !active);
        });
        tabContents.forEach(function(tc) {
          tc.classList.toggle('hidden', !tc.id.endsWith(name));
        });
        resultsEmpty.classList.remove('hidden');
        resultsContent.classList.add('hidden');
      }

      tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() { switchTab(btn.dataset.tab); });
      });

      // ─── Custom Scale ───
      toggleScale.addEventListener('click', function() {
        scalePanel.classList.toggle('hidden');
        scaleChevron.style.transform = scalePanel.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(90deg)';
      });

      scalePlusMinus.addEventListener('change', function() {
        usePlusMinus = scalePlusMinus.checked;
      });

      // ─── Classic desired type toggle ───
      cDesiredType.addEventListener('change', function() {
        cDesiredLetterWrap.classList.toggle('hidden', cDesiredType.value !== 'letter');
        cDesiredPercentWrap.classList.toggle('hidden', cDesiredType.value !== 'percent');
        cDesiredPassWrap.classList.toggle('hidden', cDesiredType.value !== 'pass');
      });

      // ─── Weighted desired type toggle ───
      wDesiredType.addEventListener('change', function() {
        wDesiredLetterWrap.classList.toggle('hidden', wDesiredType.value !== 'letter');
        wDesiredPercentWrap.classList.toggle('hidden', wDesiredType.value !== 'percent');
      });

      // ─── Wire weighted action buttons (both recalculate; mode is auto-detected) ───
      wCalcRequired.addEventListener('click', calculate);
      wCalcOverall.addEventListener('click', calculate);

      // ─── LMS Gradebook Mode helper ───
      function lmsCompute() {
        const displayed = parseFloat(lmsDisplayed.value);
        const graded = parseFloat(lmsGraded.value);
        if (isNaN(displayed) || isNaN(graded) || graded <= 0) {
          lmsResult.textContent = '—';
          return null;
        }
        const real = displayed / (graded / 100);
        lmsResult.textContent = formatNum(real) + '%';
        return real;
      }
      toggleLms.addEventListener('click', function() {
        lmsPanel.classList.toggle('hidden');
        lmsChevron.style.transform = lmsPanel.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(90deg)';
        if (!lmsPanel.classList.contains('hidden')) lmsCompute();
      });
      lmsDisplayed.addEventListener('input', lmsCompute);
      lmsGraded.addEventListener('input', lmsCompute);
      lmsApply.addEventListener('click', function() {
        const real = lmsCompute();
        if (real === null) { showToast('Enter LMS values first'); return; }
        cCurrent.value = formatNum(real);
        showToast('Applied ' + formatNum(real) + '% to current grade');
      });

      // ─── Study Priority class builder ───
      let pCount = 0;
      function addClass(name, current, weight, target) {
        pCount++;
        const div = document.createElement('div');
        div.className = 'bg-bae-bg rounded-bae-sm p-3';
        div.dataset.pRow = '1';
        div.innerHTML =
          '<div class="grid grid-cols-12 gap-2">' +
            '<div class="col-span-3"><label class="block text-[10px] text-bae-muted mb-0.5">Class</label><input type="text" data-field="name" value="' + (name || 'Class') + '" class="w-full bg-white border border-bae-border rounded-bae-sm px-2 py-1 text-xs text-bae-ink focus:outline-none focus:border-bae-primary" /></div>' +
            '<div class="col-span-3"><label class="block text-[10px] text-bae-muted mb-0.5">Current (%)</label><input type="number" data-field="current" min="0" max="100" step="0.01" value="' + (current !== undefined ? current : '') + '" class="w-full bg-white border border-bae-border rounded-bae-sm px-2 py-1 text-xs text-bae-ink focus:outline-none focus:border-bae-primary" /></div>' +
            '<div class="col-span-2"><label class="block text-[10px] text-bae-muted mb-0.5">Final wt (%)</label><input type="number" data-field="weight" min="1" max="100" step="0.01" value="' + (weight !== undefined ? weight : '') + '" class="w-full bg-white border border-bae-border rounded-bae-sm px-2 py-1 text-xs text-bae-ink focus:outline-none focus:border-bae-primary" /></div>' +
            '<div class="col-span-2"><label class="block text-[10px] text-bae-muted mb-0.5">Target (%)</label><input type="number" data-field="target" min="0" max="100" step="0.01" value="' + (target !== undefined ? target : '') + '" class="w-full bg-white border border-bae-border rounded-bae-sm px-2 py-1 text-xs text-bae-ink focus:outline-none focus:border-bae-primary" /></div>' +
            '<div class="col-span-2 flex items-end"><button type="button" data-remove class="text-[10px] text-red-500 hover:text-red-700 font-semibold px-1 py-1 rounded-bae-sm">Remove</button></div>' +
          '</div>';
        pClasses.appendChild(div);
        div.querySelector('[data-remove]').addEventListener('click', function() { div.remove(); });
      }
      addClass('Stats', 85, 50, 90);       // needs ~95 -> high (red)
      addClass('Economics', 80, 40, 80);   // needs ~80 -> medium (amber)
      addClass('English', 88, 25, 80);     // needs ~56 -> low (green, you're safe)
      pAdd.addEventListener('click', function() { addClass('New Class', '', '', ''); });

      function getPriorityClasses() {
        const rows = [];
        pClasses.querySelectorAll('[data-p-row]').forEach(function(div) {
          const name = div.querySelector('[data-field="name"]').value.trim() || 'Class';
          const current = parseFloat(div.querySelector('[data-field="current"]').value);
          const weight = parseFloat(div.querySelector('[data-field="weight"]').value);
          const target = parseFloat(div.querySelector('[data-field="target"]').value);
          if (isNaN(current) || isNaN(weight) || isNaN(target) || weight <= 0) return;
          const required = (target - current * (1 - weight/100)) / (weight/100);
          let band;
          if (required < 0) band = 'secured';
          else if (required > 100) band = 'impossible';
          else if (required >= 90) band = 'high';
          else if (required >= 70) band = 'medium';
          else band = 'low';
          rows.push({ name: name, current: current, weight: weight, target: target, required: required, band: band });
        });
        rows.sort(function(a, b) { return b.required - a.required; });
        return rows;
      }

      // ─── Weighted category builder ───
      let wCatCount = 0;
      function addCategory(name, weight, score, isFinal) {
        wCatCount++;
        const id = 'wcat-' + wCatCount;
        const div = document.createElement('div');
        div.className = 'bg-bae-bg rounded-bae-sm p-3';
        div.dataset.catId = id;
        div.innerHTML =
          '<div class="grid grid-cols-12 gap-2">' +
            '<div class="col-span-4"><label class="block text-[10px] text-bae-muted mb-0.5">Category</label><input type="text" data-field="name" value="' + (name || 'Category') + '" class="w-full bg-white border border-bae-border rounded-bae-sm px-2 py-1 text-xs text-bae-ink focus:outline-none focus:border-bae-primary" /></div>' +
            '<div class="col-span-3"><label class="block text-[10px] text-bae-muted mb-0.5">Weight (%)</label><input type="number" data-field="weight" min="0" max="100" step="0.01" value="' + (weight || 0) + '" class="w-full bg-white border border-bae-border rounded-bae-sm px-2 py-1 text-xs text-bae-ink focus:outline-none focus:border-bae-primary" /></div>' +
            '<div class="col-span-3"><label class="block text-[10px] text-bae-muted mb-0.5">Score (%)</label><input type="number" data-field="score" min="0" max="200" step="0.01" value="' + (score !== undefined ? score : '') + '" class="w-full bg-white border border-bae-border rounded-bae-sm px-2 py-1 text-xs text-bae-ink focus:outline-none focus:border-bae-primary" placeholder="leave blank to calculate" /></div>' +
            '<div class="col-span-2 flex items-end"><button type="button" data-remove class="text-[10px] text-red-500 hover:text-red-700 font-semibold px-2 py-1 rounded-bae-sm">Remove</button></div>' +
          '</div>' +
          '<div class="mt-2 flex items-center gap-2">' +
            '<label class="flex items-center gap-1.5 cursor-pointer"><input type="checkbox" data-advanced-toggle class="w-3 h-3 accent-bae-primary rounded" /><span class="text-[10px] text-bae-muted">Advanced</span></label>' +
          '</div>' +
          '<div data-advanced class="hidden mt-2 grid grid-cols-12 gap-2">' +
            '<div class="col-span-6"><label class="block text-[10px] text-bae-muted mb-0.5">Individual scores (comma-separated)</label><input type="text" data-field="scores" class="w-full bg-white border border-bae-border rounded-bae-sm px-2 py-1 text-xs text-bae-ink focus:outline-none focus:border-bae-primary" placeholder="e.g. 85, 92, 78" /></div>' +
            '<div class="col-span-3"><label class="block text-[10px] text-bae-muted mb-0.5">Drop lowest</label><input type="number" data-field="drop" min="0" max="10" step="1" value="0" class="w-full bg-white border border-bae-border rounded-bae-sm px-2 py-1 text-xs text-bae-ink focus:outline-none focus:border-bae-primary" /></div>' +
            '<div class="col-span-3"><label class="block text-[10px] text-bae-muted mb-0.5">Extra credit</label><input type="number" data-field="extra" min="0" max="100" step="0.01" value="0" class="w-full bg-white border border-bae-border rounded-bae-sm px-2 py-1 text-xs text-bae-ink focus:outline-none focus:border-bae-primary" placeholder="pts" /></div>' +
          '</div>';
        wCategories.appendChild(div);

        div.querySelector('[data-remove]').addEventListener('click', function() {
          div.remove();
        });
        div.querySelector('[data-advanced-toggle]').addEventListener('change', function(e) {
          div.querySelector('[data-advanced]').classList.toggle('hidden', !e.target.checked);
        });
      }

      // Init default categories
      addCategory('Homework', 20, 88);
      addCategory('Quizzes', 20, 82);
      addCategory('Midterm', 25, 76);
      addCategory('Final Exam', 35, '', true);

      wAddCat.addEventListener('click', function() {
        addCategory('New Category', 0, '');
      });

      function getWeightedCategories() {
        const cats = [];
        wCategories.querySelectorAll('[data-cat-id]').forEach(function(div) {
          const name = div.querySelector('[data-field="name"]').value.trim() || 'Category';
          const weight = parseFloat(div.querySelector('[data-field="weight"]').value) || 0;
          const scoreInput = div.querySelector('[data-field="score"]');
          const score = scoreInput.value === '' ? null : (parseFloat(scoreInput.value) || 0);
          const scoresStr = div.querySelector('[data-field="scores"]').value;
          const drop = parseInt(div.querySelector('[data-field="drop"]').value, 10) || 0;
          const extra = parseFloat(div.querySelector('[data-field="extra"]').value) || 0;
          let finalScore = score;
          if (scoresStr && scoresStr.trim()) {
            const arr = scoresStr.split(',').map(function(s) { return parseFloat(s.trim()); }).filter(function(n) { return !isNaN(n); });
            if (arr.length > 0) {
              arr.sort(function(a, b) { return a - b; });
              const dropCount = Math.min(drop, arr.length - 1);
              const kept = arr.slice(dropCount);
              const sum = kept.reduce(function(a, b) { return a + b; }, 0);
              finalScore = sum / kept.length + extra;
            }
          } else if (extra > 0 && score !== null) {
            finalScore = score + extra;
          }
          cats.push({ name: name, weight: weight, score: finalScore, rawScore: score });
        });
        return cats;
      }

      // ─── Calculate ───
      function calculate() {
        const scale = getScale();
        const gradeMap = buildGradeMap(scale, usePlusMinus);
        let result = {};

        if (activeTab === 'classic') {
          const current = parseFloat(cCurrent.value) || 0;
          const weight = parseFloat(cWeight.value) || 0;
          const type = cDesiredType.value;
          let desired = 0;
          let desiredLetter = null;
          if (type === 'letter') { desired = resolveTarget(cDesiredLetter.value, scale, gradeMap); desiredLetter = cDesiredLetter.value; }
          else if (type === 'percent') desired = parseFloat(cDesiredPercent.value) || 0;
          else desired = parseFloat(cDesiredPass.value) || 0;

          const required = (desired - current * (1 - weight/100)) / (weight/100);
          const maxPossible = current * (1 - weight/100) + 100 * (weight/100);
          const minPossible = current * (1 - weight/100); // overall if final = 0

          result = {
            mode: 'classic',
            current: current,
            weight: weight,
            invalid: !(weight > 0),         // weight 0 / blank → division by zero
            desired: desired,
            desiredLetter: desiredLetter,
            required: required,
            maxPossible: maxPossible,
            minPossible: minPossible,
            lockedIn: required < 0,        // target already guaranteed (even a 0 reaches it)
            impossible: required > 100,    // unreachable even with a perfect final
            possible: required >= 0 && required <= 100,
            letter: percentToLetter(required, gradeMap),
            overallLetter: percentToLetter(maxPossible, gradeMap),
            minLetter: percentToLetter(minPossible, gradeMap)
          };
        } else if (activeTab === 'reverse') {
          const current = parseFloat(rCurrent.value) || 0;
          const final = parseFloat(rFinal.value) || 0;
          const weight = parseFloat(rWeight.value) || 0;
          const overall = current * (1 - weight/100) + final * (weight/100);
          result = {
            mode: 'reverse',
            current: current,
            final: final,
            weight: weight,
            overall: overall,
            letter: percentToLetter(overall, gradeMap)
          };
        } else if (activeTab === 'weighted') {
          const cats = getWeightedCategories();
          const totalWeight = cats.reduce(function(s, c) { return s + c.weight; }, 0);
          const known = cats.filter(function(c) { return c.score !== null; });
          const unknown = cats.filter(function(c) { return c.score === null; });
          const knownWeight = known.reduce(function(s, c) { return s + c.weight; }, 0);
          const knownScore = known.reduce(function(s, c) { return s + c.weight * c.score; }, 0);

          result = {
            mode: 'weighted',
            cats: cats,
            totalWeight: totalWeight,
            knownWeight: knownWeight,
            knownScore: knownScore,
            unknownCount: unknown.length
          };

          // If calculating required final
          if (unknown.length === 1) {
            const u = unknown[0];
            const type = wDesiredType.value;
            let desired = 0;
            let desiredLetter = null;
            if (type === 'letter') { desired = resolveTarget(wDesiredLetter.value, scale, gradeMap); desiredLetter = wDesiredLetter.value; }
            else desired = parseFloat(wDesiredPercent.value) || 0;

            const required = (desired * totalWeight - knownScore) / u.weight;
            const maxOverall = (knownScore + u.weight * 100) / totalWeight;
            const minOverall = knownScore / totalWeight; // overall if final = 0
            result.invalid = !(totalWeight > 0 && u.weight > 0); // zero weight → division by zero
            result.desired = desired;
            result.desiredLetter = desiredLetter;
            result.required = required;
            result.unknown = u;
            result.lockedIn = required < 0;     // target already guaranteed
            result.impossible = required > 100;  // unreachable even with a perfect final
            result.possible = required >= 0 && required <= 100;
            result.maxOverall = maxOverall;
            result.minOverall = minOverall;
            result.letter = percentToLetter(required, gradeMap);
            result.minLetter = percentToLetter(minOverall, gradeMap);
          } else if (unknown.length === 0) {
            // Calculate overall
            result.invalid = !(totalWeight > 0); // no weights entered → division by zero
            const overall = knownScore / totalWeight;
            result.overall = overall;
            result.letter = percentToLetter(overall, gradeMap);
          }
        } else if (activeTab === 'gpa') {
          const cum = parseFloat(gCum.value) || 0;
          const target = parseFloat(gTarget.value) || 0;
          const done = parseFloat(gDone.value) || 0;
          const remaining = parseFloat(gRemaining.value) || 0;
          const currentQP = cum * done;
          const totalCredits = done + remaining;
          const targetQP = target * totalCredits;
          const required = remaining > 0 ? (targetQP - currentQP) / remaining : Infinity;
          result = {
            mode: 'gpa',
            cum: cum, target: target, done: done, remaining: remaining,
            required: required,
            lockedIn: required < 0,
            impossible: required > 4.0 + 1e-9,
            possible: required >= 0 && required <= 4.0 + 1e-9
          };
        } else if (activeTab === 'priority') {
          const rows = getPriorityClasses();
          result = { mode: 'priority', rows: rows };
        }

        lastResult = result;
        renderResults(result, gradeMap);
      }

      function renderResults(result, gradeMap) {
        resultsEmpty.classList.add('hidden');
        resultsContent.classList.remove('hidden');
        resWarning.classList.add('hidden');
        resImpossible.classList.add('hidden');
        resSecured.classList.add('hidden');
        resDetails.innerHTML = '';

        // Echo the letter the user actually picked; fall back to deriving it from the % target.
        const desiredLabel = result.desiredLetter || (result.desired !== undefined ? percentToLetter(result.desired, gradeMap) : '');

        if (result.mode === 'classic') {
          if (result.invalid) {
            resMainValue.textContent = '—';
            resMainLabel.textContent = 'Check final weight';
            resImpossible.classList.remove('hidden');
            resImpossible.innerHTML = '<strong>Enter a final exam weight greater than 0%.</strong> The final has to be worth something for us to work out what you need on it.';
          } else if (result.lockedIn) {
            resMainValue.textContent = formatNum(result.minPossible) + '%';
            resMainLabel.textContent = 'Already secured (' + result.minLetter + ')';
            resSecured.classList.remove('hidden');
            resSecured.innerHTML = '<strong>Your target is already locked in.</strong> Even a 0% on the final leaves you at ' + formatNum(result.minPossible) + '% (' + result.minLetter + '), at or above your ' + formatNum(result.desired) + '% goal. Relax: your final cannot drop you below this floor.';
            resDetails.innerHTML =
              '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Current grade</span><span class="font-semibold text-bae-ink">' + formatNum(result.current) + '%</span></div>' +
              '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Final weight</span><span class="font-semibold text-bae-ink">' + formatNum(result.weight) + '%</span></div>' +
              '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Target grade</span><span class="font-semibold text-bae-ink">' + formatNum(result.desired) + '% (' + desiredLabel + ')</span></div>' +
              '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Worst-case grade (0% final)</span><span class="font-semibold text-bae-ink">' + formatNum(result.minPossible) + '% (' + result.minLetter + ')</span></div>' +
              '<div class="flex justify-between py-1"><span class="text-bae-muted">Best-case grade (100% final)</span><span class="font-semibold text-bae-ink">' + formatNum(result.maxPossible) + '% (' + result.overallLetter + ')</span></div>';
          } else if (result.possible) {
            resMainValue.textContent = formatNum(result.required) + '%';
            resMainLabel.textContent = 'Needed on final for ' + desiredLabel;
            resDetails.innerHTML =
              '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Current grade</span><span class="font-semibold text-bae-ink">' + formatNum(result.current) + '%</span></div>' +
              '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Final weight</span><span class="font-semibold text-bae-ink">' + formatNum(result.weight) + '%</span></div>' +
              '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Target grade</span><span class="font-semibold text-bae-ink">' + formatNum(result.desired) + '% (' + desiredLabel + ')</span></div>' +
              '<div class="flex justify-between py-1"><span class="text-bae-muted">Max possible grade</span><span class="font-semibold text-bae-ink">' + formatNum(result.maxPossible) + '% (' + result.overallLetter + ')</span></div>';
            if (result.required > 90) {
              resWarning.classList.remove('hidden');
              resWarning.textContent = 'You need a very high score. Study hard, but consider a backup target grade.';
            }
          } else {
            resMainValue.textContent = formatNum(result.required) + '%';
            resMainLabel.textContent = 'Required (impossible)';
            resImpossible.classList.remove('hidden');
            resImpossible.innerHTML = '<strong>Target is mathematically impossible.</strong> The highest grade you can achieve is ' + formatNum(result.maxPossible) + '% (' + result.overallLetter + '). Try lowering your target to a ' + result.overallLetter + ' or lower.';
            resDetails.innerHTML =
              '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Current grade</span><span class="font-semibold text-bae-ink">' + formatNum(result.current) + '%</span></div>' +
              '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Final weight</span><span class="font-semibold text-bae-ink">' + formatNum(result.weight) + '%</span></div>' +
              '<div class="flex justify-between py-1"><span class="text-bae-muted">Max possible grade</span><span class="font-semibold text-bae-ink">' + formatNum(result.maxPossible) + '% (' + result.overallLetter + ')</span></div>';
          }
        } else if (result.mode === 'reverse') {
          resMainValue.textContent = formatNum(result.overall) + '%';
          resMainLabel.textContent = 'Overall grade (' + result.letter + ')';
          resDetails.innerHTML =
            '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Grade before final</span><span class="font-semibold text-bae-ink">' + formatNum(result.current) + '%</span></div>' +
            '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Final score</span><span class="font-semibold text-bae-ink">' + formatNum(result.final) + '%</span></div>' +
            '<div class="flex justify-between py-1"><span class="text-bae-muted">Final weight</span><span class="font-semibold text-bae-ink">' + formatNum(result.weight) + '%</span></div>';
        } else if (result.mode === 'weighted') {
          if (result.invalid) {
            resMainValue.textContent = '—';
            resMainLabel.textContent = 'Check category weights';
            resImpossible.classList.remove('hidden');
            resImpossible.innerHTML = '<strong>Category weights must add up to more than 0%.</strong> Give each category (including the blank one you want calculated) a weight greater than 0.';
          } else if (result.unknownCount === 1 && result.required !== undefined) {
            if (result.lockedIn) {
              resMainValue.textContent = formatNum(result.minOverall) + '%';
              resMainLabel.textContent = 'Already secured (' + result.minLetter + ')';
              resSecured.classList.remove('hidden');
              resSecured.innerHTML = '<strong>Your target is already locked in.</strong> Even a 0% on ' + result.unknown.name + ' leaves you at ' + formatNum(result.minOverall) + '% (' + result.minLetter + '), at or above your ' + formatNum(result.desired) + '% goal.';
              resDetails.innerHTML =
                '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Target overall</span><span class="font-semibold text-bae-ink">' + formatNum(result.desired) + '% (' + desiredLabel + ')</span></div>' +
                '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Worst-case (0% on ' + result.unknown.name + ')</span><span class="font-semibold text-bae-ink">' + formatNum(result.minOverall) + '% (' + result.minLetter + ')</span></div>' +
                '<div class="flex justify-between py-1"><span class="text-bae-muted">Best-case (100%)</span><span class="font-semibold text-bae-ink">' + formatNum(result.maxOverall) + '% (' + percentToLetter(result.maxOverall, gradeMap) + ')</span></div>';
            } else if (result.possible) {
              resMainValue.textContent = formatNum(result.required) + '%';
              resMainLabel.textContent = 'Needed on ' + result.unknown.name;
              resDetails.innerHTML =
                '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Target overall</span><span class="font-semibold text-bae-ink">' + formatNum(result.desired) + '% (' + desiredLabel + ')</span></div>' +
                '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Known categories</span><span class="font-semibold text-bae-ink">' + formatNum(result.knownWeight) + '% weight</span></div>' +
                '<div class="flex justify-between py-1"><span class="text-bae-muted">Max possible</span><span class="font-semibold text-bae-ink">' + formatNum(result.maxOverall) + '% (' + percentToLetter(result.maxOverall, gradeMap) + ')</span></div>';
              if (result.required > 90) {
                resWarning.classList.remove('hidden');
                resWarning.textContent = 'You need a very high score on ' + result.unknown.name + '. Consider a backup target.';
              }
            } else {
              resMainValue.textContent = formatNum(result.required) + '%';
              resMainLabel.textContent = 'Required (impossible)';
              resImpossible.classList.remove('hidden');
              resImpossible.innerHTML = '<strong>Target is mathematically impossible.</strong> The highest overall grade you can achieve is ' + formatNum(result.maxOverall) + '% (' + percentToLetter(result.maxOverall, gradeMap) + ').';
            }
          } else if (result.unknownCount === 0 && result.overall !== undefined) {
            resMainValue.textContent = formatNum(result.overall) + '%';
            resMainLabel.textContent = 'Overall grade (' + result.letter + ')';
            let html = '';
            result.cats.forEach(function(c) {
              html += '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">' + c.name + ' (' + c.weight + '%)</span><span class="font-semibold text-bae-ink">' + formatNum(c.score) + '%</span></div>';
            });
            html += '<div class="flex justify-between py-1"><span class="text-bae-muted">Total weight</span><span class="font-semibold text-bae-ink">' + formatNum(result.totalWeight) + '%</span></div>';
            resDetails.innerHTML = html;
          } else {
            resMainValue.textContent = '—';
            resMainLabel.textContent = 'Check inputs';
            resDetails.innerHTML = '<p class="text-sm text-bae-muted">Leave exactly one category score blank to calculate the required score. Or fill in all categories to see the overall grade.</p>';
          }
        } else if (result.mode === 'gpa') {
          const currentQP = result.cum * result.done;
          const totalCredits = result.done + result.remaining;
          const maxCum = totalCredits > 0 ? (currentQP + 4.0 * result.remaining) / totalCredits : 0;
          const minCum = totalCredits > 0 ? currentQP / totalCredits : 0;
          const detail =
            '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Current cumulative GPA</span><span class="font-semibold text-bae-ink">' + formatNum(result.cum) + '</span></div>' +
            '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Target cumulative GPA</span><span class="font-semibold text-bae-ink">' + formatNum(result.target) + '</span></div>' +
            '<div class="flex justify-between py-1 border-b border-bae-border"><span class="text-bae-muted">Credits completed</span><span class="font-semibold text-bae-ink">' + formatNum(result.done) + '</span></div>' +
            '<div class="flex justify-between py-1"><span class="text-bae-muted">Credits remaining</span><span class="font-semibold text-bae-ink">' + formatNum(result.remaining) + '</span></div>';
          if (result.lockedIn) {
            resMainValue.textContent = formatNum(minCum);
            resMainLabel.textContent = 'Target already secured';
            resSecured.classList.remove('hidden');
            resSecured.innerHTML = '<strong>Your target is already locked in.</strong> Even a 0.0 this semester leaves your cumulative GPA at ' + formatNum(minCum) + ', at or above your ' + formatNum(result.target) + ' goal.';
            resDetails.innerHTML = detail;
          } else if (result.impossible) {
            resMainValue.textContent = formatNum(result.required);
            resMainLabel.textContent = 'GPA needed (impossible)';
            resImpossible.classList.remove('hidden');
            resImpossible.innerHTML = '<strong>Out of reach this semester.</strong> A ' + formatNum(result.required) + ' GPA is above the 4.0 maximum. Even straight A&rsquo;s (4.0) this semester reach only a ' + formatNum(maxCum) + ' cumulative GPA. Lower your target or spread it across more semesters.';
            resDetails.innerHTML = detail;
          } else {
            resMainValue.textContent = formatNum(result.required);
            resMainLabel.textContent = 'GPA needed this semester';
            resDetails.innerHTML = detail;
            if (result.required >= 3.7) {
              resWarning.classList.remove('hidden');
              resWarning.textContent = 'You need a very high GPA this semester (' + formatNum(result.required) + '). Achievable, but it leaves little room for a slip.';
            }
          }
        } else if (result.mode === 'priority') {
          const rows = result.rows || [];
          if (rows.length === 0) {
            resMainValue.textContent = '—';
            resMainLabel.textContent = 'Add classes';
            resDetails.innerHTML = '<p class="text-sm text-bae-muted">Add at least one class with a current grade, final weight, and target to see your study ranking.</p>';
          } else {
            const colors = { high: 'text-red-600', impossible: 'text-red-600', medium: 'text-amber-600', low: 'text-green-600', secured: 'text-green-600' };
            const labels = { high: 'Must ace it', impossible: 'Out of reach', medium: 'Study up', low: 'You’re safe', secured: 'Locked in' };
            resMainValue.textContent = rows.length;
            resMainLabel.textContent = rows.length === 1 ? 'class ranked' : 'classes ranked, hardest first';
            let html = '';
            rows.forEach(function(r, i) {
              const c = colors[r.band] || 'text-bae-ink';
              const valTxt = r.band === 'secured' ? 'Secured' : (r.band === 'impossible' ? '>100%' : 'Need ' + formatNum(r.required) + '%');
              html += '<div class="flex items-center justify-between py-1.5 border-b border-bae-border">' +
                '<span class="flex items-center gap-2"><span class="inline-flex w-5 h-5 items-center justify-center rounded-full bg-bae-bg text-[10px] font-bold text-bae-muted">' + (i + 1) + '</span><span class="text-bae-ink font-medium">' + r.name + '</span></span>' +
                '<span class="text-right"><span class="font-bold ' + c + '">' + valTxt + '</span><span class="block text-[10px] ' + c + '">' + (labels[r.band] || '') + '</span></span>' +
                '</div>';
            });
            resDetails.innerHTML = html;
          }
        }
      }

      btnCalculate.addEventListener('click', calculate);

      btnClear.addEventListener('click', function() {
        // Classic tab
        cCurrent.value = '';
        cWeight.value = '25';
        cDesiredType.value = 'letter';
        cDesiredLetter.value = 'B';
        cDesiredPercent.value = '80';
        cDesiredPass.value = '60';
        cDesiredLetterWrap.classList.remove('hidden');
        cDesiredPercentWrap.classList.add('hidden');
        cDesiredPassWrap.classList.add('hidden');

        // Reverse tab
        rCurrent.value = '';
        rFinal.value = '';
        rWeight.value = '25';

        // Weighted tab — remove all, restore defaults
        wCategories.innerHTML = '';
        wCatCount = 0;
        addCategory('Homework', 20, 88);
        addCategory('Quizzes', 20, 82);
        addCategory('Midterm', 25, 76);
        addCategory('Final Exam', 35, '', true);
        wDesiredType.value = 'letter';
        wDesiredLetter.value = 'B';
        wDesiredPercent.value = '80';
        wDesiredLetterWrap.classList.remove('hidden');
        wDesiredPercentWrap.classList.add('hidden');

        // GPA Plan tab
        gCum.value = '3.2';
        gTarget.value = '3.5';
        gDone.value = '30';
        gRemaining.value = '30';

        // Study Priority tab — remove all, restore defaults
        pClasses.innerHTML = '';
        pCount = 0;
        addClass('Stats', 85, 50, 90);
        addClass('Economics', 80, 40, 80);
        addClass('English', 88, 25, 80);

        // LMS helper
        lmsDisplayed.value = '49';
        lmsGraded.value = '75';
        lmsResult.textContent = '—';

        // Reset custom scale
        scaleBounds = { A: 90, B: 80, C: 70, D: 60, F: 0 };
        usePlusMinus = true;
        scalePlusMinus.checked = true;
        scaleInputs.forEach(function(inp) {
          const g = inp.dataset.grade;
          if (g && scaleBounds[g] !== undefined) { inp.value = scaleBounds[g]; }
        });
        if (!scalePanel.classList.contains('hidden')) {
          toggleScale.click();
        }

        // Reset results
        resultsContent.classList.add('hidden');
        resultsEmpty.classList.remove('hidden');
        lastResult = null;

        // Clear URL params
        if (window.history.replaceState) {
          window.history.replaceState({}, document.title, window.location.pathname);
        }

        showToast('All fields cleared');
      });

      // ─── PDF Export ───
      btnPdf.addEventListener('click', function() {
        if (!lastResult) { showToast('Calculate first'); return; }
        if (typeof html2pdf === 'undefined') { showToast('PDF library loading'); return; }

        const gradeMap = buildGradeMap(getScale(), usePlusMinus);
        document.getElementById('pdf-date').textContent = 'Generated on ' + new Date().toLocaleDateString();

        let summaryHtml = '';
        if (lastResult.mode === 'classic') {
          summaryHtml = '<p><strong>Mode:</strong> Classic (What do I need on my final?)</p>' +
            '<p><strong>Current grade:</strong> ' + formatNum(lastResult.current) + '%</p>' +
            '<p><strong>Final weight:</strong> ' + formatNum(lastResult.weight) + '%</p>' +
            (lastResult.lockedIn
              ? '<p><strong>Target already secured:</strong> even a 0% final keeps you at ' + formatNum(lastResult.minPossible) + '% (' + lastResult.minLetter + ')</p>'
              : '<p><strong>Required on final:</strong> ' + formatNum(lastResult.required) + '% (' + lastResult.letter + ')</p>');
        } else if (lastResult.mode === 'reverse') {
          summaryHtml = '<p><strong>Mode:</strong> Reverse (What is my overall grade?)</p>' +
            '<p><strong>Overall grade:</strong> ' + formatNum(lastResult.overall) + '% (' + lastResult.letter + ')</p>';
        } else if (lastResult.mode === 'weighted') {
          summaryHtml = '<p><strong>Mode:</strong> Weighted Categories</p>';
          if (lastResult.overall !== undefined) {
            summaryHtml += '<p><strong>Overall grade:</strong> ' + formatNum(lastResult.overall) + '% (' + lastResult.letter + ')</p>';
          } else if (lastResult.required !== undefined) {
            summaryHtml += lastResult.lockedIn
              ? '<p><strong>Target already secured on ' + lastResult.unknown.name + ':</strong> even a 0% keeps you at ' + formatNum(lastResult.minOverall) + '% (' + lastResult.minLetter + ')</p>'
              : '<p><strong>Required on ' + lastResult.unknown.name + ':</strong> ' + formatNum(lastResult.required) + '% (' + lastResult.letter + ')</p>';
          }
        } else if (lastResult.mode === 'gpa') {
          summaryHtml = '<p><strong>Mode:</strong> Semester GPA Planner</p>' +
            '<p><strong>Current cumulative GPA:</strong> ' + formatNum(lastResult.cum) + ' over ' + formatNum(lastResult.done) + ' credits</p>' +
            (lastResult.impossible
              ? '<p><strong>Target ' + formatNum(lastResult.target) + ' is out of reach this semester</strong> (needs ' + formatNum(lastResult.required) + ' GPA, above the 4.0 max)</p>'
              : lastResult.lockedIn
                ? '<p><strong>Target ' + formatNum(lastResult.target) + ' already secured</strong>: even a 0.0 this semester keeps you there</p>'
                : '<p><strong>GPA needed this semester:</strong> ' + formatNum(lastResult.required) + ' (to reach a ' + formatNum(lastResult.target) + ' cumulative)</p>');
        } else if (lastResult.mode === 'priority') {
          summaryHtml = '<p><strong>Mode:</strong> Study Priority</p>' +
            '<p><strong>' + (lastResult.rows ? lastResult.rows.length : 0) + ' classes ranked hardest-first</strong> by the score needed on each final.</p>';
        }
        document.getElementById('pdf-summary').innerHTML = summaryHtml;

        const tbody = document.getElementById('pdf-table-body');
        tbody.innerHTML = '';
        function addRow(item, val) {
          const tr = document.createElement('tr');
          tr.innerHTML = '<td style="border:1px solid #e2e8f0;padding:6px;">' + item + '</td><td style="border:1px solid #e2e8f0;padding:6px;">' + val + '</td>';
          tbody.appendChild(tr);
        }
        if (lastResult.mode === 'classic') {
          addRow('Current grade', formatNum(lastResult.current) + '%');
          addRow('Final weight', formatNum(lastResult.weight) + '%');
          addRow('Target grade', formatNum(lastResult.desired) + '% (' + (lastResult.desiredLetter || percentToLetter(lastResult.desired, gradeMap)) + ')');
          if (lastResult.lockedIn) {
            addRow('Status', 'Already secured: even a 0% final passes your target');
            addRow('Worst-case grade (0% final)', formatNum(lastResult.minPossible) + '% (' + lastResult.minLetter + ')');
          } else {
            addRow('Required on final', formatNum(lastResult.required) + '% (' + lastResult.letter + ')');
          }
          addRow('Max possible', formatNum(lastResult.maxPossible) + '% (' + lastResult.overallLetter + ')');
        } else if (lastResult.mode === 'reverse') {
          addRow('Current grade', formatNum(lastResult.current) + '%');
          addRow('Final score', formatNum(lastResult.final) + '%');
          addRow('Final weight', formatNum(lastResult.weight) + '%');
          addRow('Overall grade', formatNum(lastResult.overall) + '% (' + lastResult.letter + ')');
        } else if (lastResult.mode === 'weighted' && lastResult.cats) {
          lastResult.cats.forEach(function(c) {
            addRow(c.name + ' (' + c.weight + '%)', (c.score !== null ? formatNum(c.score) + '%' : '—'));
          });
          if (lastResult.overall !== undefined) addRow('Overall grade', formatNum(lastResult.overall) + '% (' + lastResult.letter + ')');
          if (lastResult.required !== undefined) {
            if (lastResult.lockedIn) {
              addRow('Status on ' + lastResult.unknown.name, 'Already secured: even a 0% passes your target');
              addRow('Worst-case overall (0%)', formatNum(lastResult.minOverall) + '% (' + lastResult.minLetter + ')');
            } else {
              addRow('Required on ' + lastResult.unknown.name, formatNum(lastResult.required) + '% (' + lastResult.letter + ')');
            }
          }
        } else if (lastResult.mode === 'gpa') {
          addRow('Current cumulative GPA', formatNum(lastResult.cum));
          addRow('Target cumulative GPA', formatNum(lastResult.target));
          addRow('Credits completed', formatNum(lastResult.done));
          addRow('Credits remaining', formatNum(lastResult.remaining));
          addRow(lastResult.impossible ? 'GPA needed (impossible)' : (lastResult.lockedIn ? 'Status' : 'GPA needed this semester'),
                 lastResult.lockedIn ? 'Already secured' : formatNum(lastResult.required));
        } else if (lastResult.mode === 'priority' && lastResult.rows) {
          lastResult.rows.forEach(function(r, i) {
            addRow((i + 1) + '. ' + r.name, r.band === 'secured' ? 'Secured' : (r.band === 'impossible' ? 'Out of reach (>100%)' : 'Need ' + formatNum(r.required) + '% on final'));
          });
        }

        const report = document.getElementById('pdf-report-content');
        const clone = report.cloneNode(true);
        clone.removeAttribute('id');
        clone.style.maxWidth = 'none';
        clone.style.width = '210mm';
        clone.style.margin = '0';
        clone.style.boxSizing = 'border-box';
        document.body.appendChild(clone);

        html2pdf().set({
          margin: 0,
          filename: 'finals-grade-report.pdf',
          image: { type: 'jpeg', quality: 0.95 },
          html2canvas: { scale: 2, scrollX: 0, scrollY: 0 },
          jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
        }).from(clone).save().then(function() {
          if (clone.parentNode) document.body.removeChild(clone);
          showToast('PDF downloaded');
        }).catch(function() {
          if (clone.parentNode) document.body.removeChild(clone);
          showToast('PDF generation failed');
        });
      });

      // ─── Shareable URL ───
      btnShare.addEventListener('click', function() {
        if (!lastResult) { showToast('Calculate first'); return; }
        const params = new URLSearchParams();
        params.set('tab', activeTab);
        if (activeTab === 'classic') {
          params.set('current', cCurrent.value);
          params.set('weight', cWeight.value);
          params.set('dtype', cDesiredType.value);
          if (cDesiredType.value === 'letter') params.set('desired', cDesiredLetter.value);
          else if (cDesiredType.value === 'percent') params.set('desired', cDesiredPercent.value);
          else params.set('desired', cDesiredPass.value);
        } else if (activeTab === 'reverse') {
          params.set('current', rCurrent.value);
          params.set('final', rFinal.value);
          params.set('weight', rWeight.value);
        }
        const url = window.location.origin + window.location.pathname + '?' + params.toString();
        navigator.clipboard.writeText(url).then(function() { showToast('Link copied'); }).catch(function() { showToast('Copy failed'); });
      });

      // ─── Read URL on load ───
      function readURL() {
        const params = new URLSearchParams(window.location.search);
        const tab = params.get('tab');
        if (tab && ['classic','weighted','reverse'].indexOf(tab) !== -1) {
          switchTab(tab);
        }
        if (tab === 'classic' || !tab) {
          if (params.has('current')) cCurrent.value = params.get('current');
          if (params.has('weight')) cWeight.value = params.get('weight');
          if (params.has('dtype')) {
            cDesiredType.value = params.get('dtype');
            cDesiredType.dispatchEvent(new Event('change'));
            if (params.get('dtype') === 'letter') cDesiredLetter.value = params.get('desired');
            else if (params.get('dtype') === 'percent') cDesiredPercent.value = params.get('desired');
            else cDesiredPass.value = params.get('desired');
          }
          calculate();
        } else if (tab === 'reverse') {
          if (params.has('current')) rCurrent.value = params.get('current');
          if (params.has('final')) rFinal.value = params.get('final');
          if (params.has('weight')) rWeight.value = params.get('weight');
          calculate();
        }
      }

      readURL();
    })();
  </script>

  <script slot="scripts" src="/html2pdf.bundle.min.js"></script>
</BaseLayout>
