  }

  function rrefWithSteps(m) {
    const M = cloneMatrix(m);
    const rows = M.length, cols = M[0].length;
    const steps = [];
    let pivotRow = 0;
    for (let col = 0; col < cols && pivotRow < rows; col++) {
      // Find pivot
      let maxRow = pivotRow;
      for (let r = pivotRow + 1; r < rows; r++) {
        if (M[r][col].abs().toNum() > M[maxRow][col].abs().toNum()) maxRow = r;
      }
      if (M[maxRow][col].isZero()) continue;
      if (maxRow !== pivotRow) {
        [M[pivotRow], M[maxRow]] = [M[maxRow], M[pivotRow]];
        steps.push('<p class="mb-1">Swap R<sub>' + (pivotRow+1) + '</sub> ↔ R<sub>' + (maxRow+1) + '</sub></p>');
        steps.push(matrixToHTML(M));
      }
      // Scale pivot to 1
      const pivVal = M[pivotRow][col];
      if (!pivVal.isOne()) {
