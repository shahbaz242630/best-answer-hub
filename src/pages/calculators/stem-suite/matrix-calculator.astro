  // ===== Shared eigenvalue/eigenvector helpers =====
  function approxFrac(x) {
    // Closest small rational within tolerance, or null if x looks irrational
    let bestN = Math.round(x), bestD = 1, bestErr = Math.abs(x - Math.round(x));
    for (let d = 2; d <= 100; d++) {
      const n = Math.round(x * d), err = Math.abs(x - n / d);
      if (err < bestErr) { bestErr = err; bestN = n; bestD = d; }
