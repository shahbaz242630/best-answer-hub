    steps.push('<p class="mb-1">Determinant = ' + escapeHtml(d.toStr()) + ' (non-zero, so inverse exists)</p>');
    if (n === 2) {
      const a = m[0][0], b = m[0][1], c = m[1][0], d0 = m[1][1];
      const inv = [[d0.div(d), b.neg().div(d)], [c.neg().div(d), a.div(d)]];
