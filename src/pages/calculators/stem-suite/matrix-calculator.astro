    return sum;
  }
  function detSteps(m) {
    const n = m.length;
    const steps = [];
    if (n === 2) {
      const a = fmtF(m[0][0]), b = fmtF(m[0][1]), c = fmtF(m[1][0]), d = fmtF(m[1][1]);
      const res = det(m);
      steps.push('<p class="mb-1">For a 2×2 matrix, det = ad − bc</p>');
      steps.push('<p class="mb-1">det = (' + escapeHtml(a) + ')(' + escapeHtml(d) + ') − (' + escapeHtml(b) + ')(' + escapeHtml(c) + ') = <strong>' + escapeHtml(fmtF(res)) + '</strong></p>');
      return { value: res, steps };
    }
    if (n === 3) {
      steps.push('<p class="mb-1">Using cofactor expansion along the first row:</p>');
      steps.push(matrixToHTML(m));
      let sum = new Frac(0);
      let terms = [];
      for (let c = 0; c < 3; c++) {
        const minor = [];
        for (let r = 1; r < 3; r++) {
