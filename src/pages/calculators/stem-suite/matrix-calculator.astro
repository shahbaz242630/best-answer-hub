    steps.push('<p class="mb-2">Result matrix C = A × B, where C<sub>ij</sub> = row i of A · column j of B</p>');
    steps.push(matrixToHTML(res, {label: 'C = A × B'}));
    for (let i = 0; i < Math.min(r, 3); i++) {
      for (let j = 0; j < Math.min(c, 3); j++) {
        const parts = [];
        for (let k = 0; k < inner; k++) {
          parts.push('(' + escapeHtml(fmtF(a[i][k])) + ')(' + escapeHtml(fmtF(b[k][j])) + ')');
        }
        steps.push('<p class="mb-1 mt-2">C<sub>' + (i+1) + ',' + (j+1) + '</sub> = ' + parts.join(' + ') + ' = <strong>' + escapeHtml(fmtF(res[i][j])) + '</strong></p>');
      }
    }
    if (r > 3 || c > 3) steps.push('<p class="mb-1 mt-1 text-bae-muted">(Showing first 3×3 block; remaining elements computed similarly.)</p>');
