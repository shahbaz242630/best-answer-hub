        steps.push('<p class="mb-1 mt-2">M<sub>1,' + (c+1) + '</sub> (delete row 1, col ' + (c+1) + '):</p>');
        steps.push(matrixToHTML(minor));
        steps.push('<p class="mb-1">det(M<sub>1,' + (c+1) + '</sub>) = ' + escapeHtml(fmtF(minorDet)) + '</p>');
