    for (let col = 0; col < n; col++) {
      if (pivotCols.includes(col)) continue;
      const v = new Array(n).fill(0); v[col] = 1;
      for (let i = 0; i < pivotCols.length; i++) v[pivotCols[i]] = -A[i][col];
      basis.push(v);
    }
    return basis;
  }
  function fmtVec(v) {
    // Format an eigenvector: clean integers when possible, else fractions or decimals
    if (decimalMode) return v.map(x => String(Math.round(x * 1e6) / 1e6));
    const fr = v.map(approxFrac);
    if (!fr.some(f => f === null)) {
      let L = 1; for (const f of fr) L = lcm(L, f.d);
      if (L <= 10000) {
        let iv = fr.map(f => f.n * (L / f.d));
        let g = 0; for (const x of iv) g = gcd(g, x);
        if (g > 1) iv = iv.map(x => x / g);
        const firstNZ = iv.find(x => x !== 0);
        if (firstNZ < 0) iv = iv.map(x => -x);
        return iv.map(String);
      }
    }
    const firstNZ = v.find(x => Math.abs(x) > 1e-9) || 1;
    return v.map(x => fmtRoot(x / firstNZ));
  }
  function vecHTML(strArr) {
    return '[' + strArr.map(escapeHtml).join(', ') + ']<sup>T</sup>';
  }
  function appendEigenDisplay(steps, mNum, roots) {
    const reals = roots.filter(r => r.im === 0);
    const complexes = roots.filter(r => r.im !== 0);
    steps.push('<p class="mb-1 mt-2 font-semibold">Eigenvalues &amp; eigenvectors:</p>');
    const seen = [];
    reals.forEach(r => {
      const key = fmtRoot(r.re);
      if (seen.includes(key)) return;
      seen.push(key);
      const mult = reals.filter(x => fmtRoot(x.re) === key).length;
      const basis = eigenspaceBasis(mNum, r.re);
      let line = '<p class="mb-1">λ = <strong>' + escapeHtml(key) + '</strong>' + (mult > 1 ? ' <span class="text-bae-muted">(algebraic multiplicity ' + mult + ')</span>' : '') + ' &nbsp;→&nbsp; ';
      line += basis.length ? basis.map(v => vecHTML(fmtVec(v))).join(' , ') : '<span class="text-bae-muted">no eigenvector found</span>';
      line += '</p>';
      steps.push(line);
    });
    complexes.forEach(r => {
      const lbl = fmtRoot(r.re) + ' ' + (r.im > 0 ? '+' : '−') + ' ' + fmtRoot(Math.abs(r.im)) + 'i';
      steps.push('<p class="mb-1">λ = <strong>' + escapeHtml(lbl) + '</strong> <span class="text-bae-muted">(complex: eigenvector is complex; not shown)</span></p>');
    });
    steps.push('<p class="mb-1 mt-1 text-bae-muted text-xs">Eigenvectors solve (A − λI)v = 0. Any nonzero scalar multiple is also a valid eigenvector. Values are exact where a clean fraction exists, otherwise rounded.</p>');
  }

  function solveCubicRoots(B, C, D) {
    // Real/complex roots of the monic cubic x³ + Bx² + Cx + D = 0 (Cardano + trig method)
    const p = C - B * B / 3;
    const q = (2 * B * B * B) / 27 - (B * C) / 3 + D;
    const shift = -B / 3;
    if (Math.abs(p) < 1e-12 && Math.abs(q) < 1e-12) {
      // Triple root
      return [{ re: shift, im: 0 }, { re: shift, im: 0 }, { re: shift, im: 0 }];
    }
    const disc = (q * q) / 4 + (p * p * p) / 27;
    const roots = [];
    if (disc > 1e-12) {
      // One real root, two complex conjugates
      const s = Math.sqrt(disc);
      const u = Math.cbrt(-q / 2 + s);
      const v = Math.cbrt(-q / 2 - s);
      const t1 = u + v;
      const re = -t1 / 2 + shift;
      const im = (Math.sqrt(3) / 2) * (u - v);
      roots.push({ re: t1 + shift, im: 0 }, { re, im }, { re, im: -im });
    } else {
      // Three real roots (handles repeated roots), trigonometric method
      const r = Math.sqrt(-(p * p * p) / 27);
      const phi = Math.acos(Math.max(-1, Math.min(1, -q / (2 * r))));
      const mm = 2 * Math.sqrt(-p / 3);
      for (let k = 0; k < 3; k++) roots.push({ re: mm * Math.cos((phi + 2 * Math.PI * k) / 3) + shift, im: 0 });
    }
    return roots;
  }
  function fmtRoot(x) {
    // Snap to an exact small rational when very close; otherwise show a 6-decimal value
    let bestN = Math.round(x), bestD = 1, bestErr = Math.abs(x - Math.round(x));
    for (let d = 2; d <= 100; d++) {
      const n = Math.round(x * d), err = Math.abs(x - n / d);
      if (err < bestErr) { bestErr = err; bestN = n; bestD = d; }
      if (err === 0) break;
    }
    if (bestErr < 1e-9 * Math.max(1, Math.abs(x))) return bestD === 1 ? String(bestN) : bestN + '/' + bestD;
    return String(Math.round(x * 1e6) / 1e6);
  }

  function eigenvalues3x3(m) {
    const a=m[0][0], b=m[0][1], c=m[0][2];
    const d=m[1][0], e=m[1][1], f=m[1][2];
    const g=m[2][0], h=m[2][1], i=m[2][2];
    // det(A) = a(ei-fh) - b(di-fg) + c(dh-eg)
    const detA = a.mul(e.mul(i).sub(f.mul(h))).sub(b.mul(d.mul(i).sub(f.mul(g)))).add(c.mul(d.mul(h).sub(e.mul(g))));
    const trA = a.add(e).add(i);
    // sum of principal 2×2 minors
    const s2 = a.mul(e).sub(b.mul(d)).add(a.mul(i).sub(c.mul(g))).add(e.mul(i).sub(f.mul(h)));
    // Characteristic polynomial: λ³ − tr(A)λ² + s2·λ − det(A) = 0
    const steps = [];
    steps.push('<p class="mb-1">Characteristic polynomial: det(A − λI) = 0</p>');
    steps.push('<p class="mb-1">λ³ − (' + escapeHtml(fmtF(trA)) + ')λ² + (' + escapeHtml(fmtF(s2)) + ')λ − (' + escapeHtml(fmtF(detA)) + ') = 0</p>');
    // Solve the cubic for all three roots (real and complex), exact in closed form
    let roots = solveCubicRoots(-trA.toNum(), s2.toNum(), -detA.toNum());
    const scale = Math.max(1, Math.abs(trA.toNum()));
    roots = roots.map(r => ({ re: r.re, im: Math.abs(r.im) < 1e-6 * scale ? 0 : r.im }));
    // Sort: real eigenvalues ascending first, then complex conjugate pairs
    roots.sort((x, y) => ((x.im !== 0) - (y.im !== 0)) || (x.re - y.re) || (y.im - x.im));
    const mNum = m.map(row => row.map(x => x.toNum()));
    appendEigenDisplay(steps, mNum, roots);
    return { values: roots, steps };
  }

  function solveLinearSystem(A, b) {
    const n = A.length;
    const aug = [];
    for (let i = 0; i < n; i++) aug.push([...A[i], b[i][0]]);
    const rrefRes = rrefWithSteps(aug);
    const R = rrefRes.result;
    // Check for inconsistency: [0 0 ... 0 | nonzero]
    for (let i = 0; i < n; i++) {
      let allZero = true;
      for (let j = 0; j < n; j++) if (!R[i][j].isZero()) { allZero = false; break; }
      if (allZero && !R[i][n].isZero()) {
        return { error: 'The system is inconsistent. No solution exists. Row ' + (i+1) + ' reduces to 0 = ' + escapeHtml(fmtF(R[i][n])) + '.', steps: rrefRes.steps };
      }
    }
    // Check rank
    let rank = 0;
    for (let i = 0; i < n; i++) {
      let hasPivot = false;
      for (let j = 0; j < n; j++) if (R[i][j].isOne()) { hasPivot = true; break; }
      if (hasPivot) rank++;
    }
    if (rank < n) {
      // Infinite solutions
      const freeVars = [];
      const pivotCols = [];
      for (let i = 0; i < n; i++) {
        for (let j = 0; j < n; j++) {
          if (R[i][j].isOne()) { pivotCols.push(j); break; }
        }
      }
      for (let j = 0; j < n; j++) if (!pivotCols.includes(j)) freeVars.push(j);
      const steps = [...rrefRes.steps];
      steps.push('<p class="mb-1 mt-2">The system has <strong>infinitely many solutions</strong> (rank = ' + rank + ' < ' + n + ' variables).</p>');
      steps.push('<p class="mb-1">Free variable' + (freeVars.length > 1 ? 's' : '') + ': ' + freeVars.map(v => 'x<sub>' + (v+1) + '</sub>').join(', ') + '</p>');
      // Express basic variables in terms of free variables
      for (let i = 0; i < n; i++) {
        let pivotCol = -1;
        for (let j = 0; j < n; j++) if (R[i][j].isOne()) { pivotCol = j; break; }
        if (pivotCol === -1) continue;
        const constTerm = R[i][n];
        const otherTerms = [];
        for (let j = 0; j < n; j++) {
          if (j === pivotCol || R[i][j].isZero()) continue;
          const coeff = R[i][j].neg();
          const mag = coeff.abs();
          const magStr = mag.isOne() ? '' : escapeHtml(fmtF(mag)) + '·';
          otherTerms.push({ neg: coeff.isNeg(), text: magStr + 'x<sub>' + (j+1) + '</sub>' });
        }
        let expr = (!constTerm.isZero() || otherTerms.length === 0) ? escapeHtml(fmtF(constTerm)) : '';
        otherTerms.forEach(t => {
          if (expr === '') expr = (t.neg ? '−' : '') + t.text;
          else expr += (t.neg ? ' − ' : ' + ') + t.text;
        });
        steps.push('<p class="mb-1">x<sub>' + (pivotCol+1) + '</sub> = ' + expr + '</p>');
      }
      return { infinite: true, freeVars, steps };
    }
    // Unique solution
    const x = [];
    for (let i = 0; i < n; i++) x.push([R[i][n]]);
    const steps = [...rrefRes.steps];
    steps.push('<p class="mb-1 mt-2">The system has a <strong>unique solution</strong>:</p>');
    for (let i = 0; i < n; i++) {
      steps.push('<p class="mb-1">x<sub>' + (i+1) + '</sub> = ' + escapeHtml(fmtF(x[i][0])) + '</p>');
    }
    return { result: x, steps };
  }

  function rankMatrix(m) {
    const rrefRes = rrefWithSteps(m);
    let rank = 0;
    for (let i = 0; i < rrefRes.result.length; i++) {
      let hasPivot = false;
      for (let j = 0; j < rrefRes.result[0].length; j++) {
        if (rrefRes.result[i][j].isOne()) { hasPivot = true; break; }
      }
      if (hasPivot) rank++;
    }
    return { rank, steps: rrefRes.steps };
  }


  // ========== UI helpers ==========
  function createGrid(container, rows, cols, prefix) {
    container.innerHTML = '';
    const table = document.createElement('table');
    table.className = 'text-sm';
    for (let i = 0; i < rows; i++) {
      const tr = document.createElement('tr');
      for (let j = 0; j < cols; j++) {
        const td = document.createElement('td');
        td.className = 'p-0.5';
        const input = document.createElement('input');
        input.type = 'text';
        input.className = prefix + '-cell w-14 md:w-16 px-1.5 py-1 text-sm text-center border border-bae-border rounded-bae-sm bg-white focus:outline-none focus:border-bae-primary';
        input.dataset.row = i;
        input.dataset.col = j;
        input.value = i === j ? '1' : '0';
        td.appendChild(input);
        tr.appendChild(td);
      }
      table.appendChild(tr);
    }
    container.appendChild(table);
  }
  function readGrid(container, rows, cols) {
    const cells = container.querySelectorAll('input');
    const m = [];
    for (let i = 0; i < rows; i++) {
      const row = [];
      for (let j = 0; j < cols; j++) {
        const idx = i * cols + j;
        const val = cells[idx] ? cells[idx].value : '0';
        row.push(parseCell(val));
      }
      m.push(row);
    }
    return m;
  }
  function readVector(container, n) {
    const cells = container.querySelectorAll('input');
    const v = [];
    for (let i = 0; i < n; i++) {
      v.push([parseCell(cells[i] ? cells[i].value : '0')]);
    }
    return v;
  }
  function switchTab(name) {
    document.querySelectorAll('.tab-btn').forEach(b => {
      b.classList.remove('active', 'bg-bae-primary', 'text-white');
      b.classList.add('text-bae-muted', 'hover:bg-bae-border/20');
      if (b.dataset.tab === name) {
        b.classList.add('active', 'bg-bae-primary', 'text-white');
        b.classList.remove('text-bae-muted', 'hover:bg-bae-border/20');
      }
    });
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
    const panel = document.getElementById('panel-' + name);
    if (panel) panel.classList.remove('hidden');
  }

  // ========== Tab 1: Single Matrix ==========
  function initSingleGrid() {
    const size = parseInt(document.getElementById('single-size').value, 10);
    createGrid(document.getElementById('single-grid'), size, size, 'single');
  }
  function doSingleCalc() {
    const size = parseInt(document.getElementById('single-size').value, 10);
    const op = document.getElementById('single-op').value;
    const m = readGrid(document.getElementById('single-grid'), size, size);
    const out = document.getElementById('single-output');
    const resultBox = document.getElementById('single-result');
    resultBox.classList.remove('hidden');
    let html = '';

    if (op === 'det') {
      const res = detSteps(m);
      html = '<div class="space-y-1">' + res.steps.join('') + '</div>';
    } else if (op === 'inv') {
      const res = inverseWithSteps(m);
      if (res.error) {
        html = '<p class="text-red-600">' + escapeHtml(res.error) + '</p>';
      } else {
        html = '<div class="space-y-1">' + res.steps.join('') + '</div>';
        html += '<button type="button" class="mt-3 px-3 py-1.5 border border-bae-border text-xs font-medium rounded-bae-sm hover:bg-bae-border/20 transition-colors" onclick="verifyInverse()">Verify (A × A⁻¹)</button>';
        window._lastMatrix = m;
        window._lastInverse = res.result;
      }
    } else if (op === 'rref') {
      const res = rrefWithSteps(m);
      html = '<div class="space-y-1">' + res.steps.join('') + '</div>';
    } else if (op === 'eigen') {
      if (size === 2) {
        const res = eigenvalues2x2(m);
        html = '<div class="space-y-1">' + res.steps.join('') + '</div>';
      } else if (size === 3) {
        const res = eigenvalues3x3(m);
        html = '<div class="space-y-1">' + res.steps.join('') + '</div>';
      } else {
        html = '<p class="text-bae-muted">Eigenvalues and eigenvectors are computed for 2×2 and 3×3 matrices, where exact closed-form solutions exist. For 4×4 and larger matrices, use the Determinant, Inverse, RREF, or Rank tools, which stay exact at every size.</p>';
      }
    } else if (op === 'transpose') {
      const t = transpose(m);
      html = '<p class="mb-1">Transpose of A (rows become columns):</p>' + matrixToHTML(t);
    } else if (op === 'trace') {
      const tr = trace(m);
      html = '<p class="mb-1">Trace = sum of diagonal elements = ' + escapeHtml(fmtF(tr)) + '</p>';
    } else if (op === 'rank') {
      const res = rankMatrix(m);
      html = '<div class="space-y-1">' + res.steps.join('') + '</div>';
      html += '<p class="mt-2">Rank = <strong>' + res.rank + '</strong> (number of nonzero rows in RREF)</p>';
    }

    out.innerHTML = html;
    out.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
  window.verifyInverse = function() {
    if (!window._lastMatrix || !window._lastInverse) return;
    const prod = multiply(window._lastMatrix, window._lastInverse);
    const out = document.getElementById('single-output');
    out.innerHTML += '<div class="mt-3"><p class="mb-1">A × A<sup>−1</sup> =</p>' + matrixToHTML(prod) + '<p class="mt-1 text-bae-muted">Because the calculator uses exact rational arithmetic, this equals the identity matrix exactly: ones on the diagonal, zeros elsewhere.</p></div>';
  };

  // ========== Tab 2: Multiply ==========
  function initMulGrids() {
    const ar = parseInt(document.getElementById('mul-a-rows').value, 10);
    const ac = parseInt(document.getElementById('mul-a-cols').value, 10);
    const br = parseInt(document.getElementById('mul-b-rows').value, 10);
    const bc = parseInt(document.getElementById('mul-b-cols').value, 10);
    createGrid(document.getElementById('mul-grid-a'), ar, ac, 'mula');
    createGrid(document.getElementById('mul-grid-b'), br, bc, 'mulb');
    const err = document.getElementById('mul-dim-error');
    if (ac !== br) {
      err.classList.remove('hidden');
    } else {
      err.classList.add('hidden');
    }
  }
  function doMulCalc() {
    const ar = parseInt(document.getElementById('mul-a-rows').value, 10);
    const ac = parseInt(document.getElementById('mul-a-cols').value, 10);
    const br = parseInt(document.getElementById('mul-b-rows').value, 10);
    const bc = parseInt(document.getElementById('mul-b-cols').value, 10);
    if (ac !== br) {
      document.getElementById('mul-dim-error').classList.remove('hidden');
      return;
    }
    const A = readGrid(document.getElementById('mul-grid-a'), ar, ac);
    const B = readGrid(document.getElementById('mul-grid-b'), br, bc);
    const res = multiplyVisual(A, B);
    document.getElementById('mul-result').classList.remove('hidden');
    document.getElementById('mul-output').innerHTML = '<div class="space-y-1">' + res.steps.join('') + '</div>';
    document.getElementById('mul-output').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ========== Tab 3: Linear System ==========
  function initLinGrids() {
    const n = parseInt(document.getElementById('lin-size').value, 10);
    createGrid(document.getElementById('lin-grid-a'), n, n, 'lina');
    // Vector b: n rows, 1 column
    const container = document.getElementById('lin-grid-b');
    container.innerHTML = '';
    const table = document.createElement('table');
    table.className = 'text-sm';
    for (let i = 0; i < n; i++) {
      const tr = document.createElement('tr');
      const td = document.createElement('td');
      td.className = 'p-0.5';
      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'linb-cell w-14 md:w-16 px-1.5 py-1 text-sm text-center border border-bae-border rounded-bae-sm bg-white focus:outline-none focus:border-bae-primary';
      input.value = '0';
      td.appendChild(input);
      tr.appendChild(td);
      table.appendChild(tr);
    }
    container.appendChild(table);
  }
  function doLinCalc() {
    const n = parseInt(document.getElementById('lin-size').value, 10);
    const A = readGrid(document.getElementById('lin-grid-a'), n, n);
    const b = readVector(document.getElementById('lin-grid-b'), n);
    const res = solveLinearSystem(A, b);
    document.getElementById('lin-result').classList.remove('hidden');
    let html = '';
    if (res.error) {
      html = '<p class="text-red-600">' + res.error + '</p>';
    } else if (res.infinite) {
      html = '<div class="space-y-1">' + res.steps.join('') + '</div>';
    } else {
      html = '<div class="space-y-1">' + res.steps.join('') + '</div>';
    }
    document.getElementById('lin-output').innerHTML = html;
    document.getElementById('lin-output').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ========== Paste handler ==========
  function handlePaste() {
    const text = prompt('Paste your matrix (supports [[1,2],[3,4]], MATLAB [1 2; 3 4], or space-separated rows):');
    if (!text) return;
    const parsed = parsePaste(text);
    if (!parsed.length || !parsed[0].length) {
      alert('Could not parse matrix. Please check the format.');
      return;
    }
    const rows = parsed.length;
    const cols = parsed[0].length;
    if (rows !== cols) {
      alert('Pasted matrix is ' + rows + '×' + cols + '. For Single Matrix operations, only square matrices are supported. Please use the Multiply or Linear System tabs for non-square matrices.');
      return;
    }
    if (rows < 2 || rows > 6) {
      alert('Matrix size must be between 2×2 and 6×6.');
      return;
    }
    document.getElementById('single-size').value = String(rows);
    initSingleGrid();
    const cells = document.getElementById('single-grid').querySelectorAll('input');
    for (let i = 0; i < rows; i++) {
      for (let j = 0; j < cols; j++) {
        const idx = i * cols + j;
        if (cells[idx] && parsed[i][j]) {
          cells[idx].value = parsed[i][j].toStr();
        }
      }
    }
  }

  // ========== PDF Export ==========
  function exportPDF() {
    if (typeof html2pdf === 'undefined') {
      alert('PDF library not loaded. Please try again in a moment.');
      return;
    }
    const clone = document.querySelector('.bg-bae-card.border.rounded-bae').cloneNode(true);
    // Remove inputs, replace with text
    clone.querySelectorAll('input, select, button').forEach(el => {
      const span = document.createElement('span');
      span.textContent = el.value || el.textContent || '';
      span.className = 'text-sm';
      el.parentNode.replaceChild(span, el);
    });
    const wrap = document.createElement('div');
    wrap.innerHTML = '<h1 style="font-size:18px;margin-bottom:12px;">Best Answer Hub · Matrix Calculator Results</h1>';
    wrap.appendChild(clone);
    wrap.style.padding = '20px';
    wrap.style.background = '#fff';
    document.body.appendChild(wrap);
    html2pdf().set({ margin: 10, filename: 'matrix-calculator-results.pdf', image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2 }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' } }).from(wrap).save().then(() => {
      document.body.removeChild(wrap);
    });
  }

  // ========== Init ==========
  document.addEventListener('DOMContentLoaded', function() {
    // Tabs
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => switchTab(btn.dataset.tab));
    });
    // Style active tab
    const activeBtn = document.querySelector('.tab-btn.active');
    if (activeBtn) {
      activeBtn.classList.add('bg-bae-primary', 'text-white');
      activeBtn.classList.remove('text-bae-muted', 'hover:bg-bae-border/20');
    }
    document.querySelectorAll('.tab-btn:not(.active)').forEach(btn => {
      btn.classList.add('text-bae-muted', 'hover:bg-bae-border/20');
    });

    // Single matrix
    initSingleGrid();
    document.getElementById('single-size').addEventListener('change', initSingleGrid);
    document.getElementById('single-calc').addEventListener('click', doSingleCalc);
    document.getElementById('single-clear').addEventListener('click', () => { initSingleGrid(); document.getElementById('single-result').classList.add('hidden'); });
    document.getElementById('single-paste').addEventListener('click', handlePaste);

    // Multiply
    initMulGrids();
    ['mul-a-rows','mul-a-cols','mul-b-rows','mul-b-cols'].forEach(id => {
      document.getElementById(id).addEventListener('change', initMulGrids);
    });
    document.getElementById('mul-calc').addEventListener('click', doMulCalc);
    document.getElementById('mul-clear').addEventListener('click', () => { initMulGrids(); document.getElementById('mul-result').classList.add('hidden'); });

    // Linear
    initLinGrids();
    document.getElementById('lin-size').addEventListener('change', initLinGrids);
    document.getElementById('lin-calc').addEventListener('click', doLinCalc);
    document.getElementById('lin-clear').addEventListener('click', () => { initLinGrids(); document.getElementById('lin-result').classList.add('hidden'); });

    // Decimal-approximation toggle: re-render whichever result is currently shown
    document.getElementById('decimal-toggle').addEventListener('change', function() {
      decimalMode = this.checked;
      const vis = (panelId, resultId) =>
        !document.getElementById(panelId).classList.contains('hidden') &&
        !document.getElementById(resultId).classList.contains('hidden');
      if (vis('panel-single', 'single-result')) doSingleCalc();
      if (vis('panel-multiply', 'mul-result')) doMulCalc();
      if (vis('panel-linear', 'lin-result')) doLinCalc();
    });
  });
</script>

<style>
  .tab-btn.active { background-color: #6366f1; color: #fff; }
</style>
