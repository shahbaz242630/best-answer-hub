        steps.push('<p class="mb-1">R<sub>' + (pivotRow+1) + '</sub> → R<sub>' + (pivotRow+1) + '</sub> ÷ ' + escapeHtml(pivVal.toStr()) + '</p>');
        steps.push(matrixToHTML(M));
      }
      // Eliminate other rows
      for (let r = 0; r < rows; r++) {
        if (r === pivotRow) continue;
