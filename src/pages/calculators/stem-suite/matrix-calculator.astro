  // ========== Core operations ==========
  function det(m) {
    const n = m.length;
    if (n === 0) return new Frac(1);
    if (n === 1) return m[0][0];
    if (n === 2) return m[0][0].mul(m[1][1]).sub(m[0][1].mul(m[1][0]));
