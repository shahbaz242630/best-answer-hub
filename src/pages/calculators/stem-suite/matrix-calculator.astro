  function eigenspaceBasis(Anum, lambda) {
    // Basis of the null space of (A − λI) via numeric Gauss-Jordan; one vector per free column
    const n = Anum.length;
    const A = Anum.map((rowArr, i) => rowArr.map((x, j) => x - (i === j ? lambda : 0)));
    const pivotCols = []; let row = 0;
    for (let col = 0; col < n && row < n; col++) {
      let mx = row;
      for (let r = row + 1; r < n; r++) if (Math.abs(A[r][col]) > Math.abs(A[mx][col])) mx = r;
