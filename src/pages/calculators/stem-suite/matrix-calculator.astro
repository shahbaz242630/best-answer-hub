    }
    // Try MATLAB [1 2 3; 4 5 6]
    const matlab = text.match(/^\s*\[?\s*([\d\s\.,;\/\-\+]+)\s*\]?\s*$/);
    if (matlab) {
      const rows = matlab[1].split(/;|\n/).map(r => r.trim()).filter(Boolean);
      return rows.map(r => r.split(/[\s,]+/).filter(Boolean).map(v => parseCell(v)));
    }
    // Default: lines = rows, whitespace/comma = separators
    const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
    return lines.map(l => l.split(/[\s,]+/).filter(Boolean).map(v => parseCell(v)));
  }
  function matrixToHTML(m, opts) {
    opts = opts || {};
    const pad = opts.pad !== false;
    let html = '<div class="inline-block border border-bae-border rounded-bae-sm overflow-hidden my-2"><table class="text-sm">';
    for (let i = 0; i < m.length; i++) {
      html += '<tr>';
      for (let j = 0; j < m[i].length; j++) {
        html += '<td class="px-2 py-1 text-center border-bae-border ' + (j < m[i].length - 1 ? 'border-r ' : '') + (i < m.length - 1 ? 'border-b ' : '') + 'min-w-[3rem]">' + escapeHtml(fmtF(m[i][j])) + '</td>';
      }
      html += '</tr>';
    }
    html += '</table></div>';
    return html;
  }
  function escapeHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
