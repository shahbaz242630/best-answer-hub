    const res = det(m);
    steps.push('<p class="mb-1">Using Laplace expansion (cofactor method):</p>');
    steps.push('<p class="mb-1">det(A) = <strong>' + escapeHtml(fmtF(res)) + '</strong></p>');
    return { value: res, steps };
