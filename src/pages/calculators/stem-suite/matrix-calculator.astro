    steps.push('<p class="mb-1">Characteristic equation: λ² − tr(A)λ + det(A) = 0</p>');
    steps.push('<p class="mb-1">tr(A) = ' + escapeHtml(fmtF(a)) + ' + ' + escapeHtml(fmtF(d)) + ' = ' + escapeHtml(fmtF(tr)) + '</p>');
    steps.push('<p class="mb-1">det(A) = ' + escapeHtml(fmtF(dval)) + '</p>');
    steps.push('<p class="mb-1">λ² − (' + escapeHtml(fmtF(tr)) + ')λ + ' + escapeHtml(fmtF(dval)) + ' = 0</p>');
    const discNum = discriminant.toNum();
    const mNum = m.map(row => row.map(x => x.toNum()));
    let roots;
    if (discNum < 0) {
      const re = tr.toNum() / 2, im = Math.sqrt(-discNum) / 2;
      steps.push('<p class="mb-1">Discriminant = ' + escapeHtml(fmtF(discriminant)) + ' &lt; 0 → complex conjugate eigenvalues.</p>');
      steps.push('<p class="mb-1">λ = (' + escapeHtml(fmtF(tr)) + ' ± i√' + escapeHtml(fmtF(discriminant.neg())) + ') / 2</p>');
