  <HowToSchema steps={[
    { name: 'Choose your mode', text: 'Switch between resistor color code decoder, Ohm\'s Law calculator, and LED resistor calculator. Each mode handles a specific electronics task.' },
    { name: 'Enter your values', text: 'Click color bands, type SMD codes, or enter voltage and current. Use GPIO presets for Arduino and Raspberry Pi to skip manual setup.' },
