  <script slot="scripts" src="/html2pdf.bundle.min.js"></script>

  <script is:inline>
    (function() {
      const $ = (id) => document.getElementById(id);

      // ===== Color Data =====
      const COLORS = [
        { name: 'Black',  val: 0,  mult: 0,     tol: null, tcr: null, hex: '#1a1a1a' },
        { name: 'Brown',  val: 1,  mult: 1,     tol: 1,    tcr: 100,  hex: '#8B4513' },
        { name: 'Red',    val: 2,  mult: 2,     tol: 2,    tcr: 50,   hex: '#DC143C' },
        { name: 'Orange', val: 3,  mult: 3,     tol: null, tcr: 15,   hex: '#FF8C00' },
        { name: 'Yellow', val: 4,  mult: 4,     tol: null, tcr: 25,   hex: '#FFD700' },
        { name: 'Green',  val: 5,  mult: 5,     tol: 0.5,  tcr: null, hex: '#228B22' },
        { name: 'Blue',   val: 6,  mult: 6,     tol: 0.25, tcr: 10,   hex: '#4169E1' },
        { name: 'Violet', val: 7,  mult: 7,     tol: 0.1,  tcr: 5,    hex: '#8A2BE2' },
        { name: 'Gray',   val: 8,  mult: 8,     tol: 0.05, tcr: null, hex: '#808080' },
        { name: 'White',  val: 9,  mult: 9,     tol: null, tcr: 1,    hex: '#F5F5F5' },
        { name: 'Gold',   val: null,mult: -1,    tol: 5,    tcr: null, hex: '#FFD700' },
        { name: 'Silver', val: null,mult: -2,    tol: 10,   tcr: null, hex: '#C0C0C0' },
      ];

      const E12 = [1.0,1.2,1.5,1.8,2.2,2.7,3.3,3.9,4.7,5.6,6.8,8.2];
      const E24 = [1.0,1.1,1.2,1.3,1.5,1.6,1.8,2.0,2.2,2.4,2.7,3.0,3.3,3.6,3.9,4.3,4.7,5.1,5.6,6.2,6.8,7.5,8.2,9.1];

      // EIA-96 SMD codes: 2-digit value code (01–96) maps to a 3-significant-figure base value,
      // followed by a letter multiplier. R/S are omitted to avoid clashing with 4R7 decimal notation.
      const EIA96 = [100,102,105,107,110,113,115,118,121,124,127,130,133,137,140,143,147,150,154,158,162,165,169,174,178,182,187,191,196,200,205,210,215,221,226,232,237,243,249,255,261,267,274,280,287,294,301,309,316,324,332,340,348,357,365,374,383,392,402,412,422,432,442,453,464,475,487,499,511,523,536,549,562,576,590,604,619,634,649,665,681,698,715,732,750,768,787,806,825,845,866,887,909,931,953,976];
      const EIA96_MULT = { Z:0.001, Y:0.01, X:0.1, A:1, B:10, C:100, D:1000, E:10000, F:100000 };

      const LED_PRESETS = {
        arduino5v:  { v: 5.0, i: 20, iUnit: 0.001, note: 'Arduino 5V pin (max 40mA)' },
        arduino3v3: { v: 3.3, i: 20, iUnit: 0.001, note: 'Arduino 3.3V pin (max 40mA)' },
        pi3v3:      { v: 3.3, i: 16, iUnit: 0.001, note: 'Raspberry Pi GPIO (max 16mA)' },
        pi5v:       { v: 5.0, i: 16, iUnit: 0.001, note: 'Raspberry Pi 5V rail' },
      };

      // ===== Tab Switching =====
      let activeTab = 'color';
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          activeTab = btn.dataset.tab;
          document.querySelectorAll('.tab-btn').forEach(b => {
            b.classList.remove('active', 'bg-bae-primary', 'text-white', 'border-bae-primary');
            b.classList.add('bg-white', 'text-bae-ink', 'border-bae-border');
          });
          btn.classList.add('active', 'bg-bae-primary', 'text-white', 'border-bae-primary');
          btn.classList.remove('bg-white', 'text-bae-ink', 'border-bae-border');
          document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
          $('panel-' + activeTab).classList.remove('hidden');
          updateResults();
        });
      });

      // ===== Color Code Calculator =====
      let bandCount = 4;
      let selectedBands = [1, 0, 2, 10, 1, 1]; // default: brown-black-red-gold
      let colorblind = false;

      function buildColorPickers() {
        const container = $('color-pickers');
        container.innerHTML = '';

        // Labels and types depend on band count
        let labels, bandTypes;
        if (bandCount === 4) {
          labels = ['1st Digit','2nd Digit','Multiplier','Tolerance'];
          bandTypes = ['digit','digit','mult','tol'];
        } else if (bandCount === 5) {
          labels = ['1st Digit','2nd Digit','3rd Digit','Multiplier','Tolerance'];
          bandTypes = ['digit','digit','digit','mult','tol'];
        } else {
          labels = ['1st Digit','2nd Digit','3rd Digit','Multiplier','Tolerance','Temp Coef'];
          bandTypes = ['digit','digit','digit','mult','tol','tcr'];
        }

        for (let i = 0; i < bandCount; i++) {
          const wrap = document.createElement('div');
          wrap.className = 'color-picker-wrap';
          wrap.dataset.band = i;

          const label = document.createElement('label');
          label.className = 'text-xs font-semibold text-bae-muted block mb-1.5';
          label.textContent = labels[i];
          wrap.appendChild(label);

          const sel = document.createElement('select');
          sel.className = 'w-full text-sm border border-bae-border rounded-bae-sm px-2 py-2 bg-white focus:outline-none focus:border-bae-primary';
          sel.dataset.band = i;

          COLORS.forEach((c, idx) => {
            let usable = false;
            if (bandTypes[i] === 'digit' && c.val !== null) usable = true;
            if (bandTypes[i] === 'mult' && c.mult !== null) usable = true;
            if (bandTypes[i] === 'tol' && c.tol !== null) usable = true;
            if (bandTypes[i] === 'tcr' && c.tcr !== null) usable = true;
            if (!usable) return;

            const opt = document.createElement('option');
            opt.value = idx;
            if (selectedBands[i] === idx) opt.selected = true;

            if (colorblind) {
              opt.textContent = c.name + ' (' + (c.val !== null ? c.val : (c.mult !== null ? '×10^' + c.mult : (c.tol !== null ? '±' + c.tol + '%' : c.tcr + ' ppm'))) + ')';
            } else {
              opt.textContent = c.name;
              opt.style.backgroundColor = c.hex;
              opt.style.color = (c.name === 'White' || c.name === 'Yellow') ? '#1a1a1a' : '#fff';
            }
            sel.appendChild(opt);
          });

          sel.addEventListener('change', () => {
            selectedBands[i] = parseInt(sel.value);
            updateResistorVisual();
            updateResults();
          });
          wrap.appendChild(sel);
          container.appendChild(wrap);
        }
      }

      function updateResistorVisual() {
        const bands = document.querySelectorAll('.resistor-band');
        bands.forEach((b, i) => {
          if (i < bandCount) {
            b.classList.remove('hidden');
            b.style.backgroundColor = COLORS[selectedBands[i]].hex;
          } else {
            b.classList.add('hidden');
          }
        });
        // Show/hide gaps
        const gap4 = document.querySelector('[data-band="4-gap"]');
        if (gap4) gap4.classList.toggle('hidden', bandCount < 5);
        // Update labels with correct mapping
        document.querySelectorAll('#band-labels > span').forEach((s, i) => {
          let show = false;
          if (bandCount === 4) show = (i === 0 || i === 1 || i === 3 || i === 4);
          else if (bandCount === 5) show = (i === 0 || i === 1 || i === 2 || i === 3 || i === 4);
          else show = (i >= 0 && i <= 5);
          s.classList.toggle('hidden', !show);
        });
      }

      document.querySelectorAll('.band-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          bandCount = parseInt(btn.dataset.bands);
          document.querySelectorAll('.band-btn').forEach(b => {
            b.classList.remove('active', 'bg-bae-primary', 'text-white', 'border-bae-primary');
            b.classList.add('bg-white', 'text-bae-ink', 'border-bae-border');
          });
          btn.classList.add('active', 'bg-bae-primary', 'text-white', 'border-bae-primary');
          btn.classList.remove('bg-white', 'text-bae-ink', 'border-bae-border');
          buildColorPickers();
          updateResistorVisual();
          updateResults();
        });
      });

      $('colorblind-mode').addEventListener('change', () => {
        colorblind = $('colorblind-mode').checked;
        buildColorPickers();
      });

      function formatResistance(ohms) {
        if (ohms >= 1000000) return (ohms / 1000000).toFixed(ohms >= 10000000 ? 1 : 2) + ' MΩ';
        if (ohms >= 1000) return (ohms / 1000).toFixed(ohms >= 10000 ? 1 : 2) + ' kΩ';
        if (ohms >= 1) return ohms.toFixed(ohms >= 100 ? 1 : 2) + ' Ω';
        return ohms.toFixed(2) + ' Ω';
      }

      function findNearestStandard(ohms, series) {
        const vals = series === 'E24' ? E24 : E12;
        if (!(ohms > 0)) return { nearest: 0, higher: 0 };
        const exp = Math.pow(10, Math.floor(Math.log10(ohms)));
        // Build all standard values across the surrounding decades
        const candidates = [];
        for (const mult of [exp / 10, exp, exp * 10]) {
          for (const v of vals) candidates.push(v * mult);
        }
        let nearest = candidates[0];
        let minDiff = Math.abs(ohms - nearest);
        let higher = Infinity; // smallest standard value >= ohms (round UP — safe for LEDs)
        for (const c of candidates) {
          const diff = Math.abs(ohms - c);
          if (diff < minDiff) { minDiff = diff; nearest = c; }
          if (c >= ohms - 1e-9 && c < higher) higher = c;
        }
        if (!isFinite(higher)) higher = nearest;
        return { nearest, higher };
      }

      function calcColorCode() {
        const c0 = COLORS[selectedBands[0]];
        const c1 = COLORS[selectedBands[1]];
        const c2 = bandCount >= 5 ? COLORS[selectedBands[2]] : null;
        const multIdx = bandCount >= 5 ? 3 : 2;
        const tolIdx = bandCount >= 5 ? 4 : 3;
        const tcrIdx = 5;
        const cm = COLORS[selectedBands[multIdx]];
        const ct = COLORS[selectedBands[tolIdx]];

        let val;
        if (bandCount >= 5) {
          val = (c0.val * 100 + c1.val * 10 + c2.val) * Math.pow(10, cm.mult);
        } else {
          val = (c0.val * 10 + c1.val) * Math.pow(10, cm.mult);
        }

        const tolPct = ct.tol;
        const minVal = val * (1 - tolPct / 100);
        const maxVal = val * (1 + tolPct / 100);

        let html = '<div class="space-y-3">';
        html += '<div class="text-3xl font-bold font-serif">' + formatResistance(val) + '</div>';
        html += '<div class="text-sm text-white/70">Tolerance: ±' + tolPct + '% (' + ct.name + ')</div>';
        html += '<div class="text-xs text-white/50">Range: ' + formatResistance(minVal) + ' – ' + formatResistance(maxVal) + '</div>';

        if (bandCount === 6) {
          const ctcr = COLORS[selectedBands[tcrIdx]];
          html += '<div class="text-xs text-white/50 mt-1">Temp Coefficient: ' + ctcr.tcr + ' ppm/°C (' + ctcr.name + ')</div>';
        }

        // Standard values
        const std = findNearestStandard(val, 'E24');
        html += '<div class="border-t border-white/10 pt-3 mt-2">';
        html += '<div class="text-xs text-white/50 mb-1">Nearest standard values</div>';
        html += '<div class="flex justify-between"><span class="text-sm text-white/70">Nearest E24 value</span><span class="text-sm font-semibold">' + formatResistance(std.nearest) + '</span></div>';
        html += '</div>';
        html += '</div>';
        return html;
      }

      // ===== Reverse Lookup =====
      $('reverse-btn').addEventListener('click', () => {
        const rawVal = parseFloat($('reverse-value').value);
        const unit = parseFloat($('reverse-unit').value);
        const tol = parseFloat($('reverse-tolerance').value);
        if (!rawVal || rawVal <= 0) return;
        const ohms = rawVal * unit;

        // Convert to scientific notation with 2 significant digits
        let exp = Math.floor(Math.log10(ohms));
        let mantissa = ohms / Math.pow(10, exp);
        let sigStr = mantissa.toFixed(1);
        if (sigStr === '10.0') {
          sigStr = '1.0';
          exp += 1;
        }
        const d1Val = parseInt(sigStr[0]);
        const d2Val = parseInt(sigStr[2]);
        const multVal = exp - 1;

        function findColorByVal(target) {
          let bestIdx = -1, bestDiff = Infinity;
          COLORS.forEach((c, i) => { if (c.val !== null) { const diff = Math.abs(c.val - target); if (diff < bestDiff) { bestDiff = diff; bestIdx = i; } } });
          return bestIdx;
        }
        function findColorByMult(target) {
          let bestIdx = -1, bestDiff = Infinity;
          COLORS.forEach((c, i) => { if (c.mult !== null) { const diff = Math.abs(c.mult - target); if (diff < bestDiff) { bestDiff = diff; bestIdx = i; } } });
          return bestIdx;
        }

        const d1 = findColorByVal(d1Val);
        const d2 = findColorByVal(d2Val);
        const m = findColorByMult(multVal);
        const t = COLORS.findIndex(c => c.tol === tol);

        const r = $('reverse-result');
        r.classList.remove('hidden');
        let html = '<div class="bg-bae-bg border border-bae-border rounded-bae p-4">';
        html += '<div class="text-sm font-semibold text-bae-ink mb-2">Color bands for ' + formatResistance(ohms) + ' ±' + tol + '%</div>';
        html += '<div class="flex items-center gap-1">';
        html += '<div class="w-4 h-8 rounded-sm" style="background:' + COLORS[d1 >= 0 ? d1 : 0].hex + '"></div>';
        html += '<div class="w-4 h-8 rounded-sm" style="background:' + COLORS[d2 >= 0 ? d2 : 0].hex + '"></div>';
        html += '<div class="w-4 h-8 rounded-sm" style="background:' + COLORS[m >= 0 ? m : 0].hex + '"></div>';
        if (t >= 0) html += '<div class="w-4 h-8 rounded-sm" style="background:' + COLORS[t].hex + '"></div>';
        html += '</div>';
        html += '<div class="text-xs text-bae-muted mt-2">' + COLORS[d1 >= 0 ? d1 : 0].name + ' – ' + COLORS[d2 >= 0 ? d2 : 0].name + ' – ' + COLORS[m >= 0 ? m : 0].name;
        if (t >= 0) html += ' – ' + COLORS[t].name;
        html += '</div></div>';
        r.innerHTML = html;
        updateResults();
      });

      // ===== SMD Decoder =====
      $('smd-btn').addEventListener('click', () => {
        const code = $('smd-code').value.trim().toUpperCase();
        if (!code) return;
        const r = $('smd-result');
        r.classList.remove('hidden');
        let val, type;

        if (/^\d*R\d*$/.test(code)) {
          // Decimal format: 4R7 = 4.7, 10R = 10, R47 = 0.47
          val = parseFloat(code.replace('R', '.'));
          type = 'Decimal (R = decimal point)';
        } else if (/^\d{2}[A-FXYZ]$/.test(code)) {
          // EIA-96 format: 2-digit value code + letter multiplier
          const codeNum = parseInt(code.slice(0, 2), 10);
          const letter = code[2];
          if (codeNum < 1 || codeNum > 96 || !(letter in EIA96_MULT)) {
            r.innerHTML = '<div class="text-sm text-red-600">Unrecognized EIA-96 code. The value code must be 01–96 and the letter a valid multiplier (Z, Y, X, A–F).</div>';
            return;
          }
          val = EIA96[codeNum - 1] * EIA96_MULT[letter];
          type = 'EIA-96 code (' + code.slice(0, 2) + ' = ' + EIA96[codeNum - 1] + ', ' + letter + ' = ×' + EIA96_MULT[letter] + ')';
        } else if (/^\d{3}$/.test(code)) {
          const a = parseInt(code[0] + code[1]);
          const b = parseInt(code[2]);
          val = a * Math.pow(10, b);
          type = '3-digit code';
        } else if (/^\d{4}$/.test(code)) {
          const a = parseInt(code[0] + code[1] + code[2]);
          const b = parseInt(code[3]);
          val = a * Math.pow(10, b);
          type = '4-digit code';
        } else if (code === '0') {
          val = 0;
          type = 'Zero-ohm jumper';
        } else {
          r.innerHTML = '<div class="text-sm text-red-600">Unrecognized SMD code format. Try formats like 103, 4R7, 1002, 01C, or 000.</div>';
          return;
        }

        // Any code that resolves to 0 ohms is a zero-ohm jumper (e.g. 000, 0R0).
        if (val === 0) type = 'Zero-ohm jumper';

        let html = '<div class="bg-bae-bg border border-bae-border rounded-bae p-4">';
        html += '<div class="text-sm font-semibold text-bae-ink mb-1">' + formatResistance(val) + '</div>';
        html += '<div class="text-xs text-bae-muted">Type: ' + type + '</div>';
        html += '</div>';
        r.innerHTML = html;
        updateResults();
      });

      // ===== Ohm's Law =====
      $('ohms-solve').addEventListener('click', () => {
        const v = parseFloat($('ohms-v').value);
        const iRaw = parseFloat($('ohms-i').value);
        const iUnit = parseFloat($('ohms-i-unit').value);
        const i = iRaw * iUnit;
        const rRaw = parseFloat($('ohms-r').value);
        const rUnit = parseFloat($('ohms-r-unit').value);
        const r = rRaw * rUnit;

        const res = $('ohms-result');
        res.classList.remove('hidden');

        let html = '<div class="bg-bae-bg border border-bae-border rounded-bae p-4 space-y-2">';
        let known = 0;
        if (!isNaN(v) && v > 0) known++;
        if (!isNaN(i) && i > 0) known++;
        if (!isNaN(r) && r > 0) known++;

        if (known < 2) {
          html += '<div class="text-sm text-bae-ink">Enter at least 2 values to solve for the third.</div>';
        } else {
          let sv, si, sr, p;
          if (isNaN(v)) { sv = i * r; si = i; sr = r; }
          else if (isNaN(i)) { sv = v; si = v / r; sr = r; }
          else { sv = v; si = i; sr = v / i; }
          p = sv * si;

          html += '<div class="flex justify-between"><span class="text-sm text-bae-muted">Voltage</span><span class="text-sm font-semibold">' + sv.toFixed(3) + ' V</span></div>';
          html += '<div class="flex justify-between"><span class="text-sm text-bae-muted">Current</span><span class="text-sm font-semibold">' + (si >= 1 ? si.toFixed(3) + ' A' : (si * 1000).toFixed(2) + ' mA') + '</span></div>';
          html += '<div class="flex justify-between"><span class="text-sm text-bae-muted">Resistance</span><span class="text-sm font-semibold">' + formatResistance(sr) + '</span></div>';
          html += '<div class="border-t border-bae-border pt-2 flex justify-between"><span class="text-sm text-bae-muted">Power</span><span class="text-sm font-semibold text-bae-primary">' + (p >= 1 ? p.toFixed(3) + ' W' : (p * 1000).toFixed(2) + ' mW') + '</span></div>';

          // Wattage recommendation
          let rec = '1/8 W (0.125W)';
          if (p > 0.125) rec = '1/4 W (0.25W)';
          if (p > 0.25) rec = '1/2 W (0.5W)';
          if (p > 0.5) rec = '1 W';
          if (p > 1) rec = '2 W';
          if (p > 2) rec = '5 W+';
          html += '<div class="text-xs text-bae-muted mt-1">Recommended resistor wattage: <span class="font-semibold text-bae-ink">' + rec + '</span></div>';
          // Update right panel if on ohms tab
          if (activeTab === 'ohms') {
            let panelHtml = '<div class="space-y-2">';
            panelHtml += '<div class="flex justify-between"><span class="text-sm text-white/70">Voltage</span><span class="text-sm font-semibold">' + sv.toFixed(3) + ' V</span></div>';
            panelHtml += '<div class="flex justify-between"><span class="text-sm text-white/70">Current</span><span class="text-sm font-semibold">' + (si >= 1 ? si.toFixed(3) + ' A' : (si * 1000).toFixed(2) + ' mA') + '</span></div>';
            panelHtml += '<div class="flex justify-between"><span class="text-sm text-white/70">Resistance</span><span class="text-sm font-semibold">' + formatResistance(sr) + '</span></div>';
            panelHtml += '<div class="border-t border-white/10 pt-2 flex justify-between"><span class="text-sm text-white/70">Power</span><span class="text-sm font-semibold text-bae-primary">' + (p >= 1 ? p.toFixed(3) + ' W' : (p * 1000).toFixed(2) + ' mW') + '</span></div>';
            panelHtml += '</div>';
            $('result-content').innerHTML = panelHtml;
          }
        }
        html += '</div>';
        res.innerHTML = html;
        updateResults();
      });

      $('ohms-clear').addEventListener('click', () => {
        $('ohms-v').value = '';
        $('ohms-i').value = '';
        $('ohms-r').value = '';
        $('ohms-result').classList.add('hidden');
        updateResults();
      });

      // ===== LED Calculator =====
      document.querySelectorAll('.preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const p = LED_PRESETS[btn.dataset.preset];
          if (!p) return;
          $('led-vsupply').value = p.v;
          $('led-current').value = p.i;
          $('led-current-unit').value = p.iUnit;
          document.querySelectorAll('.preset-btn').forEach(b => {
            b.classList.remove('bg-bae-primary', 'text-white', 'border-bae-primary');
            b.classList.add('bg-white', 'text-bae-ink', 'border-bae-border');
          });
          btn.classList.add('bg-bae-primary', 'text-white', 'border-bae-primary');
          btn.classList.remove('bg-white', 'text-bae-ink', 'border-bae-border');
          // Clear old results so user must recalculate
          $('led-result').classList.add('hidden');
          $('led-result').innerHTML = '';
          if (activeTab === 'led') {
            $('result-content').innerHTML = '<p class="text-sm text-white/70">Click Calculate LED Resistor to see results.</p>';
          }
        });
      });

      $('led-type').addEventListener('change', () => {
        const v = $('led-type').value;
        if (v !== 'custom') $('led-vf').value = v;
      });

      $('led-calc').addEventListener('click', () => {
        const vSupply = parseFloat($('led-vsupply').value);
        const vF = parseFloat($('led-vf').value);
        const iRaw = parseFloat($('led-current').value);
        const iUnit = parseFloat($('led-current-unit').value);
        const i = iRaw * iUnit;

        const res = $('led-result');
        res.classList.remove('hidden');

        if (!vSupply || !vF || !i || vSupply <= vF) {
          res.innerHTML = '<div class="bg-red-50 border border-red-200 rounded-bae p-4 text-sm text-red-700">Supply voltage must be greater than LED forward voltage. Check your inputs.</div>';
          updateResults();
          return;
        }

        const vRes = vSupply - vF;
        const rExact = vRes / i;
        const pDiss = vRes * i;
        const std = findNearestStandard(rExact, 'E12');
        const iAtStd = vRes / std.higher;

        let html = '<div class="bg-bae-bg border border-bae-border rounded-bae p-4 space-y-3">';
        html += '<div class="grid grid-cols-2 gap-3">';
        html += '<div><div class="text-xs text-bae-muted">Exact resistor</div><div class="text-lg font-bold text-bae-ink">' + formatResistance(rExact) + '</div></div>';
        html += '<div><div class="text-xs text-bae-muted">Use this standard value</div><div class="text-lg font-bold text-bae-primary">' + formatResistance(std.higher) + '</div></div>';
        html += '</div>';
        html += '<div class="border-t border-bae-border pt-2 space-y-1">';
        html += '<div class="flex justify-between text-sm"><span class="text-bae-muted">Voltage across resistor</span><span class="font-semibold">' + vRes.toFixed(2) + ' V</span></div>';
        html += '<div class="flex justify-between text-sm"><span class="text-bae-muted">Current at standard value</span><span class="font-semibold">' + (iAtStd * 1000).toFixed(1) + ' mA</span></div>';
        html += '<div class="flex justify-between text-sm"><span class="text-bae-muted">Power dissipated</span><span class="font-semibold">' + (pDiss >= 1 ? pDiss.toFixed(3) + ' W' : (pDiss * 1000).toFixed(1) + ' mW') + '</span></div>';
        html += '</div>';

        // Wattage warning
        let recW = 0.125;
        if (pDiss > 0.125) recW = 0.25;
        if (pDiss > 0.25) recW = 0.5;
        if (pDiss > 0.5) recW = 1;
        if (pDiss > 1) recW = 2;

        if (pDiss > recW * 0.8) {
          html += '<div class="bg-amber-50 border border-amber-200 rounded-bae-sm p-3 text-sm text-amber-800">';
          html += '<strong>Wattage warning:</strong> This circuit dissipates ' + (pDiss * 1000).toFixed(1) + ' mW. Use at least a ' + (recW >= 1 ? recW + 'W' : (recW * 1000) + 'mW') + ' resistor for safety margin.';
          html += '</div>';
        } else {
          html += '<div class="bg-green-50 border border-green-200 rounded-bae-sm p-3 text-sm text-green-800">';
          html += 'A standard 1/4W (250mW) resistor is safe for this circuit.';
          html += '</div>';
        }

        html += '</div>';
        res.innerHTML = html;
        // Update right panel if on led tab
        if (activeTab === 'led') {
          let panelHtml = '<div class="space-y-3">';
          panelHtml += '<div class="text-2xl font-bold font-serif">' + formatResistance(rExact) + '</div>';
          panelHtml += '<div class="text-sm text-white/70">Standard: ' + formatResistance(std.higher) + '</div>';
          panelHtml += '<div class="border-t border-white/10 pt-3 space-y-1">';
          panelHtml += '<div class="flex justify-between text-sm"><span class="text-white/70">V across resistor</span><span class="font-semibold">' + vRes.toFixed(2) + ' V</span></div>';
          panelHtml += '<div class="flex justify-between text-sm"><span class="text-white/70">Current</span><span class="font-semibold">' + (iAtStd * 1000).toFixed(1) + ' mA</span></div>';
          panelHtml += '<div class="flex justify-between text-sm"><span class="text-white/70">Power</span><span class="font-semibold">' + (pDiss >= 1 ? pDiss.toFixed(3) + ' W' : (pDiss * 1000).toFixed(1) + ' mW') + '</span></div>';
          panelHtml += '</div></div>';
          $('result-content').innerHTML = panelHtml;
        }
        updateResults();
      });

      // ===== Results Panel =====
      function updateResults() {
        const panel = $('result-content');
        if (activeTab === 'color') {
          panel.innerHTML = calcColorCode();
        } else if (activeTab === 'ohms') {
          const ohmsRes = $('ohms-result');
          if (ohmsRes.classList.contains('hidden') || !ohmsRes.innerHTML.trim()) {
            panel.innerHTML = '<p class="text-sm text-white/70">Enter any two values in Ohm\'s Law to see results.</p>';
          }
          // If results exist, they were set by the Calculate button handler
        } else if (activeTab === 'led') {
          const ledRes = $('led-result');
          if (ledRes.classList.contains('hidden') || !ledRes.innerHTML.trim()) {
            panel.innerHTML = '<p class="text-sm text-white/70">Click Calculate LED Resistor to see results.</p>';
          }
          // If results exist, they were set by the Calculate button handler
        }
      }

      // ===== PDF Export =====
      $('pdf-btn').addEventListener('click', async () => {
        if (typeof html2pdf === 'undefined') return;
        const btn = $('pdf-btn');
        const orig = btn.textContent;
        btn.textContent = 'Generating PDF...';
        btn.disabled = true;

        // Build PDF content
        let pdfHtml = '';
        if (activeTab === 'color') {
          pdfHtml = '<h3 style="font-size:16px;font-weight:bold;margin-bottom:12px;">Resistor Color Code Result</h3>' + calcColorCode().replace(/class="/g, 'style="').replace(/text-white\/70/g, 'color:#666').replace(/text-white\/50/g, 'color:#999').replace(/border-white\/10/g, 'border-color:#eee');
        } else if (activeTab === 'led') {
          const ledRes = $('led-result');
          if (!ledRes.classList.contains('hidden')) {
            pdfHtml = '<h3 style="font-size:16px;font-weight:bold;margin-bottom:12px;">LED Resistor Calculation</h3>' + ledRes.innerHTML;
          }
        } else {
          const ohmsRes = $('ohms-result');
          if (!ohmsRes.classList.contains('hidden')) {
            pdfHtml = '<h3 style="font-size:16px;font-weight:bold;margin-bottom:12px;">Ohm\'s Law Calculation</h3>' + ohmsRes.innerHTML;
          }
        }

        if (!pdfHtml) {
          btn.textContent = orig;
          btn.disabled = false;
          return;
        }

        $('pdf-content').innerHTML = pdfHtml;
        const wrapper = document.createElement('div');
        wrapper.style.width = '210mm';
        wrapper.style.boxSizing = 'border-box';
        wrapper.style.margin = '0';
        const report = $('print-report').cloneNode(true);
        report.removeAttribute('id');
        report.classList.remove('hidden');
        wrapper.appendChild(report);
        document.body.appendChild(wrapper);

        try {
          await html2pdf().set({
            margin: [8, 8, 8, 8],
            filename: 'resistor-calculator-report.pdf',
            image: { type: 'jpeg', quality: 0.95 },
            html2canvas: { scale: 2, useCORS: true, logging: false, scrollX: 0, scrollY: 0 },
            pagebreak: { mode: ['css', 'legacy'], avoid: 'p, li, div, h1, h2, h3, h4, h5, h6, ul, tr, td, table' },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
          }).from(wrapper).save();
        } catch (e) { console.error(e); }
        finally {
          if (wrapper.parentNode) document.body.removeChild(wrapper);
          btn.textContent = orig;
          btn.disabled = false;
        }
      });

      // ===== Init =====
      buildColorPickers();
      updateResistorVisual();
      updateResults();
    })();
  </script>

  <style>
    @media print {
      body * { visibility: hidden; }
      #print-report, #print-report * { visibility: visible; }
      #print-report { position: absolute; left: 0; top: 0; width: 100%; display: block !important; }
      nav, footer, section:not(#print-report), main > *:not(#print-report) { display: none !important; }
    }
    .resistor-band { transition: background-color 0.2s; }
  </style>
</BaseLayout>
