        'epsom salt':'MgSO4·7H2O', 'magnesium sulfate':'MgSO4', gypsum:'CaSO4·2H2O',
        'plaster of paris':'CaSO4·0.5H2O', 'copper sulfate':'CuSO4', 'copper ii sulfate':'CuSO4',
        'blue vitriol':'CuSO4·5H2O', alum:'KAl(SO4)2·12H2O', tnt:'C7H5N3O6', aspirin:'C9H8O4',
        'acetylsalicylic acid':'C9H8O4', caffeine:'C8H10N4O2', benzene:'C6H6', toluene:'C7H8',
        methanol:'CH3OH', acetone:'C3H6O', formaldehyde:'CH2O', urea:'CO(NH2)2', 'oxalic acid':'C2H2O4',
        'citric acid':'C6H8O7', 'sulfuric acid':'H2SO4', 'nitric acid':'HNO3', 'hydrochloric acid':'HCl',
        'phosphoric acid':'H3PO4', 'ammonium nitrate':'NH4NO3', 'potassium nitrate':'KNO3',
        'sodium hydroxide':'NaOH', 'potassium hydroxide':'KOH', 'calcium hydroxide':'Ca(OH)2',
        'slaked lime':'Ca(OH)2', 'sodium carbonate':'Na2CO3', 'washing soda':'Na2CO3',
        'potassium permanganate':'KMnO4', 'sodium thiosulfate':'Na2S2O3', 'barium sulfate':'BaSO4',
        'lead nitrate':'Pb(NO3)2', 'silver nitrate':'AgNO3', 'zinc sulfate':'ZnSO4',
        'iron sulfate':'FeSO4', 'ferrous sulfate':'FeSO4', 'titanium dioxide':'TiO2',
        'sodium chloride':'NaCl', 'potassium chloride':'KCl', 'calcium chloride':'CaCl2',
        'magnesium chloride':'MgCl2', 'aluminum oxide':'Al2O3', 'silicon dioxide':'SiO2',
        'carbon dioxide':'CO2', 'carbon monoxide':'CO', 'nitrogen dioxide':'NO2',
        'sulfur dioxide':'SO2', 'sulfur trioxide':'SO3', 'nitrous oxide':'N2O',
        'dinitrogen tetroxide':'N2O4', ozone:'O3', 'hydrogen sulfide':'H2S',
        'ammonium sulfate':'(NH4)2SO4', 'ammonium chloride':'NH4Cl', 'calcium sulfate':'CaSO4',
        'magnesium oxide':'MgO', 'sodium sulfate':'Na2SO4', 'potassium carbonate':'K2CO3',
        'lithium carbonate':'Li2CO3', 'barium carbonate':'BaCO3', 'strontium carbonate':'SrCO3',
        'zinc oxide':'ZnO', 'cadmium sulfide':'CdS', 'mercury oxide':'HgO', 'tin chloride':'SnCl2',
        'stannous chloride':'SnCl2', 'lead oxide':'PbO', litharge:'PbO', borax:'Na2B4O7·10H2O',
        'boric acid':'H3BO3', 'lactic acid':'C3H6O3', 'salicylic acid':'C7H6O3',
        'tartaric acid':'C4H6O6', 'malic acid':'C4H6O5', 'oxalic acid dihydrate':'C2H2O4·2H2O',
        edta:'C10H16N2O8', glycine:'C2H5NO2', alanine:'C3H7NO2'
      };

      let lastMolarMass = 0;
      let lastFormula = '';
      let lastResult = null;

      function escapeHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      }

      function parseFormula(input) {
        const raw = input.trim();
        const lower = raw.toLowerCase();
        if (COMMON_NAMES[lower]) {
          const resolved = COMMON_NAMES[lower];
          const result = parseMolecule(resolved);
          return { formula: resolved, commonName: raw, isCommonName: true, ...result };
        }
        const result = parseMolecule(raw);
        return { formula: raw, ...result };
      }

      function parseMolecule(str) {
        const hydrateMatch = str.match(/^(.+?)\s*[·\.*]\s*(\d*)\s*[Hh]2[Oo]$/);
        let mainStr = str;
        let hydrateCount = 0;
        let hasHydrate = false;

        if (hydrateMatch) {
          mainStr = hydrateMatch[1].trim();
          hydrateCount = parseInt(hydrateMatch[2] || '1', 10);
          hasHydrate = true;
        }

        const anhydrousElements = {};
        parseGroup(mainStr, 1, anhydrousElements);

        const totalElements = {};
        for (const k in anhydrousElements) totalElements[k] = anhydrousElements[k];
        if (hasHydrate) {
          parseGroup('H2O', hydrateCount, totalElements);
        }

        return { elements: totalElements, anhydrousElements, hasHydrate, hydrateCount };
      }

      function parseGroup(str, multiplier, elements) {
        let i = 0;
        while (i < str.length) {
          const ch = str[i];
          if (ch === '(' || ch === '[') {
            const close = ch === '(' ? ')' : ']';
            let depth = 1;
            let j = i + 1;
            while (j < str.length && depth > 0) {
              if (str[j] === ch) depth++;
              else if (str[j] === close) depth--;
              j++;
            }
            const inner = str.slice(i + 1, j - 1);
            let num = 0;
            let k = j;
            while (k < str.length && /\d/.test(str[k])) {
              num = num * 10 + parseInt(str[k]);
              k++;
            }
            if (num === 0) num = 1;
            parseGroup(inner, multiplier * num, elements);
            i = k;
          } else if (/[A-Z]/.test(ch)) {
            let symbol = ch;
            let j = i + 1;
            if (j < str.length && /[a-z]/.test(str[j])) {
              symbol += str[j];
              j++;
            }
            if (!ATOMIC_WEIGHTS[symbol]) {
              throw new Error('Unknown element symbol: ' + symbol + '. Check capitalization. Na is sodium, but NA is not valid.');
            }
            let num = 0;
            let k = j;
            while (k < str.length && /\d/.test(str[k])) {
              num = num * 10 + parseInt(str[k]);
              k++;
            }
            if (num === 0) num = 1;
            elements[symbol] = (elements[symbol] || 0) + multiplier * num;
            i = k;
          } else if (/\s/.test(ch) || ch === '-') {
            i++;
          } else {
            throw new Error('Unexpected character: ' + ch);
          }
        }
      }

      function calculate() {
        hideError();
        const input = $('formula-input').value.trim();
        if (!input) return;

        let parsed;
        try {
          parsed = parseFormula(input);
        } catch (e) {
          showError(e.message);
          return;
        }

        const elements = parsed.elements;
        let total = 0;
        for (const sym in elements) {
          total += ATOMIC_WEIGHTS[sym] * elements[sym];
        }

        let anhydrousMass = 0;
        let hydrateMass = 0;
        if (parsed.hasHydrate) {
          for (const sym in parsed.anhydrousElements) {
            anhydrousMass += ATOMIC_WEIGHTS[sym] * parsed.anhydrousElements[sym];
          }
          hydrateMass = parsed.hydrateCount * (ATOMIC_WEIGHTS.H * 2 + ATOMIC_WEIGHTS.O);
        }

        const breakdown = Object.entries(elements).map(([symbol, count]) => {
          const weight = ATOMIC_WEIGHTS[symbol];
          const subtotal = weight * count;
          const percent = (subtotal / total) * 100;
          return { symbol, count, weight, subtotal, percent };
        }).sort((a, b) => b.subtotal - a.subtotal);

        lastMolarMass = total;
        lastFormula = parsed.formula;
        lastResult = { ...parsed, total, breakdown, anhydrousMass, hydrateMass };

        renderResult(lastResult);
        updateURL(parsed.formula);
        $('converter-card').classList.remove('hidden');
        $('pdf-btn').classList.remove('hidden');
      }

      function renderResult(result) {
        let html = '';
        if (result.commonName) {
          html += '<div class="text-xs text-white/50 mb-2">Recognized as ' + escapeHtml(result.commonName) + '</div>';
        }
        html += '<div class="text-sm text-white/50 mb-1">Formula</div>';
        html += '<div class="text-lg font-semibold mb-4">' + escapeHtml(result.formula) + '</div>';
        html += '<div class="text-3xl font-bold font-serif mb-1">' + result.total.toFixed(2) + ' <span class="text-lg font-normal text-white/70">g/mol</span></div>';

        if (result.hasHydrate) {
          html += '<div class="mt-3 space-y-1 text-sm">';
          html += '<div class="flex justify-between"><span class="text-white/50">Anhydrous</span><span class="font-medium">' + result.anhydrousMass.toFixed(2) + ' g/mol</span></div>';
          html += '<div class="flex justify-between"><span class="text-white/50">Water (' + result.hydrateCount + ' H₂O)</span><span class="font-medium">' + result.hydrateMass.toFixed(2) + ' g/mol</span></div>';
          html += '</div>';
        }

        html += '<div class="border-t border-white/10 pt-3 mt-3">';
        html += '<div class="text-xs font-bold uppercase tracking-wider text-white/50 mb-2">Element Breakdown</div>';
        html += '<table class="w-full text-sm">';
        html += '<thead><tr class="text-white/50 text-xs"><th class="text-left py-1">Element</th><th class="text-right py-1">Mass</th><th class="text-right py-1">%</th></tr></thead>';
        html += '<tbody>';
        for (const el of result.breakdown) {
          html += '<tr>';
          html += '<td class="py-1 text-white/80">' + escapeHtml(el.symbol) + ' <span class="text-white/40">×' + el.count + '</span></td>';
          html += '<td class="py-1 text-right text-white/80">' + el.subtotal.toFixed(2) + '</td>';
          html += '<td class="py-1 text-right text-bae-primary font-medium">' + el.percent.toFixed(1) + '%</td>';
          html += '</tr>';
        }
        html += '</tbody></table>';
        html += '</div>';

        $('result-content').innerHTML = html;
      }

      function renderPDFContent(result) {
        let html = '<div style="font-family:sans-serif;color:#1a1a1a;">';
        html += '<div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">';
        html += '<div style="width:40px;height:40px;border-radius:10px;background:#0f0f1a;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:bold;font-family:Georgia,serif;">B<span style=\"color:#8b5cf6;\">.</span></div>';
        html += '<div><div style="font-size:18px;font-weight:bold;">Best Answer Hub</div><div style="font-size:13px;color:#666;">Molecular Weight Report</div></div>';
        html += '</div>';
        html += '<h1 style="font-size:22px;font-weight:bold;margin-bottom:8px;">Molecular Weight Calculation</h1>';
        if (result.commonName) {
          html += '<p style="color:#666;margin-bottom:4px;">Common name: ' + escapeHtml(result.commonName) + '</p>';
        }
        html += '<p style="color:#666;margin-bottom:16px;">Formula: ' + escapeHtml(result.formula) + '</p>';
        html += '<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px;margin-bottom:20px;">';
        html += '<div style="font-size:28px;font-weight:bold;color:#1a1a1a;">' + result.total.toFixed(2) + ' <span style="font-size:16px;font-weight:normal;color:#666;">g/mol</span></div>';
        if (result.hasHydrate) {
          html += '<div style="margin-top:8px;font-size:13px;color:#666;">';
          html += 'Anhydrous: ' + result.anhydrousMass.toFixed(2) + ' g/mol &nbsp;|&nbsp; ';
          html += 'Water (' + result.hydrateCount + ' H₂O): ' + result.hydrateMass.toFixed(2) + ' g/mol';
          html += '</div>';
        }
        html += '</div>';
        html += '<h2 style="font-size:16px;font-weight:bold;margin-bottom:12px;">Element Breakdown</h2>';
        html += '<table style="width:100%;border-collapse:collapse;font-size:12px;">';
        html += '<thead><tr style="border-bottom:2px solid #e2e8f0;">';
        html += '<th style="padding:8px 6px;text-align:left;white-space:nowrap;">Element</th>';
        html += '<th style="padding:8px 6px;text-align:right;white-space:nowrap;">Count</th>';
        html += '<th style="padding:8px 6px;text-align:right;white-space:nowrap;">Atomic Wt.</th>';
        html += '<th style="padding:8px 6px;text-align:right;white-space:nowrap;">Subtotal</th>';
        html += '<th style="padding:8px 6px;text-align:right;white-space:nowrap;">%</th>';
        html += '</tr></thead><tbody>';
        for (const el of result.breakdown) {
          html += '<tr style="border-bottom:1px solid #e2e8f0;">';
          html += '<td style="padding:6px;text-align:left;">' + escapeHtml(el.symbol) + '</td>';
          html += '<td style="padding:6px;text-align:right;">' + el.count + '</td>';
          html += '<td style="padding:6px;text-align:right;">' + el.weight.toFixed(3) + '</td>';
          html += '<td style="padding:6px;text-align:right;">' + el.subtotal.toFixed(2) + '</td>';
          html += '<td style="padding:6px;text-align:right;font-weight:600;color:#6366f1;">' + el.percent.toFixed(1) + '%</td>';
          html += '</tr>';
        }
        html += '</tbody></table>';
        html += '<div style="margin-top:24px;padding-top:16px;border-top:1px solid #e2e8f0;font-size:11px;color:#999;">';
        html += 'Report generated by Best Answer Hub Molecular Weight Calculator. Atomic weights from IUPAC periodic table.';
        html += '</div>';
        html += '</div>';
        return html;
      }

      function updateConverter() {
        if (lastMolarMass <= 0) return;
        const grams = parseFloat($('grams-input').value);
        const moles = parseFloat($('moles-input').value);
        if (!isNaN(grams) && grams !== 0) {
          $('grams-result').textContent = (grams / lastMolarMass).toFixed(4) + ' moles';
        } else {
          $('grams-result').textContent = '';
        }
        if (!isNaN(moles) && moles !== 0) {
          $('moles-result').textContent = (moles * lastMolarMass).toFixed(4) + ' grams';
        } else {
          $('moles-result').textContent = '';
        }
      }

      function updateURL(formula) {
        const url = new URL(window.location.href);
        if (formula) {
          url.searchParams.set('formula', formula);
        } else {
          url.searchParams.delete('formula');
        }
        history.replaceState({}, '', url);
      }

      function loadFromURL() {
        const url = new URL(window.location.href);
        const formula = url.searchParams.get('formula');
        if (formula) {
          $('formula-input').value = formula;
          calculate();
        }
      }

      async function exportPDF() {
        if (typeof html2pdf === 'undefined' || !lastResult) return;
        const btn = $('pdf-btn');
        const orig = btn.textContent;
        btn.textContent = 'Generating PDF...';
        btn.disabled = true;

        const report = document.createElement('div');
        report.style.cssText = 'width:210mm;padding:20px;box-sizing:border-box;background:#fff;color:#1a1a1a;font-family:sans-serif;';
        report.innerHTML = renderPDFContent(lastResult);
        document.body.appendChild(report);

        await html2pdf().set({
          margin: 0,
          filename: 'molecular-weight-report.pdf',
          image: { type: 'jpeg', quality: 0.95 },
          html2canvas: { scale: 2, scrollX: 0, scrollY: 0 },
          jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
        }).from(report).save();

        document.body.removeChild(report);
        btn.textContent = orig;
        btn.disabled = false;
      }

      function showError(msg) {
        const el = $('error-msg');
        el.textContent = msg;
        el.classList.remove('hidden');
      }

      function hideError() {
        $('error-msg').classList.add('hidden');
      }

      $('calc-btn').addEventListener('click', calculate);
      $('clear-btn').addEventListener('click', () => {
        $('formula-input').value = '';
        $('result-content').innerHTML = '<p class="text-sm text-white/70">Enter a chemical formula to see molar mass, element breakdown, and percent composition.</p>';
        $('converter-card').classList.add('hidden');
        $('pdf-btn').classList.add('hidden');
        $('grams-input').value = '';
        $('moles-input').value = '';
        $('grams-result').textContent = '';
        $('moles-result').textContent = '';
        hideError();
        lastMolarMass = 0;
        lastFormula = '';
        lastResult = null;
        updateURL('');
      });
      $('formula-input').addEventListener('keydown', e => { if (e.key === 'Enter') calculate(); });
      $('grams-input').addEventListener('input', updateConverter);
      $('moles-input').addEventListener('input', updateConverter);
      $('pdf-btn').addEventListener('click', exportPDF);

      document.querySelectorAll('.quick-formula').forEach(btn => {
        btn.addEventListener('click', () => {
          $('formula-input').value = btn.textContent;
          calculate();
        });
      });

      loadFromURL();
    })();
  </script>
</BaseLayout>
