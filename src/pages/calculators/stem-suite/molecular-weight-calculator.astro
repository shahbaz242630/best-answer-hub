      };

      const COMMON_NAMES = {
        water:'H2O', salt:'NaCl', sugar:'C12H22O11', glucose:'C6H12O6', sucrose:'C12H22O11',
        fructose:'C6H12O6', ethanol:'C2H5OH', alcohol:'C2H5OH', methane:'CH4', ammonia:'NH3',
