    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Social Media Engagement Calculator",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0" }
    }
  </script>
</BaseLayout>
