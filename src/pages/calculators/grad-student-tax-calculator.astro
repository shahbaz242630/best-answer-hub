  <script slot="scripts" src="/html2pdf.bundle.min.js"></script>

  <script is:inline>
    (function() {
      const $ = (id) => document.getElementById(id);

      function formatMoney(n) {
        const abs = Math.abs(n);
        if (abs >= 1000) return '$' + Math.round(n).toLocaleString();
        if (abs >= 1) return '$' + n.toFixed(2);
        return '$' + n.toFixed(2);
      }

      function formatPct(n) {
        if (!isFinite(n)) return '—';
        return n.toFixed(1) + '%';
      }

      const US_BRACKETS = {
        single: [
          { rate: 0.10, limit: 12400 },
          { rate: 0.12, limit: 50400 },
          { rate: 0.22, limit: 105700 },
          { rate: 0.24, limit: 201775 },
          { rate: 0.32, limit: 256225 },
          { rate: 0.35, limit: 640600 },
          { rate: 0.37, limit: Infinity },
        ],
        married: [
          { rate: 0.10, limit: 24800 },
          { rate: 0.12, limit: 100800 },
          { rate: 0.22, limit: 211400 },
          { rate: 0.24, limit: 403550 },
          { rate: 0.32, limit: 512450 },
          { rate: 0.35, limit: 768700 },
          { rate: 0.37, limit: Infinity },
        ],
        hoh: [
          { rate: 0.10, limit: 17700 },
          { rate: 0.12, limit: 67450 },
          { rate: 0.22, limit: 105700 },
          { rate: 0.24, limit: 201775 },
          { rate: 0.32, limit: 256200 },
          { rate: 0.35, limit: 640600 },
          { rate: 0.37, limit: Infinity },
        ],
      };

      const STD_DEDUCTION_DEFAULTS = {
        single: 16100,
        married: 32200,
        hoh: 24150,
      };

      const STATE_RATES = {
        none: 0,
        ca: 6.0,
        ny: 5.5,
        ma: 5.0,
        il: 5.0,
        pa: 3.1,
        other: 0,
      };

      const INCOME_TYPE_DESC = {
        w2: 'W-2 income has FICA withholding and standard tax withholding.',
        '1098t': '1098-T fellowship: taxable portion is Box 5 minus Box 1. Not subject to FICA or SE tax.',
        '1099': '1099 fellowship: taxable as ordinary income. NOT self-employment. No 15.3% SE tax.',
        noform: 'No-form fellowship: still taxable. Estimate from your bank deposits.',
      };

      function calculateUSTax(taxableIncome, filingStatus) {
        const brackets = US_BRACKETS[filingStatus];
        let tax = 0;
        let remaining = taxableIncome;
        let prevLimit = 0;
        const breakdown = [];

        for (const b of brackets) {
          if (remaining <= 0) break;
          const bracketSize = b.limit === Infinity ? remaining : b.limit - prevLimit;
          const taxedAtThisRate = Math.min(remaining, bracketSize);
          const bracketTax = taxedAtThisRate * b.rate;
          tax += bracketTax;
          breakdown.push({
            rate: b.rate,
            amount: taxedAtThisRate,
            tax: bracketTax,
            from: prevLimit,
            to: b.limit === Infinity ? Infinity : b.limit,
          });
          remaining -= taxedAtThisRate;
          prevLimit = b.limit;
        }
        return { tax, breakdown };
      }

      function getMarginalRate(taxableIncome, filingStatus) {
        const brackets = US_BRACKETS[filingStatus];
        for (const b of brackets) {
          if (taxableIncome <= b.limit) return b.rate;
        }
        return brackets[brackets.length - 1].rate;
      }

      function calculate() {
        const incomeType = $('incomeType').value;
        const stipend = parseFloat($('stipend').value) || 0;
        const otherIncome = parseFloat($('otherIncome').value) || 0;
        const box5 = parseFloat($('box5').value) || 0;
        const box1 = parseFloat($('box1').value) || 0;
        const healthInsurance = parseFloat($('healthInsurance').value) || 0;
        const age = parseInt($('age').value) || 0;
        const isDependent = $('isDependent').checked;
        const ficaExempt = $('ficaExempt').checked;
        const filingStatus = $('filingStatus').value;
        const state = $('state').value;
        const customStateRate = parseFloat($('customStateRate').value) || 0;
        const parentRate = parseFloat($('parentRate').value) || 22;
        const withheld = parseFloat($('withheld').value) || 0;
        const creditType = $('creditType').value;
        const creditExpenses = parseFloat($('creditExpenses').value) || 0;
        const payPeriods = parseInt($('payPeriods').value) || 12;

        // Taxable fellowship
        let taxableFellowship = 0;
        if (incomeType === 'w2') {
          taxableFellowship = stipend;
        } else if (incomeType === '1098t') {
          taxableFellowship = Math.max(0, box5 - box1);
        } else {
          taxableFellowship = stipend;
        }

        // Show taxable scholarship for 1098t
        if (incomeType === '1098t') {
          $('taxable-scholarship-display').textContent = formatMoney(taxableFellowship);
        }

        // Total income
        const totalIncome = taxableFellowship + otherIncome + healthInsurance;

        // Standard deduction
        const stdDeduction = parseFloat($('stdDeduction').value) || STD_DEDUCTION_DEFAULTS[filingStatus];

        // Taxable income
        const taxableIncome = Math.max(0, totalIncome - stdDeduction);

        // Federal tax
        const fedResult = calculateUSTax(taxableIncome, filingStatus);
        let federalTax = fedResult.tax;
        const marginalRate = getMarginalRate(taxableIncome, filingStatus);

        // FICA (W-2 only; student employees enrolled at least half-time are exempt under §3121(b)(10))
        let ficaTax = 0;
        if (incomeType === 'w2' && !ficaExempt) {
          const ssWageBase = 184500;
          ficaTax = Math.min(stipend, ssWageBase) * 0.062 + stipend * 0.0145;
        }

        // Kiddie Tax flag
        let kiddieTaxRisk = false;
        let kiddieTaxMessage = '';
        if (age < 24 && isDependent && incomeType !== 'w2' && taxableFellowship > 2700) {
          kiddieTaxRisk = true;
          const exposedAmount = taxableFellowship - 2700;
          const regularTaxOnExposed = calculateUSTax(Math.max(0, taxableFellowship - 1350), 'single').tax;
          const parentTaxOnExposed = (1350 * 0.10) + (exposedAmount * (parentRate / 100));
          const potentialIncrease = Math.max(0, parentTaxOnExposed - regularTaxOnExposed);
          kiddieTaxMessage = `Kiddie Tax risk: As a dependent under 24, your fellowship above $2,700 may be taxed at your parent's ${parentRate}% rate instead of your graduated rate.`;
          if (potentialIncrease > 0) {
            kiddieTaxMessage += ` This could increase your tax by approximately ${formatMoney(potentialIncrease)}.`;
          }
          kiddieTaxMessage += ' Consult a tax professional.';
        }

        // Education credit (gross amount earned)
        let educationCredit = 0;
        if (creditType === 'llc') {
          educationCredit = Math.min(2000, creditExpenses * 0.20);
        } else if (creditType === 'aotc') {
          educationCredit = Math.min(2500, creditExpenses <= 2000 ? creditExpenses : 2000 + (creditExpenses - 2000) * 0.25);
        }

        // Credits reduce federal INCOME tax only — never FICA or state tax.
        // LLC is nonrefundable (capped at federal income tax). AOTC is 40% refundable + 60% nonrefundable.
        let creditApplied = 0;
        if (creditType === 'llc') {
          creditApplied = Math.min(educationCredit, federalTax);
        } else if (creditType === 'aotc') {
          const refundable = educationCredit * 0.40;
          const nonRefundable = Math.min(educationCredit * 0.60, federalTax);
          creditApplied = refundable + nonRefundable;
        }

        // State tax
        let stateRate = STATE_RATES[state] || 0;
        if (state === 'other') stateRate = customStateRate;
        const stateTax = taxableIncome * (stateRate / 100);

        // Total tax (credit benefit applied against federal income tax, not FICA/state)
        let totalTax = Math.max(0, federalTax + ficaTax + stateTax - creditApplied);

        // Effective rate
        const effectiveRate = totalIncome > 0 ? (totalTax / totalIncome) * 100 : 0;

        // Refund / owed
        const refundOwed = withheld - totalTax;

        // Quarterly
        const needsQuarterly = (incomeType !== 'w2') && (totalTax - withheld > 1000);
        const quarterly = needsQuarterly ? (totalTax - withheld) / 4 : 0;

        // Per-paycheck savings
        const perPaycheck = totalTax / payPeriods;

        // Update main results
        $('res-taxableIncome').textContent = formatMoney(taxableIncome);
        $('res-federalTax').textContent = formatMoney(federalTax);
        $('res-ficaTax').textContent = formatMoney(ficaTax);
        $('res-stateTax').textContent = formatMoney(stateTax);
        $('res-credit').textContent = (creditApplied > 0 ? '-' : '') + formatMoney(creditApplied);
        $('res-totalTax').textContent = formatMoney(totalTax);
        $('res-effectiveRate').textContent = formatPct(effectiveRate);
        $('res-marginalRate').textContent = formatPct(marginalRate * 100);
        $('res-perPaycheck').textContent = formatMoney(perPaycheck);

        // Refund / Owed
        const refundEl = $('res-refundOwed');
        const refundDesc = $('res-refundDesc');
        if (withheld > 0) {
          if (refundOwed > 0) {
            refundEl.textContent = formatMoney(refundOwed);
            refundEl.className = 'text-2xl font-bold font-serif text-bae-primary';
            refundDesc.textContent = 'Estimated refund';
          } else if (refundOwed < 0) {
            refundEl.textContent = formatMoney(Math.abs(refundOwed));
            refundEl.className = 'text-2xl font-bold font-serif text-red-400';
            refundDesc.textContent = 'Estimated amount owed';
          } else {
            refundEl.textContent = '$0';
            refundEl.className = 'text-2xl font-bold font-serif';
            refundDesc.textContent = 'Break even';
          }
        } else {
          refundEl.textContent = formatMoney(totalTax);
          refundEl.className = 'text-2xl font-bold font-serif';
          refundDesc.textContent = 'Enter withholding above to see refund or balance due';
        }

        // Quarterly
        if (needsQuarterly) {
          $('res-quarterly-panel').classList.remove('hidden');
          $('res-quarterly').textContent = formatMoney(quarterly) + '/quarter';
        } else {
          $('res-quarterly-panel').classList.add('hidden');
        }

        // Alerts
        const alertsPanel = $('alerts-panel');
        const alertSE = $('alert-se');
        const alertKiddie = $('alert-kiddie');
        const alertQuarterly = $('alert-quarterly');
        let anyAlert = false;

        if (incomeType === '1099') {
          alertSE.classList.remove('hidden');
          anyAlert = true;
        } else {
          alertSE.classList.add('hidden');
        }

        if (kiddieTaxRisk) {
          alertKiddie.classList.remove('hidden');
          $('alert-kiddie-text').textContent = kiddieTaxMessage;
          anyAlert = true;
        } else {
          alertKiddie.classList.add('hidden');
        }

        if (needsQuarterly) {
          alertQuarterly.classList.remove('hidden');
          anyAlert = true;
        } else {
          alertQuarterly.classList.add('hidden');
        }

        if (anyAlert) {
          alertsPanel.classList.remove('hidden');
        } else {
          alertsPanel.classList.add('hidden');
        }

        // Show Your Work
        const workContent = $('show-work-content');
        let html = '<div class="space-y-2">';
        html += '<div class="flex justify-between text-xs font-semibold text-bae-muted uppercase tracking-wider border-b border-bae-border pb-1">';
        html += '<span>Line Item</span><span>Amount</span></div>';

        if (incomeType === '1098t') {
          html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">Box 5 (Scholarships)</span><span class="font-semibold text-bae-ink">' + formatMoney(box5) + '</span></div>';
          html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">Box 1 (Qualified Tuition)</span><span class="font-semibold text-bae-ink">' + formatMoney(box1) + '</span></div>';
          html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">Taxable Scholarship</span><span class="font-semibold text-bae-ink">' + formatMoney(taxableFellowship) + '</span></div>';
        } else {
          html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">Stipend / Fellowship</span><span class="font-semibold text-bae-ink">' + formatMoney(stipend) + '</span></div>';
        }

        if (healthInsurance > 0) {
          html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">Health Insurance Stipend</span><span class="font-semibold text-bae-ink">' + formatMoney(healthInsurance) + '</span></div>';
        }
        if (otherIncome > 0) {
          html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">Other Income</span><span class="font-semibold text-bae-ink">' + formatMoney(otherIncome) + '</span></div>';
        }

        html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">Total Income</span><span class="font-semibold text-bae-ink">' + formatMoney(totalIncome) + '</span></div>';
        html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">Standard Deduction</span><span class="font-semibold text-bae-ink">' + formatMoney(stdDeduction) + '</span></div>';
        html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">Taxable Income</span><span class="font-semibold text-bae-ink">' + formatMoney(taxableIncome) + '</span></div>';
        html += '<div class="flex justify-between items-center text-sm border-t border-bae-border pt-2 mt-2"><span class="font-semibold text-bae-ink">Federal Income Tax</span><span class="font-bold text-bae-primary">' + formatMoney(federalTax) + '</span></div>';

        if (ficaTax > 0) {
          html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">FICA (7.65% on W-2 wages)</span><span class="font-semibold text-bae-ink">' + formatMoney(ficaTax) + '</span></div>';
        } else if (incomeType === 'w2' && ficaExempt) {
          html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">FICA (student exemption §3121(b)(10))</span><span class="font-semibold text-bae-ink">$0</span></div>';
        }
        if (stateTax > 0) {
          html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">State Tax (' + stateRate.toFixed(1) + '%)</span><span class="font-semibold text-bae-ink">' + formatMoney(stateTax) + '</span></div>';
        }
        if (creditApplied > 0) {
          html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">Education Credit</span><span class="font-semibold text-bae-primary">-' + formatMoney(creditApplied) + '</span></div>';
        }

        html += '<div class="flex justify-between items-center text-sm border-t border-bae-border pt-2 mt-2"><span class="font-semibold text-bae-ink">Total Tax</span><span class="font-bold text-bae-primary">' + formatMoney(totalTax) + '</span></div>';
        html += '<div class="flex justify-between items-center text-sm"><span class="text-bae-muted">Effective Rate</span><span class="font-semibold text-bae-ink">' + formatPct(effectiveRate) + '</span></div>';

        if (withheld > 0) {
          html += '<div class="flex justify-between items-center text-sm border-t border-bae-border pt-2 mt-2"><span class="text-bae-muted">Withheld / Paid</span><span class="font-semibold text-bae-ink">' + formatMoney(withheld) + '</span></div>';
          html += '<div class="flex justify-between items-center text-sm"><span class="font-semibold text-bae-ink">Refund / Owed</span><span class="font-bold ' + (refundOwed >= 0 ? 'text-bae-primary' : 'text-red-500') + '">' + (refundOwed >= 0 ? '' : '-') + formatMoney(Math.abs(refundOwed)) + '</span></div>';
        }

        if (needsQuarterly) {
          html += '<div class="flex justify-between items-center text-sm border-t border-bae-border pt-2 mt-2"><span class="text-bae-muted">Quarterly Payment</span><span class="font-semibold text-bae-ink">' + formatMoney(quarterly) + '</span></div>';
        }

        html += '<div class="flex justify-between items-center text-sm border-t border-bae-border pt-2 mt-2"><span class="font-semibold text-bae-ink">Per-Paycheck Savings</span><span class="font-bold text-bae-primary">' + formatMoney(perPaycheck) + '</span></div>';
        html += '</div>';
        workContent.innerHTML = html;

        // Report
        $('report-taxable').textContent = formatMoney(taxableIncome);
        $('report-total').textContent = formatMoney(totalTax);
        $('report-effective').textContent = formatPct(effectiveRate);
        $('report-federal').textContent = formatMoney(federalTax);
        $('report-fica').textContent = formatMoney(ficaTax);
        $('report-state').textContent = formatMoney(stateTax);
        $('report-credit').textContent = formatMoney(creditApplied);
        $('report-perpaycheck').textContent = formatMoney(perPaycheck);

        if (withheld > 0) {
          $('report-refund').textContent = (refundOwed >= 0 ? '' : '-') + formatMoney(Math.abs(refundOwed));
        } else {
          $('report-refund').textContent = '—';
        }

        const reportDetails = $('report-details');
        reportDetails.innerHTML = '';
        const rows = [
          ['Funding Type', incomeType.toUpperCase()],
          ['Stipend / Fellowship', formatMoney(stipend)],
        ];
        if (incomeType === '1098t') {
          rows.push(['Box 5 (Scholarships)', formatMoney(box5)]);
          rows.push(['Box 1 (QTR)', formatMoney(box1)]);
          rows.push(['Taxable Scholarship', formatMoney(taxableFellowship)]);
        }
        if (healthInsurance > 0) rows.push(['Health Insurance Stipend', formatMoney(healthInsurance)]);
        if (otherIncome > 0) rows.push(['Other Income', formatMoney(otherIncome)]);
        rows.push(['Total Income', formatMoney(totalIncome)]);
        rows.push(['Standard Deduction', formatMoney(stdDeduction)]);
        rows.push(['Taxable Income', formatMoney(taxableIncome)]);
        rows.push(['Federal Income Tax', formatMoney(federalTax)]);
        if (ficaTax > 0) rows.push(['FICA Tax', formatMoney(ficaTax)]);
        if (stateTax > 0) rows.push(['State Tax', formatMoney(stateTax)]);
        if (creditApplied > 0) rows.push(['Education Credit', '-' + formatMoney(creditApplied)]);
        rows.push(['Total Tax', formatMoney(totalTax)]);
        rows.push(['Effective Rate', formatPct(effectiveRate)]);
        if (withheld > 0) {
          rows.push(['Withheld / Paid', formatMoney(withheld)]);
          rows.push(['Refund / Owed', (refundOwed >= 0 ? '' : '-') + formatMoney(Math.abs(refundOwed))]);
        }
        rows.push(['Per-Paycheck Savings', formatMoney(perPaycheck)]);
        if (needsQuarterly) rows.push(['Quarterly Estimate', formatMoney(quarterly)]);

        rows.forEach(([label, value]) => {
          const div = document.createElement('div');
          const span1 = document.createElement('span');
          span1.className = 'text-bae-muted';
          span1.textContent = label + ': ';
          const span2 = document.createElement('span');
          span2.className = 'font-medium text-bae-ink';
          span2.textContent = value;
          div.appendChild(span1);
          div.appendChild(span2);
          reportDetails.appendChild(div);
        });

        updateURL();
      }

      function updateURL() {
        try {
          const url = new URL(window.location.href);
          const params = new URLSearchParams();

          const stipend = parseFloat($('stipend').value) || 0;
          const otherIncome = parseFloat($('otherIncome').value) || 0;
          const withheld = parseFloat($('withheld').value) || 0;
          const incomeType = $('incomeType').value;

          if (stipend !== 30000) params.set('stipend', stipend);
          if (otherIncome !== 0) params.set('other', otherIncome);
          if (withheld !== 0) params.set('withheld', withheld);
          if (incomeType !== 'w2') params.set('type', incomeType);

          if (incomeType === '1098t') {
            const box5 = parseFloat($('box5').value) || 0;
            const box1 = parseFloat($('box1').value) || 0;
            if (box5 !== 0) params.set('box5', box5);
            if (box1 !== 0) params.set('box1', box1);
          }

          const healthInsurance = parseFloat($('healthInsurance').value) || 0;
          if (healthInsurance !== 0) params.set('health', healthInsurance);

          const age = parseInt($('age').value) || 0;
          if (age !== 25) params.set('age', age);
          if ($('isDependent').checked) params.set('dep', '1');
          if ($('ficaExempt').checked) params.set('ficaex', '1');

          const fs = $('filingStatus').value;
          if (fs !== 'single') params.set('fs', fs);

          const state = $('state').value;
          if (state !== 'none') params.set('state', state);
          if (state === 'other') {
            const csr = parseFloat($('customStateRate').value) || 0;
            if (csr !== 5) params.set('csrate', csr);
          }

          const std = parseFloat($('stdDeduction').value) || 0;
          if (std !== 16100) params.set('std', std);

          if ($('tuitionWaiver').checked) params.set('waiver', '1');

          const parentRate = parseFloat($('parentRate').value) || 0;
          if (parentRate !== 22) params.set('prate', parentRate);

          const creditType = $('creditType').value;
          if (creditType !== 'none') params.set('credit', creditType);
          const creditExpenses = parseFloat($('creditExpenses').value) || 0;
          if (creditExpenses !== 0) params.set('cexpen', creditExpenses);

          const payPeriods = parseInt($('payPeriods').value) || 0;
          if (payPeriods !== 12) params.set('periods', payPeriods);

          url.search = params.toString();
          window.history.replaceState({}, '', url);
        } catch (e) {}
      }

      function readURL() {
        try {
          const url = new URL(window.location.href);

          const stipend = url.searchParams.get('stipend');
          if (stipend !== null) { $('stipend').value = stipend; $('stipend-slider').value = stipend; $('display-stipend').textContent = '$' + parseFloat(stipend).toLocaleString(); }

          const other = url.searchParams.get('other');
          if (other !== null) $('otherIncome').value = other;

          const withheld = url.searchParams.get('withheld');
          if (withheld !== null) $('withheld').value = withheld;

          const type = url.searchParams.get('type');
          if (type && $('incomeType').querySelector('option[value="' + type + '"]')) {
            $('incomeType').value = type;
            updateIncomeTypeUI();
          }

          const box5 = url.searchParams.get('box5');
          if (box5 !== null) $('box5').value = box5;

          const box1 = url.searchParams.get('box1');
          if (box1 !== null) $('box1').value = box1;

          const health = url.searchParams.get('health');
          if (health !== null) $('healthInsurance').value = health;

          const age = url.searchParams.get('age');
          if (age !== null) $('age').value = age;

          if (url.searchParams.get('dep') === '1') {
            $('isDependent').checked = true;
          }

          if (url.searchParams.get('ficaex') === '1') {
            $('ficaExempt').checked = true;
          }

          const fs = url.searchParams.get('fs');
          if (fs && $('filingStatus').querySelector('option[value="' + fs + '"]')) {
            $('filingStatus').value = fs;
          }

          const state = url.searchParams.get('state');
          if (state && $('state').querySelector('option[value="' + state + '"]')) {
            $('state').value = state;
            updateStateUI();
          }

          const csrate = url.searchParams.get('csrate');
          if (csrate !== null) $('customStateRate').value = csrate;

          const std = url.searchParams.get('std');
          if (std !== null) $('stdDeduction').value = std;

          if (url.searchParams.get('waiver') === '1') $('tuitionWaiver').checked = true;

          const prate = url.searchParams.get('prate');
          if (prate !== null) $('parentRate').value = prate;

          const credit = url.searchParams.get('credit');
          if (credit && $('creditType').querySelector('option[value="' + credit + '"]')) {
            $('creditType').value = credit;
          }

          const cexpen = url.searchParams.get('cexpen');
          if (cexpen !== null) $('creditExpenses').value = cexpen;

          const periods = url.searchParams.get('periods');
          if (periods !== null) $('payPeriods').value = periods;
        } catch (e) {}
      }

      function updateIncomeTypeUI() {
        const type = $('incomeType').value;
        $('incomeTypeDesc').textContent = INCOME_TYPE_DESC[type];

        if (type === '1098t') {
          $('1098t-panel').classList.remove('hidden');
        } else {
          $('1098t-panel').classList.add('hidden');
        }

        if (type === 'w2') {
          $('fica-panel').classList.remove('hidden');
        } else {
          $('fica-panel').classList.add('hidden');
        }

        updateKiddiePanel();
        calculate();
      }

      function updateStateUI() {
        const state = $('state').value;
        if (state === 'other') {
          $('custom-state-panel').classList.remove('hidden');
        } else {
          $('custom-state-panel').classList.add('hidden');
        }
      }

      function updateKiddiePanel() {
        const age = parseInt($('age').value) || 0;
        const isDependent = $('isDependent').checked;
        const incomeType = $('incomeType').value;

        if (age < 24 && isDependent && incomeType !== 'w2') {
          $('kiddie-panel').classList.remove('hidden');
        } else {
          $('kiddie-panel').classList.add('hidden');
        }
      }

      // Stipend slider sync
      const stipendInput = $('stipend');
      const stipendSlider = $('stipend-slider');
      const stipendDisplay = $('display-stipend');
      stipendInput.addEventListener('input', () => {
        stipendSlider.value = stipendInput.value;
        stipendDisplay.textContent = '$' + (parseFloat(stipendInput.value) || 0).toLocaleString();
        calculate();
      });
      stipendSlider.addEventListener('input', () => {
        stipendInput.value = stipendSlider.value;
        stipendDisplay.textContent = '$' + (parseFloat(stipendSlider.value) || 0).toLocaleString();
        calculate();
      });

      // Input listeners
      ['otherIncome', 'box5', 'box1', 'healthInsurance', 'age', 'withheld', 'customStateRate', 'stdDeduction', 'parentRate', 'creditExpenses'].forEach(id => {
        $(id)?.addEventListener('input', calculate);
      });

      $('incomeType').addEventListener('change', updateIncomeTypeUI);
      $('filingStatus').addEventListener('change', () => {
        const status = $('filingStatus').value;
        $('stdDeduction').value = STD_DEDUCTION_DEFAULTS[status];
        calculate();
      });
      $('state').addEventListener('change', () => { updateStateUI(); calculate(); });
      $('isDependent').addEventListener('change', () => { updateKiddiePanel(); calculate(); });
      $('ficaExempt').addEventListener('change', calculate);
      $('tuitionWaiver').addEventListener('change', calculate);
      $('creditType').addEventListener('change', calculate);
      $('payPeriods').addEventListener('change', calculate);

      // Reset
      $('clear-btn').addEventListener('click', () => {
        $('stipend').value = 0; $('stipend-slider').value = 0; $('display-stipend').textContent = '$0';
        $('otherIncome').value = 0;
        $('incomeType').value = 'w2'; updateIncomeTypeUI();
        $('box5').value = 0; $('box1').value = 0;
        $('healthInsurance').value = 0;
        $('age').value = 25; $('isDependent').checked = false;
        $('ficaExempt').checked = false;
        $('filingStatus').value = 'single'; $('stdDeduction').value = 16100;
        $('state').value = 'none'; updateStateUI(); $('customStateRate').value = 5;
        $('tuitionWaiver').checked = false;
        $('parentRate').value = 22;
        $('withheld').value = 0;
        $('creditType').value = 'none'; $('creditExpenses').value = 0;
        $('payPeriods').value = 12;
        window.history.replaceState({}, '', window.location.pathname);
        calculate();
      });

      // PDF
      $('pdf-btn').addEventListener('click', async () => {
        if (typeof html2pdf === 'undefined') return;
        const btn = $('pdf-btn');
        const originalText = btn.textContent;
        btn.textContent = 'Generating PDF...';
        btn.disabled = true;

        const element = $('print-report');
        const clone = element.cloneNode(true);
        clone.removeAttribute('id');
        clone.classList.remove('hidden');
        clone.style.maxWidth = 'none';
        clone.style.width = '210mm';
        clone.style.margin = '0';
        clone.style.boxSizing = 'border-box';
        document.body.appendChild(clone);

        try {
          await html2pdf().set({
            margin: [8, 8, 8, 8],
            filename: 'grad-student-tax-report.pdf',
            image: { type: 'jpeg', quality: 0.95 },
            html2canvas: { scale: 2, useCORS: true, logging: false, scrollX: 0, scrollY: 0 },
            pagebreak: { mode: ['css', 'legacy'], avoid: 'p, li, div, h1, h2, h3, h4, h5, h6, ul, tr, td, table' },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
          }).from(clone).save();
        } catch (err) {
          console.error(err);
        } finally {
          if (clone.parentNode) document.body.removeChild(clone);
          btn.textContent = originalText;
          btn.disabled = false;
        }
      });

      // Init
      readURL();
      updateIncomeTypeUI();
      updateStateUI();
      updateKiddiePanel();
      calculate();
    })();
  </script>

  <style>
    @media print {
      body * { visibility: hidden; }
      #print-report, #print-report * { visibility: visible; }
      #print-report { position: absolute; left: 0; top: 0; width: 100%; display: block !important; }
      #print-report .container { max-width: 100% !important; padding: 0 !important; }
      nav, footer, section:not(#print-report), main > *:not(#print-report) { display: none !important; }
    }
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      height: 6px;
      border-radius: 3px;
      background: #e5e7eb;
      outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #6366f1;
      cursor: pointer;
    }
    input[type="range"]::-moz-range-thumb {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #6366f1;
      cursor: pointer;
      border: none;
    }
  </style>
</BaseLayout>
