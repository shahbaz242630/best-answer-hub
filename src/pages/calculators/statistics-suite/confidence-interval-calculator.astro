  <script src="/html2pdf.bundle.min.js" is:inline></script>
  <script>
    (function() {
      const $ = (id) => document.getElementById(id);
      let currentMode = 'mean';
      let currentConfLevel = 95;
      let isCustomLevel = false;

      // ── Inverse Normal CDF (Acklam's algorithm, |error| < 1.15e-9) ──
      function invNormalCDF(p) {
        if (p <= 0) return -Infinity;
        if (p >= 1) return Infinity;
        const a = [-3.969683028665376e+01, 2.209460984245205e+02, -2.759285104469687e+02, 1.383577518672690e+02, -3.066479806614716e+01, 2.506628277459239e+00];
        const b = [-5.447609879822406e+01, 1.615858368580409e+02, -1.556989798598866e+02, 6.680131188771972e+01, -1.328068155288572e+01];
        const c = [-7.784894002430293e-03, -3.223964580411365e-01, -2.400758277161838e+00, -2.549732539343734e+00, 4.374664141464968e+00, 2.938163982698783e+00];
        const d = [7.784695709041462e-03, 3.224671290700398e-01, 2.445134137142996e+00, 3.754408661907416e+00];
        const plow = 0.02425, phigh = 1 - plow;
        let q, r;
        if (p < plow) {
          q = Math.sqrt(-2 * Math.log(p));
          return (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) /
                 ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);
        } else if (p <= phigh) {
          q = p - 0.5; r = q * q;
          return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q /
                 (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1);
        }
        q = Math.sqrt(-2 * Math.log(1 - p));
        return -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) /
                ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);
      }

      // ── Student's t critical value via exact inverse-t (incomplete beta) ──
      // Regularized incomplete beta I_x(a,b) — Numerical Recipes continued fraction
      function betacf(a, b, x) {
        const MAXIT = 200, EPS = 3e-12, FPMIN = 1e-300;
        const qab = a + b, qap = a + 1, qam = a - 1;
        let c = 1, d = 1 - qab * x / qap;
        if (Math.abs(d) < FPMIN) d = FPMIN;
        d = 1 / d;
        let h = d;
        for (let m = 1; m <= MAXIT; m++) {
          const m2 = 2 * m;
          let aa = m * (b - m) * x / ((qam + m2) * (a + m2));
          d = 1 + aa * d; if (Math.abs(d) < FPMIN) d = FPMIN;
          c = 1 + aa / c; if (Math.abs(c) < FPMIN) c = FPMIN;
          d = 1 / d; h *= d * c;
          aa = -(a + m) * (qab + m) * x / ((a + m2) * (qap + m2));
          d = 1 + aa * d; if (Math.abs(d) < FPMIN) d = FPMIN;
          c = 1 + aa / c; if (Math.abs(c) < FPMIN) c = FPMIN;
          d = 1 / d;
          const del = d * c; h *= del;
          if (Math.abs(del - 1) < EPS) break;
        }
        return h;
      }

      function betai(a, b, x) {
        if (x <= 0) return 0;
        if (x >= 1) return 1;
        const bt = Math.exp(lgamma(a + b) - lgamma(a) - lgamma(b) + a * Math.log(x) + b * Math.log(1 - x));
        if (x < (a + 1) / (a + b + 2)) return bt * betacf(a, b, x) / a;
        return 1 - bt * betacf(b, a, 1 - x) / b;
      }

      // Student's t cumulative distribution function P(T <= t)
      function tCDF(t, df) {
        const ib = 0.5 * betai(df / 2, 0.5, df / (df + t * t));
        return t > 0 ? 1 - ib : ib;
      }

      // Inverse t: t such that CDF(t) = p, by bisection (exact to ~1e-10)
      function tInv(p, df) {
        let lo = 0, hi = 1e4;
        for (let i = 0; i < 120; i++) {
          const mid = (lo + hi) / 2;
          if (tCDF(mid, df) < p) lo = mid; else hi = mid;
        }
        return (lo + hi) / 2;
      }

      function tCritical(df, confLevel) {
        const alpha = 1 - confLevel / 100;
        return tInv(1 - alpha / 2, df);
      }

      function zCritical(confLevel) {
        const alpha = 1 - confLevel / 100;
        return invNormalCDF(1 - alpha / 2);
      }

      // ── Distribution Visual ──
      function drawDistribution(canvas, lower, upper, center, mode, sdOrSe, df) {
        const ctx = canvas.getContext('2d');
        const w = canvas.width, h = canvas.height;
        const padL = 45, padR = 15, padT = 15, padB = 30;
        const graphW = w - padL - padR, graphH = h - padT - padB;
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, w, h);

        const spread = Math.max(Math.abs(lower - center), Math.abs(upper - center), sdOrSe * 4) * 1.5;
        const xMin = center - spread;
        const xMax = center + spread;

        // Visual uses a normal curve centered at the estimate (t ≈ normal at the
        // sample sizes shown; the interval bounds themselves use the exact t critical value).
        function normalPdfAt(x) {
          const z = (x - center) / sdOrSe;
          return (1 / Math.sqrt(2 * Math.PI * sdOrSe * sdOrSe)) * Math.exp(-0.5 * z * z);
        }

        const yMax = normalPdfAt(center);
        const scaleX = graphW / (xMax - xMin);
        const scaleY = graphH / (yMax * 1.15);

        function toCanvasX(x) { return padL + (x - xMin) * scaleX; }
        function toCanvasY(y) { return padT + graphH - y * scaleY; }

        // Shaded CI region
        ctx.fillStyle = 'rgba(59, 130, 246, 0.15)';
        ctx.beginPath();
        const step = (xMax - xMin) / 200;
        let first = true;
        for (let x = Math.max(lower, xMin); x <= Math.min(upper, xMax); x += step) {
          const px = toCanvasX(x), py = toCanvasY(normalPdfAt(x));
          if (first) { ctx.moveTo(px, toCanvasY(0)); ctx.lineTo(px, py); first = false; }
          else ctx.lineTo(px, py);
        }
        if (!first) {
          ctx.lineTo(toCanvasX(Math.min(upper, xMax)), toCanvasY(0));
          ctx.closePath();
          ctx.fill();
        }

        // Grid lines
        ctx.strokeStyle = '#e5e7eb';
        ctx.lineWidth = 1;
        const gridStep = Math.pow(10, Math.floor(Math.log10(spread)));
        for (let x = Math.floor(xMin / gridStep) * gridStep; x <= xMax; x += gridStep) {
          const cx = toCanvasX(x);
          if (cx >= padL && cx <= w - padR) {
            ctx.beginPath(); ctx.moveTo(cx, padT); ctx.lineTo(cx, h - padB); ctx.stroke();
          }
        }

        // X-axis
        ctx.strokeStyle = '#9ca3af';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(padL, toCanvasY(0));
        ctx.lineTo(w - padR, toCanvasY(0));
        ctx.stroke();

        // X-axis labels
        ctx.fillStyle = '#6b7280';
        ctx.font = '11px sans-serif';
        ctx.textAlign = 'center';
        for (let x = Math.floor(xMin / gridStep) * gridStep; x <= xMax; x += gridStep) {
          const cx = toCanvasX(x);
          if (cx >= padL && cx <= w - padR) {
            const label = Math.abs(x - center) < gridStep * 0.01 ? 'μ' : x.toFixed(1);
            ctx.fillText(label, cx, h - 10);
          }
        }

        // Curve
        ctx.strokeStyle = '#2563eb';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        first = true;
        for (let x = xMin; x <= xMax; x += step) {
          const px = toCanvasX(x), py = toCanvasY(normalPdfAt(x));
          if (first) { ctx.moveTo(px, py); first = false; }
          else ctx.lineTo(px, py);
        }
        ctx.stroke();

        // CI boundary lines
        [lower, upper].forEach(bound => {
          if (bound >= xMin && bound <= xMax) {
            const bx = toCanvasX(bound);
            ctx.strokeStyle = '#dc2626';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([4, 3]);
            ctx.beginPath();
            ctx.moveTo(bx, padT);
            ctx.lineTo(bx, toCanvasY(0));
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.fillStyle = '#dc2626';
            ctx.font = 'bold 10px sans-serif';
            ctx.textAlign = 'center';
            const label = bound === lower ? 'LB' : 'UB';
            ctx.fillText(label, bx, padT + 10);
          }
        });
      }

      // lgamma (Lanczos) — used by the incomplete beta function for exact t critical values
      function lgamma(z) {
        // Lanczos approximation
        const g = 7;
        const C = [0.99999999999980993, 676.5203681218851, -1259.1392167224028,
                   771.32342877765313, -176.61502916214059, 12.507343278686905,
                   -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7];
        if (z < 0.5) return Math.log(Math.PI) - Math.log(Math.sin(Math.PI * z)) - lgamma(1 - z);
        z -= 1;
        let x = C[0];
        for (let i = 1; i < g + 2; i++) x += C[i] / (z + i);
        const t = z + g + 0.5;
        return 0.5 * Math.log(2 * Math.PI) + (z + 0.5) * Math.log(t) - t + Math.log(x);
      }

      // ── Mode Switching ──
      function updateMode(mode) {
        currentMode = mode;
        document.querySelectorAll('.mode-tab').forEach(btn => {
          if (btn.dataset.mode === mode) {
            btn.classList.remove('bg-white', 'text-bae-ink');
            btn.classList.add('bg-bae-primary', 'text-white');
          } else {
            btn.classList.remove('bg-bae-primary', 'text-white');
            btn.classList.add('bg-white', 'text-bae-ink');
          }
        });
        $('mean-inputs').classList.toggle('hidden', mode !== 'mean');
        $('proportion-inputs').classList.toggle('hidden', mode !== 'proportion');
      }

      document.querySelectorAll('.mode-tab').forEach(btn => {
        btn.addEventListener('click', () => updateMode(btn.dataset.mode));
      });

      // Sigma known toggle
      document.querySelectorAll('input[name="sigma-known"]').forEach(r => {
        r.addEventListener('change', (e) => {
          $('label-sd').textContent = e.target.value === 'known' ? 'Population Standard Deviation (σ)' : 'Sample Standard Deviation (s)';
        });
      });

      // Proportion method toggle
      document.querySelectorAll('input[name="prop-method"]').forEach(r => {
        r.addEventListener('change', (e) => {
          $('prop-counts-wrapper').classList.toggle('hidden', e.target.value !== 'counts');
          $('prop-direct-wrapper').classList.toggle('hidden', e.target.value !== 'direct');
        });
      });

      // Confidence level buttons
      document.querySelectorAll('.conf-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const level = btn.dataset.level;
          isCustomLevel = level === 'custom';
          document.querySelectorAll('.conf-btn').forEach(b => {
            b.classList.remove('bg-bae-primary', 'text-white', 'font-medium');
            b.classList.add('bg-white', 'text-bae-ink');
          });
          btn.classList.remove('bg-white', 'text-bae-ink');
          btn.classList.add('bg-bae-primary', 'text-white', 'font-medium');

          if (isCustomLevel) {
            $('custom-level-wrapper').classList.remove('hidden');
            currentConfLevel = parseFloat($('input-custom-level').value) || 95;
          } else {
            $('custom-level-wrapper').classList.add('hidden');
            currentConfLevel = parseInt(level);
          }
        });
      });

      $('input-custom-level').addEventListener('input', (e) => {
        currentConfLevel = parseFloat(e.target.value) || 95;
      });

      // ── Calculate ──
      function calculate() {
        const confLevel = Math.min(Math.max(currentConfLevel, 1), 99.9);
        let lower, upper, me, se, critical, df = null;
        let steps = [];
        let interpretation = '';
        let center = 0;
        let warning = '';

        if (currentMode === 'mean') {
          const mean = parseFloat($('input-mean').value);
          const sd = parseFloat($('input-sd').value);
          const n = parseInt($('input-n-mean').value);
          const sigmaKnown = document.querySelector('input[name="sigma-known"]:checked').value === 'known';

          if (isNaN(mean) || isNaN(sd) || isNaN(n) || n < 2 || sd < 0) {
            showEmpty();
            return;
          }

          se = sd / Math.sqrt(n);
          center = mean;

          if (sigmaKnown) {
            // z-interval: the normal distribution has no degrees of freedom
            df = null;
            critical = zCritical(confLevel);
            steps.push(`Formula: CI = x̄ ± z* × (σ / √n)`);
            steps.push(`Substitute: ${mean} ± z* × (${sd} / √${n})`);
            steps.push(`Standard Error (SE) = ${sd} / √${n} = ${se.toFixed(4)}`);
            steps.push(`Critical z* for ${confLevel}% = ${critical.toFixed(4)}`);
          } else {
            df = n - 1;
            critical = tCritical(df, confLevel);
            steps.push(`Formula: CI = x̄ ± t* × (s / √n)`);
            steps.push(`Substitute: ${mean} ± t* × (${sd} / √${n})`);
            steps.push(`Standard Error (SE) = ${sd} / √${n} = ${se.toFixed(4)}`);
            steps.push(`Degrees of freedom = ${n} − 1 = ${df}`);
            steps.push(`Critical t* for ${confLevel}%, df=${df} = ${critical.toFixed(4)}`);
          }

          me = critical * se;
          steps.push(`Margin of Error (ME) = ${critical.toFixed(4)} × ${se.toFixed(4)} = ${me.toFixed(4)}`);

          lower = mean - me;
          upper = mean + me;
          steps.push(`Lower bound = ${mean} − ${me.toFixed(4)} = ${lower.toFixed(4)}`);
          steps.push(`Upper bound = ${mean} + ${me.toFixed(4)} = ${upper.toFixed(4)}`);
          steps.push(`Result: ${confLevel}% CI = (${lower.toFixed(4)}, ${upper.toFixed(4)})`);

          const param = sigmaKnown ? 'population mean' : 'population mean';
          interpretation = `We are ${confLevel}% confident that the true ${param} lies between ${lower.toFixed(4)} and ${upper.toFixed(4)}. The point estimate is ${mean.toFixed(4)} with a margin of error of ±${me.toFixed(4)}.`;

        } else {
          // Proportion mode
          const method = document.querySelector('input[name="prop-method"]:checked').value;
          let phat, n;

          if (method === 'counts') {
            const successes = parseInt($('input-successes').value);
            n = parseInt($('input-trials').value);
            if (isNaN(successes) || isNaN(n) || n < 1 || successes < 0 || successes > n) {
              showEmpty();
              return;
            }
            phat = successes / n;
          } else {
            phat = parseFloat($('input-phat').value);
            n = parseInt($('input-n-prop').value);
            if (isNaN(phat) || isNaN(n) || n < 1 || phat < 0 || phat > 1) {
              showEmpty();
              return;
            }
          }

          critical = zCritical(confLevel);
          se = Math.sqrt(phat * (1 - phat) / n);
          center = phat;

          steps.push(`Formula: CI = p̂ ± z* × √(p̂(1−p̂) / n)`);
          steps.push(`Sample proportion p̂ = ${phat.toFixed(4)}`);
          steps.push(`Sample size n = ${n}`);
          steps.push(`Standard Error (SE) = √(${phat.toFixed(4)} × ${(1-phat).toFixed(4)} / ${n}) = ${se.toFixed(4)}`);
          steps.push(`Critical z* for ${confLevel}% = ${critical.toFixed(4)}`);

          me = critical * se;
          steps.push(`Margin of Error (ME) = ${critical.toFixed(4)} × ${se.toFixed(4)} = ${me.toFixed(4)}`);

          lower = phat - me;
          upper = phat + me;
          steps.push(`Lower bound = ${phat.toFixed(4)} − ${me.toFixed(4)} = ${lower.toFixed(4)}`);
          steps.push(`Upper bound = ${phat.toFixed(4)} + ${me.toFixed(4)} = ${upper.toFixed(4)}`);
          if (lower < 0 || upper > 1) {
            lower = Math.max(0, lower);
            upper = Math.min(1, upper);
            steps.push(`A proportion must lie within [0, 1], so the interval is truncated to (${lower.toFixed(4)}, ${upper.toFixed(4)}).`);
          }
          steps.push(`Result: ${confLevel}% CI = (${lower.toFixed(4)}, ${upper.toFixed(4)})`);

          interpretation = `We are ${confLevel}% confident that the true population proportion lies between ${(lower * 100).toFixed(2)}% and ${(upper * 100).toFixed(2)}%. The sample estimate is ${(phat * 100).toFixed(2)}% with a margin of error of ±${(me * 100).toFixed(2)} percentage points.`;

          // Validation warning for proportions
          if (n * phat < 10 || n * (1 - phat) < 10) {
            warning = `Warning: The normal approximation may not be reliable because np̂ = ${(n * phat).toFixed(1)} or n(1−p̂) = ${(n * (1 - phat)).toFixed(1)} is below 10. Consider using an exact method (e.g., Wilson score or Clopper-Pearson) for more accurate results.`;
          }
        }

        // Show results
        $('empty-state').style.display = 'none';
        $('result-card').style.display = 'block';
        $('dist-card').style.display = 'block';
        $('steps-card').style.display = 'block';
        $('pdf-btn').classList.remove('hidden');

        $('result-ci').textContent = `(${lower.toFixed(4)}, ${upper.toFixed(4)})`;
        $('result-lower').textContent = lower.toFixed(4);
        $('result-upper').textContent = upper.toFixed(4);
        $('result-me').textContent = me.toFixed(4);
        $('result-se').textContent = se.toFixed(4);
        $('result-critical').textContent = critical.toFixed(4);
        $('result-df-wrapper').style.display = (df !== null) ? 'block' : 'none';
        if (df !== null) $('result-df').textContent = df;
        $('result-interpretation').textContent = interpretation;

        const warnEl = $('validation-warning');
        if (warning) {
          warnEl.classList.remove('hidden');
          warnEl.querySelector('p').textContent = warning;
        } else {
          warnEl.classList.add('hidden');
        }

        $('steps-content').innerHTML = steps.map(s => '<p class="font-mono text-xs bg-white border border-bae-border rounded-bae-sm px-3 py-2">' + s + '</p>').join('');

        // Draw distribution
        const canvas = $('dist-canvas');
        canvas.width = canvas.offsetWidth * 2;
        canvas.height = 220 * 2;
        drawDistribution(canvas, lower, upper, center, currentMode, se, df);

        // PDF report
        $('report-ci').textContent = `(${lower.toFixed(4)}, ${upper.toFixed(4)})`;
        $('report-lower').textContent = lower.toFixed(4);
        $('report-upper').textContent = upper.toFixed(4);
        $('report-me').textContent = me.toFixed(4);
        $('report-se').textContent = se.toFixed(4);
        $('report-critical').textContent = critical.toFixed(4);
        $('report-interpretation').textContent = interpretation;
        $('report-details').innerHTML = steps.map(s => '<p>' + s + '</p>').join('');
        $('report-dist').src = canvas.toDataURL('image/png');
        $('report-dist-wrapper').style.display = 'block';

        updateURL();
      }

      function showEmpty() {
        $('empty-state').style.display = 'block';
        $('result-card').style.display = 'none';
        $('dist-card').style.display = 'none';
        $('steps-card').style.display = 'none';
        $('pdf-btn').classList.add('hidden');
      }

      $('calc-btn').addEventListener('click', calculate);

      $('clear-btn').addEventListener('click', () => {
        $('input-mean').value = '';
        $('input-sd').value = '';
        $('input-n-mean').value = '';
        $('input-successes').value = '';
        $('input-trials').value = '';
        $('input-phat').value = '';
        $('input-n-prop').value = '';
        $('input-custom-level').value = '';
        const defLevel = document.querySelector('.conf-btn[data-level="95"]');
        if (defLevel) defLevel.click();
        showEmpty();
      });

      // PDF generation
      $('pdf-btn').addEventListener('click', async () => {
        if (typeof html2pdf === 'undefined') return;
        const btn = $('pdf-btn');
        const originalText = btn.textContent;
        btn.textContent = 'Generating...';
        btn.disabled = true;

        const wrapper = document.createElement('div');
        wrapper.style.width = '210mm';
        wrapper.style.boxSizing = 'border-box';
        wrapper.style.margin = '0';

        const report = $('print-report').cloneNode(true);
        report.removeAttribute('id');
        report.classList.remove('hidden');
        wrapper.appendChild(report);
        document.body.appendChild(wrapper);

        try {
          await html2pdf().set({
            margin: [8, 8, 8, 8],
            filename: 'confidence-interval-report.pdf',
            image: { type: 'jpeg', quality: 0.95 },
            html2canvas: { scale: 2, useCORS: true, logging: false, scrollX: 0, scrollY: 0 },
            pagebreak: { mode: ['css', 'legacy'], avoid: 'p, li, div, h1, h2, h3, h4, h5, h6, ul, tr, td, table' },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
          }).from(wrapper).save();
        } catch (err) {
          console.error(err);
        } finally {
          if (wrapper.parentNode) document.body.removeChild(wrapper);
          btn.textContent = originalText;
          btn.disabled = false;
        }
      });

      // URL sharing
      function updateURL() {
        const url = new URL(window.location.href);
        url.searchParams.set('mode', currentMode);
        url.searchParams.set('cl', currentConfLevel);
        if (currentMode === 'mean') {
          url.searchParams.set('mean', $('input-mean').value);
          url.searchParams.set('sd', $('input-sd').value);
          url.searchParams.set('n', $('input-n-mean').value);
          url.searchParams.set('sk', document.querySelector('input[name="sigma-known"]:checked').value);
        } else {
          const method = document.querySelector('input[name="prop-method"]:checked').value;
          url.searchParams.set('pm', method);
          if (method === 'counts') {
            url.searchParams.set('suc', $('input-successes').value);
            url.searchParams.set('tri', $('input-trials').value);
          } else {
            url.searchParams.set('phat', $('input-phat').value);
            url.searchParams.set('n', $('input-n-prop').value);
          }
        }
        window.history.replaceState({}, '', url);
      }

      function readURL() {
        const url = new URL(window.location.href);
        const mode = url.searchParams.get('mode');
        if (mode && ['mean', 'proportion'].includes(mode)) {
          updateMode(mode);
        }

        const cl = url.searchParams.get('cl');
        if (cl) {
          const level = parseFloat(cl);
          if ([90, 95, 99].includes(level)) {
            document.querySelectorAll('.conf-btn').forEach(b => {
              b.classList.remove('bg-bae-primary', 'text-white', 'font-medium');
              b.classList.add('bg-white', 'text-bae-ink');
            });
            const btn = document.querySelector(`.conf-btn[data-level="${level}"]`);
            if (btn) {
              btn.classList.remove('bg-white', 'text-bae-ink');
              btn.classList.add('bg-bae-primary', 'text-white', 'font-medium');
            }
            currentConfLevel = level;
            isCustomLevel = false;
            $('custom-level-wrapper').classList.add('hidden');
          } else {
            currentConfLevel = level;
            isCustomLevel = true;
            document.querySelectorAll('.conf-btn').forEach(b => {
              b.classList.remove('bg-bae-primary', 'text-white', 'font-medium');
              b.classList.add('bg-white', 'text-bae-ink');
            });
            const customBtn = document.querySelector('.conf-btn[data-level="custom"]');
            if (customBtn) {
              customBtn.classList.remove('bg-white', 'text-bae-ink');
              customBtn.classList.add('bg-bae-primary', 'text-white', 'font-medium');
            }
            $('custom-level-wrapper').classList.remove('hidden');
            $('input-custom-level').value = level;
          }
        }

        if (mode === 'mean' || !mode) {
          if (url.searchParams.has('mean')) $('input-mean').value = url.searchParams.get('mean');
          if (url.searchParams.has('sd')) $('input-sd').value = url.searchParams.get('sd');
          if (url.searchParams.has('n')) $('input-n-mean').value = url.searchParams.get('n');
          const sk = url.searchParams.get('sk');
          if (sk) {
            document.querySelectorAll('input[name="sigma-known"]').forEach(r => {
              r.checked = r.value === sk;
            });
            $('label-sd').textContent = sk === 'known' ? 'Population Standard Deviation (σ)' : 'Sample Standard Deviation (s)';
          }
        }

        if (mode === 'proportion') {
          const pm = url.searchParams.get('pm');
          if (pm) {
            document.querySelectorAll('input[name="prop-method"]').forEach(r => {
              r.checked = r.value === pm;
            });
            $('prop-counts-wrapper').classList.toggle('hidden', pm !== 'counts');
            $('prop-direct-wrapper').classList.toggle('hidden', pm !== 'direct');
          }
          if (pm === 'counts') {
            if (url.searchParams.has('suc')) $('input-successes').value = url.searchParams.get('suc');
            if (url.searchParams.has('tri')) $('input-trials').value = url.searchParams.get('tri');
          } else {
            if (url.searchParams.has('phat')) $('input-phat').value = url.searchParams.get('phat');
            if (url.searchParams.has('n')) $('input-n-prop').value = url.searchParams.get('n');
          }
        }

        // Auto-calculate if we have enough data
        const hasMeanData = $('input-mean').value && $('input-sd').value && $('input-n-mean').value;
        const hasPropCounts = $('input-successes').value && $('input-trials').value;
        const hasPropDirect = $('input-phat').value && $('input-n-prop').value;
        if (hasMeanData || hasPropCounts || hasPropDirect) {
          calculate();
        }
      }

      // Toggle steps
      let stepsVisible = true;
      $('toggle-steps').addEventListener('click', () => {
        stepsVisible = !stepsVisible;
        $('steps-content').style.display = stepsVisible ? 'block' : 'none';
        $('toggle-steps').textContent = stepsVisible ? 'Hide' : 'Show';
      });

      readURL();
    })();
  </script>
</BaseLayout>
