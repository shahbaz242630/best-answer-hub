  <!-- Hidden PDF Report -->
  <div id="print-report" class="hidden bg-white p-8">
    <div class="max-w-[190mm] mx-auto">
      <h1 class="text-2xl font-bold text-bae-ink mb-1">Z-Score Calculation Report</h1>
      <p class="text-sm text-bae-muted mb-6">Generated by Best Answer Hub Z-Score Calculator</p>
      <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="bg-gray-50 rounded p-3">
          <p class="text-xs text-gray-500 uppercase">Z-Score</p>
          <p class="text-xl font-bold text-bae-primary" id="report-z">—</p>
        </div>
        <div class="bg-gray-50 rounded p-3">
          <p class="text-xs text-gray-500 uppercase">Percentile</p>
          <p class="text-xl font-bold text-bae-primary" id="report-percentile">—</p>
        </div>
      </div>
      <div class="mb-6">
        <p class="text-xs text-gray-500 uppercase mb-1">Interpretation</p>
        <p class="text-sm text-bae-ink" id="report-interpretation"></p>
        <p class="text-xs text-gray-400 mt-2">Percentile and probability values assume an approximately normal (bell-shaped) distribution. For skewed data, interpret with caution.</p>
      </div>
      <div class="mb-6" id="report-bell-curve-wrapper">
        <p class="text-xs text-gray-500 uppercase mb-2">Normal Distribution</p>
        <img id="report-bell-curve" src="" alt="Bell curve showing z-score position" style="max-width:100%;height:auto;display:block;border:1px solid #e5e7eb;border-radius:4px;">
      </div>
      <div class="mb-6">
        <p class="text-xs text-gray-500 uppercase mb-2">Calculation Details</p>
        <div id="report-details" class="text-sm text-bae-ink space-y-1"></div>
      </div>
      <div class="mt-8 pt-4 border-t text-xs text-gray-400">
        <p>Best Answer Hub · www.bestanswerhub.com/calculators/statistics-suite/z-score-calculator/</p>
        <p>All calculations performed client-side. No data stored.</p>
      </div>
    </div>
  </div>

  <script src="/html2pdf.bundle.min.js" is:inline></script>
  <script>
    (function() {
      const $ = (id) => document.getElementById(id);
      let currentMode = 'zscore';

      function normalCDF(z) {
        // Abramowitz and Stegun approximation
        const b1 = 0.319381530, b2 = -0.356563782, b3 = 1.781477937;
        const b4 = -1.821255978, b5 = 1.330274429, p = 0.2316419, c = 0.39894228;
        if (z >= 0) {
          const t = 1.0 / (1.0 + p * z);
          return 1.0 - c * Math.exp(-z * z / 2.0) * t * (t * (t * (t * (t * b5 + b4) + b3) + b2) + b1);
        }
        return 1.0 - normalCDF(-z);
      }

      function getInterpretation(z) {
        const absZ = Math.abs(z);
        if (absZ === 0) return 'The score is exactly equal to the mean (50th percentile).';
        const dir = z > 0 ? 'above' : 'below';
        const pct = (normalCDF(z) * 100).toFixed(2);
        let level = '';
        if (absZ > 3) level = 'an extreme outlier';
        else if (absZ > 2) level = 'very unusual';
        else if (absZ > 1) level = 'unusual';
        else level = 'typical';
        return `The score is ${absZ.toFixed(2)} standard deviations ${dir} the mean (${pct}th percentile). This is considered ${level} in a normal distribution.`;
      }

      function drawBellCurve(canvas, zScore) {
        const ctx = canvas.getContext('2d');
        const w = canvas.width, h = canvas.height;
        const padL = 45, padR = 15, padT = 15, padB = 30;
        const graphW = w - padL - padR, graphH = h - padT - padB;
        ctx.clearRect(0, 0, w, h);

        // Background
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, w, h);

        // Normal PDF
        function pdf(x) {
          return (1 / Math.sqrt(2 * Math.PI)) * Math.exp(-0.5 * x * x);
        }

        const xMin = -3.5, xMax = 3.5, yMax = pdf(0);
        const scaleX = graphW / (xMax - xMin);
        const scaleY = graphH / (yMax * 1.15);

        function toCanvasX(x) { return padL + (x - xMin) * scaleX; }
        function toCanvasY(y) { return padT + graphH - y * scaleY; }

        // Shaded area under curve (left of zScore)
        if (!isNaN(zScore)) {
          ctx.fillStyle = 'rgba(59, 130, 246, 0.15)';
          ctx.beginPath();
          ctx.moveTo(toCanvasX(xMin), toCanvasY(0));
          const step = 0.02;
          for (let x = xMin; x <= Math.min(zScore, xMax); x += step) {
            ctx.lineTo(toCanvasX(x), toCanvasY(pdf(x)));
          }
          ctx.lineTo(toCanvasX(Math.min(zScore, xMax)), toCanvasY(0));
          ctx.closePath();
          ctx.fill();
        }

        // Grid lines
        ctx.strokeStyle = '#e5e7eb';
        ctx.lineWidth = 1;
        for (let x = -3; x <= 3; x++) {
          const cx = toCanvasX(x);
          ctx.beginPath(); ctx.moveTo(cx, padT); ctx.lineTo(cx, h - padB); ctx.stroke();
        }

        // X-axis
        ctx.strokeStyle = '#9ca3af';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(padL, toCanvasY(0));
        ctx.lineTo(w - padR, toCanvasY(0));
        ctx.stroke();

        // X-axis labels
        ctx.fillStyle = '#6b7280';
        ctx.font = '11px sans-serif';
        ctx.textAlign = 'center';
        for (let x = -3; x <= 3; x++) {
          ctx.fillText(x === 0 ? 'μ' : x.toString(), toCanvasX(x), h - 10);
        }

        // Curve
        ctx.strokeStyle = '#2563eb';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        for (let x = xMin; x <= xMax; x += 0.02) {
          const px = toCanvasX(x), py = toCanvasY(pdf(x));
          if (x === xMin) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.stroke();

        // Z-score line
        if (!isNaN(zScore) && zScore >= xMin && zScore <= xMax) {
          const zx = toCanvasX(zScore);
          ctx.strokeStyle = '#dc2626';
          ctx.lineWidth = 1.5;
          ctx.setLineDash([4, 3]);
          ctx.beginPath();
          ctx.moveTo(zx, padT);
          ctx.lineTo(zx, toCanvasY(0));
          ctx.stroke();
          ctx.setLineDash([]);

          // Label
          ctx.fillStyle = '#dc2626';
          ctx.font = 'bold 11px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('z = ' + zScore.toFixed(2), zx, padT + 12);
        }
      }

      function updateMode(mode) {
        currentMode = mode;
        document.querySelectorAll('.mode-tab').forEach(btn => {
          if (btn.dataset.mode === mode) {
            btn.classList.remove('bg-white', 'text-bae-ink');
            btn.classList.add('bg-bae-primary', 'text-white');
          } else {
            btn.classList.remove('bg-bae-primary', 'text-white');
            btn.classList.add('bg-white', 'text-bae-ink');
          }
        });

        const labels = {
          zscore: { x: 'Raw Score (x)', mu: 'Mean (μ)', sigma: 'Standard Deviation (σ)', res: 'Z-Score' },
          raw: { x: 'Z-Score (z)', mu: 'Mean (μ)', sigma: 'Standard Deviation (σ)', res: 'Raw Score' },
          mean: { x: 'Raw Score (x)', mu: 'Z-Score (z)', sigma: 'Standard Deviation (σ)', res: 'Mean' },
          sd: { x: 'Raw Score (x)', mu: 'Mean (μ)', sigma: 'Z-Score (z)', res: 'Standard Deviation' },
        };
        $('label-x').textContent = labels[mode].x;
        $('label-mu').textContent = labels[mode].mu;
        $('label-sigma').textContent = labels[mode].sigma;
        $('result-label-1').textContent = labels[mode].res;

        // Show/hide sample mean option
        $('sample-size-field').classList.toggle('hidden', mode !== 'zscore');
      }

      document.querySelectorAll('.mode-tab').forEach(btn => {
        btn.addEventListener('click', () => updateMode(btn.dataset.mode));
      });

      $('use-sample-mean').addEventListener('change', (e) => {
        $('sample-size-input-wrapper').classList.toggle('hidden', !e.target.checked);
      });

      document.querySelectorAll('.critical-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          updateMode('raw');
          $('input-x').value = btn.dataset.z;
          calculate();
        });
      });

      function calculate() {
        const x = parseFloat($('input-x').value);
        const mu = parseFloat($('input-mu').value);
        const sigma = parseFloat($('input-sigma').value);
        const useSampleMean = $('use-sample-mean').checked;
        const n = useSampleMean ? (parseInt($('input-n').value) || 1) : 1;
        const sdType = document.querySelector('input[name="sd-type"]:checked').value;
        const sigmaLabel = sdType === 'population' ? 'σ' : 's';

        if (isNaN(x) || isNaN(mu) || isNaN(sigma) || sigma === 0) {
          $('empty-state').style.display = 'block';
          $('result-card').style.display = 'none';
          $('bell-curve-card').style.display = 'none';
          $('steps-card').style.display = 'none';
          $('pdf-btn').classList.add('hidden');
          return;
        }

        let result, zScore, steps = [];
        const effectiveSigma = useSampleMean ? sigma / Math.sqrt(n) : sigma;

        switch (currentMode) {
          case 'zscore':
            result = (x - mu) / effectiveSigma;
            zScore = result;
            steps.push(`Formula: z = (x − μ) / ${useSampleMean ? '(σ / √n)' : sigmaLabel}`);
            steps.push(`Substitute: z = (${x} − ${mu}) / ${useSampleMean ? '(' + sigma + ' / √' + n + ')' : sigma}`);
            if (useSampleMean) {
              steps.push(`Standard Error = ${sigma} / √${n} = ${effectiveSigma.toFixed(4)}`);
              steps.push(`Simplify: z = ${(x - mu).toFixed(4)} / ${effectiveSigma.toFixed(4)}`);
            } else {
              steps.push(`Simplify: z = ${(x - mu).toFixed(4)} / ${sigma}`);
            }
            steps.push(`Result: z = ${result.toFixed(4)}`);
            break;
          case 'raw':
            result = mu + x * sigma;
            zScore = x;
            steps.push(`Formula: x = μ + z${sigmaLabel}`);
            steps.push(`Substitute: x = ${mu} + ${x} × ${sigma}`);
            steps.push(`Multiply: ${x} × ${sigma} = ${(x * sigma).toFixed(4)}`);
            steps.push(`Add: ${mu} + ${(x * sigma).toFixed(4)} = ${result.toFixed(4)}`);
            steps.push(`Result: x = ${result.toFixed(4)}`);
            break;
          case 'mean':
            result = x - mu * sigma;
            zScore = mu;
            steps.push(`Formula: μ = x − z${sigmaLabel}`);
            steps.push(`Substitute: μ = ${x} − ${mu} × ${sigma}`);
            steps.push(`Multiply: ${mu} × ${sigma} = ${(mu * sigma).toFixed(4)}`);
            steps.push(`Subtract: ${x} − ${(mu * sigma).toFixed(4)} = ${result.toFixed(4)}`);
            steps.push(`Result: μ = ${result.toFixed(4)}`);
            break;
          case 'sd':
            result = (x - mu) / sigma;
            zScore = sigma;
            steps.push(`Formula: ${sigmaLabel} = (x − μ) / z`);
            steps.push(`Substitute: ${sigmaLabel} = (${x} − ${mu}) / ${sigma}`);
            steps.push(`Subtract: ${x} − ${mu} = ${(x - mu).toFixed(4)}`);
            steps.push(`Divide: ${(x - mu).toFixed(4)} / ${sigma} = ${result.toFixed(4)}`);
            steps.push(`Result: ${sigmaLabel} = ${result.toFixed(4)}`);
            break;
        }

        const percentile = normalCDF(zScore) * 100;

        $('empty-state').style.display = 'none';
        $('result-card').style.display = 'block';
        $('bell-curve-card').style.display = 'block';
        $('steps-card').style.display = 'block';
        $('pdf-btn').classList.remove('hidden');

        $('result-z').textContent = result.toFixed(4);
        $('result-percentile').textContent = percentile.toFixed(2) + '%';
        $('result-interpretation').textContent = getInterpretation(zScore);

        // Steps
        $('steps-content').innerHTML = steps.map(s => '<p class="font-mono text-xs bg-white border border-bae-border rounded-bae-sm px-3 py-2">' + s + '</p>').join('');

        // Bell curve
        const canvas = $('bell-curve');
        canvas.width = canvas.offsetWidth * 2;
        canvas.height = 220 * 2;
        drawBellCurve(canvas, zScore);

        // PDF report
        $('report-z').textContent = result.toFixed(4);
        $('report-percentile').textContent = percentile.toFixed(2) + '%';
        $('report-interpretation').textContent = getInterpretation(zScore);
        $('report-details').innerHTML = steps.map(s => '<p>' + s + '</p>').join('');
        $('report-bell-curve').src = canvas.toDataURL('image/png');
        $('report-bell-curve-wrapper').style.display = (!isNaN(zScore)) ? 'block' : 'none';

        updateURL();
      }

      $('calc-btn').addEventListener('click', calculate);
      $('clear-btn').addEventListener('click', () => {
        $('input-x').value = '';
        $('input-mu').value = '';
        $('input-sigma').value = '';
        $('input-n').value = '';
        $('use-sample-mean').checked = false;
        $('sample-size-input-wrapper').classList.add('hidden');
        $('empty-state').style.display = 'block';
        $('result-card').style.display = 'none';
        $('bell-curve-card').style.display = 'none';
        $('steps-card').style.display = 'none';
        $('pdf-btn').classList.add('hidden');
      });

      // PDF generation
      $('pdf-btn').addEventListener('click', async () => {
        if (typeof html2pdf === 'undefined') return;
        const btn = $('pdf-btn');
        const originalText = btn.textContent;
        btn.textContent = 'Generating...';
        btn.disabled = true;

        const wrapper = document.createElement('div');
        wrapper.style.width = '210mm';
        wrapper.style.boxSizing = 'border-box';
        wrapper.style.margin = '0';

        const report = $('print-report').cloneNode(true);
        report.removeAttribute('id');
        report.classList.remove('hidden');
        wrapper.appendChild(report);
        document.body.appendChild(wrapper);

        try {
          await html2pdf().set({
            margin: [8, 8, 8, 8],
            filename: 'z-score-report.pdf',
            image: { type: 'jpeg', quality: 0.95 },
            html2canvas: { scale: 2, useCORS: true, logging: false, scrollX: 0, scrollY: 0 },
            pagebreak: { mode: ['css', 'legacy'], avoid: 'p, li, div, h1, h2, h3, h4, h5, h6, ul, tr, td, table' },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
          }).from(wrapper).save();
        } catch (err) {
          console.error(err);
        } finally {
          if (wrapper.parentNode) document.body.removeChild(wrapper);
          btn.textContent = originalText;
          btn.disabled = false;
        }
      });

      // URL sharing
      function updateURL() {
        const url = new URL(window.location.href);
        url.searchParams.set('m', currentMode);
        url.searchParams.set('x', $('input-x').value);
        url.searchParams.set('mu', $('input-mu').value);
        url.searchParams.set('s', $('input-sigma').value);
        const sdType = document.querySelector('input[name="sd-type"]:checked').value;
        url.searchParams.set('sd', sdType);
        window.history.replaceState({}, '', url);
      }

      function readURL() {
        const url = new URL(window.location.href);
        const mode = url.searchParams.get('m');
        if (mode && ['zscore', 'raw', 'mean', 'sd'].includes(mode)) {
          updateMode(mode);
        }
        if (url.searchParams.has('x')) $('input-x').value = url.searchParams.get('x');
        if (url.searchParams.has('mu')) $('input-mu').value = url.searchParams.get('mu');
        if (url.searchParams.has('s')) $('input-sigma').value = url.searchParams.get('s');
        const sd = url.searchParams.get('sd');
        if (sd) {
          document.querySelectorAll('input[name="sd-type"]').forEach(r => r.checked = r.value === sd);
        }
        if ($('input-x').value && $('input-mu').value && $('input-sigma').value) {
          calculate();
        }
      }

      // Toggle steps
      let stepsVisible = true;
      $('toggle-steps').addEventListener('click', () => {
        stepsVisible = !stepsVisible;
        $('steps-content').style.display = stepsVisible ? 'block' : 'none';
        $('toggle-steps').textContent = stepsVisible ? 'Hide' : 'Show';
      });

      readURL();
    })();
  </script>
</BaseLayout>
