  <script src="/html2pdf.bundle.min.js" is:inline></script>
  <script is:inline>
    (function() {
      const $ = (id) => document.getElementById(id);
      let currentMode = 'zscore';
      let currentTail = 'two';
      let currentAlpha = 0.05;
      let isCustomAlpha = false;
      let stepsVisible = true;

      const FPMIN = 1e-30;

      // ── Lanczos lgamma ──
      function lgamma(z) {
        const g = 7;
        const C = [0.99999999999980993, 676.5203681218851, -1259.1392167224028,
                   771.32342877765313, -176.61502916214059, 12.507343278686905,
                   -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7];
        if (z < 0.5) return Math.log(Math.PI) - Math.log(Math.sin(Math.PI * z)) - lgamma(1 - z);
        z -= 1;
        let x = C[0];
        for (let i = 1; i < g + 2; i++) x += C[i] / (z + i);
        const t = z + g + 0.5;
        return 0.5 * Math.log(2 * Math.PI) + (z + 0.5) * Math.log(t) - t + Math.log(x);
      }

      // ── Normal CDF (Abramowitz & Stegun) ──
      function normalCDF(z) {
        const b1 = 0.319381530, b2 = -0.356563782, b3 = 1.781477937;
        const b4 = -1.821255978, b5 = 1.330274429, p = 0.2316419, c = 0.39894228;
        if (z >= 0) {
          const t = 1.0 / (1.0 + p * z);
          return 1.0 - c * Math.exp(-z * z / 2.0) * t * (t * (t * (t * (t * b5 + b4) + b3) + b2) + b1);
        }
        return 1.0 - normalCDF(-z);
      }

      // ── Incomplete Beta Continued Fraction ──
      function betacf(x, a, b) {
        const MAXIT = 200;
        const EPS = 3.0e-7;
        let m2, aa, c, d, del, h;
        const qab = a + b;
        const qap = a + 1;
        const qam = a - 1;
        c = 1;
        d = 1 - qab * x / qap;
        if (Math.abs(d) < FPMIN) d = FPMIN;
        d = 1 / d;
        h = d;
        for (let m = 1; m <= MAXIT; m++) {
          m2 = 2 * m;
          aa = m * (b - m) * x / ((qam + m2) * (a + m2));
          d = 1 + aa * d;
          if (Math.abs(d) < FPMIN) d = FPMIN;
          c = 1 + aa / c;
          if (Math.abs(c) < FPMIN) c = FPMIN;
          d = 1 / d;
          del = d * c;
          h *= del;
          aa = -(a + m) * (qab + m) * x / ((a + m2) * (qap + m2));
          d = 1 + aa * d;
          if (Math.abs(d) < FPMIN) d = FPMIN;
          c = 1 + aa / c;
          if (Math.abs(c) < FPMIN) c = FPMIN;
          d = 1 / d;
          del = d * c;
          h *= del;
          if (Math.abs(del - 1) < EPS) break;
        }
        return h;
      }

      function incompleteBeta(x, a, b) {
        if (x === 0 || x === 1) return x;
        if (a <= 0 || b <= 0) return NaN;
        const lnbeta = lgamma(a) + lgamma(b) - lgamma(a + b);
        const bt = Math.exp(a * Math.log(x) + b * Math.log(1 - x) - lnbeta);
        if (x < (a + 1) / (a + b + 2)) {
          return bt * betacf(x, a, b) / a;
        } else {
          return 1 - bt * betacf(1 - x, b, a) / b;
        }
      }

      // ── Incomplete Gamma ──
      function incompleteGammaP(a, x) {
        if (x < 0 || a <= 0) return 0;
        if (x === 0) return 0;
        if (x < a + 1) {
          let ap = a;
          let del = 1 / a;
          let sum = del;
          for (let n = 1; n <= 100; n++) {
            ap++;
            del *= x / ap;
            sum += del;
            if (Math.abs(del) < Math.abs(sum) * 3e-7) break;
          }
          return sum * Math.exp(-x + a * Math.log(x) - lgamma(a));
        } else {
          return 1 - incompleteGammaQ(a, x);
        }
      }

      function incompleteGammaQ(a, x) {
        let b = x + 1 - a;
        let c = 1 / FPMIN;
        let d = 1 / b;
        let h = d;
        for (let i = 1; i <= 100; i++) {
          const an = -i * (i - a);
          b += 2;
          d = an * d + b;
          if (Math.abs(d) < FPMIN) d = FPMIN;
          c = b + an / c;
          if (Math.abs(c) < FPMIN) c = FPMIN;
          d = 1 / d;
          const del = d * c;
          h *= del;
          if (Math.abs(del - 1) < 3e-7) break;
        }
        return h * Math.exp(-x + a * Math.log(x) - lgamma(a));
      }

      // ── Distribution CDFs ──
      function tCDF(t, df) {
        if (df > 100) return normalCDF(t);
        const x = df / (df + t * t);
        const ib = incompleteBeta(x, df / 2, 0.5);
        if (t >= 0) return 1 - 0.5 * ib;
        return 0.5 * ib;
      }

      function chiSquareCDF(x, df) {
        if (x <= 0) return 0;
        return incompleteGammaP(df / 2, x / 2);
      }

      function fCDF(f, df1, df2) {
        if (f <= 0) return 0;
        const x = (df1 * f) / (df1 * f + df2);
        return incompleteBeta(x, df1 / 2, df2 / 2);
      }

      // ── Critical value finder: inverts a (monotonic) CDF by bisection ──
      function findCritical(cdfFn, targetP, lo, hi) {
        for (let i = 0; i < 100; i++) {
          const mid = (lo + hi) / 2;
          if (cdfFn(mid) < targetP) lo = mid; else hi = mid;
        }
        return (lo + hi) / 2;
      }

      // Returns the critical x-position(s) for the current test, tail, and alpha
      function getCriticals(mode, tail, alpha, df, df1, df2) {
        if (mode === 'zscore') {
          if (tail === 'two') { const m = findCritical(normalCDF, 1 - alpha / 2, 0, 40); return [-m, m]; }
          const m = findCritical(normalCDF, 1 - alpha, 0, 40);
          return tail === 'left' ? [-m] : [m];
        }
        if (mode === 'tscore') {
          const f = (x) => tCDF(x, df);
          if (tail === 'two') { const m = findCritical(f, 1 - alpha / 2, 0, 1e6); return [-m, m]; }
          const m = findCritical(f, 1 - alpha, 0, 1e6);
          return tail === 'left' ? [-m] : [m];
        }
        if (mode === 'chisquare') {
          return [findCritical((x) => chiSquareCDF(x, df), 1 - alpha, 0, 1e6)];
        }
        return [findCritical((x) => fCDF(x, df1, df2), 1 - alpha, 0, 1e6)];
      }

      // ── PDFs for visualization ──
      function normalPDF(x) {
        return (1 / Math.sqrt(2 * Math.PI)) * Math.exp(-0.5 * x * x);
      }

      function chiSquarePDF(x, k) {
        if (x <= 0) return 0;
        const halfK = k / 2;
        return Math.exp(-x / 2 + (halfK - 1) * Math.log(x) - halfK * Math.log(2) - lgamma(halfK));
      }

      function fPDF(x, d1, d2) {
        if (x <= 0) return 0;
        const h1 = d1 / 2, h2 = d2 / 2;
        const num = Math.exp(lgamma(h1 + h2) - lgamma(h1) - lgamma(h2));
        return num * Math.pow(d1 / d2, h1) * Math.pow(x, h1 - 1) * Math.pow(1 + (d1 / d2) * x, -(h1 + h2));
      }

      // ── Drawing ──
      function drawBellCurve(canvas, stat, tail, criticals) {
        const ctx = canvas.getContext('2d');
        const w = canvas.width, h = canvas.height;
        const padL = 45, padR = 15, padT = 15, padB = 30;
        const graphW = w - padL - padR, graphH = h - padT - padB;
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, w, h);

        const xMin = -3.5, xMax = 3.5;
        const yMax = normalPDF(0);
        const scaleX = graphW / (xMax - xMin);
        const scaleY = graphH / (yMax * 1.15);

        function toCanvasX(x) { return padL + (x - xMin) * scaleX; }
        function toCanvasY(y) { return padT + graphH - y * scaleY; }

        // Shaded area
        ctx.fillStyle = 'rgba(59, 130, 246, 0.15)';
        const step = 0.02;
        let first;

        if (tail === 'two') {
          const absStat = Math.abs(stat);
          first = true;
          ctx.beginPath();
          for (let x = xMin; x <= -absStat; x += step) {
            const px = toCanvasX(x), py = toCanvasY(normalPDF(x));
            if (first) { ctx.moveTo(px, toCanvasY(0)); ctx.lineTo(px, py); first = false; }
            else ctx.lineTo(px, py);
          }
          if (!first) { ctx.lineTo(toCanvasX(-absStat), toCanvasY(0)); ctx.closePath(); ctx.fill(); }

          first = true;
          ctx.beginPath();
          for (let x = absStat; x <= xMax; x += step) {
            const px = toCanvasX(x), py = toCanvasY(normalPDF(x));
            if (first) { ctx.moveTo(px, toCanvasY(0)); ctx.lineTo(px, py); first = false; }
            else ctx.lineTo(px, py);
          }
          if (!first) { ctx.lineTo(toCanvasX(xMax), toCanvasY(0)); ctx.closePath(); ctx.fill(); }
        } else if (tail === 'left') {
          first = true;
          ctx.beginPath();
          for (let x = xMin; x <= Math.min(stat, xMax); x += step) {
            const px = toCanvasX(x), py = toCanvasY(normalPDF(x));
            if (first) { ctx.moveTo(px, toCanvasY(0)); ctx.lineTo(px, py); first = false; }
            else ctx.lineTo(px, py);
          }
          if (!first) { ctx.lineTo(toCanvasX(Math.min(stat, xMax)), toCanvasY(0)); ctx.closePath(); ctx.fill(); }
        } else if (tail === 'right') {
          first = true;
          ctx.beginPath();
          for (let x = Math.max(stat, xMin); x <= xMax; x += step) {
            const px = toCanvasX(x), py = toCanvasY(normalPDF(x));
            if (first) { ctx.moveTo(px, toCanvasY(0)); ctx.lineTo(px, py); first = false; }
            else ctx.lineTo(px, py);
          }
          if (!first) { ctx.lineTo(toCanvasX(xMax), toCanvasY(0)); ctx.closePath(); ctx.fill(); }
        }

        // Grid lines
        ctx.strokeStyle = '#e5e7eb';
        ctx.lineWidth = 1;
        for (let x = -3; x <= 3; x++) {
          const cx = toCanvasX(x);
          ctx.beginPath(); ctx.moveTo(cx, padT); ctx.lineTo(cx, h - padB); ctx.stroke();
        }

        // X-axis
        ctx.strokeStyle = '#9ca3af';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(padL, toCanvasY(0));
        ctx.lineTo(w - padR, toCanvasY(0));
        ctx.stroke();

        // X-axis labels
        ctx.fillStyle = '#6b7280';
        ctx.font = '11px sans-serif';
        ctx.textAlign = 'center';
        for (let x = -3; x <= 3; x++) {
          ctx.fillText(x === 0 ? '0' : x.toString(), toCanvasX(x), h - 10);
        }

        // Curve
        ctx.strokeStyle = '#2563eb';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        first = true;
        for (let x = xMin; x <= xMax; x += step) {
          const px = toCanvasX(x), py = toCanvasY(normalPDF(x));
          if (first) { ctx.moveTo(px, py); first = false; }
          else ctx.lineTo(px, py);
        }
        ctx.stroke();

        // Statistic line
        if (!isNaN(stat) && stat >= xMin && stat <= xMax) {
          const sx = toCanvasX(stat);
          ctx.strokeStyle = '#dc2626';
          ctx.lineWidth = 1.5;
          ctx.setLineDash([4, 3]);
          ctx.beginPath();
          ctx.moveTo(sx, padT);
          ctx.lineTo(sx, toCanvasY(0));
          ctx.stroke();
          ctx.setLineDash([]);

          ctx.fillStyle = '#dc2626';
          ctx.font = 'bold 11px sans-serif';
          ctx.textAlign = 'center';
          const label = (currentMode === 'zscore' ? 'z' : 't') + ' = ' + stat.toFixed(2);
          ctx.fillText(label, sx, padT + 12);
        }

        // Critical value line(s) at the chosen alpha
        if (Array.isArray(criticals)) {
          criticals.forEach(cv => {
            if (cv >= xMin && cv <= xMax) {
              const cx = toCanvasX(cv);
              ctx.strokeStyle = '#f59e0b';
              ctx.lineWidth = 1.5;
              ctx.setLineDash([2, 2]);
              ctx.beginPath();
              ctx.moveTo(cx, padT);
              ctx.lineTo(cx, toCanvasY(0));
              ctx.stroke();
              ctx.setLineDash([]);
              ctx.fillStyle = '#f59e0b';
              ctx.font = 'bold 10px sans-serif';
              ctx.textAlign = 'center';
              ctx.fillText('crit', cx, padT + 24);
            }
          });
        }
      }

      function drawRightSkewCurve(canvas, stat, mode, df, df1, df2, criticals) {
        const ctx = canvas.getContext('2d');
        const w = canvas.width, h = canvas.height;
        const padL = 45, padR = 15, padT = 15, padB = 30;
        const graphW = w - padL - padR, graphH = h - padT - padB;
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, w, h);

        let xMax, pdfFunc;
        if (mode === 'chisquare') {
          xMax = Math.max(stat * 1.5, df + 5 * Math.sqrt(2 * df), 8);
          pdfFunc = (x) => chiSquarePDF(x, df);
        } else {
          const meanF = df2 > 2 ? df2 / (df2 - 2) : 1;
          xMax = Math.max(stat * 1.5, meanF * 5, 8);
          pdfFunc = (x) => fPDF(x, df1, df2);
        }
        const xMin = 0;

        let yMax = 0;
        for (let x = xMin; x <= xMax; x += 0.05) {
          yMax = Math.max(yMax, pdfFunc(x));
        }
        if (yMax === 0) yMax = 0.1;

        const scaleX = graphW / (xMax - xMin);
        const scaleY = graphH / (yMax * 1.15);

        function toCanvasX(x) { return padL + (x - xMin) * scaleX; }
        function toCanvasY(y) { return padT + graphH - y * scaleY; }

        // Shaded right tail
        if (!isNaN(stat) && stat >= xMin) {
          ctx.fillStyle = 'rgba(59, 130, 246, 0.15)';
          ctx.beginPath();
          let first = true;
          const step = xMax / 200;
          for (let x = Math.max(stat, xMin); x <= xMax; x += step) {
            const px = toCanvasX(x), py = toCanvasY(pdfFunc(x));
            if (first) { ctx.moveTo(px, toCanvasY(0)); ctx.lineTo(px, py); first = false; }
            else ctx.lineTo(px, py);
          }
          if (!first) { ctx.lineTo(toCanvasX(xMax), toCanvasY(0)); ctx.closePath(); ctx.fill(); }
        }

        // X-axis
        ctx.strokeStyle = '#9ca3af';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(padL, toCanvasY(0));
        ctx.lineTo(w - padR, toCanvasY(0));
        ctx.stroke();

        // X-axis labels
        ctx.fillStyle = '#6b7280';
        ctx.font = '11px sans-serif';
        ctx.textAlign = 'center';
        const labelStep = Math.max(1, Math.ceil(xMax / 5));
        for (let x = 0; x <= xMax; x += labelStep) {
          ctx.fillText(x.toFixed(0), toCanvasX(x), h - 10);
        }

        // Curve
        ctx.strokeStyle = '#2563eb';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        let first = true;
        const step = xMax / 200;
        for (let x = xMin; x <= xMax; x += step) {
          const px = toCanvasX(x), py = toCanvasY(pdfFunc(x));
          if (py < h + 50) {
            if (first) { ctx.moveTo(px, py); first = false; }
            else ctx.lineTo(px, py);
          }
        }
        ctx.stroke();

        // Statistic line
        if (!isNaN(stat) && stat >= xMin && stat <= xMax) {
          const sx = toCanvasX(stat);
          ctx.strokeStyle = '#dc2626';
          ctx.lineWidth = 1.5;
          ctx.setLineDash([4, 3]);
          ctx.beginPath();
          ctx.moveTo(sx, padT);
          ctx.lineTo(sx, toCanvasY(0));
          ctx.stroke();
          ctx.setLineDash([]);

          ctx.fillStyle = '#dc2626';
          ctx.font = 'bold 11px sans-serif';
          ctx.textAlign = 'center';
          const label = (mode === 'chisquare' ? 'χ²' : 'F') + ' = ' + stat.toFixed(2);
          ctx.fillText(label, sx, padT + 12);
        }

        // Critical value line at the chosen alpha (right-tailed)
        if (Array.isArray(criticals)) {
          criticals.forEach(cv => {
            if (cv >= xMin && cv <= xMax) {
              const cx = toCanvasX(cv);
              ctx.strokeStyle = '#f59e0b';
              ctx.lineWidth = 1.5;
              ctx.setLineDash([2, 2]);
              ctx.beginPath();
              ctx.moveTo(cx, padT);
              ctx.lineTo(cx, toCanvasY(0));
              ctx.stroke();
              ctx.setLineDash([]);
              ctx.fillStyle = '#f59e0b';
              ctx.font = 'bold 10px sans-serif';
              ctx.textAlign = 'center';
              ctx.fillText('crit', cx, padT + 24);
            }
          });
        }
      }

      // ── Mode / Tail / Alpha Switching ──
      function updateMode(mode) {
        currentMode = mode;
        document.querySelectorAll('.mode-tab').forEach(btn => {
          if (btn.dataset.mode === mode) {
            btn.classList.remove('bg-white', 'text-bae-ink');
            btn.classList.add('bg-bae-primary', 'text-white');
          } else {
            btn.classList.remove('bg-bae-primary', 'text-white');
            btn.classList.add('bg-white', 'text-bae-ink');
          }
        });

        $('zscore-inputs').classList.toggle('hidden', mode !== 'zscore');
        $('tscore-inputs').classList.toggle('hidden', mode !== 'tscore');
        $('chisquare-inputs').classList.toggle('hidden', mode !== 'chisquare');
        $('fratio-inputs').classList.toggle('hidden', mode !== 'fratio');

        // Tail toggle visibility
        const tailWrapper = $('tail-wrapper');
        if (mode === 'chisquare' || mode === 'fratio') {
          tailWrapper.classList.add('hidden');
          currentTail = 'right';
        } else {
          tailWrapper.classList.remove('hidden');
        }
      }

      function updateTail(tail) {
        currentTail = tail;
        document.querySelectorAll('.tail-tab').forEach(btn => {
          if (btn.dataset.tail === tail) {
            btn.classList.remove('bg-white', 'text-bae-ink');
            btn.classList.add('bg-bae-primary', 'text-white');
          } else {
            btn.classList.remove('bg-bae-primary', 'text-white');
            btn.classList.add('bg-white', 'text-bae-ink');
          }
        });
        const hints = {
          two: 'Two-tailed tests for a difference in either direction.',
          left: 'Left-tailed tests if the alternative hypothesis is "less than".',
          right: 'Right-tailed tests if the alternative hypothesis is "greater than".',
        };
        $('tail-hint').textContent = hints[tail];
      }

      function updateAlpha(alphaVal) {
        isCustomAlpha = alphaVal === 'custom';
        document.querySelectorAll('.alpha-btn').forEach(btn => {
          if (btn.dataset.alpha === alphaVal) {
            btn.classList.remove('bg-white', 'text-bae-ink');
            btn.classList.add('bg-bae-primary', 'text-white');
          } else {
            btn.classList.remove('bg-bae-primary', 'text-white');
            btn.classList.add('bg-white', 'text-bae-ink');
          }
        });
        if (alphaVal === 'off') {
          $('custom-alpha-wrapper').classList.add('hidden');
          currentAlpha = null;
        } else if (isCustomAlpha) {
          $('custom-alpha-wrapper').classList.remove('hidden');
          currentAlpha = parseFloat($('input-custom-alpha').value) || 0.05;
        } else {
          $('custom-alpha-wrapper').classList.add('hidden');
          currentAlpha = parseFloat(alphaVal);
        }
      }

      document.querySelectorAll('.mode-tab').forEach(btn => {
        btn.addEventListener('click', () => updateMode(btn.dataset.mode));
      });
      document.querySelectorAll('.tail-tab').forEach(btn => {
        btn.addEventListener('click', () => updateTail(btn.dataset.tail));
      });
      document.querySelectorAll('.alpha-btn').forEach(btn => {
        btn.addEventListener('click', () => { updateAlpha(btn.dataset.alpha); if ($('result-card').style.display !== 'none') calculate(); });
      });
      $('input-custom-alpha').addEventListener('input', (e) => {
        currentAlpha = parseFloat(e.target.value) || 0.05;
        if ($('result-card').style.display !== 'none') calculate();
      });

      // ── Calculate ──
      function formatP(p) {
        if (p < 0.0001) return '< 0.0001';
        return p.toFixed(4);
      }

      function getSignificanceText(p, alpha) {
        // APA convention: reject the null when p ≤ α (matches FAQ #10 and the worked examples)
        if (p <= alpha) {
          return { text: 'Significant', color: 'text-green-600', verdict: 'significant' };
        }
        return { text: 'Not Significant', color: 'text-bae-muted', verdict: 'not significant' };
      }

      function calculate() {
        const sigOff = (currentAlpha === null);
        const alpha = sigOff ? null : Math.min(Math.max(currentAlpha, 0.0001), 0.5);
        let stat, pValue, pLeft, pRight, pTwo, cdf, steps = [], interpretation = '', warning = '';

        if (currentMode === 'zscore') {
          const z = parseFloat($('input-z').value);
          if (isNaN(z)) { showEmpty(); return; }
          stat = z;
          cdf = normalCDF(z);
          pLeft = cdf;
          pRight = 1 - cdf;
          pTwo = 2 * Math.min(pLeft, pRight);

          steps.push(`Distribution: Standard normal (z)`);
          steps.push(`Test statistic: z = ${z.toFixed(4)}`);
          steps.push(`Φ(z) = ${cdf.toFixed(4)}`);

          if (currentTail === 'two') {
            pValue = pTwo;
            steps.push(`Two-tailed p = 2 × min(Φ(z), 1 − Φ(z)) = 2 × ${Math.min(pLeft, pRight).toFixed(4)} = ${pTwo.toFixed(4)}`);
          } else if (currentTail === 'left') {
            pValue = pLeft;
            steps.push(`Left-tailed p = Φ(z) = ${pLeft.toFixed(4)}`);
          } else {
            pValue = pRight;
            steps.push(`Right-tailed p = 1 − Φ(z) = ${pRight.toFixed(4)}`);
          }
        } else if (currentMode === 'tscore') {
          const t = parseFloat($('input-t').value);
          const df = parseFloat($('input-df-t').value);
          if (isNaN(t) || isNaN(df) || df <= 0) { showEmpty(); return; }
          stat = t;
          cdf = tCDF(t, df);
          pLeft = cdf;
          pRight = 1 - cdf;
          pTwo = 2 * Math.min(pLeft, pRight);

          steps.push(`Distribution: Student's t with df = ${df.toFixed(2)}`);
          steps.push(`Test statistic: t = ${t.toFixed(4)}`);
          steps.push(`F_t(t, df) = ${cdf.toFixed(4)}`);

          if (currentTail === 'two') {
            pValue = pTwo;
            steps.push(`Two-tailed p = 2 × min(F_t(t), 1 − F_t(t)) = 2 × ${Math.min(pLeft, pRight).toFixed(4)} = ${pTwo.toFixed(4)}`);
          } else if (currentTail === 'left') {
            pValue = pLeft;
            steps.push(`Left-tailed p = F_t(t, df) = ${pLeft.toFixed(4)}`);
          } else {
            pValue = pRight;
            steps.push(`Right-tailed p = 1 − F_t(t, df) = ${pRight.toFixed(4)}`);
          }
        } else if (currentMode === 'chisquare') {
          const chi = parseFloat($('input-chi').value);
          const df = parseFloat($('input-df-chi').value);
          if (isNaN(chi) || isNaN(df) || chi < 0 || df <= 0) { showEmpty(); return; }
          stat = chi;
          cdf = chiSquareCDF(chi, df);
          pValue = 1 - cdf;
          pLeft = null;
          pRight = pValue;
          pTwo = null;
          currentTail = 'right';

          steps.push(`Distribution: Chi-square with df = ${df.toFixed(0)}`);
          steps.push(`Test statistic: χ² = ${chi.toFixed(4)}`);
          steps.push(`F_χ²(χ², df) = ${cdf.toFixed(4)}`);
          steps.push(`p = 1 − F_χ² = ${pValue.toFixed(4)}`);

          if (chi < df * 0.5) {
            warning = 'The chi-square value is relatively small compared to the degrees of freedom. Ensure the correct statistic was entered.';
          }
        } else if (currentMode === 'fratio') {
          const f = parseFloat($('input-f').value);
          const df1 = parseFloat($('input-df1').value);
          const df2 = parseFloat($('input-df2').value);
          if (isNaN(f) || isNaN(df1) || isNaN(df2) || f < 0 || df1 <= 0 || df2 <= 0) { showEmpty(); return; }
          stat = f;
          cdf = fCDF(f, df1, df2);
          pValue = 1 - cdf;
          pLeft = null;
          pRight = pValue;
          pTwo = null;
          currentTail = 'right';

          steps.push(`Distribution: F with df₁ = ${df1.toFixed(0)}, df₂ = ${df2.toFixed(0)}`);
          steps.push(`Test statistic: F = ${f.toFixed(4)}`);
          steps.push(`F_F(F, df₁, df₂) = ${cdf.toFixed(4)}`);
          steps.push(`p = 1 − F_F = ${pValue.toFixed(4)}`);
        }

        // A p-value is a probability — guard against tiny floating-point excursions outside [0, 1]
        pValue = Math.min(1, Math.max(0, pValue));

        // Interpretation
        const pFormatted = formatP(pValue);
        const tailName = currentTail === 'two' ? 'two-tailed' : currentTail === 'left' ? 'left-tailed' : 'right-tailed';
        let sig;
        if (sigOff) {
          sig = { text: '—', color: 'text-bae-muted', verdict: 'not assessed' };
          interpretation = `The ${tailName} p-value is ${pFormatted}. No significance level (α) was selected, so no significant / not-significant verdict is shown. Select an α to compare this p-value against a threshold.`;
        } else {
          sig = getSignificanceText(pValue, alpha);
          const alphaPct = (alpha * 100).toFixed(1).replace(/\.0$/, '');
          if (pValue <= alpha) {
            interpretation = `With a p-value of ${pFormatted}, the result is statistically ${sig.verdict} at the ${alphaPct}% level (${tailName}). There is sufficient evidence to reject the null hypothesis.`;
          } else {
            interpretation = `With a p-value of ${pFormatted}, the result is ${sig.verdict} at the ${alphaPct}% level (${tailName}). There is insufficient evidence to reject the null hypothesis.`;
          }
          if (Math.abs(pValue - alpha) < 0.001) {
            interpretation += ' This is a borderline result. Replication is advisable.';
          }
        }

        // Show results
        $('empty-state').style.display = 'none';
        $('result-card').style.display = 'block';
        $('dist-card').style.display = 'block';
        $('steps-card').style.display = 'block';
        $('pdf-btn').classList.remove('hidden');

        $('result-pvalue').textContent = pFormatted;
        const sigEl = $('result-significance');
        sigEl.textContent = sig.text;
        sigEl.className = 'text-lg font-bold ' + sig.color;

        const extraGrid = $('extra-pvalues');
        if (currentMode === 'zscore' || currentMode === 'tscore') {
          extraGrid.style.display = 'grid';
          $('result-left').textContent = formatP(pLeft);
          $('result-right').textContent = formatP(pRight);
        } else {
          extraGrid.style.display = 'none';
        }

        $('result-interpretation').textContent = interpretation;

        const warnEl = $('validation-warning');
        if (warning) {
          warnEl.classList.remove('hidden');
          warnEl.querySelector('p').textContent = warning;
        } else {
          warnEl.classList.add('hidden');
        }

        $('steps-content').innerHTML = steps.map(s => '<p class="font-mono text-xs bg-white border border-bae-border rounded-bae-sm px-3 py-2">' + s + '</p>').join('');

        // Draw distribution
        const canvas = $('dist-canvas');
        canvas.width = canvas.offsetWidth * 2;
        canvas.height = 220 * 2;
        const dfChiVal = parseFloat($('input-df-chi').value);
        const dfTVal = parseFloat($('input-df-t').value);
        const df1Val = parseFloat($('input-df1').value);
        const df2Val = parseFloat($('input-df2').value);
        const criticals = sigOff ? [] : getCriticals(currentMode, currentTail, alpha, currentMode === 'tscore' ? dfTVal : dfChiVal, df1Val, df2Val);
        if (currentMode === 'zscore' || currentMode === 'tscore') {
          drawBellCurve(canvas, stat, currentTail, criticals);
        } else {
          drawRightSkewCurve(canvas, stat, currentMode, dfChiVal, df1Val, df2Val, criticals);
        }

        // PDF report
        $('report-pvalue').textContent = pFormatted;
        $('report-significance').textContent = sig.text;
        $('report-significance').className = 'text-xl font-bold ' + sig.color;
        $('report-stat').textContent = currentMode === 'zscore' ? 'z = ' + stat.toFixed(4) : currentMode === 'tscore' ? 't = ' + stat.toFixed(4) : currentMode === 'chisquare' ? 'χ² = ' + stat.toFixed(4) : 'F = ' + stat.toFixed(4);
        $('report-alpha').textContent = sigOff ? 'Not set' : alpha.toFixed(4);
        $('report-tail').textContent = currentTail === 'two' ? 'Two-Tailed' : currentTail === 'left' ? 'Left-Tailed' : 'Right-Tailed';
        $('report-interpretation').textContent = interpretation;
        $('report-details').innerHTML = steps.map(s => '<p>' + s + '</p>').join('');
        $('report-dist').src = canvas.toDataURL('image/png');
        $('report-dist-wrapper').style.display = 'block';

        updateURL();
      }

      function showEmpty() {
        $('empty-state').style.display = 'block';
        $('result-card').style.display = 'none';
        $('dist-card').style.display = 'none';
        $('steps-card').style.display = 'none';
        $('pdf-btn').classList.add('hidden');
      }

      $('calc-btn').addEventListener('click', calculate);
      $('clear-btn').addEventListener('click', () => {
        $('input-z').value = '';
        $('input-t').value = '';
        $('input-df-t').value = '';
        $('input-chi').value = '';
        $('input-df-chi').value = '';
        $('input-f').value = '';
        $('input-df1').value = '';
        $('input-df2').value = '';
        $('input-custom-alpha').value = '';
        updateAlpha('0.05');
        showEmpty();
      });

      // Toggle steps
      $('toggle-steps').addEventListener('click', () => {
        stepsVisible = !stepsVisible;
        $('steps-content').style.display = stepsVisible ? 'block' : 'none';
        $('toggle-steps').textContent = stepsVisible ? 'Hide' : 'Show';
      });

      // PDF generation
      $('pdf-btn').addEventListener('click', async () => {
        if (typeof html2pdf === 'undefined') return;
        const btn = $('pdf-btn');
        const originalText = btn.textContent;
        btn.textContent = 'Generating...';
        btn.disabled = true;

        const wrapper = document.createElement('div');
        wrapper.style.width = '210mm';
        wrapper.style.boxSizing = 'border-box';
        wrapper.style.margin = '0';

        const report = $('print-report').cloneNode(true);
        report.removeAttribute('id');
        report.classList.remove('hidden');
        wrapper.appendChild(report);
        document.body.appendChild(wrapper);

        try {
          await html2pdf().set({
            margin: [8, 8, 8, 8],
            filename: 'p-value-report.pdf',
            image: { type: 'jpeg', quality: 0.95 },
            html2canvas: { scale: 2, useCORS: true, logging: false, scrollX: 0, scrollY: 0 },
            pagebreak: { mode: ['css', 'legacy'], avoid: 'p, li, div, h1, h2, h3, h4, h5, h6, ul, tr, td, table' },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
          }).from(wrapper).save();
        } catch (err) {
          console.error(err);
        } finally {
          if (wrapper.parentNode) document.body.removeChild(wrapper);
          btn.textContent = originalText;
          btn.disabled = false;
        }
      });

      // URL sharing
      function updateURL() {
        const url = new URL(window.location.href);
        url.searchParams.set('mode', currentMode);
        url.searchParams.set('tail', currentTail);
        url.searchParams.set('alpha', currentAlpha === null ? 'off' : currentAlpha);
        if (currentMode === 'zscore') {
          if ($('input-z').value) url.searchParams.set('z', $('input-z').value);
          else url.searchParams.delete('z');
        } else if (currentMode === 'tscore') {
          if ($('input-t').value) url.searchParams.set('t', $('input-t').value);
          else url.searchParams.delete('t');
          if ($('input-df-t').value) url.searchParams.set('df', $('input-df-t').value);
          else url.searchParams.delete('df');
        } else if (currentMode === 'chisquare') {
          if ($('input-chi').value) url.searchParams.set('chi', $('input-chi').value);
          else url.searchParams.delete('chi');
          if ($('input-df-chi').value) url.searchParams.set('df', $('input-df-chi').value);
          else url.searchParams.delete('df');
        } else if (currentMode === 'fratio') {
          if ($('input-f').value) url.searchParams.set('f', $('input-f').value);
          else url.searchParams.delete('f');
          if ($('input-df1').value) url.searchParams.set('df1', $('input-df1').value);
          else url.searchParams.delete('df1');
          if ($('input-df2').value) url.searchParams.set('df2', $('input-df2').value);
          else url.searchParams.delete('df2');
        }
        window.history.replaceState({}, '', url);
      }

      function readURL() {
        const url = new URL(window.location.href);
        const mode = url.searchParams.get('mode');
        if (mode && ['zscore', 'tscore', 'chisquare', 'fratio'].includes(mode)) {
          updateMode(mode);
        }
        const tail = url.searchParams.get('tail');
        if (tail && ['two', 'left', 'right'].includes(tail)) {
          updateTail(tail);
        }
        const alpha = url.searchParams.get('alpha');
        if (alpha === 'off') {
          updateAlpha('off');
        } else if (alpha) {
          const a = parseFloat(alpha);
          if ([0.10, 0.05, 0.01, 0.001].includes(a)) {
            updateAlpha(a.toString());
          } else {
            updateAlpha('custom');
            $('input-custom-alpha').value = a;
            currentAlpha = a;
          }
        }
        if (mode === 'zscore' && url.searchParams.has('z')) $('input-z').value = url.searchParams.get('z');
        if (mode === 'tscore') {
          if (url.searchParams.has('t')) $('input-t').value = url.searchParams.get('t');
          if (url.searchParams.has('df')) $('input-df-t').value = url.searchParams.get('df');
        }
        if (mode === 'chisquare') {
          if (url.searchParams.has('chi')) $('input-chi').value = url.searchParams.get('chi');
          if (url.searchParams.has('df')) $('input-df-chi').value = url.searchParams.get('df');
        }
        if (mode === 'fratio') {
          if (url.searchParams.has('f')) $('input-f').value = url.searchParams.get('f');
          if (url.searchParams.has('df1')) $('input-df1').value = url.searchParams.get('df1');
          if (url.searchParams.has('df2')) $('input-df2').value = url.searchParams.get('df2');
        }
        if ($('input-z').value || $('input-t').value || $('input-chi').value || $('input-f').value) {
          calculate();
        }
      }

      readURL();
    })();
  </script>
</BaseLayout>
