  <script src="/html2pdf.bundle.min.js" is:inline></script>
  <script is:inline>
    (function() {
      const $ = (id) => document.getElementById(id);
      let currentMode = 'onesample';
      let currentVar = 'welch';
      let currentTail = 'two';
      let currentAlpha = 0.05;
      let isCustomAlpha = false;
      let stepsVisible = true;

      const FPMIN = 1e-30;

      // ── Lanczos lgamma ──
      function lgamma(z) {
        const g = 7;
        const C = [0.99999999999980993, 676.5203681218851, -1259.1392167224028,
                   771.32342877765313, -176.61502916214059, 12.507343278686905,
                   -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7];
        if (z < 0.5) return Math.log(Math.PI) - Math.log(Math.sin(Math.PI * z)) - lgamma(1 - z);
        z -= 1;
        let x = C[0];
        for (let i = 1; i < g + 2; i++) x += C[i] / (z + i);
        const t = z + g + 0.5;
        return 0.5 * Math.log(2 * Math.PI) + (z + 0.5) * Math.log(t) - t + Math.log(x);
      }

      // ── Incomplete Beta Continued Fraction ──
      function betacf(x, a, b) {
        const MAXIT = 200;
        const EPS = 3.0e-7;
        let m2, aa, c, d, del, h;
        const qab = a + b;
        const qap = a + 1;
        const qam = a - 1;
        c = 1;
        d = 1 - qab * x / qap;
        if (Math.abs(d) < FPMIN) d = FPMIN;
        d = 1 / d;
        h = d;
        for (let m = 1; m <= MAXIT; m++) {
          m2 = 2 * m;
          aa = m * (b - m) * x / ((qam + m2) * (a + m2));
          d = 1 + aa * d;
          if (Math.abs(d) < FPMIN) d = FPMIN;
          c = 1 + aa / c;
          if (Math.abs(c) < FPMIN) c = FPMIN;
          d = 1 / d;
          del = d * c;
          h *= del;
          aa = -(a + m) * (qab + m) * x / ((a + m2) * (qap + m2));
          d = 1 + aa * d;
          if (Math.abs(d) < FPMIN) d = FPMIN;
          c = 1 + aa / c;
          if (Math.abs(c) < FPMIN) c = FPMIN;
          d = 1 / d;
          del = d * c;
          h *= del;
          if (Math.abs(del - 1) < EPS) break;
        }
        return h;
      }

      function incompleteBeta(x, a, b) {
        if (x === 0 || x === 1) return x;
        if (a <= 0 || b <= 0) return NaN;
        const lnbeta = lgamma(a) + lgamma(b) - lgamma(a + b);
        const bt = Math.exp(a * Math.log(x) + b * Math.log(1 - x) - lnbeta);
        if (x < (a + 1) / (a + b + 2)) {
          return bt * betacf(x, a, b) / a;
        } else {
          return 1 - bt * betacf(1 - x, b, a) / b;
        }
      }

      // ── t-distribution CDF ──
      function tCDF(t, df) {
        if (df > 100) {
          const b1 = 0.319381530, b2 = -0.356563782, b3 = 1.781477937;
          const b4 = -1.821255978, b5 = 1.330274429, p = 0.2316419, c = 0.39894228;
          const z = t;
          let cdf;
          if (z >= 0) {
            const tt = 1.0 / (1.0 + p * z);
            cdf = 1.0 - c * Math.exp(-z * z / 2.0) * tt * (tt * (tt * (tt * (tt * b5 + b4) + b3) + b2) + b1);
          } else {
            cdf = 1.0 - tCDF(-z, df);
          }
          return cdf;
        }
        const x = df / (df + t * t);
        const ib = incompleteBeta(x, df / 2, 0.5);
        if (t >= 0) return 1 - 0.5 * ib;
        return 0.5 * ib;
      }

      // ── t-distribution PDF ──
      function tPDF(x, df) {
        const halfDf = df / 2;
        const halfDf1 = (df + 1) / 2;
        return Math.exp(lgamma(halfDf1) - lgamma(halfDf) - 0.5 * Math.log(df * Math.PI) - halfDf1 * Math.log(1 + x * x / df));
      }

      // ── Critical value finder: inverts the t-CDF by bisection ──
      function findCritical(cdfFn, targetP, lo, hi) {
        for (let i = 0; i < 100; i++) {
          const mid = (lo + hi) / 2;
          if (cdfFn(mid) < targetP) lo = mid; else hi = mid;
        }
        return (lo + hi) / 2;
      }

      // Returns the critical t-position(s) for the current tail and alpha
      function getTCriticals(tail, alpha, df) {
        const f = (x) => tCDF(x, df);
        if (tail === 'two') { const m = findCritical(f, 1 - alpha / 2, 0, 1e6); return [-m, m]; }
        const m = findCritical(f, 1 - alpha, 0, 1e6);
        return tail === 'left' ? [-m] : [m];
      }

      // ── Drawing ──
      function drawTDistribution(canvas, tStat, df, tail, criticals) {
        const ctx = canvas.getContext('2d');
        const w = canvas.width, h = canvas.height;
        const padL = 45, padR = 15, padT = 15, padB = 30;
        const graphW = w - padL - padR, graphH = h - padT - padB;
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, w, h);

        const xMax = Math.max(4, 3 + 10 / df);
        const xMin = -xMax;
        let yMax = 0;
        const step = 0.02;
        for (let x = xMin; x <= xMax; x += step) {
          yMax = Math.max(yMax, tPDF(x, df));
        }
        if (yMax === 0) yMax = 0.1;

        const scaleX = graphW / (xMax - xMin);
        const scaleY = graphH / (yMax * 1.15);

        function toCanvasX(x) { return padL + (x - xMin) * scaleX; }
        function toCanvasY(y) { return padT + graphH - y * scaleY; }

        // Shaded area
        ctx.fillStyle = 'rgba(59, 130, 246, 0.15)';
        let first;

        if (tail === 'two') {
          const absStat = Math.abs(tStat);
          first = true;
          ctx.beginPath();
          for (let x = xMin; x <= -absStat; x += step) {
            const px = toCanvasX(x), py = toCanvasY(tPDF(x, df));
            if (first) { ctx.moveTo(px, toCanvasY(0)); ctx.lineTo(px, py); first = false; }
            else ctx.lineTo(px, py);
          }
          if (!first) { ctx.lineTo(toCanvasX(-absStat), toCanvasY(0)); ctx.closePath(); ctx.fill(); }

          first = true;
          ctx.beginPath();
          for (let x = absStat; x <= xMax; x += step) {
            const px = toCanvasX(x), py = toCanvasY(tPDF(x, df));
            if (first) { ctx.moveTo(px, toCanvasY(0)); ctx.lineTo(px, py); first = false; }
            else ctx.lineTo(px, py);
          }
          if (!first) { ctx.lineTo(toCanvasX(xMax), toCanvasY(0)); ctx.closePath(); ctx.fill(); }
        } else if (tail === 'left') {
          first = true;
          ctx.beginPath();
          for (let x = xMin; x <= Math.min(tStat, xMax); x += step) {
            const px = toCanvasX(x), py = toCanvasY(tPDF(x, df));
            if (first) { ctx.moveTo(px, toCanvasY(0)); ctx.lineTo(px, py); first = false; }
            else ctx.lineTo(px, py);
          }
          if (!first) { ctx.lineTo(toCanvasX(Math.min(tStat, xMax)), toCanvasY(0)); ctx.closePath(); ctx.fill(); }
        } else if (tail === 'right') {
          first = true;
          ctx.beginPath();
          for (let x = Math.max(tStat, xMin); x <= xMax; x += step) {
            const px = toCanvasX(x), py = toCanvasY(tPDF(x, df));
            if (first) { ctx.moveTo(px, toCanvasY(0)); ctx.lineTo(px, py); first = false; }
            else ctx.lineTo(px, py);
          }
          if (!first) { ctx.lineTo(toCanvasX(xMax), toCanvasY(0)); ctx.closePath(); ctx.fill(); }
        }

        // Grid lines
        ctx.strokeStyle = '#e5e7eb';
        ctx.lineWidth = 1;
        for (let x = -3; x <= 3; x++) {
          const cx = toCanvasX(x);
          ctx.beginPath(); ctx.moveTo(cx, padT); ctx.lineTo(cx, h - padB); ctx.stroke();
        }

        // X-axis
        ctx.strokeStyle = '#9ca3af';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(padL, toCanvasY(0));
        ctx.lineTo(w - padR, toCanvasY(0));
        ctx.stroke();

        // X-axis labels
        ctx.fillStyle = '#6b7280';
        ctx.font = '11px sans-serif';
        ctx.textAlign = 'center';
        const labelStep = Math.max(1, Math.ceil(xMax / 3));
        for (let x = -labelStep; x <= labelStep; x++) {
          if (x === 0) continue;
          ctx.fillText(x.toString(), toCanvasX(x), h - 10);
        }
        ctx.fillText('0', toCanvasX(0), h - 10);

        // Curve
        ctx.strokeStyle = '#2563eb';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        first = true;
        for (let x = xMin; x <= xMax; x += step) {
          const px = toCanvasX(x), py = toCanvasY(tPDF(x, df));
          if (first) { ctx.moveTo(px, py); first = false; }
          else ctx.lineTo(px, py);
        }
        ctx.stroke();

        // Statistic line
        if (!isNaN(tStat) && tStat >= xMin && tStat <= xMax) {
          const sx = toCanvasX(tStat);
          ctx.strokeStyle = '#dc2626';
          ctx.lineWidth = 1.5;
          ctx.setLineDash([4, 3]);
          ctx.beginPath();
          ctx.moveTo(sx, padT);
          ctx.lineTo(sx, toCanvasY(0));
          ctx.stroke();
          ctx.setLineDash([]);

          ctx.fillStyle = '#dc2626';
          ctx.font = 'bold 11px sans-serif';
          ctx.textAlign = 'center';
          const label = 't = ' + tStat.toFixed(2);
          ctx.fillText(label, sx, padT + 12);
        }

        // Critical value line(s) at the chosen alpha
        if (Array.isArray(criticals)) {
          criticals.forEach(cv => {
            if (cv >= xMin && cv <= xMax) {
              const cx = toCanvasX(cv);
              ctx.strokeStyle = '#f59e0b';
              ctx.lineWidth = 1.5;
              ctx.setLineDash([2, 2]);
              ctx.beginPath();
              ctx.moveTo(cx, padT);
              ctx.lineTo(cx, toCanvasY(0));
              ctx.stroke();
              ctx.setLineDash([]);
              ctx.fillStyle = '#f59e0b';
              ctx.font = 'bold 10px sans-serif';
              ctx.textAlign = 'center';
              ctx.fillText('crit', cx, padT + 24);
            }
          });
        }
      }

      // ── Mode / Variance / Tail / Alpha Switching ──
      function updateMode(mode) {
        currentMode = mode;
        document.querySelectorAll('.mode-tab').forEach(btn => {
          if (btn.dataset.mode === mode) {
            btn.classList.remove('bg-white', 'text-bae-ink');
            btn.classList.add('bg-bae-primary', 'text-white');
          } else {
            btn.classList.remove('bg-bae-primary', 'text-white');
            btn.classList.add('bg-white', 'text-bae-ink');
          }
        });

        $('onesample-inputs').classList.toggle('hidden', mode !== 'onesample');
        $('independent-inputs').classList.toggle('hidden', mode !== 'independent');
        $('paired-inputs').classList.toggle('hidden', mode !== 'paired');

        const varWrapper = $('variance-wrapper');
        if (mode === 'independent') {
          varWrapper.classList.remove('hidden');
        } else {
          varWrapper.classList.add('hidden');
        }

        const hints = {
          onesample: 'Compare a sample mean to a known or hypothesised value.',
          independent: 'Compare the means of two separate, unrelated groups.',
          paired: 'Compare measurements from the same subjects at two different times.',
        };
        $('mode-hint').textContent = hints[mode];
      }

      function updateVar(varType) {
        currentVar = varType;
        document.querySelectorAll('.var-tab').forEach(btn => {
          if (btn.dataset.var === varType) {
            btn.classList.remove('bg-white', 'text-bae-ink');
            btn.classList.add('bg-bae-primary', 'text-white');
          } else {
            btn.classList.remove('bg-bae-primary', 'text-white');
            btn.classList.add('bg-white', 'text-bae-ink');
          }
        });
        const hints = {
          welch: "Welch's correction is recommended when variances may differ or sample sizes are unequal.",
          student: "Student's pooled method assumes equal population variances.",
        };
        $('var-hint').textContent = hints[varType];
      }

      function updateTail(tail) {
        currentTail = tail;
        document.querySelectorAll('.tail-tab').forEach(btn => {
          if (btn.dataset.tail === tail) {
            btn.classList.remove('bg-white', 'text-bae-ink');
            btn.classList.add('bg-bae-primary', 'text-white');
          } else {
            btn.classList.remove('bg-bae-primary', 'text-white');
            btn.classList.add('bg-white', 'text-bae-ink');
          }
        });
        const hints = {
          two: 'Two-tailed tests for a difference in either direction.',
          left: 'Left-tailed tests if the alternative hypothesis is "less than".',
          right: 'Right-tailed tests if the alternative hypothesis is "greater than".',
        };
        $('tail-hint').textContent = hints[tail];
      }

      function updateAlpha(alphaVal) {
        isCustomAlpha = alphaVal === 'custom';
        document.querySelectorAll('.alpha-btn').forEach(btn => {
          if (btn.dataset.alpha === alphaVal) {
            btn.classList.remove('bg-white', 'text-bae-ink');
            btn.classList.add('bg-bae-primary', 'text-white');
          } else {
            btn.classList.remove('bg-bae-primary', 'text-white');
            btn.classList.add('bg-white', 'text-bae-ink');
          }
        });
        if (alphaVal === 'off') {
          $('custom-alpha-wrapper').classList.add('hidden');
          currentAlpha = null;
        } else if (isCustomAlpha) {
          $('custom-alpha-wrapper').classList.remove('hidden');
          currentAlpha = parseFloat($('input-custom-alpha').value) || 0.05;
        } else {
          $('custom-alpha-wrapper').classList.add('hidden');
          currentAlpha = parseFloat(alphaVal);
        }
      }

      document.querySelectorAll('.mode-tab').forEach(btn => {
        btn.addEventListener('click', () => updateMode(btn.dataset.mode));
      });
      document.querySelectorAll('.var-tab').forEach(btn => {
        btn.addEventListener('click', () => updateVar(btn.dataset.var));
      });
      document.querySelectorAll('.tail-tab').forEach(btn => {
        btn.addEventListener('click', () => updateTail(btn.dataset.tail));
      });
      document.querySelectorAll('.alpha-btn').forEach(btn => {
        btn.addEventListener('click', () => { updateAlpha(btn.dataset.alpha); if ($('result-card').style.display !== 'none') calculate(); });
      });
      $('input-custom-alpha').addEventListener('input', (e) => {
        currentAlpha = parseFloat(e.target.value) || 0.05;
        if ($('result-card').style.display !== 'none') calculate();
      });

      // ── Calculate ──
      function formatP(p) {
        if (p < 0.0001) return '< 0.0001';
        return p.toFixed(4);
      }

      function getSignificanceText(p, alpha) {
        // Standard convention: reject the null when p ≤ α (consistent across the Statistics Suite)
        if (p <= alpha) {
          return { text: 'Significant', color: 'text-green-600', verdict: 'significant' };
        }
        return { text: 'Not Significant', color: 'text-bae-muted', verdict: 'not significant' };
      }

      function cohenInterpretation(d) {
        const absD = Math.abs(d);
        if (absD < 0.2) return 'negligible effect';
        if (absD < 0.5) return 'small effect';
        if (absD < 0.8) return 'medium effect';
        return 'large effect';
      }

      function calculate() {
        const sigOff = (currentAlpha === null);
        const alpha = sigOff ? null : Math.min(Math.max(currentAlpha, 0.0001), 0.5);
        let tStat, df, pValue, cohenD, stepsArr = [], interpretation = '', warning = '';

        if (currentMode === 'onesample') {
          const mean = parseFloat($('input-os-mean').value);
          const mu0 = parseFloat($('input-os-mu0').value);
          const sd = parseFloat($('input-os-sd').value);
          const n = parseFloat($('input-os-n').value);
          if (isNaN(mean) || isNaN(mu0) || isNaN(sd) || isNaN(n) || sd <= 0 || n < 2) { showEmpty(); return; }

          const se = sd / Math.sqrt(n);
          tStat = (mean - mu0) / se;
          df = n - 1;
          cohenD = (mean - mu0) / sd;

          stepsArr.push(`Formula: t = (x̄ − μ₀) / (s / √n)`);
          stepsArr.push(`x̄ = ${mean.toFixed(4)}, μ₀ = ${mu0.toFixed(4)}, s = ${sd.toFixed(4)}, n = ${n.toFixed(0)}`);
          stepsArr.push(`SE = ${sd.toFixed(4)} / √${n.toFixed(0)} = ${se.toFixed(4)}`);
          stepsArr.push(`t = (${mean.toFixed(4)} − ${mu0.toFixed(4)}) / ${se.toFixed(4)} = ${tStat.toFixed(4)}`);
          stepsArr.push(`df = n − 1 = ${df.toFixed(0)}`);
          stepsArr.push(`Cohen's d = (x̄ − μ₀) / s = ${cohenD.toFixed(4)} (${cohenInterpretation(cohenD)})`);

          if (n < 10) {
            warning = 'Sample size is very small (n < 10). The t-test assumes approximately normal data, which matters most with small samples. Consider a non-parametric alternative if normality is in doubt.';
          }
        } else if (currentMode === 'independent') {
          const m1 = parseFloat($('input-ind-m1').value);
          const m2 = parseFloat($('input-ind-m2').value);
          const s1 = parseFloat($('input-ind-s1').value);
          const s2 = parseFloat($('input-ind-s2').value);
          const n1 = parseFloat($('input-ind-n1').value);
          const n2 = parseFloat($('input-ind-n2').value);
          if (isNaN(m1) || isNaN(m2) || isNaN(s1) || isNaN(s2) || isNaN(n1) || isNaN(n2) || s1 <= 0 || s2 <= 0 || n1 < 2 || n2 < 2) { showEmpty(); return; }

          if (currentVar === 'student') {
            const pooledVar = ((n1 - 1) * s1 * s1 + (n2 - 1) * s2 * s2) / (n1 + n2 - 2);
            const se = Math.sqrt(pooledVar * (1 / n1 + 1 / n2));
            tStat = (m1 - m2) / se;
            df = n1 + n2 - 2;
            cohenD = (m1 - m2) / Math.sqrt(pooledVar);

            stepsArr.push(`Method: Student's t-test (pooled variance, equal variances assumed)`);
            stepsArr.push(`x̄₁ = ${m1.toFixed(4)}, x̄₂ = ${m2.toFixed(4)}, s₁ = ${s1.toFixed(4)}, s₂ = ${s2.toFixed(4)}, n₁ = ${n1.toFixed(0)}, n₂ = ${n2.toFixed(0)}`);
            stepsArr.push(`s_p² = [(${n1.toFixed(0)}−1)×${(s1*s1).toFixed(4)} + (${n2.toFixed(0)}−1)×${(s2*s2).toFixed(4)}] / (${n1.toFixed(0)}+${n2.toFixed(0)}−2) = ${pooledVar.toFixed(4)}`);
            stepsArr.push(`SE = √(${pooledVar.toFixed(4)} × (1/${n1.toFixed(0)} + 1/${n2.toFixed(0)})) = ${se.toFixed(4)}`);
            stepsArr.push(`t = (${m1.toFixed(4)} − ${m2.toFixed(4)}) / ${se.toFixed(4)} = ${tStat.toFixed(4)}`);
            stepsArr.push(`df = n₁ + n₂ − 2 = ${df.toFixed(0)}`);
            stepsArr.push(`Cohen's d = (x̄₁ − x̄₂) / s_p = ${cohenD.toFixed(4)} (${cohenInterpretation(cohenD)})`);
          } else {
            const se = Math.sqrt(s1 * s1 / n1 + s2 * s2 / n2);
            tStat = (m1 - m2) / se;
            const num = (s1 * s1 / n1 + s2 * s2 / n2) * (s1 * s1 / n1 + s2 * s2 / n2);
            const den = (s1 * s1 / n1) * (s1 * s1 / n1) / (n1 - 1) + (s2 * s2 / n2) * (s2 * s2 / n2) / (n2 - 1);
            df = num / den;
            cohenD = (m1 - m2) / Math.sqrt((s1 * s1 + s2 * s2) / 2);

            stepsArr.push(`Method: Welch's t-test (unequal variances, recommended default)`);
            stepsArr.push(`x̄₁ = ${m1.toFixed(4)}, x̄₂ = ${m2.toFixed(4)}, s₁ = ${s1.toFixed(4)}, s₂ = ${s2.toFixed(4)}, n₁ = ${n1.toFixed(0)}, n₂ = ${n2.toFixed(0)}`);
            stepsArr.push(`SE = √(${s1.toFixed(4)}²/${n1.toFixed(0)} + ${s2.toFixed(4)}²/${n2.toFixed(0)}) = ${se.toFixed(4)}`);
            stepsArr.push(`t = (${m1.toFixed(4)} − ${m2.toFixed(4)}) / ${se.toFixed(4)} = ${tStat.toFixed(4)}`);
            stepsArr.push(`df (Welch-Satterthwaite) = ${df.toFixed(2)}`);
            stepsArr.push(`Cohen's d = ${cohenD.toFixed(4)} (${cohenInterpretation(cohenD)})`);
          }
        } else if (currentMode === 'paired') {
          const meanDiff = parseFloat($('input-pd-mean').value);
          const sdDiff = parseFloat($('input-pd-sd').value);
          const n = parseFloat($('input-pd-n').value);
          if (isNaN(meanDiff) || isNaN(sdDiff) || isNaN(n) || sdDiff <= 0 || n < 2) { showEmpty(); return; }

          const se = sdDiff / Math.sqrt(n);
          tStat = meanDiff / se;
          df = n - 1;
          cohenD = meanDiff / sdDiff;

          stepsArr.push(`Formula: t = d̄ / (s_d / √n)`);
          stepsArr.push(`d̄ = ${meanDiff.toFixed(4)}, s_d = ${sdDiff.toFixed(4)}, n = ${n.toFixed(0)}`);
          stepsArr.push(`SE = ${sdDiff.toFixed(4)} / √${n.toFixed(0)} = ${se.toFixed(4)}`);
          stepsArr.push(`t = ${meanDiff.toFixed(4)} / ${se.toFixed(4)} = ${tStat.toFixed(4)}`);
          stepsArr.push(`df = n − 1 = ${df.toFixed(0)}`);
          stepsArr.push(`Cohen's d = d̄ / s_d = ${cohenD.toFixed(4)} (${cohenInterpretation(cohenD)})`);

          if (n < 10) {
            warning = 'Sample size is very small (n < 10). The paired t-test assumes the differences are approximately normal. Consider the Wilcoxon signed-rank test if this assumption is violated.';
          }
        }

        // P-value
        const cdf = tCDF(tStat, df);
        let pTwo, pLeft, pRight;
        pLeft = cdf;
        pRight = 1 - cdf;
        pTwo = 2 * Math.min(pLeft, pRight);

        if (currentTail === 'two') {
          pValue = pTwo;
          stepsArr.push(`Two-tailed p = 2 × min(F_t(t), 1 − F_t(t)) = ${pValue.toFixed(4)}`);
        } else if (currentTail === 'left') {
          pValue = pLeft;
          stepsArr.push(`Left-tailed p = F_t(t, df) = ${pValue.toFixed(4)}`);
        } else {
          pValue = pRight;
          stepsArr.push(`Right-tailed p = 1 − F_t(t, df) = ${pValue.toFixed(4)}`);
        }

        // Interpretation
        const pFormatted = formatP(pValue);
        const tailName = currentTail === 'two' ? 'two-tailed' : currentTail === 'left' ? 'left-tailed' : 'right-tailed';
        let sig;
        if (sigOff) {
          sig = { text: '—', color: 'text-bae-muted', verdict: 'not assessed' };
          interpretation = `The ${tailName} p-value is ${pFormatted} with t = ${tStat.toFixed(4)} and ${df.toFixed(0)} degrees of freedom. No significance level (α) was selected, so no verdict is shown. Cohen's d = ${cohenD.toFixed(4)} indicates a ${cohenInterpretation(cohenD)}.`;
        } else {
          sig = getSignificanceText(pValue, alpha);
          const alphaPct = (alpha * 100).toFixed(1).replace(/\.0$/, '');
          if (pValue <= alpha) {
            interpretation = `With a p-value of ${pFormatted}, the result is statistically ${sig.verdict} at the ${alphaPct}% level (${tailName}). The t-statistic of ${tStat.toFixed(4)} exceeds the critical threshold for ${df.toFixed(0)} degrees of freedom. Cohen's d = ${cohenD.toFixed(4)} indicates a ${cohenInterpretation(cohenD)}.`;
          } else {
            interpretation = `With a p-value of ${pFormatted}, the result is ${sig.verdict} at the ${alphaPct}% level (${tailName}). The t-statistic of ${tStat.toFixed(4)} does not exceed the critical threshold for ${df.toFixed(0)} degrees of freedom. Cohen's d = ${cohenD.toFixed(4)} indicates a ${cohenInterpretation(cohenD)}.`;
          }
          if (Math.abs(pValue - alpha) < 0.005 && pValue >= alpha) {
            interpretation += ' This is a borderline result. Replication is advisable.';
          }
        }

        // Show results
        $('empty-state').style.display = 'none';
        $('result-card').style.display = 'block';
        $('dist-card').style.display = 'block';
        $('steps-card').style.display = 'block';
        $('pdf-btn').classList.remove('hidden');

        $('result-t').textContent = tStat.toFixed(4);
        $('result-pvalue').textContent = pFormatted;
        $('result-df').textContent = Number.isInteger(df) ? df.toFixed(0) : df.toFixed(2);
        const sigEl = $('result-significance');
        sigEl.textContent = sig.text;
        sigEl.className = 'text-base font-semibold ' + sig.color;
        $('result-cohen').textContent = cohenD.toFixed(4);
        $('result-interpretation').textContent = interpretation;

        const warnEl = $('validation-warning');
        if (warning) {
          warnEl.classList.remove('hidden');
          warnEl.querySelector('p').textContent = warning;
        } else {
          warnEl.classList.add('hidden');
        }

        $('steps-content').innerHTML = stepsArr.map(s => '<p class="font-mono text-xs bg-white border border-bae-border rounded-bae-sm px-3 py-2">' + s + '</p>').join('');

        // Draw distribution
        const canvas = $('dist-canvas');
        canvas.width = canvas.offsetWidth * 2;
        canvas.height = 220 * 2;
        const criticals = sigOff ? [] : getTCriticals(currentTail, alpha, df);
        drawTDistribution(canvas, tStat, df, currentTail, criticals);

        // PDF report
        $('report-t').textContent = tStat.toFixed(4);
        $('report-pvalue').textContent = pFormatted;
        $('report-df').textContent = Number.isInteger(df) ? df.toFixed(0) : df.toFixed(2);
        $('report-alpha').textContent = sigOff ? 'Not set' : alpha.toFixed(4);
        $('report-tail').textContent = tailName.charAt(0).toUpperCase() + tailName.slice(1);
        $('report-cohen').textContent = cohenD.toFixed(4);
        $('report-interpretation').textContent = interpretation;
        $('report-details').innerHTML = stepsArr.map(s => '<p>' + s + '</p>').join('');
        $('report-dist').src = canvas.toDataURL('image/png');
        $('report-dist-wrapper').style.display = 'block';

        updateURL();
      }

      function showEmpty() {
        $('empty-state').style.display = 'block';
        $('result-card').style.display = 'none';
        $('dist-card').style.display = 'none';
        $('steps-card').style.display = 'none';
        $('pdf-btn').classList.add('hidden');
      }

      $('calc-btn').addEventListener('click', calculate);
      $('clear-btn').addEventListener('click', () => {
        $('input-os-mean').value = '';
        $('input-os-mu0').value = '';
        $('input-os-sd').value = '';
        $('input-os-n').value = '';
        $('input-ind-m1').value = '';
        $('input-ind-m2').value = '';
        $('input-ind-s1').value = '';
        $('input-ind-s2').value = '';
        $('input-ind-n1').value = '';
        $('input-ind-n2').value = '';
        $('input-pd-mean').value = '';
        $('input-pd-sd').value = '';
        $('input-pd-n').value = '';
        $('input-custom-alpha').value = '';
        updateAlpha('0.05');
        showEmpty();
        updateURL();
      });

      // Toggle steps
      $('toggle-steps').addEventListener('click', () => {
        stepsVisible = !stepsVisible;
        $('steps-content').style.display = stepsVisible ? 'block' : 'none';
        $('toggle-steps').textContent = stepsVisible ? 'Hide' : 'Show';
      });

      // PDF generation
      $('pdf-btn').addEventListener('click', async () => {
        if (typeof html2pdf === 'undefined') return;
        const btn = $('pdf-btn');
        const originalText = btn.textContent;
        btn.textContent = 'Generating...';
        btn.disabled = true;

        const wrapper = document.createElement('div');
        wrapper.style.width = '210mm';
        wrapper.style.boxSizing = 'border-box';
        wrapper.style.margin = '0';

        const report = $('print-report').cloneNode(true);
        report.removeAttribute('id');
        report.classList.remove('hidden');
        wrapper.appendChild(report);
        document.body.appendChild(wrapper);

        try {
          await html2pdf().set({
            margin: [8, 8, 8, 8],
            filename: 't-test-report.pdf',
            image: { type: 'jpeg', quality: 0.95 },
            html2canvas: { scale: 2, useCORS: true, logging: false, scrollX: 0, scrollY: 0 },
            pagebreak: { mode: ['css', 'legacy'], avoid: 'p, li, .bg-gray-50, h1, h2, h3, h4, h5, h6, ul, tr, td, table' },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
          }).from(wrapper).save();
        } catch (err) {
          console.error(err);
        } finally {
          if (wrapper.parentNode) document.body.removeChild(wrapper);
          btn.textContent = originalText;
          btn.disabled = false;
        }
      });

      // URL sharing
      function updateURL() {
        const url = new URL(window.location.href);
        url.searchParams.set('mode', currentMode);
        url.searchParams.set('tail', currentTail);
        url.searchParams.set('alpha', currentAlpha === null ? 'off' : currentAlpha);
        if (currentMode === 'independent') {
          url.searchParams.set('var', currentVar);
        } else {
          url.searchParams.delete('var');
        }

        if (currentMode === 'onesample') {
          if ($('input-os-mean').value) url.searchParams.set('m', $('input-os-mean').value); else url.searchParams.delete('m');
          if ($('input-os-mu0').value) url.searchParams.set('mu0', $('input-os-mu0').value); else url.searchParams.delete('mu0');
          if ($('input-os-sd').value) url.searchParams.set('s', $('input-os-sd').value); else url.searchParams.delete('s');
          if ($('input-os-n').value) url.searchParams.set('n', $('input-os-n').value); else url.searchParams.delete('n');
          url.searchParams.delete('m1'); url.searchParams.delete('m2'); url.searchParams.delete('s1'); url.searchParams.delete('s2');
          url.searchParams.delete('n1'); url.searchParams.delete('n2'); url.searchParams.delete('dm'); url.searchParams.delete('ds');
        } else if (currentMode === 'independent') {
          if ($('input-ind-m1').value) url.searchParams.set('m1', $('input-ind-m1').value); else url.searchParams.delete('m1');
          if ($('input-ind-m2').value) url.searchParams.set('m2', $('input-ind-m2').value); else url.searchParams.delete('m2');
          if ($('input-ind-s1').value) url.searchParams.set('s1', $('input-ind-s1').value); else url.searchParams.delete('s1');
          if ($('input-ind-s2').value) url.searchParams.set('s2', $('input-ind-s2').value); else url.searchParams.delete('s2');
          if ($('input-ind-n1').value) url.searchParams.set('n1', $('input-ind-n1').value); else url.searchParams.delete('n1');
          if ($('input-ind-n2').value) url.searchParams.set('n2', $('input-ind-n2').value); else url.searchParams.delete('n2');
          url.searchParams.delete('m'); url.searchParams.delete('mu0'); url.searchParams.delete('s'); url.searchParams.delete('n');
          url.searchParams.delete('dm'); url.searchParams.delete('ds');
        } else if (currentMode === 'paired') {
          if ($('input-pd-mean').value) url.searchParams.set('dm', $('input-pd-mean').value); else url.searchParams.delete('dm');
          if ($('input-pd-sd').value) url.searchParams.set('ds', $('input-pd-sd').value); else url.searchParams.delete('ds');
          if ($('input-pd-n').value) url.searchParams.set('n', $('input-pd-n').value); else url.searchParams.delete('n');
          url.searchParams.delete('m'); url.searchParams.delete('mu0'); url.searchParams.delete('s');
          url.searchParams.delete('m1'); url.searchParams.delete('m2'); url.searchParams.delete('s1'); url.searchParams.delete('s2');
          url.searchParams.delete('n1'); url.searchParams.delete('n2');
        }
        window.history.replaceState({}, '', url);
      }

      function readURL() {
        const url = new URL(window.location.href);
        const mode = url.searchParams.get('mode');
        if (mode && ['onesample', 'independent', 'paired'].includes(mode)) {
          updateMode(mode);
        }
        const tail = url.searchParams.get('tail');
        if (tail && ['two', 'left', 'right'].includes(tail)) {
          updateTail(tail);
        }
        const alpha = url.searchParams.get('alpha');
        if (alpha === 'off') {
          updateAlpha('off');
        } else if (alpha) {
          const a = parseFloat(alpha);
          if ([0.10, 0.05, 0.01, 0.001].includes(a)) {
            updateAlpha(a.toString());
          } else {
            updateAlpha('custom');
            $('input-custom-alpha').value = a;
            currentAlpha = a;
          }
        }
        const v = url.searchParams.get('var');
        if (v && ['welch', 'student'].includes(v)) {
          updateVar(v);
        }

        if (mode === 'onesample') {
          if (url.searchParams.has('m')) $('input-os-mean').value = url.searchParams.get('m');
          if (url.searchParams.has('mu0')) $('input-os-mu0').value = url.searchParams.get('mu0');
          if (url.searchParams.has('s')) $('input-os-sd').value = url.searchParams.get('s');
          if (url.searchParams.has('n')) $('input-os-n').value = url.searchParams.get('n');
        } else if (mode === 'independent') {
          if (url.searchParams.has('m1')) $('input-ind-m1').value = url.searchParams.get('m1');
          if (url.searchParams.has('m2')) $('input-ind-m2').value = url.searchParams.get('m2');
          if (url.searchParams.has('s1')) $('input-ind-s1').value = url.searchParams.get('s1');
          if (url.searchParams.has('s2')) $('input-ind-s2').value = url.searchParams.get('s2');
          if (url.searchParams.has('n1')) $('input-ind-n1').value = url.searchParams.get('n1');
          if (url.searchParams.has('n2')) $('input-ind-n2').value = url.searchParams.get('n2');
        } else if (mode === 'paired') {
          if (url.searchParams.has('dm')) $('input-pd-mean').value = url.searchParams.get('dm');
          if (url.searchParams.has('ds')) $('input-pd-sd').value = url.searchParams.get('ds');
          if (url.searchParams.has('n')) $('input-pd-n').value = url.searchParams.get('n');
        }

        const hasInput = $('input-os-mean').value || $('input-ind-m1').value || $('input-pd-mean').value;
        if (hasInput) {
          calculate();
        }
      }

      readURL();
    })();
  </script>
</BaseLayout>
