            <text x="310" y="62" text-anchor="middle" font-family="Playfair Display,serif" font-size="16" font-weight="800" fill="#0f0f1a">26%</text>
            <text x="291" y="262" text-anchor="middle" font-family="Inter,sans-serif" font-size="13" fill="#1a1a2e">Legal</text>
