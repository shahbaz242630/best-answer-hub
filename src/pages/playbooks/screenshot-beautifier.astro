          <rect x="184" y="132" width="180" height="42" rx="8" fill="#E4EADD" stroke="#cdd9c8"/><text x="274" y="151" text-anchor="middle" font-family="Karla, sans-serif" font-size="11" fill="#5a7355">framed in your browser</text><text x="274" y="166" text-anchor="middle" font-family="Karla, sans-serif" font-size="10.5" fill="#5a7355">Canvas API, nothing sent</text>
          <path d="M366 153 L406 153" stroke="#6F8A6A" stroke-width="2"/><path d="M400 148 l10 5 -10 5" fill="#6F8A6A"/>
