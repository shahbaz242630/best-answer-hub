          <rect x="20" y="36" width="120" height="42" rx="8" fill="#F3E2D6" stroke="#ecd6c5"/><text x="80" y="61" text-anchor="middle" font-family="Karla, sans-serif" font-size="11" fill="#8a4429">your screenshot</text>
          <path d="M142 57 L182 57" stroke="#C6603F" stroke-width="2"/><path d="M176 52 l10 5 -10 5" fill="#C6603F"/>
          <rect x="184" y="36" width="150" height="42" rx="8" fill="#efd3c8" stroke="#e2b8a7"/><text x="259" y="55" text-anchor="middle" font-family="Karla, sans-serif" font-size="11" fill="#8a4429">uploaded to</text><text x="259" y="70" text-anchor="middle" font-family="Karla, sans-serif" font-size="11" fill="#8a4429">their servers</text>
          <path d="M336 57 L376 57" stroke="#C6603F" stroke-width="2"/><path d="M370 52 l10 5 -10 5" fill="#C6603F"/>
