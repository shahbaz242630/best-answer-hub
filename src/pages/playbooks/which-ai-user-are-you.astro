    { name: 'Home', url: '/' },
    { name: 'Playbooks', url: '/playbooks/' },
    { name: 'Which AI User Are You?', url: '/playbooks/which-ai-user-are-you/' },
  ],
  faq: faqs.map(f => ({ question: f.q, answer: f.a.replace(/<[^>]*>/g, '').replace(/\s{2,}/g, ' ').trim() })),
};
