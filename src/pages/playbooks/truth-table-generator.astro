<style>
  .pb{
    --cream:#FBF6EE; --card:#fff;
    --clay:#C6603F; --clay-dark:#B0512F; --clay-deep:#8a4429;
    --sage:#6F8A6A; --sage-dark:#5a7355;
    --ink:#33302A;
    --peach:#F3E2D6; --sage-tint:#E4EADD;
    --border:#E8DECE; --fill-line:#ddd0bb;
    --body:#4f4940; --label:#847B6B; --muted:#a89c87; --faint:#bcae99;
    background:var(--cream);font-family:'Karla',system-ui,sans-serif;color:var(--body);line-height:1.65;
  }
  .pb *{box-sizing:border-box}
  .pb a{color:var(--clay)}
  .pb .cav{font-family:'Caveat',cursive;font-weight:600;color:var(--sage);transform:rotate(-1.5deg);display:inline-block}

  .pb .hero{background:var(--cream);padding:28px 0 40px;position:relative;overflow:hidden}
  .pb .hero .glow{position:absolute;right:-160px;top:-60px;width:420px;height:420px;background:radial-gradient(circle,rgba(198,96,63,.10),transparent 70%);filter:blur(10px)}
  .pb .hero-inner{max-width:1080px;margin:0 auto;padding:0 24px;position:relative}
  .pb .hero-top{position:relative;display:flex;justify-content:space-between;align-items:center;min-height:44px;margin:4px 0 30px}
  .pb .masthead{display:flex;align-items:center;gap:11px}
  .pb .masthead .bmark{width:44px;height:44px;border-radius:11px;display:block}
  .pb .masthead .word{font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:1.18rem;color:var(--ink);letter-spacing:-.01em;line-height:1.05}
  .pb .masthead .word i{font-style:normal;color:var(--clay)}
  .pb .backnav{display:inline-flex;align-items:center;gap:7px;font-size:.78rem;font-weight:700;letter-spacing:.04em;color:var(--clay-dark);text-decoration:none;background:var(--peach);border:1px solid #ecd6c5;padding:7px 14px;border-radius:999px;transition:.15s}
  .pb .backnav:hover{background:#eed6c6}
  .pb .backnav .bk-ico{font-size:.95rem;line-height:1}
  .pb .eyebrow{display:inline-flex;align-items:center;gap:8px;font-family:'Karla',sans-serif;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--clay-dark);background:var(--peach);padding:6px 14px;border-radius:999px}
  .pb .hero .cav{font-size:1.5rem;margin:20px 0 6px}
  .pb h1{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(2.4rem,5.6vw,3.7rem);line-height:1.0;margin:2px 0 18px;letter-spacing:-.02em;max-width:15em;color:var(--ink)}
  .pb h1 em{font-style:normal;color:var(--clay)}
  .pb .dek{font-size:1.16rem;color:var(--body);max-width:40em}
  .pb .byline{display:flex;flex-wrap:wrap;gap:16px;margin-top:22px;font-size:.84rem;color:var(--label);font-weight:600}
  .pb .byline b{color:var(--ink)}
  .pb .bandstrip{display:flex;gap:8px;margin-top:28px;max-width:620px}
  .pb .bandstrip .seg{flex:1;text-align:center;padding:11px 6px;border-radius:12px;font-size:.74rem;font-weight:700;border:2px solid var(--border);background:var(--card);color:var(--ink);line-height:1.25}
  .pb .bandstrip .seg small{display:block;font-weight:600;font-size:.66rem;color:var(--label);margin-top:2px}
  .pb .bandstrip .seg.b1{border-color:#cdd9c8;background:var(--sage-tint)}
  .pb .bandstrip .seg.b2{border-color:#ecd6c5;background:var(--peach)}
  .pb .bandstrip .seg.b3{border-color:var(--clay);background:var(--clay);color:#fff}
  .pb .bandstrip .seg.b3 small{color:#f3ddd2}

  .pb .stat-grid{max-width:1080px;margin:18px auto 0;padding:0 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;position:relative;z-index:3}
  .pb .stat{background:var(--card);border:2px solid var(--border);border-radius:16px;padding:18px 16px;text-align:center}
  .pb .stat .n{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:1.7rem;color:var(--clay);line-height:1}
  .pb .stat .n sup{font-size:.6em}
  .pb .stat .l{font-size:.78rem;color:var(--ink);margin-top:8px;font-weight:600;line-height:1.35}
  .pb .stat .src{font-size:.66rem;color:var(--muted);margin-top:6px;font-weight:600;letter-spacing:.02em}

  .pb .layout{max-width:1080px;margin:0 auto;padding:44px 24px 60px;display:grid;grid-template-columns:220px 1fr;gap:48px}
  .pb .toc{position:sticky;top:24px;align-self:start;font-size:.88rem}
