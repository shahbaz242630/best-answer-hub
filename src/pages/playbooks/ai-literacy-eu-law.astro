const today = '2026-07-04T00:00:00+00:00';

const faqs = [
  { q: 'What is the Best Answer Hub AI Knowledge Test?', a: 'The Best Answer Hub AI Knowledge Test is a free, browser-based assessment that scores how well you understand AI across five domains, then places you at Beginner, Intermediate, or Advanced. It takes about 20 minutes, with no signup or email. It is a personal self-check to gauge your own understanding, not a legal certificate or proof of compliance with any law.' },
  { q: 'What is Article 4 of the EU AI Act?', a: 'Article 4 is the AI literacy rule in the EU AI Act. It requires providers and deployers of AI systems to ensure their staff, and others using AI on their behalf, have a sufficient level of AI literacy suited to their role and the risks involved. It is an obligation on organizations, not on individual employees.' },
  { q: 'When did the AI literacy duty take effect?', a: 'It has applied since 2 February 2025. From that date, organizations across the EU using AI must take measures to ensure staff AI literacy. National authorities begin supervising and enforcing the rule from August 2026, but the obligation itself has been in force since early 2025.' },
  { q: 'Who does the EU AI literacy rule apply to?', a: 'Both providers and deployers of AI systems, across all sectors and risk levels, not just high-risk uses. The European Commission confirms it covers everyday tools: a company whose staff use ChatGPT to draft or translate text is in scope, and those staff should understand risks like hallucination.' },
  { q: 'Does the EU AI Act require an AI literacy certificate?', a: 'No. The European Commission states plainly that there is no need for a certificate and no obligation to measure employees’ AI knowledge. Keeping an internal record of training is enough. There is no official EU AI-literacy exam or credential, so be cautious of any tool claiming to certify you.' },
  { q: 'Does Article 4 apply to companies outside the EU?', a: 'Yes, it can. The Commission confirms the rule reaches organizations outside the EU when their AI system is placed on the EU market, used in the EU, or affects people in the EU. A non-EU employer whose AI touches EU users can fall within Article 4’s scope.' },
  { q: 'What does "AI literacy" mean in the EU AI Act?', a: 'The Act’s own definition, in Article 3(56), is the skills, knowledge, and understanding to make informed use of AI and to be aware of its opportunities, risks, and possible harms. It is not about coding. It is about knowing what AI can do, where it fails, and when to trust it.' },
  { q: 'Is my employer required to train me on AI?', a: 'Your employer has a duty to ensure you have a sufficient level of AI literacy for your role, but the law gives them flexibility on how. There is no mandated curriculum and no requirement to test you. In practice many workers still learn on their own: only 39% who use AI at work have had any training.' },
  { q: 'Can I be fined if I am not AI-literate?', a: 'No. The duty falls on employers, the providers and deployers of AI, not on individual staff. You cannot be personally fined under Article 4 for your own level of AI literacy. The risk for an individual is to your competitiveness in the job market, not a legal penalty.' },
  { q: 'Is the €35 million fine for not being AI-literate?', a: 'No, and this is a common myth. The headline fines of up to €35 million or 7% of turnover apply to prohibited AI practices under a different article, not to the AI literacy duty. Penalties for Article 4 are set by each member state and must be proportionate to the case.' },
  { q: 'Does this apply only to tech companies?', a: 'No. The European Commission states it imposes no requirements for specific sectors. Any organization that uses AI is covered, from a law firm to a bakery using an AI scheduling tool. The duty scales with the risk of the systems used, but it is not limited to technology companies.' },
  { q: 'Will Article 4 change?', a: 'Possibly. In November 2025 the European Commission proposed amendments, in a package called the Digital Omnibus, that would shift more of the literacy-promotion role to member states. It is a proposal, not yet law, and the duty as written still applies. Training obligations for high-risk AI oversight would remain regardless.' },
  { q: 'Does AI literacy actually help my career?', a: 'Yes, well beyond the EU rule. PwC found jobs requiring AI skills carried a 56% wage premium, and Microsoft found 66% of leaders would not hire someone without AI skills while only 39% had been trained. Understanding AI is becoming a career asset, which is reason enough to know where you stand.' },
  { q: 'Does this test prove I comply with the EU AI Act?', a: 'No. This test is a personal self-check, not proof of compliance. The EU AI Act does not require an exam, score, or certificate, so no quiz can demonstrate that an organization has met Article 4. Use the result to understand your own AI knowledge and decide what to learn next.' },
  { q: 'How is this different from a vendor’s AI quiz?', a: 'Most free AI quizzes exist to recommend the maker’s own product, and many gate the result behind your email. The Best Answer Hub AI Knowledge Test sells nothing, carries no affiliate links, captures no email, and runs in your browser. The honest result is the deliverable, not a sales lead.' },
];

const seo = {
  title: 'AI Literacy Is Now a Legal Duty in the EU (Article 4)',
  description: 'Since 2 February 2025, Article 4 of the EU AI Act makes AI literacy a legal duty for employers. What it requires, who it covers, the myths, and what it means.',
  url: '/playbooks/ai-literacy-eu-law/',
  type: 'WebPage' as const,
  datePublished: today,
  dateModified: today,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Playbooks', url: '/playbooks/' },
    { name: 'AI Literacy Is Now a Legal Duty in the EU', url: '/playbooks/ai-literacy-eu-law/' },
  ],
  faq: faqs.map(f => ({ question: f.q, answer: f.a.replace(/<[^>]*>/g, '').replace(/\s{2,}/g, ' ').trim() })),
};
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Karla:wght@400;500;600;700&family=Caveat:wght@600;700&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="pb">
    <div class="hero">
      <span class="glow"></span>
      <div class="hero-inner">
