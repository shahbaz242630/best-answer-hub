    <div class="stat"><div class="n">.ics</div><div class="l">export to Google, Apple, and Outlook</div><div class="src">RFC 5545</div></div>
    <div class="stat"><div class="n">$0</div><div class="l">no signup, no account, no upload</div><div class="src">free</div></div>
  </div>

