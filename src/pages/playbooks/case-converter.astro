            <div class="cell"><div class="lbl">PascalCase</div><div class="val">HelloWorldExample</div></div>
            <div class="cell"><div class="lbl">Title Case</div><div class="val">Hello World Example</div></div>
            <div class="cell"><div class="lbl">snake_case</div><div class="val">hello_world_example</div></div>
            <div class="cell"><div class="lbl">Sentence case</div><div class="val">Hello world example</div></div>
            <div class="cell"><div class="lbl">kebab-case</div><div class="val">hello-world-example</div></div>
          </div>
          <p class="chart-src">Case names per MDN glossary (camel case, snake case, kebab case). The Best Answer Hub Case Converter outputs all eight.</p>
        </figure>
        <table>
          <thead><tr><th>Case</th><th>Example</th><th>Where it belongs</th></tr></thead>
          <tbody>
            <tr><td class="band">UPPERCASE</td><td><code>HELLO WORLD</code></td><td>Acronyms, short emphasis, not body text</td></tr>
            <tr><td class="band">lowercase</td><td><code>hello world</code></td><td>Casual text, tags, some brand styling</td></tr>
            <tr><td class="band">Title Case</td><td><code>Hello World</code></td><td>Formal titles, headings, product names</td></tr>
