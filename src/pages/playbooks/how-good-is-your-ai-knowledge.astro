            <rect x="150" y="127" width="120" height="105" rx="8" fill="url(#bargrad)" opacity="0.85"/>
            <text x="210" y="117" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-size="27" font-weight="800" fill="#33302A">63%</text>
            <text x="210" y="252" text-anchor="middle" font-family="Karla, sans-serif" font-size="14" fill="#847B6B">Admit exaggerating</text>
