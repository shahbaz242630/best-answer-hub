        <tr><td class="band">Chatterbox</td><td>MIT</td><td><span class="score lv1">Yes</span></td><td>Every output carries an inaudible watermark</td></tr>
        <tr><td class="band">MeloTTS</td><td>MIT</td><td><span class="score lv1">Yes</span></td><td>None</td></tr>
        <tr><td class="band">Google Cloud TTS</td><td>Commercial terms</td><td><span class="score lv1">Yes</span></td><td>Free only to 4M characters a month</td></tr>
        <tr><td class="band">ElevenLabs free</td><td>Free plan terms</td><td><span class="score lv3">No</span></td><td>Non-commercial only, attribution required</td></tr>
        <tr><td class="band">Coqui XTTS-v2</td><td>Coqui CPML</td><td><span class="score lv3">No</span></td><td>The license explicitly covers the output audio</td></tr>
