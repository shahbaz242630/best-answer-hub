---
import BaseLayout from '../../layouts/BaseLayout.astro';

const today = '2026-07-04T00:00:00+00:00';

const faqs = [
  { q: 'What is the Best Answer Hub Resume Builder?', a: 'The Best Answer Hub Resume Builder is a free, browser-based tool that builds an ATS-friendly resume with a live preview and exports a real PDF and Word file. It needs no account and adds no watermark, and it assembles the resume on your own device, so the personal details on it are never uploaded to a server.' },
  { q: 'Is it really free to download the resume?', a: 'Yes. The Best Answer Hub Resume Builder gives you a real, formatted PDF and Word file for free, with no paywall at the download step. Many free builders let you build a resume, then charge to download the formatted file or hand over only a plain text export. This tool exports the finished document directly.' },
  { q: 'Does the resume have a watermark?', a: 'No. Resumes from the Best Answer Hub Resume Builder are clean, with no watermark and no branding on them. Some free builders stamp a watermark on the free PDF to push a paid plan. Because there is no paid tier here, the tool simply outputs the finished, professional document.' },
  { q: 'Do I need to sign up or give an email?', a: 'No. The Best Answer Hub Resume Builder needs no account, no email, and no login. You build your resume and download it directly. This avoids both the signup wall and the free trial that many resume sites place between you and the finished file, and there is no subscription to cancel later.' },
  { q: 'Can I download my resume as a PDF and a Word file?', a: 'Yes. The Best Answer Hub Resume Builder exports a real PDF for applying and a real Word document for editing, both free. Several free builders give only a plain text export unless you pay, and recruiters and application forms often expect a proper document rather than a stripped text file.' },
  { q: 'What does ATS-friendly mean?', a: 'ATS-friendly means a resume an applicant tracking system can read cleanly. That calls for a single-column layout, standard section headings, no tables, graphics, or photos, and a common font, so the parser captures every detail. The Best Answer Hub Resume Builder uses single-column, ATS-friendly templates for exactly this reason.' },
  { q: 'Do applicant tracking systems automatically reject resumes?', a: 'Mostly no. The idea that systems auto-reject most resumes is a myth with no solid source. An applicant tracking system parses and ranks resumes so recruiters can search them, and the vast majority are still seen by a person. The real risk is a resume that parses badly, which the Best Answer Hub Resume Builder avoids by design.' },
  { q: 'How do I make my resume ATS-friendly?', a: 'Use a single-column layout, standard headings like Experience and Education, a web-safe font, and no tables, images, or icons, and keep your name and contact details in the body rather than the header. The Best Answer Hub Resume Builder builds to these rules automatically, so the structure parses cleanly.' },
  { q: 'Is a Canva resume ATS-friendly?', a: 'Often not. Canva resumes look striking but use multi-column layouts, graphics, and text boxes that applicant tracking systems can scramble or drop. A clean, single-column resume parses far more reliably. The Best Answer Hub Resume Builder keeps the professional look while using the structure an ATS can actually read.' },
  { q: 'How long should a resume be?', a: 'One page suits most people, especially with under about ten years of experience, and two pages are fine for a longer, relevant history. Relevance matters more than length, because recruiters skim. The Best Answer Hub Resume Builder keeps formatting tight so your content fits cleanly on the right number of pages.' },
  { q: 'Should I send my resume as a PDF or a Word document?', a: 'Either works if it parses cleanly, and the Best Answer Hub Resume Builder exports both. A PDF preserves your layout exactly, which is best when the posting accepts it; a Word file is easy for a recruiter to edit or a form to ingest. If a job asks for one format, follow that, and the tool has it ready.' },
  { q: 'Is my resume data uploaded to a server?', a: 'No. The Best Answer Hub Resume Builder assembles your resume in your browser, so your name, address, phone, and full work history stay on your device and are never uploaded. Server-based builders store that data in the cloud, and some keep it after you delete the account. This tool processes it locally.' },
  { q: 'Should I put my address on my resume?', a: 'A full street address is no longer expected, and many people list only a city and state, or leave it off, for privacy. A phone number and email are enough to be reached. The Best Answer Hub Resume Builder lets you include as much or as little contact detail as you want, and keeps it on your device.' },
  { q: 'How is it different from Zety or Resume Genius?', a: 'Those builders usually let you create a resume free but charge to download the formatted PDF or Word file, leaving the free export as plain text, and they store your data on their servers. The Best Answer Hub Resume Builder exports a real PDF and Word file free, needs no account, adds no watermark, and assembles the resume in your browser.' },
  { q: 'Does using this builder help me get past the ATS?', a: 'It helps by giving the system a resume it can read. The Best Answer Hub Resume Builder uses a single-column, standard-heading, text-based layout that parses cleanly, which avoids lost or scrambled sections. Matching the wording of the job description then helps you rank in a recruiter search, since no tool can guarantee an interview.' },
];

const seo = {
  title: 'How to Make an ATS-Friendly Resume (Free, 2026)',
  description: 'Build an ATS-friendly resume free in your browser, with a real PDF and Word download, no signup and no watermark. Plus what ATS-friendly really means.',
  url: '/playbooks/resume-builder/',
  type: 'WebPage' as const,
  datePublished: today,
  dateModified: today,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Playbooks', url: '/playbooks/' },
    { name: 'Resume Builder', url: '/playbooks/resume-builder/' },
  ],
  faq: faqs.map(f => ({ question: f.q, answer: f.a.replace(/<[^>]*>/g, '').replace(/\s{2,}/g, ' ').trim() })),
};
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Karla:wght@400;500;600;700&family=Caveat:wght@600;700&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="pb">
    <div class="hero">
      <span class="glow"></span>
      <div class="hero-inner">
        <div class="hero-top">
          <div class="masthead">
            <img class="bmark" src="/brand-mark.png" alt="Best Answer Hub logo" width="44" height="44" />
            <span class="word">Best Answer Hub<i>.</i></span>
          </div>
          <a class="backnav" href="/playbooks/"><span class="bk-ico" aria-hidden="true">&larr;</span> Back to Playbooks</a>
        </div>
        <span class="eyebrow">Best Answer Hub Playbooks · Career</span>
        <div class="cav">Build it free, download it free</div>
        <h1>Build an ATS-Friendly Resume, <em>Free to Download</em></h1>
        <p class="dek">A plain guide to building a resume that gets read: what ATS-friendly actually means, how long a resume should be, and where your personal data goes. The Best Answer Hub Resume Builder exports a real PDF and Word file free, with no signup and no watermark.</p>
        <div class="byline"><span><b>Best Answer Hub</b></span><span>~10 min read</span><span>ATS-friendly</span><span>No signup</span></div>
        <div class="bandstrip">
          <div class="seg b1">Build<small>live preview</small></div>
          <div class="seg b2">Private<small>never uploaded</small></div>
          <div class="seg b3">Free<small>real PDF and Word</small></div>
        </div>
      </div>
    </div>

    <div class="stat-grid">
      <div class="stat"><div class="n">2</div><div class="l">real file formats</div><div class="src">PDF and Word, free</div></div>
      <div class="stat"><div class="n">0</div><div class="l">signups, watermarks, or trials</div><div class="src">free to download</div></div>
      <div class="stat"><div class="n">100%</div><div class="l">runs in your browser</div><div class="src">resume never uploaded</div></div>
      <div class="stat"><div class="n">97.8%</div><div class="l">of Fortune 500 use an ATS</div><div class="src">Jobscan, 2025</div></div>
    </div>

    <div class="layout">
      <nav class="toc" aria-label="On this page">
        <div class="t">On this page</div>
        <a href="#what">What it is</a>
        <a href="#free">Free to download</a>
        <a href="#ats">What ATS-friendly means</a>
        <a href="#format">Length and format</a>
        <a href="#private">Where your data goes</a>
        <a href="#different">Versus other builders</a>
        <a href="#faq">FAQ</a>
      </nav>

      <article>
        <p class="lead"><strong>The Best Answer Hub Resume Builder is a free, browser-based tool that builds an ATS-friendly resume with a live preview and exports a real PDF and Word file, with no signup and no watermark.</strong> This guide explains why the free download matters, what ATS-friendly actually means, how long a resume should be and which file format to send, and where the personal data on your resume ends up.</p>

        <div class="cav">Start here</div>
        <h2 id="what">What is the Best Answer Hub Resume Builder?</h2>
        <p>The Best Answer Hub <a href="/tools/resume-builder/">Resume Builder</a> is a single-page tool that turns your details into a clean, ATS-friendly resume, with a live preview so you see the finished document as you type. It exports a real PDF for applying and a real Word file for editing, both free and free of watermarks. It assembles the resume as JavaScript on your own device, so the personal details on it, your name, address, phone, and work history, are never uploaded to a server, and it needs no account. The tool lives in the Best Answer Hub <a href="/career-toolkit/">Career Toolkit</a> alongside a cover letter builder and a job keyword matcher, is built and maintained by <a href="/about/shahbaz-ali-malik/">Shahbaz Ali Malik</a>, and stays free because Best Answer Hub is funded by optional paid assessments rather than advertising.</p>

        <div class="cav">No catch at the end</div>
        <h2 id="free">Is it really free to download the resume?</h2>
        <p>Yes, and that is the point most free builders miss, which is why the Best Answer Hub Resume Builder hands you a real PDF and Word file with no paywall at the download step. The common trap is to let you spend an hour building a resume, then ask for payment to download the formatted file, or hand over only a plain text export unless you subscribe. On several well-known builders the free download is a plain text file, and the formatted PDF and Word versions sit behind a cheap trial that renews into a monthly charge. The Best Answer Hub Resume Builder skips all of it: build the resume, preview it, and download the finished document directly, with no account, no trial, and no card.</p>
        <blockquote>A resume you cannot download for free is not a free resume. <span class="accent">Build it, then keep the real file, no paywall at the finish line.</span></blockquote>

        <div class="cav">The part machines read</div>
        <h2 id="ats">What makes a resume ATS-friendly?</h2>
        <p>An ATS-friendly resume is one an applicant tracking system can read without scrambling it, and the Best Answer Hub Resume Builder is built to those rules: a single-column layout, standard section headings, a web-safe font, and no tables, graphics, or photos, with your name and contact details in the body rather than a header. Applicant tracking systems are close to universal, with a detectable one found for 97.8% of Fortune 500 companies in 2025, according to the resume-tool company Jobscan. The real risk is not an automatic rejection, a claim that is a widely repeated myth with no solid source, but content that parses badly or ranks low. Employers see the effect: in the Harvard Business School and Accenture Hidden Workers report, 88% of executives agreed that qualified, high-skilled candidates are screened out because their resumes do not match the exact criteria in a job description.</p>
        <figure class="chart">
          <figcaption class="chart-title">Software reads your resume before a person does</figcaption>
          <svg viewBox="0 0 600 280" role="img" aria-label="Bar chart: 97.8 percent of Fortune 500 companies use an applicant tracking system, and 88 percent of executives say qualified candidates are screened out">
            <defs><linearGradient id="bargrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#C6603F"/><stop offset="1" stop-color="#8a4429"/></linearGradient></defs>
            <line x1="70" y1="232" x2="560" y2="232" stroke="#E1D4be" stroke-width="2"/>
            <rect x="150" y="66" width="130" height="166" rx="8" fill="url(#bargrad)"/>
            <text x="215" y="56" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-size="25" font-weight="800" fill="#33302A">97.8%</text>
            <text x="215" y="252" text-anchor="middle" font-family="Karla, sans-serif" font-size="13" fill="#847B6B">Fortune 500 using an ATS</text>
            <rect x="350" y="82" width="130" height="150" rx="8" fill="url(#bargrad)" opacity="0.85"/>
            <text x="415" y="72" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-size="25" font-weight="800" fill="#33302A">88%</text>
            <text x="415" y="252" text-anchor="middle" font-family="Karla, sans-serif" font-size="13" fill="#847B6B">Execs: qualified people screened out</text>
          </svg>
          <p class="chart-src">Sources: Jobscan, 2025 (97.8% of Fortune 500 use a detectable ATS, a vendor audit); Harvard Business School and Accenture, Hidden Workers, 2021 (88% of executives say qualified candidates are screened out for not matching the job description).</p>
        </figure>
        <div class="callout sage"><div class="h">Why a Canva resume can backfire</div><p>The striking multi-column, graphic-heavy templates from design tools look great to a person but often confuse an applicant tracking system, which can drop or jumble text held in columns, text boxes, and images. A clean single-column resume parses reliably. The Best Answer Hub Resume Builder keeps the professional look while using the structure a parser can read.</p></div>

        <div class="cav">Fit and file</div>
        <h2 id="format">How long should a resume be, and PDF or Word?</h2>
        <p>One page suits most people and two pages are fine for a longer, relevant history, and the Best Answer Hub Resume Builder keeps the formatting tight so your content fits cleanly either way. A single page is the usual expectation for early career, up to roughly ten years of experience, while a second page earns its place when you have more relevant history to show, as university career centers such as Purdue and MIT advise. Relevance matters more than length, because recruiters skim quickly. On file type, both a PDF and a Word document work when they parse cleanly, and the tool exports both: a PDF preserves your layout exactly and is best when the posting accepts it, while a Word file is easy for a recruiter to edit or an online form to ingest. If a job asks for one format, send that one.</p>

        <div class="cav">The part that matters</div>
        <h2 id="private">Where does the data on your resume go?</h2>
        <p>Nowhere, because the Best Answer Hub Resume Builder assembles your resume in your browser and uploads nothing. A resume is a concentrated file of personal data, your full name, home address, phone, email, and complete work history, and a server-based builder stores all of it in the cloud, sometimes keeping it even after you delete the account. Processing the resume on your own device removes that exposure entirely: there is no server-side copy to leak or share. The reliable defense is to hand over less in the first place, which the US Federal Trade Commission frames simply, that a business does not have to protect what it does not collect (<a href="https://www.ftc.gov/business-guidance/privacy-security/data-security" target="_blank" rel="noopener noreferrer">FTC</a>). The Best Answer Hub Resume Builder collects nothing, so your details stay with you.</p>

        <div class="cav">The honest comparison</div>
        <h2 id="different">How is it different from Zety, Canva, and other builders?</h2>
        <p>The difference is that the Best Answer Hub Resume Builder gives you the finished file for free and keeps your data on your device, while most builders charge to download, add a watermark, or store your resume on their servers. The table sets the usual experience next to this one.</p>
        <table>
          <thead><tr><th>What you get</th><th>Best Answer Hub</th><th>Typical resume builder</th></tr></thead>
          <tbody>
            <tr><td>Download the formatted file</td><td class="band">Free PDF and Word</td><td>Often paywalled; free export is plain text</td></tr>
            <tr><td>Watermark on free output</td><td class="band">None</td><td>On some free PDFs</td></tr>
            <tr><td>Account or email</td><td class="band">Not required</td><td>Required</td></tr>
            <tr><td>Subscription or trial</td><td class="band">None</td><td>Common cheap-trial-to-recurring</td></tr>
            <tr><td>Your resume data</td><td class="band">Stays in your browser</td><td>Stored on their servers</td></tr>
            <tr><td>ATS-friendly structure</td><td class="band">Single-column by design</td><td>Varies; some break parsing</td></tr>
          </tbody>
        </table>
        <p>These contrasts come from the services' own pages. On builders such as Zety, Resume Genius, and Resume.io the free export is plain text, with the formatted PDF and Word versions behind a paid plan, and several use a cheap trial that renews into a monthly charge unless cancelled in time. Novoresume gives a free PDF but stamps it with a watermark and caps it at one page. Design tools like Canva export freely but produce layouts that often are not ATS-friendly, and even the genuinely free option from Indeed requires an account and keeps your resume on its platform. The Best Answer Hub Resume Builder asks for none of that: a real PDF and Word file for free, no account, no watermark, no subscription, and the resume assembled in your browser.</p>
        <div class="callout"><div class="h">Finish the application</div><p>A resume is one piece. Pair it with the Best Answer Hub <a href="/tools/cover-letter-builder/">Cover Letter Builder</a> to write the letter in the same sitting, and the <a href="/tools/job-keyword-matcher/">Job Keyword Matcher</a> to compare your resume against a posting and add the keywords you are missing, so a human is more likely to see the experience you already have.</p></div>

        <div class="cta">
          <span class="kicker">Build yours now</span>
          <h3>Open the Resume Builder</h3>
          <p>Free, no signup, and no watermark. Build an ATS-friendly resume with a live preview and download a real PDF and Word file.</p>
          <a class="btn" href="/tools/resume-builder/">Build my resume</a>
        </div>

        <div class="cav">Good questions</div>
        <h2 id="faq">Common questions about building a resume</h2>
        <div class="faq">
          {faqs.map((f) => (
            <div class="qa">
              <div class="q" set:html={f.q}></div>
              <div class="a" set:html={f.a}></div>
            </div>
          ))}
        </div>

        <div class="cav">People also read</div>
        <h2>Keep going</h2>
        <div class="sec">
          <ul class="pillars">
            <li><span class="dot">&rarr;</span><div><b><a href="/playbooks/free-career-tools/">Free Career Tools, No Pay to Download</a></b> The full Career Toolkit guide: resume builder, cover letter builder, and ATS keyword matcher.</div></li>
            <li><span class="dot">&rarr;</span><div><b><a href="/playbooks/free-online-tools/">70+ Free Online Tools, Nothing Uploaded</a></b> The overview of every Best Answer Hub hub, from calculators to PDFs.</div></li>
            <li><span class="dot">&rarr;</span><div><b><a href="/playbooks/gpa-calculator/">How to Calculate Your GPA, Done Right</a></b> For students and new graduates working out where they stand.</div></li>
            <li><span class="dot">&rarr;</span><div><b><a href="/playbooks/how-good-is-your-ai-knowledge/">How Good Is Your AI Knowledge, Really?</a></b> What AI literacy involves, and how to tell where you stand.</div></li>
          </ul>
        </div>

        <h2>Sources</h2>
        <ul class="sources">
          <li>Jobscan, <a href="https://www.jobscan.co/blog/fortune-500-use-applicant-tracking-systems/" target="_blank" rel="noopener noreferrer">Fortune 500 Use Applicant Tracking Systems</a>, 2025 (97.8% of Fortune 500 use a detectable ATS; vendor audit).</li>
          <li>Harvard Business School and Accenture, <a href="https://www.hbs.edu/managing-the-future-of-work/research/Pages/hidden-workers-untapped-talent.aspx" target="_blank" rel="noopener noreferrer">Hidden Workers: Untapped Talent</a>, 2021 (88% of executives say qualified candidates are screened out).</li>
          <li>Indeed Career Guide, <a href="https://www.indeed.com/career-advice/resumes-cover-letters/ats-resume-template" target="_blank" rel="noopener noreferrer">How To Write an ATS Resume</a> (single-column, standard headings parse best).</li>
          <li>MIT Career Advising and Professional Development, <a href="https://capd.mit.edu/resources/make-your-resume-ats-friendly/" target="_blank" rel="noopener noreferrer">Make Your Resume ATS-Friendly</a>, and Purdue OWL, <a href="https://owl.purdue.edu/owl/job_search_writing/resumes_and_vitas/using_two_pages_or_more.html" target="_blank" rel="noopener noreferrer">Using Two Pages or More</a> (formatting and length).</li>
          <li>The Interview Guys, <a href="https://blog.theinterviewguys.com/ats-resume-rejection-myth/" target="_blank" rel="noopener noreferrer">The ATS Resume Rejection Myth</a> (the 75% auto-reject claim is unsupported).</li>
          <li>US Federal Trade Commission, <a href="https://www.ftc.gov/business-guidance/privacy-security/data-security" target="_blank" rel="noopener noreferrer">Data Security</a> (collect and keep less data).</li>
        </ul>
        <p class="mt-12 pt-6 border-t border-bae-border-light text-sm text-bae-muted">Jump into the tools: <a href="/tools/resume-builder/" class="text-bae-ink underline underline-offset-2 hover:text-bae-primary transition-colors">Resume Builder</a>, <a href="/career-toolkit/" class="text-bae-ink underline underline-offset-2 hover:text-bae-primary transition-colors">Career Toolkit</a>, <a href="/tools/cover-letter-builder/" class="text-bae-ink underline underline-offset-2 hover:text-bae-primary transition-colors">Cover Letter Builder</a>, and <a href="/tools/" class="text-bae-ink underline underline-offset-2 hover:text-bae-primary transition-colors">all Tools</a>.</p>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .pb{
    --cream:#FBF6EE; --card:#fff;
    --clay:#C6603F; --clay-dark:#B0512F; --clay-deep:#8a4429;
    --sage:#6F8A6A; --sage-dark:#5a7355;
    --ink:#33302A;
    --peach:#F3E2D6; --sage-tint:#E4EADD;
    --border:#E8DECE; --fill-line:#ddd0bb;
    --body:#4f4940; --label:#847B6B; --muted:#a89c87; --faint:#bcae99;
    background:var(--cream);font-family:'Karla',system-ui,sans-serif;color:var(--body);line-height:1.65;
  }
  .pb *{box-sizing:border-box}
  .pb a{color:var(--clay)}
  .pb .cav{font-family:'Caveat',cursive;font-weight:600;color:var(--sage);transform:rotate(-1.5deg);display:inline-block}

  .pb .hero{background:var(--cream);padding:28px 0 40px;position:relative;overflow:hidden}
  .pb .hero .glow{position:absolute;right:-160px;top:-60px;width:420px;height:420px;background:radial-gradient(circle,rgba(198,96,63,.10),transparent 70%);filter:blur(10px)}
  .pb .hero-inner{max-width:1080px;margin:0 auto;padding:0 24px;position:relative}
  .pb .hero-top{position:relative;display:flex;justify-content:space-between;align-items:center;min-height:44px;margin:4px 0 30px}
  .pb .masthead{display:flex;align-items:center;gap:11px}
  .pb .masthead .bmark{width:44px;height:44px;border-radius:11px;display:block}
  .pb .masthead .word{font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:1.18rem;color:var(--ink);letter-spacing:-.01em;line-height:1.05}
  .pb .masthead .word i{font-style:normal;color:var(--clay)}
  .pb .backnav{display:inline-flex;align-items:center;gap:7px;font-size:.78rem;font-weight:700;letter-spacing:.04em;color:var(--clay-dark);text-decoration:none;background:var(--peach);border:1px solid #ecd6c5;padding:7px 14px;border-radius:999px;transition:.15s}
  .pb .backnav:hover{background:#eed6c6}
  .pb .backnav .bk-ico{font-size:.95rem;line-height:1}
  .pb .eyebrow{display:inline-flex;align-items:center;gap:8px;font-family:'Karla',sans-serif;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--clay-dark);background:var(--peach);padding:6px 14px;border-radius:999px}
  .pb .hero .cav{font-size:1.5rem;margin:20px 0 6px}
  .pb h1{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(2.4rem,5.6vw,3.7rem);line-height:1.0;margin:2px 0 18px;letter-spacing:-.02em;max-width:15em;color:var(--ink)}
  .pb h1 em{font-style:normal;color:var(--clay)}
  .pb .dek{font-size:1.16rem;color:var(--body);max-width:40em}
  .pb .byline{display:flex;flex-wrap:wrap;gap:16px;margin-top:22px;font-size:.84rem;color:var(--label);font-weight:600}
  .pb .byline b{color:var(--ink)}
  .pb .bandstrip{display:flex;gap:8px;margin-top:28px;max-width:620px}
  .pb .bandstrip .seg{flex:1;text-align:center;padding:11px 6px;border-radius:12px;font-size:.74rem;font-weight:700;border:2px solid var(--border);background:var(--card);color:var(--ink);line-height:1.25}
  .pb .bandstrip .seg small{display:block;font-weight:600;font-size:.66rem;color:var(--label);margin-top:2px}
  .pb .bandstrip .seg.b1{border-color:#cdd9c8;background:var(--sage-tint)}
  .pb .bandstrip .seg.b2{border-color:#ecd6c5;background:var(--peach)}
  .pb .bandstrip .seg.b3{border-color:var(--clay);background:var(--clay);color:#fff}
  .pb .bandstrip .seg.b3 small{color:#f3ddd2}

  .pb .stat-grid{max-width:1080px;margin:18px auto 0;padding:0 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;position:relative;z-index:3}
  .pb .stat{background:var(--card);border:2px solid var(--border);border-radius:16px;padding:18px 16px;text-align:center}
  .pb .stat .n{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:2rem;color:var(--clay);line-height:1}
