const today = '2026-07-04T00:00:00+00:00';

const faqs = [
  { q: 'What is the Best Answer Hub GPA Calculator?', a: 'The Best Answer Hub GPA Calculator is a free, browser-based tool that works out weighted, unweighted, and cumulative GPA across 8 grading scales, including the US 4.0, UK Honours, German, and Indian CGPA systems. It includes a target planner, shows step-by-step working, needs no account, and keeps your grades on your device.' },
  { q: 'How do I calculate my GPA?', a: 'Turn each grade into grade points, multiply by the course credit hours to get quality points, add the quality points, and divide by the total credit hours. It is a credit-weighted average, not a simple average of grades. The Best Answer Hub calculator does this automatically and shows every step.' },
  { q: 'What is the difference between weighted and unweighted GPA?', a: 'An unweighted GPA scores every course on the same 4.0 scale. A weighted GPA gives extra points to harder classes such as honors, AP, or IB, so it can rise above 4.0. Schools weight differently, which is why the Best Answer Hub tool shows both figures side by side.' },
  { q: 'Can a GPA be higher than 4.0?', a: 'Yes, on a weighted scale. Extra points for honors, AP, or IB courses can lift a weighted GPA above 4.0, sometimes toward 5.0. An unweighted GPA is capped at 4.0. The exact bonus varies by school, so the Best Answer Hub calculator lets you set the honors and AP weighting yourself.' },
  { q: 'How do I calculate my cumulative GPA?', a: 'Add the quality points from every course across all your terms and divide by the total credit hours, exactly as you would for one term. It is not the average of your term GPAs. The Best Answer Hub calculator keeps a running cumulative GPA as you add each term.' },
  { q: 'Why does averaging my semester GPAs give the wrong number?', a: 'Because terms carry different credit loads. A 21-credit term counts more than a 9-credit term, so averaging the two GPAs overstates or understates the result. The correct method weights each term by its credits. The Best Answer Hub calculator handles the weighting so the cumulative figure is accurate.' },
  { q: 'How do plus and minus grades affect GPA?', a: 'A plus or minus shifts a grade by roughly 0.3 points, so an A- is about 3.7 and a B+ about 3.3, while a straight A is 4.0. The exact decimals vary by school. The Best Answer Hub calculator applies the plus and minus values for the scale you choose.' },
  { q: 'What grades do I need to raise my GPA to my target?', a: 'It depends on your current GPA, the credits you have completed, and the credits you have left. The more credits already banked, the harder the average is to move. The Best Answer Hub target planner shows the average grade you need across remaining credits, or says honestly when a goal is out of reach.' },
  { q: 'How much will one bad grade lower my GPA?', a: 'Less than most students fear once they have many credits, and more when the record is short. A single low grade is diluted by every other credit you have earned. The Best Answer Hub calculator shows the exact effect, so you can see the real cost of one hard class before worrying.' },
  { q: 'Do colleges use my weighted or unweighted GPA?', a: 'It varies, and many recalculate. Colleges often convert applicants onto a standard unweighted scale, sometimes counting only core academic courses, so everyone is compared fairly. That is why the weighted number a school prints may differ from the one a college uses. The Best Answer Hub tool shows both.' },
  { q: 'How do I convert an international grade or CGPA to a US GPA?', a: 'Only approximately, because each country grades differently and each university applies its own mapping. A UK 2:1, an Indian CGPA, or a German grade becomes a US GPA range, not one exact figure. The Best Answer Hub calculator includes presets for these scales and shows the mapping it uses, as a planning estimate.' },
  { q: 'Is the GPA Calculator free, with no signup?', a: 'Yes. It is completely free, with no account, no email, and no ads, and there is no premium tier. Because it runs on your device, there is no server cost to recover. Best Answer Hub is funded by optional paid assessments in the Knowledge Center, which are entirely separate.' },
  { q: 'Does it work for both high school and college?', a: 'Yes. The Best Answer Hub calculator handles high school GPA, including weighted honors and AP courses, and college GPA with credit hours and cumulative tracking across terms. You choose the grading scale and enter grades and credits, and the tool reports the weighted, unweighted, and cumulative figures for either level.' },
  { q: 'Can I save or export my GPA result?', a: 'Yes. The Best Answer Hub calculator can export your result and working to a PDF, so you can save it, print it, or share it with an advisor. The file is generated in your browser from the grades you entered, so nothing is uploaded and no account is required.' },
  { q: 'What is a good GPA?', a: 'It depends on context, but a 3.0 is a common baseline for good standing, 3.5 and above is competitive, and 3.7 and above is strong for graduate school. Standards vary by school and program. The Best Answer Hub calculator helps you see where you stand and plan toward a specific goal.' },
];

const seo = {
  title: 'How to Calculate Your GPA (Free Calculator, 2026)',
  description: 'Calculate weighted, unweighted, and cumulative GPA across 8 scales, free in your browser. Learn the formula, plan a target GPA, and convert global grades.',
  url: '/playbooks/gpa-calculator/',
  type: 'WebPage' as const,
