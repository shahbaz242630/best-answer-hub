              <rect x="392" y="76" width="30" height="30" rx="5"/><rect x="432" y="76" width="30" height="30" rx="5"/><rect x="472" y="76" width="30" height="30" rx="5"/><rect x="512" y="76" width="30" height="30" rx="5"/><rect x="552" y="76" width="30" height="30" rx="5"/>
            </g>
