---
import BaseLayout from '../../layouts/BaseLayout.astro';

const today = '2026-07-04T00:00:00+00:00';

const faqs = [
  { q: 'What is the Best Answer Hub Mortgage Calculator?', a: 'The Best Answer Hub Mortgage Calculator is a free, browser-based tool that shows your true monthly payment, with principal, interest, property taxes, homeowners insurance, PMI, and HOA dues included. It estimates PMI, marks when it ends, compares loan terms, and models extra payments. It needs no account and sends nothing to a server.' },
  { q: 'Why is my real mortgage payment higher than the calculator showed?', a: 'Most basic calculators show only principal and interest, the smaller part of the bill. The full payment adds property taxes, homeowners insurance, PMI if your down payment is under 20%, and any HOA dues. On a typical home these can add several hundred dollars a month. The Best Answer Hub Mortgage Calculator includes every part upfront.' },
  { q: 'What does PITI mean?', a: 'PITI stands for Principal, Interest, Taxes, and Insurance, the four core parts of a monthly mortgage payment. The Consumer Financial Protection Bureau describes the total as principal and interest plus mortgage insurance if applicable plus escrow for taxes and insurance. The Best Answer Hub Mortgage Calculator shows all of it, plus PMI and HOA, in one figure.' },
  { q: 'What is the 28/36 rule?', a: 'The 28/36 rule is a lender rule of thumb: keep your total housing payment under 28% of gross monthly income and all debt payments, including the mortgage, under 36%. It is guidance rather than a hard limit, and stronger applicants often qualify above it. The Best Answer Hub Mortgage Calculator lets you test these ratios against real figures.' },
  { q: 'Do free mortgage calculators sell my data?', a: 'Many do. A large share are lead generators that capture your name, email, or financial details and sell them to lenders and brokers. The FTC has taken action against sites posing as free quote tools that harvested and resold visitor information. The Best Answer Hub Mortgage Calculator asks for none of this, so it has no lead to sell.' },
  { q: 'Are my numbers uploaded when I use this calculator?', a: 'No. The Best Answer Hub Mortgage Calculator runs entirely in your browser, so your income, savings, and target price stay on your device and are never sent to a server. As the FTC notes, data that is not collected cannot be stolen. There is no account, no login, and no server-side copy of your finances.' },
  { q: 'What is PMI and when does it stop?', a: 'Private mortgage insurance is charged on conventional loans with less than 20% down, and it protects the lender rather than you. Under the federal Homeowners Protection Act it cancels automatically at 78% of the original value, and you can request cancellation at 80%. The Best Answer Hub Mortgage Calculator estimates PMI and marks the month it ends.' },
  { q: 'How much PMI will I pay?', a: 'PMI is commonly cited at around 0.3% to 1.5% of the loan a year, depending on your down payment and credit. On a $270,000 loan at 0.5%, that is about $112 a month. A larger down payment or higher credit score lowers it. The Best Answer Hub Mortgage Calculator estimates PMI from your down payment percentage automatically.' },
  { q: 'What is the difference between PMI and FHA mortgage insurance?', a: 'PMI applies to conventional loans under 20% down and cancels at 78% to 80% of the original value. FHA insurance carries a 1.75% upfront premium plus an annual premium, and on FHA loans with under 10% down it lasts the whole loan term, under the current HUD schedule. For buyers who can reach 20% equity, cancellable PMI is often cheaper long term.' },
  { q: 'Should I choose a 15-year or 30-year mortgage?', a: 'A 15-year loan has a higher monthly payment, often around a third more, but saves a large amount of interest and builds equity faster. A 30-year loan lowers the payment and adds flexibility to invest or handle a shock. Neither is always right. The Best Answer Hub Mortgage Calculator compares both side by side for your exact numbers.' },
  { q: 'How much can extra payments save me?', a: 'A lot, and sooner than most expect. On a $350,000 loan at 7% over 30 years, an extra $100 a month saves about $71,000 in interest and clears it roughly 3.7 years early; $200 a month saves about $122,000 and over six years. The Best Answer Hub Mortgage Calculator shows your interest and years saved instantly.' },
  { q: 'How much does a 1% higher interest rate cost?', a: 'A lot over time. On a $400,000 loan over 30 years, a 1% higher rate adds roughly $263 to the monthly principal and interest and about $95,000 in total interest across the loan. This is why comparing rates and improving your credit before applying matters so much. The Best Answer Hub Mortgage Calculator lets you toggle rates to see the difference.' },
  { q: 'Why did my fixed-rate payment go up?', a: 'A fixed rate locks your principal and interest, but most payments run through an escrow account for property taxes and homeowners insurance. When your home is reassessed higher or your insurance premium rises, the escrow portion goes up to cover it, and lenders keep a cushion, so a tax jump can hit twice. Only refinancing or modifying the loan changes the principal and interest.' },
  { q: 'What are typical closing costs?', a: 'Closing costs cover the appraisal, title insurance, loan fees, prepaid interest, and an escrow cushion for taxes and insurance, and for a purchase they commonly run a few percent of the price, often estimated at 2% to 5%. Freddie Mac puts refinancing costs at 3% to 6% of the principal. Budgeting for them alongside the down payment avoids a surprise at closing.' },
  { q: 'How is this different from a bank mortgage calculator?', a: 'A bank calculator usually aims to move you toward its own loan and often captures your contact details as a lead. The Best Answer Hub Mortgage Calculator sells nothing and recommends no lender: it shows the full payment, the PMI drop-off, and your extra-payment savings, and it keeps every figure in your browser rather than on a server.' },
];

const seo = {
  title: 'What Your Mortgage Payment Really Includes (2026)',
  description: 'A principal-and-interest quote hides taxes, insurance, and PMI. See what your true monthly mortgage payment includes, then calculate it free and privately.',
