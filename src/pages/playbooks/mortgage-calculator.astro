            <rect x="70" y="186" width="270" height="34" rx="6" fill="url(#bg)"/>
            <rect x="342" y="186" width="60" height="34" fill="#6F8A6A"/>
            <rect x="404" y="186" width="18" height="34" fill="#E2B79f"/>
