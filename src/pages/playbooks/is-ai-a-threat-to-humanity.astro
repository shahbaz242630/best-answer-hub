          <div class="seg b2">Elicited<small>asked, then averaged</small></div>
          <div class="seg b3">Asserted<small>stated, no method</small></div>
        </div>
      </div>
    </div>

    <div class="stat-grid">
      <div class="stat"><div class="n">5%</div><div class="l">median extinction estimate from published AI researchers, fielded in 2023</div><div class="src">Grace et al., 2024</div></div>
