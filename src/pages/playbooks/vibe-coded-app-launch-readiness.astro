          <text x="590" y="42" text-anchor="end" font-family="Karla, sans-serif" font-size="12" font-weight="700" fill="#33302A">Operationally Mature</text>
          <rect x="30" y="55" width="224" height="40" rx="9" fill="#C6603F"/>
