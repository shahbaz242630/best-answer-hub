      <div class="stat"><div class="n">2024</div><div class="l">the current IUPAC standard atomic weights</div><div class="src">CIAAW</div></div>
      <div class="stat"><div class="n">100%</div><div class="l">computed in your browser, nothing uploaded</div><div class="src">no upload</div></div>
    </div>

