            <rect x="330" y="121" width="90" height="111" rx="8" fill="url(#gapgrad)" opacity="0.87"/>
            <text x="375" y="111" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-size="20" font-weight="800" fill="#33302A">7.4%</text>
            <text x="375" y="252" text-anchor="middle" font-family="Karla, sans-serif" font-size="13" fill="#847B6B">GB / GiB</text>
            <rect x="455" y="82" width="90" height="150" rx="8" fill="url(#gapgrad)"/>
            <text x="500" y="72" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-size="20" font-weight="800" fill="#33302A">10.0%</text>
