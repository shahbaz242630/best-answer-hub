    </div>

    <div class="layout">
      <nav class="toc" aria-label="On this page">
        <div class="t">On this page</div>
        <a href="#what">What it is</a>
        <a href="#pvalue">The p-value trap</a>
        <a href="#ci">Confidence intervals</a>
        <a href="#zscore">Z-scores</a>
