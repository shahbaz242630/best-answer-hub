<style>
  .pb{
    --primary:#6366f1; --accent:#8b5cf6; --accent-warm:#c4b5fd; --ink:#0f0f1a; --fg:#1a1a2e;
    --muted:#6b6b80; --card:#fff; --border:#e8e8f0; --border-light:#f0f0f6;
  }
  .pb a{color:var(--primary)}
  .pb .hero{background:radial-gradient(1200px 500px at 75% -10%,rgba(139,92,246,.35),transparent 60%),linear-gradient(160deg,#15152a 0%,#0f0f1a 100%);color:#fff;padding:28px 0 86px;position:relative;overflow:hidden}
  .pb .hero .glow{position:absolute;right:-120px;top:30px;width:380px;height:380px;background:radial-gradient(circle,rgba(99,102,241,.45),transparent 70%);filter:blur(20px)}
  .pb .hero-inner{max-width:1080px;margin:0 auto;padding:0 24px;position:relative}
  .pb .hero-top{position:relative;display:flex;justify-content:center;align-items:center;min-height:44px;margin:4px 0 34px}
  .pb .masthead{display:flex;justify-content:center;align-items:center;gap:12px;margin:0}
  .pb .masthead .bmark{width:44px;height:44px;border-radius:11px;display:block}
  .pb .masthead .word{font-family:'Playfair Display',serif;font-weight:700;font-size:1.5rem;color:#fff;letter-spacing:.01em}
  .pb .masthead .word i{font-style:normal;color:var(--accent-warm)}
  .pb .backnav{position:absolute;right:0;top:50%;transform:translateY(-50%);display:inline-flex;align-items:center;gap:7px;font-size:.8rem;font-weight:600;letter-spacing:.02em;color:var(--accent-warm);text-decoration:none;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);padding:6px 13px;border-radius:999px;transition:.15s}
  .pb .backnav:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.28)}
  .pb .backnav .bk-ico{font-size:.95rem;line-height:1}
  .pb .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-warm);background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);padding:6px 14px;border-radius:999px}
  .pb h1{font-family:'Playfair Display',serif;font-weight:700;font-size:clamp(2.3rem,5.4vw,3.5rem);line-height:1.14;margin:22px 0 16px;padding-bottom:.12em;letter-spacing:-.015em;max-width:15em;color:#fff}
  .pb h1 em{font-style:italic;background:linear-gradient(90deg,#a5b4fc,#c4b5fd);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;padding-bottom:.06em}
  .pb .dek{font-size:1.18rem;color:#c9c9d6;max-width:40em}
  .pb .byline{display:flex;flex-wrap:wrap;gap:16px;margin-top:24px;font-size:.85rem;color:#9a9ab0}
  .pb .byline b{color:#fff}
  .pb .bandstrip{display:flex;gap:4px;margin-top:30px;max-width:680px}
  .pb .bandstrip .seg{flex:1;text-align:center;padding:10px 4px;border-radius:8px;font-size:.72rem;font-weight:600;color:#fff;border:1px solid rgba(255,255,255,.16)}
  .pb .seg.s1{background:rgba(99,102,241,.28)}
  .pb .seg.s2{background:rgba(99,102,241,.45)}
  .pb .seg.s3{background:rgba(99,102,241,.66)}
  .pb .seg.s4{background:rgba(99,102,241,.9)}
  .pb .seg small{display:block;font-weight:500;opacity:.82;font-size:.64rem;margin-top:2px}
  .pb .stat-grid{max-width:1080px;margin:-56px auto 0;padding:0 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;position:relative;z-index:3}
  .pb .stat{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px 14px;text-align:center;box-shadow:0 14px 44px rgba(15,15,26,.12)}
  .pb .stat .n{font-family:'Playfair Display',serif;font-weight:700;font-size:1.9rem;color:var(--primary);line-height:1}
  .pb .stat .l{font-size:.76rem;color:var(--fg);margin-top:7px;font-weight:600}
  .pb .stat .src{font-size:.64rem;color:var(--muted);margin-top:5px}
  .pb .layout{max-width:1080px;margin:0 auto;padding:48px 24px 60px;display:grid;grid-template-columns:220px 1fr;gap:48px}
  .pb .toc{position:sticky;top:24px;align-self:start;font-size:.88rem}
  .pb .toc .t{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:600;margin-bottom:12px}
  .pb .toc a{display:block;color:var(--muted);text-decoration:none;padding:7px 0;border-left:2px solid var(--border);padding-left:14px;transition:.15s}
  .pb .toc a:hover{color:var(--primary);border-left-color:var(--primary)}
  .pb .toc a.active{color:var(--primary);border-left-color:var(--primary);font-weight:600}
  .pb article{min-width:0;max-width:740px}
  .pb .lead{font-size:1.2rem;color:var(--ink);margin:0 0 26px}
  .pb .lead strong{font-weight:700}
  .pb h2{font-family:'Playfair Display',serif;font-weight:700;font-size:1.6rem;color:var(--ink);margin:40px 0 6px;letter-spacing:-.01em;scroll-margin-top:88px}
  .pb .chaprule{height:3px;width:54px;background:linear-gradient(90deg,var(--primary),var(--accent));border-radius:2px;margin:0 0 16px}
  .pb p{margin:14px 0}
  .pb table{display:table;white-space:normal;width:100%;border-collapse:collapse;margin:10px 0;font-size:.9rem}
  .pb th{background:var(--ink);color:#fff;text-align:left;padding:11px 13px;font-size:.74rem;text-transform:uppercase;letter-spacing:.04em}
  .pb th:first-child{border-top-left-radius:10px}
  .pb th:last-child{border-top-right-radius:10px}
  .pb td{padding:12px 13px;border-top:1px solid var(--border-light);vertical-align:top;background:var(--card)}
  .pb td.band{font-weight:700;color:var(--ink)}
  .pb .score{font-variant-numeric:tabular-nums;color:#fff;font-weight:700;font-size:.76rem;padding:4px 10px;border-radius:6px;display:inline-block;white-space:nowrap;letter-spacing:.01em}
  .pb .sc1{background:#6366f1}
  .pb .sc2{background:#4f46e5}
  .pb .sc3{background:#4338ca}
  .pb .sc4{background:#312e81}
  .pb .callout{background:var(--card);border:1px solid var(--border);border-left:4px solid var(--primary);border-radius:12px;padding:18px 20px;margin:20px 0}
  .pb .callout .h{font-weight:700;color:var(--ink);margin-bottom:6px;font-size:.98rem}
  .pb .callout ul{margin:6px 0 0 18px}
  .pb .callout li{margin:4px 0}
  .pb blockquote{font-family:'Playfair Display',serif;font-style:italic;font-size:1.4rem;line-height:1.42;color:var(--ink);background:rgba(99,102,241,.06);border:1px solid rgba(99,102,241,.18);border-left:4px solid var(--primary);border-radius:12px;padding:24px 28px;margin:28px 0}
  .pb blockquote .accent{color:var(--primary)}
  .pb blockquote .cite{display:block;font-family:'Inter',sans-serif;font-style:normal;font-size:.82rem;color:var(--muted);margin-top:10px}
  .pb .cta{background:rgba(99,102,241,.12);border:1px solid rgba(99,102,241,.3);color:var(--ink);border-radius:16px;padding:32px;margin:24px 0;text-align:center}
  .pb .cta .kicker{font-size:.76rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--primary)}
  .pb .cta h3{font-family:'Playfair Display',serif;font-weight:700;font-size:1.5rem;margin:8px 0 6px;color:var(--ink)}
  .pb .cta p{margin:0 auto 20px;color:var(--muted);max-width:32em}
  .pb .btn{display:inline-block;background:var(--primary);color:#fff;text-decoration:none;font-weight:700;font-size:.95rem;padding:14px 30px;border-radius:12px}
  .pb .faq .q{font-weight:700;color:var(--ink);margin-top:18px}
  .pb .faq .a{color:var(--fg);font-size:.96rem;margin-top:4px}
  .pb .chart{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:20px 24px;margin:22px 0;box-shadow:0 1px 2px rgba(0,0,0,.03)}
  .pb .chart-title{font-family:'Playfair Display',serif;font-weight:700;font-size:1.08rem;color:var(--ink);margin-bottom:2px}
  .pb .chart svg{width:100%;height:auto;display:block;margin:8px 0 2px}
  .pb .chart-src{font-size:.74rem;color:var(--muted);margin:6px 0 0}
  .pb .sources{font-size:.82rem;color:var(--muted);margin-top:20px;padding-left:18px}
  .pb .sources li{margin:5px 0}
  @media(max-width:860px){.pb .layout{grid-template-columns:1fr}.pb .toc{display:none}}
  @media(max-width:680px){.pb .stat-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:600px){.pb .hero-top{flex-direction:column;gap:12px;align-items:flex-start;min-height:0;margin:4px 0 28px}.pb .hero-top .masthead{justify-content:flex-start}.pb .backnav{position:static;transform:none}}
</style>

<script is:inline>
  (function () {
    function init() {
      var toc = document.querySelector('.pb .toc');
      if (!toc) return;
      var items = Array.prototype.slice.call(toc.querySelectorAll('a')).map(function (a) {
        var href = a.getAttribute('href') || '';
        var el = href.charAt(0) === '#' ? document.getElementById(href.slice(1)) : null;
        return el ? { a: a, el: el } : null;
      }).filter(Boolean);
      if (!items.length) return;
      var current = null;
      function update() {
        var line = 110, active = items[0];
        for (var i = 0; i < items.length; i++) {
          if (items[i].el.getBoundingClientRect().top <= line) active = items[i];
          else break;
        }
        if (active.a !== current) {
          items.forEach(function (it) { it.a.classList.remove('active'); });
          active.a.classList.add('active');
          current = active.a;
        }
      }
      var ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () { update(); ticking = false; });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
