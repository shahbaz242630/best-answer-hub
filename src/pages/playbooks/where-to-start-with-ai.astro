      <nav class="toc" aria-label="On this page">
        <div class="t">On this page</div>
        <a href="#behind">Am I already behind?</a>
        <a href="#task">Find your first task</a>
        <a href="#tool">Which tool to start with</a>
        <a href="#test">The 30-day test</a>
