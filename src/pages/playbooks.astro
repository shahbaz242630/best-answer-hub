  <script is:inline>
    // Playbooks hub search. Filters the deduplicated results grid and collapses the
    // browse-by-track sections while a query or topic filter is active. No network
    // access, no storage, no dependencies. Degrades to plain browsing if JS is off,
    // because the track sections render visible and the results grid renders hidden.
    (function () {
      var input = document.getElementById('pb-search');
      var results = document.getElementById('pb-results');
      var empty = document.getElementById('pb-empty');
      var count = document.getElementById('pb-count');
      if (!input || !results || !empty || !count) return;

      var sections = Array.prototype.slice.call(document.querySelectorAll('[data-pb-section]'));
      var chips = Array.prototype.slice.call(document.querySelectorAll('[data-pb-filter]'));
      var cards = Array.prototype.slice.call(results.querySelectorAll('[data-pb-card]'));
      var haystacks = cards.map(function (c) { return c.getAttribute('data-pb-text') || ''; });
      var tracks = cards.map(function (c) { return c.getAttribute('data-pb-track') || ''; });
      var total = cards.length;
      var track = 'all';

      var CHIP_BASE = 'text-xs font-semibold px-3 py-1.5 rounded-full border transition-colors cursor-pointer';
      var CHIP_OFF = 'border-bae-border text-bae-muted hover:border-bae-primary hover:text-bae-primary';
      var CHIP_ON = 'border-bae-primary bg-bae-primary-soft text-bae-primary';

      function matches(i, terms) {
        if (track !== 'all' && tracks[i] !== track) return false;
        for (var t = 0; t < terms.length; t++) {
          if (haystacks[i].indexOf(terms[t]) === -1) return false;
        }
        return true;
      }

      function apply() {
        var q = input.value.trim().toLowerCase();
        var terms = q === '' ? [] : q.split(/\s+/);
        var active = terms.length > 0 || track !== 'all';
        var shown = 0;

        if (active) {
          for (var i = 0; i < total; i++) {
            var hit = matches(i, terms);
            cards[i].hidden = !hit;
            if (hit) shown++;
          }
        }

        results.hidden = !active;
        empty.hidden = !(active && shown === 0);
        for (var j = 0; j < sections.length; j++) sections[j].hidden = active;

        if (!active) {
          count.textContent = 'Browse all ' + total + ' guides by topic below, or type above to search.';
        } else if (shown === 0) {
          count.textContent = 'No matches';
        } else if (shown === 1) {
          count.textContent = '1 guide matches';
        } else {
          count.textContent = shown + ' guides match';
        }
      }

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          var next = chip.getAttribute('data-pb-filter');
          track = track === next ? 'all' : next;
          chips.forEach(function (c) {
            var on = c.getAttribute('data-pb-filter') === track;
            c.setAttribute('aria-pressed', on ? 'true' : 'false');
            c.className = CHIP_BASE + ' ' + (on ? CHIP_ON : CHIP_OFF);
          });
          apply();
        });
      });

      input.addEventListener('input', apply);
      input.addEventListener('search', apply);

      // Allow /playbooks/?q=pdf to open straight into a filtered view.
      try {
        var seeded = new URLSearchParams(window.location.search).get('q');
        if (seeded) input.value = seeded;
      } catch (e) { /* no-op */ }

      apply();
    })();
  </script>
