---
import { toolCountLabel } from '../../data/tools';

const toolCards = [
  { icon: '⚡', label: 'Speed Test', suffix: 'Check site performance' },
  { icon: '🔍', label: 'SEO Checker', suffix: 'Audit any page' },
  { icon: '💰', label: 'AI Cost Calc', suffix: 'Compare AI pricing' },
  { icon: '🖼️', label: 'Image Compress', suffix: 'Shrink JPEG/PNG/WebP' },
  { icon: '📄', label: 'PDF Converter', suffix: 'PDF ↔ Word' },
];
---

<section class="py-16 md:py-20 relative z-[1]" aria-labelledby="hero-title">
  <div class="container max-w-page mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-12 items-center">
      <div>
        <div class="inline-flex items-center gap-2 bg-bae-primary-soft border border-bae-primary/15 px-3.5 py-1.5 rounded-full text-xs font-semibold text-bae-primary mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-bae-primary animate-pulse-dot"></span>
          Free tools · no signup required
        </div>
        <h1 id="hero-title" class="font-serif text-4xl md:text-5xl lg:text-[3.6rem] font-bold leading-[1.08] tracking-tight text-bae-ink mb-5">
          What is the <em class="italic text-bae-primary relative">best tool<svg class="absolute -bottom-1 -left-1 -right-1 h-2.5 text-bae-accent-warm/25 -z-10" viewBox="0 0 100 10" preserveAspectRatio="none"><rect width="100" height="10" rx="3" fill="currentColor"/></svg></em> for your exact need?
        </h1>
        <p class="text-base md:text-lg text-bae-muted max-w-md leading-relaxed mb-8">
          <strong class="text-bae-ink font-semibold">Best Answer Hub is a free toolkit of {toolCountLabel} calculators, converters, and checkers</strong> that run entirely in your browser, with no signup, no uploads, and no data stored.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/tools/" class="inline-flex items-center gap-2 bg-bae-ink text-white px-6 py-3 rounded-bae-sm font-semibold text-sm shadow-[0_4px_14px_rgba(15,15,26,0.15)] hover:bg-bae-primary hover:-translate-y-0.5 transition-all">
            Try free tools →
          </a>
          <a href="/tools/" class="inline-flex items-center gap-2 bg-bae-card text-bae-ink px-6 py-3 rounded-bae-sm font-semibold text-sm border border-bae-border hover:border-bae-primary hover:text-bae-primary transition-all">
            Browse tools
          </a>
        </div>
      </div>
      
      <div class="relative h-[300px] md:h-[360px] hidden md:flex items-center justify-center" aria-hidden="true">
        {toolCards.map((card, i) => (
          <div class={`absolute bg-bae-card border border-bae-border rounded-bae px-4 py-3 text-sm font-medium text-bae-muted shadow-bae-md transition-transform duration-300 hover:-translate-y-1 flex items-center gap-2.5 ${
            i === 0 ? 'top-2 left-0 -rotate-[3deg]' :
            i === 1 ? 'top-[70px] right-2 rotate-[2deg]' :
            i === 2 ? 'top-[150px] left-4 -rotate-[1deg]' :
            i === 3 ? 'top-[230px] right-0 rotate-[3deg]' :
            'top-[290px] left-10 -rotate-[2deg]'
          }`}>
            <span class="text-bae-primary font-bold">{card.icon}</span>
            <strong class="text-bae-ink">{card.label}</strong> <span class="text-bae-muted/70">{card.suffix}</span>
          </div>
        ))}
        <div class="absolute bottom-4 right-4 bg-gradient-to-br from-bae-primary to-bae-accent text-white px-5 py-2.5 rounded-full font-bold text-sm shadow-[0_8px_32px_rgba(99,102,241,0.3)] z-[2] whitespace-nowrap">
          → Best Answer Hub
        </div>
      </div>
    </div>
  </div>
</section>
