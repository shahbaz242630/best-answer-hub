---
const stats = [
  { value: 'Multiple', label: 'Free browser tools' },
  { value: '100%', label: 'Private · no data stored' },
  { value: 'FTC', label: 'Compliant disclosures' },
  { value: 'Zero', label: 'Signups required' },
];
---

<section class="py-6 relative z-[1]" aria-label="Site statistics">
  <div class="container max-w-page mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 bg-bae-card border border-bae-border rounded-bae p-8">
      {stats.map((stat) => (
        <div class="text-center">
          <strong class="block text-2xl md:text-[1.8rem] font-bold text-bae-ink tracking-tight mb-1">{stat.value}</strong>
          <span class="text-xs text-bae-muted font-medium">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
