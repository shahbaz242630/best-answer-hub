---
const trustItems = [
  { icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', label: 'HTTPS Secured' },
  { icon: 'M5 11h14a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2zm7-7a4 4 0 0 1 4 4v3H8V8a4 4 0 0 1 4-4z', label: 'No Data Stored' },
  { icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z', label: 'Client-Side Only' },
  { icon: 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z', label: 'Free Forever' },
];
---

<div class="pt-4 pb-2 md:pt-6 md:pb-3" role="region" aria-label="Trust signals">
  <div class="container max-w-page mx-auto px-6 flex items-center justify-center gap-6 md:gap-10 flex-wrap">
    {trustItems.map((item) => (
      <div class="flex items-center gap-2 text-sm text-bae-muted font-medium">
        <svg class="w-4 h-4 text-bae-primary flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          {item.icon.split(' ').map((path) => (
            <path d={path} />
          ))}
        </svg>
        <span>{item.label}</span>
      </div>
    ))}
  </div>
</div>
