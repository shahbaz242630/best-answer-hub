---
const trustItems = [
  { icon: 'shield', label: 'HTTPS Secured' },
  { icon: 'zap', label: 'Free Tools' },
  { icon: 'lock', label: 'Privacy First' },
  { icon: 'check-circle', label: 'No Signup Needed' },
];

const icons: Record<string, string[]> = {
  shield: ['M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'],
  'file-text': ['M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z', 'M14 2v6h6', 'M16 13H8', 'M16 17H8'],
  edit: ['M12 20h9', 'M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z'],
  calendar: ['M16 2v4', 'M8 2v4', 'M3 10h18', 'M8 14h.01', 'M12 14h.01', 'M16 14h.01', 'M8 18h.01', 'M12 18h.01', 'M16 18h.01'],
  zap: ['M13 2L3 14h9l-1 8 10-12h-9l1-8z'],
  lock: ['M19 11H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2z', 'M8 11V7a4 4 0 0 1 8 0v4'],
  'check-circle': ['M22 11.08V12a10 10 0 1 1-5.93-9.14', 'M22 4L12 14.01l-3-3'],
};
---

<div class="pt-2 pb-1 md:pt-3 md:pb-2" role="region" aria-label="Trust signals">
  <div class="container max-w-page mx-auto px-6 flex items-center justify-center gap-6 md:gap-10 flex-wrap">
    {trustItems.map((item) => (
      <div class="flex items-center gap-2 text-sm text-bae-muted font-medium">
        <svg class="w-4 h-4 text-bae-primary flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          {icons[item.icon].map((path) => (
            <path d={path} />
          ))}
        </svg>
        <span>{item.label}</span>
      </div>
    ))}
  </div>
</div>
