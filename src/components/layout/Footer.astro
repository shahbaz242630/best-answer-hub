---
import { hubNavLinks, featuredTools } from '../../data/tools';

const discoverLinks = hubNavLinks;

// "Popular free tools" strip: featured tools (self-healing — a removed tool drops
// out automatically) plus two hub links. Edit via `featured: true` in tools.ts.
const popularLinks = [
  ...featuredTools,
  { label: 'PDF Toolkit', href: '/pdf-toolkit/' },
  { label: 'Developer Toolbox', href: '/developer-toolbox/' },
];

const companyLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Founder', href: '/about/shahbaz-ali-malik/' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'Contact', href: '/contact/' },
];

const legalLinks = [
  { label: 'Affiliate Disclosure', href: '/affiliate-disclosure/' },
  { label: 'Privacy Policy', href: '/privacy-policy/' },
  { label: 'Cookie Policy', href: '/cookie-policy/' },
  { label: 'Refund Policy', href: '/refund-policy/' },
  { label: 'Terms of Use', href: '/terms/' },
];

const communityLinks = [
  // All brand social accounts removed 2026-06-18 (X, LinkedIn, Reddit accounts blocked, restore once resolved):
  // { label: 'Reddit', href: 'https://www.reddit.com/r/BestAnswerhub1/', external: true },
  // { label: 'X (Twitter)', href: 'https://x.com/BestAnswerHub', external: true },
  // { label: 'LinkedIn', href: 'https://www.linkedin.com/company/bestanswerhub/', external: true },
];
---

<footer class="bg-bae-ink text-[#e8e8f0] py-14 relative z-[1]" role="contentinfo">
  <div class="container max-w-page mx-auto px-6">
    <!-- lg:grid-cols-4 while the Social Media column is hidden (brand accounts blocked 2026-06-18); restore to lg:grid-cols-5 when re-adding it -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-2.5 text-white font-bold text-[1.05rem] tracking-tight no-underline mb-3" aria-label="Best Answer Hub - Home">
          <img src="/brand-mark.png" alt="" width="32" height="32" class="w-8 h-8 rounded-[10px]" aria-hidden="true" />
          Best Answer Hub
        </a>
        <p class="text-sm text-[#9a9ab0] leading-relaxed max-w-[280px]">
          Free browser-based tools and honest recommendations for software, tools, and services. No signup. No data stored.
        </p>
        <a href="https://www.google.com/preferences/source?q=bestanswerhub.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-5 px-4 py-2 rounded-full border border-white/20 text-xs whitespace-nowrap font-semibold text-white no-underline transition-colors hover:bg-white/10 hover:border-white/40">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.7 7.3L12 17.8 5.7 21.5l1.7-7.3L2 9.5l7.1-.6z"/></svg>
          Add as a preferred source on Google
        </a>
      </div>
      
      <!-- Discover -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.08em] mb-5 text-[#7a7a9a]">Discover</h4>
        {discoverLinks.map((link) => (
          <a href={link.href} class="block text-sm text-[#b4b4c8] no-underline mb-2.5 transition-colors hover:text-white">{link.label}</a>
        ))}
      </div>
      
      <!-- Company -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.08em] mb-5 text-[#7a7a9a]">Company</h4>
        {companyLinks.map((link) => (
          <a href={link.href} class="block text-sm text-[#b4b4c8] no-underline mb-2.5 transition-colors hover:text-white">{link.label}</a>
        ))}
      </div>
      
      <!-- Legal -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.08em] mb-5 text-[#7a7a9a]">Legal</h4>
        {legalLinks.map((link) => (
          <a href={link.href} class="block text-sm text-[#b4b4c8] no-underline mb-2.5 transition-colors hover:text-white">{link.label}</a>
        ))}
      </div>
      
      <!-- Social Media column hidden 2026-06-18 while brand accounts are blocked; renders automatically once communityLinks is repopulated -->
      {communityLinks.length > 0 && (
        <div>
          <h4 class="text-xs font-bold uppercase tracking-[0.08em] mb-5 text-[#7a7a9a]">Social Media</h4>
          {communityLinks.map((link) => (
            <a href={link.href} class="block text-sm text-[#b4b4c8] no-underline mb-2.5 transition-colors hover:text-white" rel="noopener noreferrer" target="_blank">{link.label}</a>
          ))}
        </div>
      )}
    </div>
    
    <!-- Popular Tools -->
    <div class="border-t border-white/10 pt-6 mb-6">
      <p class="text-sm text-[#9a9ab0] leading-relaxed">
        Popular free tools: {popularLinks.map((link, i) => (
          <>
            <a href={link.href} class="text-[#a5a5d0] hover:text-white hover:underline transition-colors">{link.label}</a>{i < popularLinks.length - 2 ? ', ' : i === popularLinks.length - 2 ? ', and ' : '.'}
          </>
        ))}
      </p>
    </div>

    <!-- Bottom -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-xs text-[#6a6a8a]">© 2026 Best Answer Hub. All rights reserved.</p>
      <div class="flex flex-wrap justify-center gap-x-5">
        <a href="#" id="footer-manage-cookies" class="text-xs text-[#6a6a8a] no-underline transition-colors hover:text-[#9a9ab0]">Manage Cookies</a>
        <a href="/affiliate-disclosure/" class="text-xs text-[#6a6a8a] no-underline transition-colors hover:text-[#9a9ab0]">Disclosure</a>
        <a href="/privacy-policy/" class="text-xs text-[#6a6a8a] no-underline transition-colors hover:text-[#9a9ab0]">Privacy</a>
        <a href="/refund-policy/" class="text-xs text-[#6a6a8a] no-underline transition-colors hover:text-[#9a9ab0]">Refunds</a>
        <a href="/terms/" class="text-xs text-[#6a6a8a] no-underline transition-colors hover:text-[#9a9ab0]">Terms</a>
      </div>
    </div>
  </div>
</footer>
