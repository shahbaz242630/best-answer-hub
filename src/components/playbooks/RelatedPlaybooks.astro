---
// Shared "People also read these" related-articles block for Playbook pages.
// Data-driven from the single source of truth in src/data/tools.ts, so adding a
// new playbook there makes it appear in its track-mates' related lists
// automatically. Two visual families: track="aikt" (clay Coaching Workbook) and
// track="smb" (indigo Sample D). Pass the current page's URL so it excludes itself.
import { playbooks } from '../../data/tools';

interface Props {
  track: 'smb' | 'aikt' | 'career';
  currentHref: string;
  heading?: string;
}
const { track, currentHref, heading = 'People also read these' } = Astro.props;

// Siblings in the same track, excluding the current page. Rotate the start point
// by the current page's index so different siblings surface across pages (better
// internal-link distribution), then cap at 4.
const sibs = playbooks.filter(
  (p) => p.live && (p.track ?? 'smb') === track && p.href !== currentHref,
);
const i = playbooks.findIndex((p) => p.href === currentHref);
const off = sibs.length ? ((i < 0 ? 0 : i) % sibs.length) : 0;
const related = [...sibs.slice(off), ...sibs.slice(0, off)].slice(0, 4);
---

{related.length > 0 && (
  <section class={`relwrap ${track}`} aria-label="Related playbooks">
    {(track === 'aikt' || track === 'career') && <div class="relcav">Keep going</div>}
    <h2 class="relh">{heading}</h2>
    {track === 'smb' && <div class="relrule"></div>}
    <div class="relgrid">
      {related.map((r) => (
        <a href={r.href} class="relcard">
          <div class="reltop"><span class="relicon">{r.icon}</span><span class="relbadge">{r.badge}</span></div>
          <span class="reltitle">{r.title}</span>
          <span class="reldesc">{r.description}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .relwrap{margin:42px 0 6px}
  .relh{margin:0}
  .relgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:16px}
  .relcard{display:block;border-radius:14px;padding:16px 18px;text-decoration:none;border:2px solid;transition:.15s}
  .reltop{display:flex;align-items:center;gap:9px;margin-bottom:9px}
  .relicon{flex:none;width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:.98rem}
  .relbadge{font-weight:700;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase}
  .reltitle{font-weight:700;font-size:1rem;line-height:1.22;margin-bottom:6px;display:block}
  .reldesc{font-size:.82rem;line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

  /* AI Knowledge Test + Career tracks — clay Coaching Workbook */
  .relwrap.aikt .relcav, .relwrap.career .relcav{font-family:'Caveat',cursive;font-weight:600;color:#6F8A6A;transform:rotate(-1.5deg);display:inline-block;font-size:1.4rem;margin-bottom:2px}
  .relwrap.aikt .relh, .relwrap.career .relh{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:1.72rem;color:#33302A;letter-spacing:-.02em;line-height:1.06}
  .relwrap.aikt .relcard, .relwrap.career .relcard{background:#fff;border-color:#E8DECE}
  .relwrap.aikt .relcard:hover, .relwrap.career .relcard:hover{border-color:#C6603F;transform:translateY(-2px)}
  .relwrap.aikt .relicon, .relwrap.career .relicon{background:#F3E2D6}
  .relwrap.aikt .relbadge, .relwrap.career .relbadge{font-family:'Karla',sans-serif;color:#B0512F}
  .relwrap.aikt .reltitle, .relwrap.career .reltitle{font-family:'Bricolage Grotesque',sans-serif;color:#33302A}
  .relwrap.aikt .reldesc, .relwrap.career .reldesc{font-family:'Karla',sans-serif;color:#847B6B}

  /* SMB track — indigo Sample D */
  .relwrap.smb .relh{font-family:'Playfair Display',serif;font-weight:700;font-size:1.6rem;color:#0f0f1a;letter-spacing:-.01em}
  .relwrap.smb .relrule{height:3px;width:54px;background:linear-gradient(90deg,#6366f1,#8b5cf6);border-radius:2px;margin:10px 0 0}
  .relwrap.smb .relcard{background:#fff;border-color:#e8e8f0}
  .relwrap.smb .relcard:hover{border-color:#6366f1;transform:translateY(-2px)}
  .relwrap.smb .relicon{background:rgba(99,102,241,.08)}
  .relwrap.smb .relbadge{font-family:'Inter',sans-serif;color:#6366f1}
  .relwrap.smb .reltitle{font-family:'Inter',sans-serif;color:#0f0f1a}
  .relwrap.smb .reldesc{font-family:'Inter',sans-serif;color:#6b6b80}

  @media(max-width:600px){.relgrid{grid-template-columns:1fr}}
</style>
