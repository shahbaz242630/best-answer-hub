---
import { getToolBackLink } from '../../data/tools';

interface Props {
  badge: string;
  title: string;
  accentText: string;
  description: string;
  /** Pass the page's own href to auto-derive the back pill from tools.ts. */
  href?: string;
  backLink?: string;
  backLabel?: string;
}

const { badge, title, accentText, description, href, backLink, backLabel } = Astro.props;

// Explicit backLink always wins (keeps all existing pages unchanged). Otherwise,
// if an href is supplied, derive the back pill from the hub map in tools.ts.
const derived = !backLink && href ? getToolBackLink(href) : null;
const resolvedBackLink = backLink ?? derived?.backLink;
const resolvedBackLabel = backLabel ?? derived?.backLabel;
---

<section class="pt-10 pb-6 md:pt-14 md:pb-8">
  <div class="container max-w-page mx-auto px-6">
    <div class="max-w-3xl">
      <!-- Top row: badge on left, back link on right -->
      <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
        <div class="inline-flex items-center gap-2 bg-bae-primary-soft border border-bae-primary/15 px-3.5 py-1.5 rounded-full text-xs font-semibold text-bae-primary">
          <span class="w-1.5 h-1.5 rounded-full bg-bae-primary animate-pulse-dot"></span>
          {badge}
        </div>
        {resolvedBackLink && (
          <a href={resolvedBackLink} class="inline-flex items-center gap-1.5 text-sm font-semibold text-bae-ink bg-white border border-bae-border px-3.5 py-2 rounded-bae-sm hover:border-bae-primary hover:text-bae-primary transition-colors no-underline shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            {resolvedBackLabel || 'Back'}
          </a>
        )}
      </div>
      <h1 class="font-serif text-3xl md:text-4xl lg:text-[2.75rem] font-bold leading-[1.1] tracking-tight text-bae-ink mb-4">
        {title}<br/>
        <em class="italic text-bae-primary">{accentText}</em>
      </h1>
      <p class="text-base md:text-lg text-bae-muted leading-relaxed max-w-2xl">
        {description}
      </p>
    </div>
  </div>
</section>
