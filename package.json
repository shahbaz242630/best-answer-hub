{
  "name": "best-answer-hub",
  "version": "1.0.0",
  "description": "Best Answer Hub — Honest, practical answers to 'what is the best...' questions",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/kc-availability.mjs && node prebuild.mjs && astro build",
    "preview": "astro preview",
    "audit": "node maintenance-audit.mjs",
    "audit:server": "node server-audit.mjs",
    "catalog:check": "node scripts/catalog-check.mjs",
    "provision": "node scripts/provision.mjs",
    "astro": "astro",
    "visual": "node scripts/visual-stamp.mjs && python scripts/visual_check.py",
